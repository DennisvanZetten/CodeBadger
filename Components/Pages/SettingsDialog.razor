@inject LauncherSettingsService SettingsService
@inject LocalizationService L
@inject AiCommitMessageService AiCommitMessageService
@inject RepositoryFolderPicker FolderPicker
@inject AgentConfigService AgentConfigService
@inject StartupDetectionService StartupDetection
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IDialogService DialogService
@implements IDisposable

<MudDialog Class="settings-dialog">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Settings" Color="Color.Primary" />
            <MudText Typo="Typo.h6">@L.T("Settings")</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudTabs Position="Position.Left" Rounded="true" Border="true" ApplyEffectsToContainer="true"
                 TabPanelsClass="settings-tab-panel" Class="settings-tabs">
            <MudTabPanel Text="@L.T("Repositories")" Icon="@Icons.Material.Filled.Folder">
                <MudStack Spacing="3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <div>
                            <MudText Typo="Typo.h6">@L.T("Manage repositories")</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@L.T("Active repositories get their own tab on the home screen.")</MudText>
                        </div>
                         <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddRepository">@L.T("Add")</MudButton>
                    </MudStack>
                    @if (Settings.Repositories.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@L.T("Add a repository folder to get started.")</MudAlert>
                    }
                    @foreach (var repository in Settings.Repositories)
                    {
                        <MudPaper @key="repository" Class="pa-3 repository-setting-row" Outlined="true" Elevation="0">
                            <div class="repository-active-toggle">
                                <MudSwitch @bind-Value="repository.IsActive" Color="Color.Primary" />
                            </div>
                            <div class="repository-name-control">
                                <MudTextField @bind-Value="repository.Name" Label="@L.T("Name")" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </div>
                            <div class="repository-path-control">
                                <MudTextField @bind-Value="repository.Path" Label="@L.T("Path")" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.FolderOpen" Color="Color.Primary" aria-label="@L.T("Browse for repository folder")"
                                                Disabled="@(!FolderPicker.IsSupported)" OnClick="@(() => BrowseRepositoryAsync(repository))" />
                            </div>
                            <div class="repository-agent-control">
                                <MudSelect T="string" @bind-Value="repository.AgentTool" Label="@L.T("Agent tool")" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    <MudSelectItem T="string" Value="@AgentTools.OpenCode">OpenCode</MudSelectItem>
                                    <MudSelectItem T="string" Value="@AgentTools.ClaudeCode">Claude Code</MudSelectItem>
                                    <MudSelectItem T="string" Value="@AgentTools.Codex">Codex</MudSelectItem>
                                    <MudSelectItem T="string" Value="@AgentTools.Hermes">Hermes</MudSelectItem>
                                </MudSelect>
                                @if (!StartupDetection.IsAgentAvailable(repository.AgentTool))
                                {
                                    <MudTooltip Text="@L.T("Agent command not found")">
                                        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small" />
                                    </MudTooltip>
                                }
                                @if (AgentTools.Normalize(repository.AgentTool) == AgentTools.ClaudeCode && !string.IsNullOrWhiteSpace(repository.Path))
                                {
                                    <MudIconButton Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.SettingsSuggest"
                                                   aria-label="@L.T("Claude Code config")"
                                                   OnClick="@(() => OpenClaudeRepositoryConfigAsync(repository))" />
                                }
                                else if (AgentTools.Normalize(repository.AgentTool) == AgentTools.OpenCode && !string.IsNullOrWhiteSpace(repository.Path))
                                {
                                    <MudIconButton Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.SettingsSuggest"
                                                   aria-label="@L.T("OpenCode project config & skills")"
                                                     OnClick="@(() => OpenOpenCodeRepositoryConfigAsync(repository))" />
                                }
                                else if (AgentTools.Normalize(repository.AgentTool) == AgentTools.Codex && !string.IsNullOrWhiteSpace(repository.Path))
                                {
                                    <MudIconButton Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.SettingsSuggest"
                                                   aria-label="@L.T("Codex project config & skills")"
                                                   OnClick="@(() => OpenCodexRepositoryConfigAsync(repository))" />
                                }
                            </div>
                            @if (AgentTools.Normalize(repository.AgentTool) == AgentTools.OpenCode)
                            {
                                <fieldset class="repository-sandbox-toggle">
                                    <legend>Sandbox</legend>
                                    <div class="repository-sandbox-controls">
                                    <MudSwitch T="bool" @bind-Value="repository.OpenCodeSandboxEnabled" Color="Color.Warning"
                                               Label="@L.T("Enabled")" />
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Security"
                                               OnClick="@(() => OpenSandboxPermissionsAsync(repository))">@L.T("Permissions")</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Tune"
                                               OnClick="@(() => OpenSandboxSettingsAsync(repository))">@L.T("Settings")</MudButton>
                                    </div>
                                </fieldset>
                            }
                            <div class="repository-order-controls">
                                <MudTooltip Text="@L.T("Move up")">
                                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.KeyboardArrowUp" aria-label="@L.T("Move up")"
                                                   Disabled="@(Settings.Repositories.IndexOf(repository) == 0)"
                                                   OnClick="@(() => MoveRepository(repository, -1))" />
                                </MudTooltip>
                                <MudTooltip Text="@L.T("Move down")">
                                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.KeyboardArrowDown" aria-label="@L.T("Move down")"
                                                   Disabled="@(Settings.Repositories.IndexOf(repository) == Settings.Repositories.Count - 1)"
                                                   OnClick="@(() => MoveRepository(repository, 1))" />
                                </MudTooltip>
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" aria-label="@L.T("Remove repository")"
                                               OnClick="@(() => Settings.Repositories.Remove(repository))" />
                            </div>
                        </MudPaper>
                    }
                </MudStack>
            </MudTabPanel>
            <MudTabPanel Text="@L.T("Agent management")" Icon="@Icons.Material.Filled.Terminal">
                <MudStack Spacing="3">
                    <MudText Typo="Typo.h6">@L.T("Agent management")</MudText>
                     <MudSelect T="string" Value="_selectedAgent" ValueChanged="LoadAgentConfigAsync" Label="@L.T("Agent tool")" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(_isLoadingAgentConfig || _isSavingAgentConfig)">
                         <MudSelectItem T="string" Value="@AgentTools.OpenCode">OpenCode</MudSelectItem>
                         <MudSelectItem T="string" Value="@AgentTools.ClaudeCode">Claude Code</MudSelectItem>
                          <MudSelectItem T="string" Value="@AgentTools.Codex">Codex</MudSelectItem>
                          <MudSelectItem T="string" Value="@AgentTools.Hermes">Hermes</MudSelectItem>
                     </MudSelect>
                     <MudText Typo="Typo.subtitle1">@_selectedAgent</MudText>
                     @if (GetAgentStartupState(_selectedAgent) is { } agentState)
                     {
                         <MudStack Row="true" Spacing="1" Class="flex-wrap">
                             <MudChip T="string" Size="Size.Small" Color="@(agentState.Installed ? Color.Success : Color.Warning)" Variant="Variant.Outlined">
                                 @L.T(agentState.Installed ? "Agent command detected" : "Agent command not found")
                             </MudChip>
                             <MudChip T="string" Size="Size.Small" Color="@(agentState.HasGlobalConfig ? Color.Info : Color.Default)" Variant="Variant.Outlined">
                                 @L.T(agentState.HasGlobalConfig ? "Global settings found" : "No global settings found")
                             </MudChip>
                         </MudStack>
                     }
                      <MudText Typo="Typo.caption" Color="Color.Secondary">@_agentConfigPath</MudText>
                     @if (!StartupDetection.IsAgentAvailable(_selectedAgent))
                     {
                         <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@L.T("{0} was not detected. Its settings are read-only until it is available.", _selectedAgent)</MudAlert>
                     }
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                           @L.T(_selectedAgent == AgentTools.Hermes
                               ? "Hermes uses YAML config files. MCP switches update mcp_servers.<name>.enabled."
                               : AgentTools.GetDisplayName(_selectedAgent) == "OpenCode"
                              ? "OpenCode MCP switches update the disabled value in this config file."
                              : _selectedAgent == AgentTools.ClaudeCode
                                  ? "Claude Code project config is managed from each repository."
                                  : "Codex uses TOML config files. MCP switches update mcp_servers.<name>.enabled.")
                         @L.T("A timestamped backup is created before each change to an existing config file.")
                    </MudAlert>
                    @if (_agentMcpServers.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle1">@L.T("MCP servers")</MudText>
                        @foreach (var server in _agentMcpServers)
                        {
                            <MudPaper @key="server.Name" Outlined="true" Elevation="0" Class="pa-2">
                                <MudSwitch T="bool" Value="server.Enabled" ValueChanged="@(enabled => ToggleMcpServerAsync(server.Name, enabled))"
                                             Color="Color.Primary" Label="@server.Name" Disabled="@(_isLoadingAgentConfig || _agentConfigLoadFailed || _isSavingAgentConfig || !StartupDetection.IsAgentAvailable(_selectedAgent))" />
                            </MudPaper>
                        }
                    }
                    else if (!_isLoadingAgentConfig)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@L.T("No MCP servers found in this config.")</MudAlert>
                    }
                    <MudExpansionPanels Elevation="0" Outlined="true">
                          <MudExpansionPanel Text="@L.T(_selectedAgent == AgentTools.Hermes ? "Agent configuration (YAML)" : _selectedAgent == AgentTools.Codex ? "Agent configuration (TOML)" : "Agent configuration (JSON)")">
                              <MudStack Spacing="2">
                                 <MudTextField @bind-Value="_agentConfigJson" Label="@L.T(_selectedAgent == AgentTools.Hermes ? "Agent configuration (YAML)" : _selectedAgent == AgentTools.Codex ? "Agent configuration (TOML)" : "Agent configuration (JSON)")"
                                              Lines="18" Sizing="InputSizing.Fixed" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                ReadOnly="@(!StartupDetection.IsAgentAvailable(_selectedAgent))" Disabled="@(_isLoadingAgentConfig || _agentConfigLoadFailed)" />
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Save"
                                             OnClick="SaveAgentConfigAsync" Disabled="@(_isLoadingAgentConfig || _agentConfigLoadFailed || _isSavingAgentConfig || !StartupDetection.IsAgentAvailable(_selectedAgent))" Class="align-self-start">
                                    @L.T("Save agent config")
                                </MudButton>
                            </MudStack>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                </MudStack>
            </MudTabPanel>
            <MudTabPanel Text="@L.T("AI provider")" Icon="@Icons.Material.Filled.AutoAwesome">
                <MudStack Spacing="3">
                    <MudText Typo="Typo.h6">@L.T("AI for commit messages")</MudText>
                    <MudSelect T="string" Label="@L.T("Provider")" Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="Settings.AiProvider" @bind-Value:after="ResetModelList">
                        @foreach (var provider in AiProviders)
                        {
                            <MudSelectItem T="string" Value="@provider">@provider</MudSelectItem>
                        }
                    </MudSelect>
                    @if (Settings.AiProvider is "Custom URL" or "Azure OpenAI")
                    {
                        <MudTextField @bind-Value="Settings.AiCustomUrl" @bind-Value:after="ResetModelList" Label="@L.T("Provider URL")" Margin="Margin.Dense" Variant="Variant.Outlined"
                                      HelperText="@L.T("OpenAI-compatible base URL (e.g. https://host/v1) or full /chat/completions endpoint; Azure: deployment URL including api-version.")" />
                    }
                    <MudSelect T="string" Label="@L.T("Model")" Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="Settings.AiModel"
                               Disabled="@(!_hasTestedConnection || _availableModels.Count == 0)"
                                HelperText="@(_hasTestedConnection ? L.T("Choose a model from the provider.") : L.T("Test the connection first to load models."))">
                        @foreach (var model in _availableModels)
                        {
                            <MudSelectItem T="string" Value="@model">@model</MudSelectItem>
                        }
                    </MudSelect>
                    <MudNumericField T="int" @bind-Value="Settings.AiMaxInputTokens" Label="@L.T("Max input tokens")"
                                      Min="256" Max="200000" Margin="Margin.Dense" Variant="Variant.Outlined" />
                    <MudTextField @bind-Value="Settings.AiCustomInstruction" Label="@L.T("Custom instructions for commit messages")"
                                  HelperText="@L.T("For example: use Conventional Commits and write in English.")"
                                  Lines="3" Margin="Margin.Dense" Variant="Variant.Outlined" />
                    @if (Settings.AiProvider != "Ollama")
                    {
                        <MudTextField @bind-Value="Settings.AiApiKey" @bind-Value:after="ResetModelList" Label="@L.T("Provider API key")" Margin="Margin.Dense" Variant="Variant.Outlined"
                                      InputType="InputType.Password" HelperText="@L.T("Stored securely on this device.")" />
                    }
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.WifiTethering"
                               OnClick="TestAiConnectionAsync" Disabled="@_isTestingAi" Class="align-self-start">
                         @(_isTestingAi ? L.T("Loading connection and models...") : L.T("Test connection & load models"))
                    </MudButton>
                </MudStack>
            </MudTabPanel>
            <MudTabPanel Text="@L.T("Other")" Icon="@Icons.Material.Filled.Tune">
                <MudStack Spacing="3">
                    <MudText Typo="Typo.h6">@L.T("Other settings")</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L.T("Settings are stored locally. API keys are stored securely.")</MudText>
                    <MudSelect T="string" Label="@L.T("Language")" Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="Settings.Language">
                        <MudSelectItem T="string" Value="@("en")">@L.T("English")</MudSelectItem>
                        <MudSelectItem T="string" Value="@("nl")">@L.T("Dutch")</MudSelectItem>
                        <MudSelectItem T="string" Value="@("de")">@L.T("German")</MudSelectItem>
                        <MudSelectItem T="string" Value="@("fr")">@L.T("French")</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="string" Label="@L.T("Theme")" Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="Settings.Theme">
                        @foreach (var theme in LauncherThemes.All)
                        {
                            <MudSelectItem T="string" Value="@theme.Id">@theme.Name (@L.T(theme.IsDark ? "Dark" : "Light"))</MudSelectItem>
                        }
                    </MudSelect>
                    <MudNumericField T="int" @bind-Value="Settings.ToastDurationSeconds" Label="@L.T("Toast duration (seconds)")"
                                     Min="1" Max="10" Margin="Margin.Dense" Variant="Variant.Outlined" />
                    <MudDivider Class="my-2" />
                    <MudSelect T="string" Label="@L.T("Completion sound")" Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="Settings.CompletionSound" @bind-Value:after="PreviewSoundAsync" Disabled="@(!Settings.CompletionSoundEnabled)">
                        @foreach (var sound in CompletionSounds.All)
                        {
                            <MudSelectItem T="string" Value="@sound">@L.T($"Sound: {sound}")</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSwitch @bind-Value="Settings.CompletionSoundEnabled" Color="Color.Primary" Label="@L.T("Play a sound when a session finishes")" />
                </MudStack>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton Size="Size.Small" OnClick="Cancel">@L.T("Cancel")</MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                   Disabled="@_isSaving" OnClick="SaveAsync">@L.T("Save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    protected override void OnInitialized() => L.LanguageChanged += HandleLanguageChanged;

    private void HandleLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task PreviewSoundAsync()
    {
        try { await JS.InvokeVoidAsync("codeBadgerSounds.play", CompletionSounds.Normalize(Settings.CompletionSound)); }
        catch (JSException) { }
    }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public LauncherSettings Settings { get; set; } = new();

    private bool _isTestingAi;
    private bool _isSaving;
    private bool _hasTestedConnection;
    private IReadOnlyList<string> _availableModels = [];
    private static readonly string[] AiProviders = ["OpenAI", "Azure OpenAI", "Anthropic", "Google Gemini", "Ollama", "Custom URL"];
    private string _selectedAgent = AgentTools.OpenCode;
    private string _agentConfigJson = "{}";
    private string _agentConfigPath = string.Empty;
    private IReadOnlyList<AgentMcpServer> _agentMcpServers = [];
    private bool _isLoadingAgentConfig;
    private bool _isSavingAgentConfig;
    private bool _agentConfigLoadFailed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await LoadAgentConfigAsync(_selectedAgent);
    }

    private async Task LoadAgentConfigAsync(string agent)
    {
        _selectedAgent = AgentTools.Normalize(agent);
        _isLoadingAgentConfig = true;
        _agentConfigLoadFailed = false;
        _agentConfigJson = "{}";
        _agentMcpServers = [];
        try
        {
            _agentConfigPath = AgentConfigService.GetConfigPath(_selectedAgent);
            _agentConfigJson = await AgentConfigService.LoadAsync(_selectedAgent);
            _agentMcpServers = await AgentConfigService.GetMcpServersAsync(_selectedAgent, _agentConfigJson, Settings.Repositories);
        }
        catch (Exception exception)
        {
            _agentConfigLoadFailed = true;
            _agentMcpServers = [];
            Snackbar.Add(L.T("Could not load agent config: {0}", exception.Message), Severity.Error);
        }
        finally
        {
            _isLoadingAgentConfig = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleMcpServerAsync(string serverName, bool enabled)
    {
        if (_agentConfigLoadFailed || !StartupDetection.IsAgentAvailable(_selectedAgent))
            return;

        _isSavingAgentConfig = true;
        try
        {
            _agentConfigJson = await AgentConfigService.SetMcpServerEnabledAsync(
                _selectedAgent, _agentConfigJson, serverName, enabled, Settings.Repositories);
            _agentMcpServers = await AgentConfigService.GetMcpServersAsync(_selectedAgent, _agentConfigJson, Settings.Repositories);
            Snackbar.Add(L.T("MCP server updated. Backup created when an existing config was changed."), Severity.Success);
        }
        catch (Exception exception)
        {
            Snackbar.Add(L.T("Could not update MCP server: {0}", exception.Message), Severity.Error);
            await LoadAgentConfigAsync(_selectedAgent);
        }
        finally
        {
            _isSavingAgentConfig = false;
        }
    }

    private async Task SaveAgentConfigAsync()
    {
        if (_agentConfigLoadFailed || !StartupDetection.IsAgentAvailable(_selectedAgent))
            return;

        _isSavingAgentConfig = true;
        try
        {
            await AgentConfigService.SaveAsync(_selectedAgent, _agentConfigJson);
            _agentMcpServers = await AgentConfigService.GetMcpServersAsync(_selectedAgent, _agentConfigJson, Settings.Repositories);
            Snackbar.Add(L.T("Agent config saved. Backup created when an existing config was changed."), Severity.Success);
        }
        catch (Exception exception)
        {
            Snackbar.Add(L.T("Could not save agent config: {0}", exception.Message), Severity.Error);
        }
        finally
        {
            _isSavingAgentConfig = false;
        }
    }

    private void AddRepository() => Settings.Repositories.Add(new RepositoryEntry { Name = L.T("New repository") });

    private void MoveRepository(RepositoryEntry repository, int offset)
    {
        var currentIndex = Settings.Repositories.IndexOf(repository);
        var targetIndex = currentIndex + offset;
        if (currentIndex < 0 || targetIndex < 0 || targetIndex >= Settings.Repositories.Count)
            return;

        Settings.Repositories.RemoveAt(currentIndex);
        Settings.Repositories.Insert(targetIndex, repository);
    }

    private bool IsRepositoryConfigReadOnly(RepositoryEntry repository) =>
        !StartupDetection.IsAgentAvailable(repository.AgentTool);

    private AgentStartupState? GetAgentStartupState(string agent) => StartupDetection.GetAgentState(agent);

    private async Task OpenClaudeRepositoryConfigAsync(RepositoryEntry repository)
    {
        var parameters = new DialogParameters<ClaudeRepositoryConfigDialog>
        {
            { dialog => dialog.RepositoryPath, repository.Path },
            { dialog => dialog.RepositoryName, repository.Name },
            { dialog => dialog.ReadOnly, IsRepositoryConfigReadOnly(repository) }
        };
        var options = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Large, CloseButton = true, CloseOnEscapeKey = true };
        await DialogService.ShowAsync<ClaudeRepositoryConfigDialog>(L.T("Claude Code project config"), parameters, options);
    }

    private async Task OpenOpenCodeRepositoryConfigAsync(RepositoryEntry repository)
    {
        var parameters = new DialogParameters<OpenCodeRepositoryConfigDialog>
        {
            { dialog => dialog.RepositoryPath, repository.Path },
            { dialog => dialog.RepositoryName, repository.Name },
            { dialog => dialog.ReadOnly, IsRepositoryConfigReadOnly(repository) }
        };
        var options = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Large, CloseButton = true, CloseOnEscapeKey = true };
        await DialogService.ShowAsync<OpenCodeRepositoryConfigDialog>(L.T("OpenCode project config & skills"), parameters, options);
    }

    private async Task OpenSandboxPermissionsAsync(RepositoryEntry repository)
    {
        var parameters = new DialogParameters<SandboxPermissionsDialog>
        {
            { dialog => dialog.RepositoryName, string.IsNullOrWhiteSpace(repository.Name) ? repository.Path : repository.Name },
            { dialog => dialog.RepositoryId, repository.Id },
            { dialog => dialog.RepositoryPath, repository.Path }
        };
        var options = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, CloseButton = true, CloseOnEscapeKey = true };
        await DialogService.ShowAsync<SandboxPermissionsDialog>(L.T("Sandbox permissions"), parameters, options);
    }

    private async Task OpenSandboxSettingsAsync(RepositoryEntry repository)
    {
        await DialogService.ShowAsync<SandboxSettingsDialog>(L.T("Sandbox settings"),
            new DialogParameters<SandboxSettingsDialog> { { dialog => dialog.Repository, repository } },
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium, CloseButton = true });
    }

    private async Task OpenCodexRepositoryConfigAsync(RepositoryEntry repository)
    {
        var parameters = new DialogParameters<CodexRepositoryConfigDialog>
        {
            { dialog => dialog.RepositoryPath, repository.Path },
            { dialog => dialog.RepositoryName, repository.Name },
            { dialog => dialog.ReadOnly, IsRepositoryConfigReadOnly(repository) }
        };
        var options = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Large, CloseButton = true, NoHeader = true, CloseOnEscapeKey = true };
        await DialogService.ShowAsync<CodexRepositoryConfigDialog>(L.T("Codex project config & skills"), parameters, options);
    }

    private async Task BrowseRepositoryAsync(RepositoryEntry repository)
    {
        var path = await FolderPicker.PickFolderAsync();
        if (string.IsNullOrWhiteSpace(path))
            return;
        repository.Path = path;
        if (string.IsNullOrWhiteSpace(repository.Name) || IsDefaultRepositoryName(repository.Name))
            repository.Name = Path.GetFileName(Path.TrimEndingDirectorySeparator(path));
    }

    private static bool IsDefaultRepositoryName(string name) =>
        name is "New repository" or "Nieuwe repository" or "Neues Repository" or "Nouveau dépôt";

    private async Task TestAiConnectionAsync()
    {
        _isTestingAi = true;
        _hasTestedConnection = false;
        _availableModels = [];
        try
        {
            var result = await AiCommitMessageService.GetAvailableModelsAsync(Settings);
            if (result.Success)
            {
                _availableModels = result.Models;
                _hasTestedConnection = true;
                if (!_availableModels.Contains(Settings.AiModel, StringComparer.OrdinalIgnoreCase))
                    Settings.AiModel = _availableModels[0];
            }
            Snackbar.Add(result.Success ? L.T("Connection successful. {0} models found.", _availableModels.Count) : result.Error,
                result.Success ? Severity.Success : Severity.Error);
        }
        finally
        {
            _isTestingAi = false;
        }
    }

    private void ResetModelList()
    {
        _hasTestedConnection = false;
        _availableModels = [];
    }

    private async Task SaveAsync()
    {
        _isSaving = true;
        try
        {
            await SettingsService.SaveAsync(Settings);
            Snackbar.Configuration.VisibleStateDuration = Settings.ToastDurationSeconds * 1000;
            Snackbar.Add(L.T("Settings saved."), Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    public void Dispose() => L.LanguageChanged -= HandleLanguageChanged;
}
