    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public RepositoryEntry Repository { get; set; } = null!;
    [Parameter, EditorRequired] public string RepositoryTitle { get; set; } = string.Empty;
    [Parameter] public bool RepositoryExists { get; set; }
    [Parameter] public bool AgentAvailable { get; set; }
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string GitBranchLabel { get; set; } = string.Empty;
    [Parameter] public GitRepositorySnapshot? GitSnapshot { get; set; }
    [Parameter] public string? OpenCodeSessionId { get; set; }
    [Parameter, EditorRequired] public EventCallback OnOpenGitOverview { get; set; }

    private string TerminalKey =>
        $"{Repository.Id}:{Repository.Path}:{AgentTools.Normalize(Repository.AgentTool)}:{Repository.OpenCodeSandboxEnabled}:{Repository.OpenCodeSandboxModel}:{Repository.OpenCodeSandboxFiles}:{OpenCodeSessionId}";

    private IReadOnlyDictionary<string, string> OpenCodeSessions
    {
        get
        {
            var sessions = new Dictionary<string, string>(StringComparer.Ordinal);
            foreach (var terminalSession in _terminalState.Sessions)
            {
                var state = terminalSession;
                foreach (var (role, sessionId) in state.AgentSessionIds)
                {
                    if (!IsOpenCodeSessionKey(role) || !IsOpenCodeSessionId(sessionId))
                        continue;
                    var roleName = role == "SingleAgent" ? state.Mode : RoleDisplayName(role);
                    var title = string.IsNullOrWhiteSpace(state.Title) ? L.T("Terminal session") : state.Title;
                    sessions.TryAdd(sessionId, $"{title} · {roleName}");
                }
            }
            return sessions;
        }
    }

    private static bool IsOpenCodeSessionKey(string key) => key == "SingleAgent" ||
        (!key.StartsWith("Model:", StringComparison.Ordinal) && !key.StartsWith("ModelSelector:", StringComparison.Ordinal));

    private static bool IsOpenCodeSessionId(string sessionId) =>
        sessionId.StartsWith("ses_", StringComparison.Ordinal) &&
        sessionId.All(character => char.IsAsciiLetterOrDigit(character) || character == '_');

    private string _agentCommand = "opencode";
    private ElementReference _terminalStack;
    private IJSObjectReference? _splitterModule;
    private IJSObjectReference? _conversationScrollModule;
    private IJSObjectReference? _composerModule;
    private DotNetObjectReference<RepositoryWorkspace>? _selfReference;
    private readonly List<CodeBadgerTerminalSession> _terminalSessions = [];
    private readonly Dictionary<string, HashSet<CodeBadgerAgentInteraction>> _pendingTerminalInteractions = new(StringComparer.Ordinal);
    private CodeBadgerTerminalState _terminalState = new();
    private LauncherSettings _settings = new();
    private IReadOnlyList<OpenCodeActivityService.AvailableModel> _availableOpenCodeModels = [];
    private Guid _selectedTerminalSessionId;
    private Guid? _terminalContextMenuSessionId;
    private double _terminalContextMenuX;
    private double _terminalContextMenuY;
    private double _aiPanelHeight = 38;
    private AiPanelMode _aiPanelMode = AiPanelMode.Collapsed;
    private bool _showAgentContext = true;
    private bool _splitterAttached;
    private bool _conversationScrollAttached;
    private bool _composerAttached;
    private bool _wasCodeBadgerTerminalEnabled;
    private Timer? _agentStatusRotationTimer;
    private int _agentStatusRotationIndex;
    private bool _isDisposed;
    private string? _agentModelReference;
    private string _agentModelLookupKey = string.Empty;
    private string _contextModelLookupKey = string.Empty;
    private readonly Dictionary<string, AgentContextSnapshot> _agentContextSnapshots = new(StringComparer.Ordinal);

    private string AiPaneModeClass => _aiPanelMode switch
    {
        AiPanelMode.Collapsed => "ai-pane-collapsed",
        AiPanelMode.Expanded => "ai-pane-expanded",
        _ => string.Empty
    };
    private string SessionStatusLabel(CodeBadgerTerminalSession session)
    {
        var mode = L.T(session.Mode == TerminalMode.Plan ? "Plan" : "Build");
        var agent = AgentTools.GetDisplayName(Repository.AgentTool);
        if (!string.IsNullOrWhiteSpace(_agentModelReference))
            agent += "-" + FormatModelName(_agentModelReference.Split('/').Last());
        return $"{mode} · {agent}";
    }

    private string AgentLogoPath => AgentTools.Normalize(Repository.AgentTool) switch
    {
        AgentTools.ClaudeCode => "claude-code.svg",
        AgentTools.OpenCode => "opencode.svg",
        _ => "codebadger.svg"
    };

    private static string FormatModelName(string model)
    {
        var words = model.Split(['-', '_', '.'], StringSplitOptions.RemoveEmptyEntries);
        return string.Join(' ', words.Select(word => string.Equals(word, "gpt", StringComparison.OrdinalIgnoreCase)
            ? "GPT"
            : char.ToUpperInvariant(word[0]) + word[1..]));
    }

    private static string FormatModelReference(string modelReference) =>
        $"{modelReference.Split('/').FirstOrDefault()} · {FormatModelName(modelReference.Split('/').Last())}";

    private CodeBadgerAgentPreferences GetAgentPreferences(string? agentTool)
    {
        _settings.CodeBadgerAgentPreferences ??= CodeBadgerRoles.CreateAgentDefaults();
        CodeBadgerRoles.NormalizeAgentPreferences(_settings.CodeBadgerAgentPreferences);
        var normalized = AgentTools.Normalize(agentTool);
        return _settings.CodeBadgerAgentPreferences.First(item => item.AgentTool == normalized);
    }

    private IEnumerable<string> GetTrackedAgentRoles(CodeBadgerTerminalSession session)
    {
        if (CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode) == CodeBadgerOrchestrationModes.SingleAgent)
        {
            if (session.State.AgentSessionIds.ContainsKey("SingleAgent"))
                return new[] { session.Mode == TerminalMode.Plan ? CodeBadgerRoles.Planner : CodeBadgerRoles.Worker };
            return Array.Empty<string>();
        }
        return session.State.AgentSessionIds.Keys
        .Where(role => !role.StartsWith("ModelSelector:", StringComparison.Ordinal) &&
            !role.StartsWith("Model:", StringComparison.Ordinal) && role != "SingleAgent")
        .OrderBy(role => role, StringComparer.Ordinal)
        .Concat(session.IsBusy && !string.IsNullOrWhiteSpace(session.State.ActiveAgentRole)
            ? new[] { session.State.ActiveAgentRole } : Array.Empty<string>())
        .Distinct(StringComparer.Ordinal);
    }

    private IEnumerable<string> GetSessionAgentRoles(CodeBadgerTerminalSession session) =>
        CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode) switch
        {
            CodeBadgerOrchestrationModes.Full => CodeBadgerRoles.All,
            CodeBadgerOrchestrationModes.PlanBuild => [CodeBadgerRoles.Planner, CodeBadgerRoles.Worker],
            _ => [session.Mode == TerminalMode.Plan ? CodeBadgerRoles.Planner : CodeBadgerRoles.Worker]
        };

    private List<string> GetActiveSessionAgentRoles(CodeBadgerTerminalSession session) =>
        GetSessionAgentRoles(session)
            .Where(role => GetAgentRoleProgress(session, role) is AgentRoleProgress.Working or AgentRoleProgress.Waiting)
            .ToList();

    private void SynchronizeAgentStatusRotationTimer()
    {
        var shouldRotate = Repository.CodeBadgerTerminalEnabled &&
            _terminalSessions.Any(session => GetActiveSessionAgentRoles(session).Count > 1);
        if (shouldRotate && _agentStatusRotationTimer is null)
        {
            _agentStatusRotationTimer = new Timer(async _ =>
            {
                try
                {
                    await InvokeAsync(() =>
                    {
                        if (_isDisposed)
                            return;
                        _agentStatusRotationIndex++;
                        StateHasChanged();
                    });
                }
                catch (ObjectDisposedException) { }
                catch (InvalidOperationException) { }
            }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
        }
        else if (!shouldRotate)
        {
            _agentStatusRotationTimer?.Dispose();
            _agentStatusRotationTimer = null;
            _agentStatusRotationIndex = 0;
        }
    }

    private AgentRoleProgress GetAgentRoleProgress(CodeBadgerTerminalSession session, string role)
    {
        var roleKey = GetRoleSessionKey(session, role);
        if (session.State.AgentSessionIds.TryGetValue(roleKey, out var agentSessionId) &&
            _pendingTerminalInteractions.TryGetValue(agentSessionId, out var pending) && pending.Count > 0)
            return AgentRoleProgress.Waiting;
        if (IsAgentRoleBusy(session, role))
            return AgentRoleProgress.Working;
        if (session.RoleProgress.TryGetValue(role, out var progress))
            return progress;

        var lastUserMessageIndex = session.Messages.FindLastIndex(message => message.Role == "user");
        var latestMessage = session.Messages.Skip(lastUserMessageIndex + 1)
            .LastOrDefault(message => message.Role == "assistant" && message.AgentRole == role);
        if (latestMessage is null || latestMessage.Text.StartsWith(L.T("Sending to {0}...", RoleDisplayName(role)), StringComparison.Ordinal))
            return AgentRoleProgress.NotStarted;
        if (latestMessage.Text == L.T("The agent request was stopped."))
            return AgentRoleProgress.Stopped;
        if (latestMessage.Text.StartsWith(L.T("Agent request failed: {0}", string.Empty), StringComparison.Ordinal))
            return AgentRoleProgress.Failed;
        return AgentRoleProgress.Completed;
    }

    private static string RoleProgressCssClass(AgentRoleProgress progress) => progress switch
    {
        AgentRoleProgress.Working => "working",
        AgentRoleProgress.Waiting => "waiting",
        AgentRoleProgress.Completed => "completed",
        AgentRoleProgress.Stopped => "stopped",
        AgentRoleProgress.Failed => "failed",
        _ => "not-started"
    };

    private static string RoleProgressIcon(AgentRoleProgress progress) => progress switch
    {
        AgentRoleProgress.Working => Icons.Material.Filled.Autorenew,
        AgentRoleProgress.Waiting => Icons.Material.Filled.QuestionAnswer,
        AgentRoleProgress.Completed => Icons.Material.Filled.CheckCircle,
        AgentRoleProgress.Stopped => Icons.Material.Filled.PauseCircleFilled,
        AgentRoleProgress.Failed => Icons.Material.Filled.Error,
        _ => Icons.Material.Filled.RadioButtonUnchecked
    };

    private string RoleProgressLabel(AgentRoleProgress progress) => L.T(progress switch
    {
        AgentRoleProgress.Working => "Working",
        AgentRoleProgress.Waiting => "Waiting for you",
        AgentRoleProgress.Completed => "Answer ready",
        AgentRoleProgress.Stopped => "Stopped",
        AgentRoleProgress.Failed => "Failed",
        _ => "Not started"
    });

    private static string ShortRoleDisplayName(string role) => role switch
    {
        CodeBadgerRoles.Orchestrator => "Orch",
        CodeBadgerRoles.Router => "Route",
        CodeBadgerRoles.Planner => "Plan",
        CodeBadgerRoles.Worker => "Work",
        CodeBadgerRoles.Rag => "RAG",
        CodeBadgerRoles.Critic => "Critic",
        _ => role
    };

    private string GetRoleSessionKey(CodeBadgerTerminalSession session, string role) =>
        CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode) == CodeBadgerOrchestrationModes.SingleAgent
            ? "SingleAgent" : role;

    private ICodeBadgerAgentInteractionProvider? GetInteractionProvider(string agentTool) =>
        AgentInteractionProviders.FirstOrDefault(provider => provider.Supports(agentTool));

    private async Task HandleInteractionReplyAsync(CodeBadgerTerminalSession session,
        CodeBadgerAgentInteraction interaction, CodeBadgerAgentInteractionAnswer answer)
    {
        var sessionId = session.ActiveAgentSessionId;
        var agentTool = session.ActiveAgentTool;
        if (string.IsNullOrWhiteSpace(sessionId) || string.IsNullOrWhiteSpace(agentTool) ||
            GetInteractionProvider(agentTool) is not { } provider)
        {
            Snackbar.Add(L.T("This agent interaction cannot be answered by the current terminal provider."), Severity.Warning);
            return;
        }
        try
        {
            await provider.ReplyAsync(sessionId, Repository.Path, interaction, answer, CancellationToken.None);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception exception)
        {
            Snackbar.Add(L.T("Could not submit the answer: {0}", exception.Message), Severity.Error);
        }
    }

    private static string InteractionAnswerKey(CodeBadgerAgentInteraction interaction,
        CodeBadgerAgentInteractionField field) => interaction.Id + ":" + field.Key;

    private static string CustomInteractionAnswerKey(CodeBadgerAgentInteraction interaction,
        CodeBadgerAgentInteractionField field) => InteractionAnswerKey(interaction, field) + ":custom";

    private static bool IsInteractionOptionSelected(CodeBadgerTerminalSession session,
        CodeBadgerAgentInteraction interaction, CodeBadgerAgentInteractionField field, string option) =>
        session.InteractionAnswers.TryGetValue(InteractionAnswerKey(interaction, field), out var current) &&
        (current ?? string.Empty).Split('|', StringSplitOptions.RemoveEmptyEntries).Contains(option, StringComparer.Ordinal);

    private static bool HasSelectedInteractionOption(CodeBadgerTerminalSession session,
        CodeBadgerAgentInteraction interaction, CodeBadgerAgentInteractionField field) =>
        session.InteractionAnswers.TryGetValue(InteractionAnswerKey(interaction, field), out var current) &&
        !string.IsNullOrWhiteSpace(current);

    private static bool HasCustomInteractionAnswer(CodeBadgerTerminalSession session,
        CodeBadgerAgentInteraction interaction, CodeBadgerAgentInteractionField field) =>
        session.InteractionAnswers.TryGetValue(CustomInteractionAnswerKey(interaction, field), out var current) &&
        !string.IsNullOrWhiteSpace(current);

    private static bool HasInteractionAnswer(CodeBadgerTerminalSession session,
        CodeBadgerAgentInteraction interaction, CodeBadgerAgentInteractionField field) =>
        HasSelectedInteractionOption(session, interaction, field) || HasCustomInteractionAnswer(session, interaction, field);

    private static bool IsInteractionOptionDisabled(CodeBadgerTerminalSession session,
        CodeBadgerAgentInteraction interaction, CodeBadgerAgentInteractionField field, string option) =>
        HasCustomInteractionAnswer(session, interaction, field) ||
        HasSelectedInteractionOption(session, interaction, field) && !IsInteractionOptionSelected(session, interaction, field, option);

    private static void ResetInteractionAnswer(CodeBadgerTerminalSession session,
        CodeBadgerAgentInteraction interaction, CodeBadgerAgentInteractionField field)
    {
        session.InteractionAnswers[InteractionAnswerKey(interaction, field)] = null;
        session.InteractionAnswers[CustomInteractionAnswerKey(interaction, field)] = null;
    }

    private static void ToggleInteractionOption(CodeBadgerTerminalSession session,
        CodeBadgerAgentInteraction interaction, CodeBadgerAgentInteractionField field, string option, bool selected)
    {
        var key = InteractionAnswerKey(interaction, field);
        if (selected)
            session.InteractionAnswers[key] = option;
        else if (IsInteractionOptionSelected(session, interaction, field, option))
            session.InteractionAnswers[key] = null;
    }

    private async Task SubmitInteractionAnswerAsync(CodeBadgerTerminalSession session,
        CodeBadgerAgentInteraction interaction)
    {
        try
        {
            var values = new Dictionary<string, object?>(StringComparer.Ordinal);
            foreach (var field in interaction.Fields)
            {
                string? value;
                if (field.Type == "multiselect")
                {
                    session.InteractionAnswers.TryGetValue(InteractionAnswerKey(interaction, field), out var selectedValues);
                    var selected = (selectedValues ?? string.Empty).Split('|', StringSplitOptions.RemoveEmptyEntries).ToList();
                    session.InteractionAnswers.TryGetValue(CustomInteractionAnswerKey(interaction, field), out var customValue);
                    if (!string.IsNullOrWhiteSpace(customValue))
                        selected = [customValue];
                    value = selected.Count == 0 ? null : string.Join('|', selected);
                }
                else
                {
                    session.InteractionAnswers.TryGetValue(InteractionAnswerKey(interaction, field), out value);
                    session.InteractionAnswers.TryGetValue(CustomInteractionAnswerKey(interaction, field), out var customValue);
                    if (!string.IsNullOrWhiteSpace(customValue))
                        value = customValue;
                }
                if (field.Required && string.IsNullOrWhiteSpace(value))
                {
                    Snackbar.Add(L.T("Complete the required field: {0}", string.IsNullOrWhiteSpace(field.Title) ? field.Key : field.Title), Severity.Warning);
                    return;
                }
                if (string.IsNullOrWhiteSpace(value))
                    continue;
                object parsed = field.Type switch
                {
                    "boolean" when bool.TryParse(value, out var boolean) => boolean,
                    "integer" when long.TryParse(value, out var integer) => integer,
                    "number" when double.TryParse(value, System.Globalization.NumberStyles.Float,
                        System.Globalization.CultureInfo.InvariantCulture, out var number) => number,
                    "boolean" => throw new InvalidOperationException(L.T("Enter a valid true/false value for {0}.", field.Key)),
                    "integer" or "number" => throw new InvalidOperationException(L.T("Enter a valid number for {0}.", field.Key)),
                    "multiselect" => value.Split('|', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries),
                    _ => value
                };
                if (field.Type is not "multiselect" && field.Options.Count > 0 &&
                    !field.Options.Any(option => option.Value == value) && !(field.AllowsCustomValue &&
                        !string.IsNullOrWhiteSpace(session.InteractionAnswers.GetValueOrDefault(CustomInteractionAnswerKey(interaction, field)))))
                    throw new InvalidOperationException(L.T("Please select one of the available choices."));
                values[field.Key] = parsed;
            }
            await HandleInteractionReplyAsync(session, interaction, new CodeBadgerAgentInteractionAnswer(Values: values));
        }
        catch (Exception exception)
        {
            Snackbar.Add(L.T("Could not submit the answer: {0}", exception.Message), Severity.Error);
        }
    }

    private bool IsAgentRoleBusy(CodeBadgerTerminalSession session, string role)
    {
        var activeRole = session.State.ActiveAgentRole;
        if (!session.IsBusy || string.IsNullOrWhiteSpace(activeRole))
            return false;
        return CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode) == CodeBadgerOrchestrationModes.SingleAgent
            ? true
            : string.Equals(activeRole, role, StringComparison.Ordinal);
    }

    private AgentContextSnapshot? GetContextUsage(CodeBadgerTerminalSession session, string sessionKey, string sessionId)
    {
        var model = session.State.AgentContextModels.TryGetValue(sessionKey, out var modelReference)
            ? modelReference
            : session.State.AgentSessionIds.TryGetValue("Model:" + sessionKey, out var storedModel) ? storedModel : string.Empty;
        if (session.State.AgentContextTokens.TryGetValue(sessionKey, out var tokens) &&
            !string.IsNullOrWhiteSpace(model) && GetModelContextLimit(model) is var limit && limit > 0)
            return new AgentContextSnapshot(tokens, limit, model);
        if (_agentContextSnapshots.TryGetValue(sessionId, out var snapshot))
            return snapshot;
        return null;
    }

    private long GetModelContextLimit(string modelReference) =>
        _availableOpenCodeModels.FirstOrDefault(model =>
            string.Equals(model.Reference, modelReference, StringComparison.OrdinalIgnoreCase))?.Context ?? 0;

    private async Task RefreshAgentContextAsync(CodeBadgerTerminalSession session, string role, string sessionKey,
        string sessionId, CancellationToken cancellationToken)
    {
        try
        {
            var usage = await OpenCodeActivity.GetLatestContextUsageAsync(sessionId, Repository.Path, cancellationToken);
            if (usage is null)
                return;
            var model = string.IsNullOrWhiteSpace(usage.ModelReference) && session.State.AgentContextModels.TryGetValue(sessionKey, out var previousModel)
                ? previousModel : usage.ModelReference;
            if (string.IsNullOrWhiteSpace(model))
                return;
            session.State.AgentContextTokens[sessionKey] = usage.Tokens;
            session.State.AgentContextModels[sessionKey] = model;
            var limit = GetModelContextLimit(model);
            if (limit > 0)
                _agentContextSnapshots[sessionId] = new AgentContextSnapshot(usage.Tokens, limit, model);
            await PersistTerminalStateAsync();
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (Exception exception)
        {
            Logger.LogDebug(exception, "Could not refresh context usage for CodeBadger role {Role}.", role);
        }
    }

    private async Task RotateAgentSessionAsync(CodeBadgerTerminalSession session, string role)
    {
        if (IsAgentRoleBusy(session, role) || session.IsRotatingAgentRole)
            return;
        var agentPreferences = GetAgentPreferences(Repository.AgentTool);
        var preference = agentPreferences.RolePreferences.FirstOrDefault(item => item.Role == role)
            ?? new CodeBadgerRolePreference { Role = role, AgentType = CodeBadgerRoles.DefaultAgentType(role) };
        if (!session.State.AgentSessionIds.TryGetValue(GetRoleSessionKey(session, role), out var oldSessionId))
            return;

        session.IsRotatingAgentRole = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            using var cancellation = new CancellationTokenSource(TimeSpan.FromMinutes(2));
            var summary = await OpenCodeActivity.GenerateSessionHandoffSummaryAsync(oldSessionId, Repository.Path, cancellation.Token);
            var agent = await ResolvePreferenceAgentAsync(preference, role, cancellation.Token);
            var modelKey = CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode) == CodeBadgerOrchestrationModes.SingleAgent
                ? "Model:SingleAgent" : "Model:" + role;
            var model = session.State.AgentSessionIds.TryGetValue(modelKey, out var storedModel) ? storedModel : null;
            var roleSessionKey = GetRoleSessionKey(session, role);
            var title = $"{session.Title} · {RoleDisplayName(role)} · {L.T("Session {0}", session.State.AgentSessionGenerations.GetValueOrDefault(roleSessionKey) + 2)}";
            var created = await OpenCodeActivity.CreateOrchestrationSessionAsync(Repository.Path, agent, title,
                parentSessionId: null, modelReference: model, cancellationToken: cancellation.Token);
            await OpenCodeActivity.AddSessionHandoffSummaryAsync(created.Id, Repository.Path, summary, cancellation.Token);
            session.State.AgentSessionIds[roleSessionKey] = created.Id;
            session.State.AgentSessionGenerations[roleSessionKey] = session.State.AgentSessionGenerations.GetValueOrDefault(roleSessionKey) + 1;
            if (CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode) == CodeBadgerOrchestrationModes.SingleAgent)
            {
                var handoffRole = session.Mode == TerminalMode.Plan ? CodeBadgerRoles.Planner : CodeBadgerRoles.Worker;
                session.State.AgentSessionGenerations[handoffRole] = session.State.AgentSessionGenerations.GetValueOrDefault(handoffRole) + 1;
            }
            session.State.AgentContextTokens.Remove(GetRoleSessionKey(session, role));
            session.State.AgentContextModels.Remove(GetRoleSessionKey(session, role));
            _agentContextSnapshots.Remove(oldSessionId);
            await PersistTerminalStateAsync();
            Snackbar.Add(L.T("A new agent session is ready with a handoff summary."), Severity.Success);
        }
        catch (Exception exception)
        {
            Snackbar.Add(L.T("Could not start a new agent session: {0}", exception.Message), Severity.Error);
        }
        finally
        {
            session.IsRotatingAgentRole = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private sealed record AgentContextSnapshot(long Used, long Limit, string ModelReference)
    {
