@page "/manual"
@inject LocalizationService L
@inject RepositoryDetachedWindowService DetachedWindows
@implements IDisposable

<PageTitle>@L.T(_selectedManual is null ? "Manuals" : _selectedManual.Title) - CodeBadger</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="manual-page py-4">
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                @if (OperatingSystem.IsMacCatalyst())
                {
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="ReturnToCodeBadger">
                        @L.T("Back to CodeBadger")
                    </MudButton>
                }
                @if (_selectedManual is not null)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Default" Size="Size.Small"
                                   aria-label="@L.T("Back to manuals")" OnClick="ShowManuals" />
                }
            <MudText Typo="Typo.h5">@L.T(_selectedManual is null ? "Manuals" : _selectedManual.Title)</MudText>
            </MudStack>
            @if (_selectedManual is not null)
            {
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.MenuBook" OnClick="ShowManuals">
                    @L.T("All manuals")
                </MudButton>
            }
        </MudStack>

        @if (_selectedManual is null)
        {
            <MudTextField T="string" @bind-Value="_searchText" @bind-Value:after="SearchManuals"
                          Placeholder="@L.T("Search all manuals")" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
                          Clearable="true" Variant="Variant.Outlined" Class="manual-search" />

            @if (_isLoading)
            {
                <MudPaper Class="pa-5" Outlined="true" Elevation="0">
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    <MudText Typo="Typo.body2" Class="mt-3">@L.T("Loading manuals...")</MudText>
                </MudPaper>
            }
            else if (_manuals.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@L.T("No manuals match your search.")</MudAlert>
            }
            else
            {
                <MudGrid Spacing="3">
                    @foreach (var manual in _manuals)
                    {
                        <MudItem xs="12" sm="6" md="4" @key="manual.Id">
                            <MudCard Outlined="true" Class="manual-card" @onclick="@(() => OpenManualAsync(manual))">
                                <MudCardContent>
                                    <MudStack Spacing="1">
                                        <MudIcon Icon="@manual.Icon" Color="Color.Primary" Size="Size.Medium" />
                                        <MudText Typo="Typo.h6">@L.T(manual.Title)</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L.T(manual.Description)</MudText>
                                    </MudStack>
                                </MudCardContent>
                                <MudCardActions>
                                    <MudButton Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward"
                                               OnClick="@(() => OpenManualAsync(manual))">@L.T("Read manual")</MudButton>
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            }
        }
        else if (_isLoading)
        {
            <MudPaper Class="pa-5" Outlined="true" Elevation="0">
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                <MudText Typo="Typo.body2" Class="mt-3">@L.T("Loading manual...")</MudText>
            </MudPaper>
        }
        else if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@L.T(_error, _errorDetail)</MudAlert>
        }
        else
        {
            <MarkdownContent Content="@_content" />
        }
    </MudStack>
</MudContainer>

@code {
    private sealed record ManualDefinition(string Id, string Title, string Description, string Icon);

    private static readonly ManualDefinition[] AllManuals =
    [
        new("repositories", "Repository setup manual", "Set up repositories, choose an agent, activate tabs, and configure repository-specific options.",
            Icons.Material.Filled.Folder),
        new("git", "Git module manual", "Use the Git overview to inspect changes, stage files, create commits, and manage branches safely.",
            Icons.Material.Filled.AccountTree),
        new("tasks", "Ideas and tasks manual", "Capture ideas, manage task status, choose a repository, and start OpenCode work from the task list.",
            Icons.Material.Filled.Checklist),
        new("agents", "Agents and project configuration manual", "Choose an agent and manage global and repository-specific settings, MCP servers, and project skills.",
            Icons.Material.Filled.Terminal),
        new("sessions", "Agent terminals and sessions manual", "Start agent terminals, work in repository tabs, send prompts, resume OpenCode sessions, and respond to questions.",
            Icons.Material.Filled.Forum),
        new("sandbox", "OpenCode sandbox manual", "Select files for isolated OpenCode sessions, understand review mode, permissions, and network approvals.",
            Icons.Material.Filled.Security),
        new("settings", "AI and application settings manual", "Configure AI commit messages, language, appearance, sounds, and application behavior.",
            Icons.Material.Filled.Tune),
        new("security", "Security and privacy manual", "Understand secrets, local settings, sandbox access modes, review backups, and external integrations.",
            Icons.Material.Filled.Lock),
        new("notifications", "Notifications manual", "Set up Slack or Discord, configure the active notification channel, reply to sessions, switch agents, and mute repositories or sessions.",
            Icons.Material.Filled.NotificationsActive)
    ];

    private readonly Dictionary<string, string> _searchIndex = new(StringComparer.Ordinal);
    private IReadOnlyList<ManualDefinition> _manuals = AllManuals;
    private ManualDefinition? _selectedManual;
    private string _searchText = string.Empty;
    private string _content = string.Empty;
    private string _error = string.Empty;
    private string _errorDetail = string.Empty;
    private bool _isLoading;

    protected override void OnInitialized()
    {
        L.LanguageChanged += HandleLanguageChanged;
        _ = LoadSearchIndexAndRefreshAsync();
    }

    private async Task LoadSearchIndexAndRefreshAsync()
    {
        await LoadSearchIndexAsync();
        await InvokeAsync(() =>
        {
            SearchManuals();
            StateHasChanged();
        });
    }

    private void HandleLanguageChanged() => _ = InvokeAsync(async () =>
    {
        await LoadSearchIndexAsync();
        SearchManuals();
        if (_selectedManual is not null)
            await LoadManualAsync(_selectedManual);
        StateHasChanged();
    });

    private async Task LoadSearchIndexAsync()
    {
        var language = LocalizationService.NormalizeLanguage(L.CurrentLanguage);
        foreach (var manual in AllManuals)
        {
            try
            {
                await using var stream = await FileSystem.OpenAppPackageFileAsync($"manual/{manual.Id}-{language}.md");
                using var reader = new StreamReader(stream);
                _searchIndex[manual.Id] = await reader.ReadToEndAsync();
            }
            catch
            {
                _searchIndex[manual.Id] = string.Empty;
            }
        }
    }

    private void SearchManuals()
    {
        var search = _searchText.Trim();
        _manuals = AllManuals
            .Where(manual => string.IsNullOrWhiteSpace(search) ||
                ContainsLocalized(L.T(manual.Title), search) ||
                ContainsLocalized(L.T(manual.Description), search) ||
                (_searchIndex.TryGetValue(manual.Id, out var content) && ContainsLocalized(content, search)))
            .ToArray();
    }

    private static bool ContainsLocalized(string text, string search) =>
        text.Contains(search, StringComparison.CurrentCultureIgnoreCase);

    private async Task OpenManualAsync(ManualDefinition manual)
    {
        _selectedManual = manual;
        await LoadManualAsync(manual);
    }

    private void ShowManuals()
    {
        _selectedManual = null;
        _content = string.Empty;
        _error = string.Empty;
        SearchManuals();
    }

    private void ReturnToCodeBadger() => DetachedWindows.CloseUtilityWindow("/manual");

    private async Task LoadManualAsync(ManualDefinition manual)
    {
        _isLoading = true;
        _error = string.Empty;
        _errorDetail = string.Empty;
        try
        {
            var language = LocalizationService.NormalizeLanguage(L.CurrentLanguage);
            await using var stream = await FileSystem.OpenAppPackageFileAsync($"manual/{manual.Id}-{language}.md");
            using var reader = new StreamReader(stream);
            _content = await reader.ReadToEndAsync();
        }
        catch (Exception exception)
        {
            _error = "Could not load the manual: {0}";
            _errorDetail = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    public void Dispose() => L.LanguageChanged -= HandleLanguageChanged;
}
