@implements IAsyncDisposable
@inject LocalizationService L
@inject WindowsTerminalSessionService TerminalService
@inject RepositoryDetachedWindowService DetachedWindows
@inject IJSRuntime JS

<div class="repository-terminal" @ref="_terminalElement"></div>

@code {
    [Parameter, EditorRequired] public Guid SessionId { get; set; }
    [Parameter, EditorRequired] public string RepositoryPath { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Command { get; set; } = "opencode";
    [Parameter] public bool OpenCodeSandboxEnabled { get; set; }
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string? OpenCodeSessionId { get; set; }
    [Parameter] public bool UsePowerShell { get; set; }
    [Parameter] public bool PreserveSession { get; set; }
    [Parameter] public bool StartWhenVisible { get; set; }

    private ElementReference _terminalElement;
    private DotNetObjectReference<RepositoryTerminal>? _selfReference;
    private IJSObjectReference? _module;
    private bool _disposed;

    protected override void OnInitialized()
    {
        TerminalService.OutputReceived += HandleOutput;
        TerminalService.SessionExited += HandleExit;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./terminal.js");
                _selfReference = DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync("create", SessionId.ToString(), _terminalElement, _selfReference);
                foreach (var output in TerminalService.GetRecentOutput(SessionId))
                    await _module.InvokeVoidAsync("write", SessionId.ToString(), output);
            }
            catch (Exception exception)
            {
                if (_module is not null)
                    await _module.InvokeVoidAsync("write", SessionId.ToString(), $"\r\n\x1b[31m{L.T("Terminal failed to start: {0}", exception.Message)}\x1b[0m\r\n");
            }
        }

        if (_module is not null && (!StartWhenVisible || IsVisible) && !TerminalService.IsRunning(SessionId))
        {
            try
            {
                if (UsePowerShell)
                    await TerminalService.StartPowerShellAsync(SessionId, RepositoryPath);
                else
                    await TerminalService.StartAsync(SessionId, RepositoryPath, Command,
                        openCodeSandboxEnabled: OpenCodeSandboxEnabled, openCodeSessionId: OpenCodeSessionId);
            }
            catch (Exception exception)
            {
                if (_module is not null)
                    await _module.InvokeVoidAsync("write", SessionId.ToString(), $"\r\n\x1b[31m{L.T("Terminal failed to start: {0}", exception.Message)}\x1b[0m\r\n");
            }
        }

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("setVisible", SessionId.ToString(), IsVisible);
        }
    }

    [JSInvokable]
    public Task SendInput(string input) => TerminalService.WriteInputAsync(SessionId, input);

    [JSInvokable]
    public void Resize(int columns, int rows) => TerminalService.Resize(SessionId, columns, rows);

    private void HandleOutput(Guid id, string text)
    {
        if (id == SessionId && _module is not null)
        {
            try { _ = _module.InvokeVoidAsync("write", SessionId.ToString(), text); }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
        }
    }

    private void HandleExit(Guid id, int exitCode)
    {
        if (id == SessionId && _module is not null)
            _ = _module.InvokeVoidAsync("write", SessionId.ToString(), $"\r\n\x1b[90m[{L.T("Process ended with exit code {0}", exitCode)}]\x1b[0m\r\n");
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
            return;
        _disposed = true;
        TerminalService.OutputReceived -= HandleOutput;
        TerminalService.SessionExited -= HandleExit;
        if (!PreserveSession && !DetachedWindows.ShouldPreserveSession(SessionId))
        {
            await TerminalService.StopAsync(SessionId);
            TerminalService.ClearRecentOutput(SessionId);
        }
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", SessionId.ToString());
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        _selfReference?.Dispose();
    }
}
