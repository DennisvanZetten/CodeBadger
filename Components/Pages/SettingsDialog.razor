@inject LauncherSettingsService SettingsService
@inject AiCommitMessageService AiCommitMessageService
@inject RepositoryFolderPicker FolderPicker
@inject ISnackbar Snackbar

<MudDialog Class="settings-dialog">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Settings" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Instellingen</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudTabs Position="Position.Left" Rounded="true" Border="true" ApplyEffectsToContainer="true"
                 TabPanelsClass="pa-4 settings-tab-panel" Class="settings-tabs">
            <MudTabPanel Text="Repositories" Icon="@Icons.Material.Filled.Folder">
                <MudStack Spacing="3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <div>
                            <MudText Typo="Typo.h6">Repositories beheren</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Actieve repositories krijgen een eigen starttab.</MudText>
                        </div>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddRepository">Toevoegen</MudButton>
                    </MudStack>
                    @if (Settings.Repositories.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Voeg een repositorymap toe om te beginnen.</MudAlert>
                    }
                    @foreach (var repository in Settings.Repositories)
                    {
                        <MudPaper @key="repository" Class="pa-3" Outlined="true" Elevation="0">
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="1"><MudSwitch @bind-Value="repository.IsActive" Color="Color.Primary" /></MudItem>
                                <MudItem xs="12" sm="3"><MudTextField @bind-Value="repository.Name" Label="Naam" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="12" sm="7">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudTextField @bind-Value="repository.Path" Label="Pad" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                                        <MudIconButton Icon="@Icons.Material.Filled.FolderOpen" Color="Color.Primary" aria-label="Repositorymap zoeken"
                                                       Disabled="@(!FolderPicker.IsSupported)" OnClick="@(() => BrowseRepositoryAsync(repository))" />
                                    </MudStack>
                                </MudItem>
                                <MudItem xs="12" sm="1" Class="d-flex justify-end">
                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" aria-label="Repository verwijderen"
                                                   OnClick="@(() => Settings.Repositories.Remove(repository))" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                </MudStack>
            </MudTabPanel>
            <MudTabPanel Text="Starten" Icon="@Icons.Material.Filled.Terminal">
                <MudStack Spacing="3">
                    <MudText Typo="Typo.h6">Startinstellingen</MudText>
                    <MudTextField @bind-Value="Settings.ToolCommand" Label="Applicatie / opdracht"
                                  HelperText="Wordt rechtstreeks gestart in de repositorymap, bijvoorbeeld opencode of een volledig exe-pad met argumenten."
                                  Variant="Variant.Outlined" />
                </MudStack>
            </MudTabPanel>
            <MudTabPanel Text="AI-provider" Icon="@Icons.Material.Filled.AutoAwesome">
                <MudStack Spacing="3">
                    <MudText Typo="Typo.h6">AI voor commitberichten</MudText>
                    <MudSelect T="string" Label="Provider" Variant="Variant.Outlined" @bind-Value="Settings.AiProvider" @bind-Value:after="ResetModelList">
                        @foreach (var provider in AiProviders)
                        {
                            <MudSelectItem T="string" Value="@provider">@provider</MudSelectItem>
                        }
                    </MudSelect>
                    @if (Settings.AiProvider is "Custom URL" or "Azure OpenAI")
                    {
                        <MudTextField @bind-Value="Settings.AiCustomUrl" @bind-Value:after="ResetModelList" Label="Provider URL" Variant="Variant.Outlined"
                                      HelperText="OpenAI-compatible basis-URL (bijv. https://host/v1) of volledig /chat/completions-endpoint; Azure: deployment-URL inclusief api-version." />
                    }
                    <MudSelect T="string" Label="Model" Variant="Variant.Outlined" @bind-Value="Settings.AiModel"
                               Disabled="@(!_hasTestedConnection || _availableModels.Count == 0)"
                               HelperText="@(_hasTestedConnection ? "Kies een model uit de provider." : "Test eerst de verbinding om modellen op te halen.")">
                        @foreach (var model in _availableModels)
                        {
                            <MudSelectItem T="string" Value="@model">@model</MudSelectItem>
                        }
                    </MudSelect>
                    <MudNumericField T="int" @bind-Value="Settings.AiMaxInputTokens" Label="Max. inputtokens"
                                     Min="256" Max="200000" Variant="Variant.Outlined" />
                    <MudTextField @bind-Value="Settings.AiCustomInstruction" Label="Eigen instructie voor commitberichten"
                                  HelperText="Bijvoorbeeld: gebruik Conventional Commits en schrijf in het Nederlands."
                                  Lines="3" Variant="Variant.Outlined" />
                    @if (Settings.AiProvider != "Ollama")
                    {
                        <MudTextField @bind-Value="Settings.AiApiKey" @bind-Value:after="ResetModelList" Label="Provider API key" Variant="Variant.Outlined"
                                      InputType="InputType.Password" HelperText="Wordt veilig lokaal opgeslagen." />
                    }
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.WifiTethering"
                               OnClick="TestAiConnectionAsync" Disabled="@_isTestingAi" Class="align-self-start">
                        @(_isTestingAi ? "Verbinding en modellen ophalen..." : "Verbinding testen & modellen ophalen")
                    </MudButton>
                </MudStack>
            </MudTabPanel>
            <MudTabPanel Text="Overig" Icon="@Icons.Material.Filled.Tune">
                <MudStack Spacing="3">
                    <MudText Typo="Typo.h6">Overige instellingen</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Instellingen worden lokaal opgeslagen. API-sleutels worden beveiligd opgeslagen.</MudText>
                </MudStack>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Annuleren</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                   Disabled="@_isSaving" OnClick="SaveAsync">Opslaan</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public LauncherSettings Settings { get; set; } = new();

    private bool _isTestingAi;
    private bool _isSaving;
    private bool _hasTestedConnection;
    private IReadOnlyList<string> _availableModels = [];
    private static readonly string[] AiProviders = ["OpenAI", "Azure OpenAI", "Anthropic", "Google Gemini", "Ollama", "Custom URL"];

    private void AddRepository() => Settings.Repositories.Add(new RepositoryEntry { Name = "Nieuwe repository" });

    private async Task BrowseRepositoryAsync(RepositoryEntry repository)
    {
        var path = await FolderPicker.PickFolderAsync();
        if (string.IsNullOrWhiteSpace(path))
            return;
        repository.Path = path;
        if (string.IsNullOrWhiteSpace(repository.Name) || repository.Name == "Nieuwe repository")
            repository.Name = Path.GetFileName(Path.TrimEndingDirectorySeparator(path));
    }

    private async Task TestAiConnectionAsync()
    {
        _isTestingAi = true;
        _hasTestedConnection = false;
        _availableModels = [];
        try
        {
            var result = await AiCommitMessageService.GetAvailableModelsAsync(Settings);
            if (result.Success)
            {
                _availableModels = result.Models;
                _hasTestedConnection = true;
                if (!_availableModels.Contains(Settings.AiModel, StringComparer.OrdinalIgnoreCase))
                    Settings.AiModel = _availableModels[0];
            }
            Snackbar.Add(result.Success ? $"Verbinding werkt. {_availableModels.Count} modellen gevonden." : result.Error,
                result.Success ? Severity.Success : Severity.Error,
                config => config.VisibleStateDuration = 10000);
        }
        finally
        {
            _isTestingAi = false;
        }
    }

    private void ResetModelList()
    {
        _hasTestedConnection = false;
        _availableModels = [];
    }

    private async Task SaveAsync()
    {
        _isSaving = true;
        try
        {
            await SettingsService.SaveAsync(Settings);
            Snackbar.Add("Instellingen opgeslagen.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
