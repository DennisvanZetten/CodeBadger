@implements IAsyncDisposable
@inject LocalizationService L
@inject GitBranchService GitBranchService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudDialog Class="git-conflict-dialog">
    <DialogContent>
        <div class="git-conflict-editor">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="git-conflict-toolbar">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle1">@L.T("Resolve conflict")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@ConflictPath</MudText>
                </MudStack>
                <MudStack Row="true" Spacing="1">
                    <MudButton Variant="Variant.Outlined" OnClick="TakeAllOurs" Disabled="@(_loading || _saving)">@L.T("Take all left")</MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="TakeAllTheirs" Disabled="@(_loading || _saving)">@L.T("Take all right")</MudButton>
                </MudStack>
            </MudStack>

            @if (_loading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
            }
            else
            {
                <div class="git-conflict-sides">
                    <section class="git-conflict-side">
                        <header><MudText Typo="Typo.subtitle2">@L.T("Current (left)")</MudText><MudButton Size="Size.Small" OnClick="TakeAllOurs">@L.T("Take all")</MudButton></header>
                        <div class="git-conflict-code" @ref="_leftCode">
                            @foreach (var row in BuildSideRows(false))
                            {
                                @if (row.Conflict is { RequiresSelection: true } conflict)
                                {
                                    <label @key="conflict" data-conflict-row="true" class="git-conflict-code-line git-conflict-diff-line git-conflict-change @(row.Text is null ? "git-conflict-empty-line" : "") @(conflict.Selection == false ? "selected" : "")">
                                        <input type="checkbox" checked="@(conflict.Selection == false)" aria-label="@L.T("Choose left line")" @onchange="args => SetLineSelection(conflict, false, args)" />
                                        <span class="git-conflict-line-number">@row.LineNumber</span><code>@row.Text</code>
                                    </label>
                                }
                                else
                                {
                                    <div class="git-conflict-code-line"><span class="git-conflict-selector-placeholder"></span><span class="git-conflict-line-number">@row.LineNumber</span><code>@row.Text</code></div>
                                }
                            }
                        </div>
                    </section>
                    <section class="git-conflict-side">
                        <header><MudText Typo="Typo.subtitle2">@L.T("Incoming (right)")</MudText><MudButton Size="Size.Small" OnClick="TakeAllTheirs">@L.T("Take all")</MudButton></header>
                        <div class="git-conflict-code" @ref="_rightCode">
                            @foreach (var row in BuildSideRows(true))
                            {
                                @if (row.Conflict is { RequiresSelection: true } conflict)
                                {
                                    <label @key="conflict" data-conflict-row="true" class="git-conflict-code-line git-conflict-diff-line git-conflict-change @(row.Text is null ? "git-conflict-empty-line" : "") @(conflict.Selection == true ? "selected" : "")">
                                        <input type="checkbox" checked="@(conflict.Selection == true)" aria-label="@L.T("Choose right line")" @onchange="args => SetLineSelection(conflict, true, args)" />
                                        <span class="git-conflict-line-number">@row.LineNumber</span><code>@row.Text</code>
                                    </label>
                                }
                                else
                                {
                                    <div class="git-conflict-code-line"><span class="git-conflict-selector-placeholder"></span><span class="git-conflict-line-number">@row.LineNumber</span><code>@row.Text</code></div>
                                }
                            }
                        </div>
                    </section>
                </div>

                <section class="git-conflict-result">
                    <MudText Typo="Typo.subtitle2">@L.T("Result (editable)")</MudText>
                    <div class="git-conflict-result-editor">
                        <div class="git-conflict-result-preview" aria-hidden="true"></div>
                        <textarea @ref="_resultEditor" class="git-conflict-result-textarea" spellcheck="false" aria-label="@L.T("Result (editable)")" value="@_result" @oninput="HandleResultInput"></textarea>
                    </div>
                </section>

                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="git-conflict-footer">
                    <MudText Typo="Typo.caption" Color="@(_hasConflictSelection && _chunks.OfType<ConflictChunk>().Any(c => c.Rows.Any(r => r.RequiresSelection && r.Selection is null)) ? Color.Warning : Color.Success)">
                        @(_chunks.OfType<ConflictChunk>().Any(c => c.Rows.Any(r => r.RequiresSelection && r.Selection is null)) ? L.T("Choose a side for every conflicting line before saving.") : L.T("All conflicts have a selection. You can still edit the result."))
                    </MudText>
                    <MudStack Row="true" Spacing="1">
                        <MudButton Variant="Variant.Text" OnClick="Close" Disabled="@_saving">@L.T("Cancel")</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check" OnClick="SaveAsync" Disabled="@(_saving || (_hasConflictSelection && _chunks.OfType<ConflictChunk>().Any(c => c.Rows.Any(r => r.RequiresSelection && r.Selection is null))))">@L.T("Save and mark resolved")</MudButton>
                    </MudStack>
                </MudStack>
            }
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string RepositoryPath { get; set; } = string.Empty;
    [Parameter] public string ConflictPath { get; set; } = string.Empty;

    private string _ours = string.Empty;
    private string _theirs = string.Empty;
    private string _result = string.Empty;
    private string _fingerprint = string.Empty;
    private string _lineEnding = "\n";
    private bool _hasUtf8Bom;
    private bool _hasTrailingNewline;
    private string[] _resultLines = [];
    private List<ConflictChunkBase> _chunks = [];
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private bool _hasConflictSelection;
    private ElementReference _leftCode;
    private ElementReference _rightCode;
    private ElementReference _resultEditor;
    private IJSObjectReference? _conflictModule;
    private bool _scrollSyncInitialized;
    private bool _resultRenderPending;
    private string? _pendingResultEditorValue;

    protected override async Task OnInitializedAsync()
    {
        var response = await GitBranchService.GetConflictVersionsAsync(RepositoryPath, ConflictPath);
        if (response.Versions is null)
        {
            _error = response.Result.Message;
            _loading = false;
            return;
        }

        _ours = response.Versions.Ours;
        _theirs = response.Versions.Theirs;
        _fingerprint = response.Versions.Fingerprint;
        _lineEnding = response.Versions.LineEnding;
        _hasUtf8Bom = response.Versions.HasUtf8Bom;
        _hasTrailingNewline = HasTrailingNewline(response.Versions.WorkingContent);
        _chunks = ParseConflictChunks(response.Versions.WorkingContent);
        if (!_chunks.OfType<ConflictChunk>().Any())
            _chunks = [new ConflictChunk(AlignLines(_ours, _theirs))];
        _hasConflictSelection = _chunks.OfType<ConflictChunk>().Any(c => c.Rows.Any(r => r.RequiresSelection));
        UpdateResult();
        _pendingResultEditorValue = _result;
        _resultRenderPending = true;
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loading || _error is not null)
            return;

        if (!_scrollSyncInitialized)
        {
            _conflictModule = await JS.InvokeAsync<IJSObjectReference>("import", "./git-conflict.js");
            await _conflictModule.InvokeVoidAsync("initializeConflictScroll", _leftCode, _rightCode, _resultEditor);
            _scrollSyncInitialized = true;
            _resultRenderPending = true;
            _pendingResultEditorValue = _result;
        }

        if (_resultRenderPending && _conflictModule is not null)
        {
            await _conflictModule.InvokeVoidAsync("renderConflictResult", _resultEditor, BuildResultRows(), _pendingResultEditorValue);
            _resultRenderPending = false;
            _pendingResultEditorValue = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_conflictModule is not null)
        {
            try { await _conflictModule.InvokeVoidAsync("disposeConflictScroll", _leftCode, _rightCode, _resultEditor); }
            catch (JSDisconnectedException) { }
            try { await _conflictModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }

    private void SetLineSelection(ConflictLine row, bool takeRight, ChangeEventArgs args)
    {
        if (!row.RequiresSelection)
            return;
        var isChecked = args.Value is bool value && value;
        if (isChecked)
            row.Selection = takeRight;
        else if (row.Selection == takeRight)
            row.Selection = null;
        UpdateResult();
        _resultRenderPending = true;
        _pendingResultEditorValue = _result;
    }

    private async Task HandleResultInput(ChangeEventArgs args)
    {
        _result = args.Value?.ToString() ?? string.Empty;
        _hasTrailingNewline = HasTrailingNewline(_result);
        _resultLines = GetResultLines(_result);
        _resultRenderPending = true;
        _pendingResultEditorValue = null;
        await InvokeAsync(StateHasChanged);
    }

    private void SelectBlock(ConflictChunk chunk, bool takeRight)
    {
        foreach (var row in chunk.Rows.Where(row => row.RequiresSelection))
            row.Selection = takeRight;
        UpdateResult();
        _resultRenderPending = true;
        _pendingResultEditorValue = _result;
    }

    private void TakeAllOurs() { SelectAll(false); }
    private void TakeAllTheirs() { SelectAll(true); }

    private void SelectAll(bool takeRight)
    {
        foreach (var chunk in _chunks.OfType<ConflictChunk>())
            SelectBlock(chunk, takeRight);
    }

    private void UpdateResult()
    {
        var lines = new List<string>();
        foreach (var chunk in _chunks)
        {
            if (chunk is ContextChunk context)
                lines.AddRange(context.Lines);
            else if (chunk is ConflictChunk conflict)
            {
                foreach (var row in conflict.Rows)
                {
                    if (row.RequiresSelection && row.Selection is null)
                        continue;
                    var line = row.Selection == true ? row.RightLine : row.LeftLine;
                    if (line is not null)
                        lines.Add(line);
                }
            }
        }
        var result = string.Join(_lineEnding, lines);
        _result = _hasTrailingNewline ? result + _lineEnding : result;
        _resultLines = lines.ToArray();
    }

    private static bool HasTrailingNewline(string value) => value.Length > 0 && (value.EndsWith('\n') || value.EndsWith('\r'));

    private static string[] GetResultLines(string value)
    {
        if (value.Length == 0)
            return [];
        var normalized = value.Replace("\r\n", "\n", StringComparison.Ordinal).Replace('\r', '\n');
        var lines = normalized.Split('\n');
        return lines.Length > 0 && lines[^1].Length == 0 ? lines[..^1] : lines;
    }

    private IReadOnlyList<ConflictResultRow> BuildResultRows()
    {
        var selectedRows = new List<ConflictResultRow>();
        foreach (var chunk in _chunks)
        {
            if (chunk is ContextChunk context)
            {
                selectedRows.AddRange(context.Lines.Select(line => new ConflictResultRow(line, "context", 0)));
            }
            else if (chunk is ConflictChunk conflict)
            {
                foreach (var row in conflict.Rows)
                {
                    if (row.RequiresSelection && row.Selection is null)
                        continue;
                    var text = row.Selection == true ? row.RightLine : row.LeftLine;
                    if (text is not null)
                        selectedRows.Add(new ConflictResultRow(text, row.RequiresSelection ? "chosen" : "context", 0));
                }
            }
        }

        var rows = new List<ConflictResultRow>(_resultLines.Length);
        var sourceIndex = 0;
        for (var index = 0; index < _resultLines.Length; index++)
        {
            var line = _resultLines[index];
            var matchIndex = -1;
            for (var candidate = sourceIndex; candidate < selectedRows.Count; candidate++)
            {
                if (selectedRows[candidate].Text != line)
                    continue;
                matchIndex = candidate;
                break;
            }

            var kind = matchIndex >= 0 ? selectedRows[matchIndex].Kind : "context";
            if (matchIndex >= 0)
                sourceIndex = matchIndex + 1;
            rows.Add(new ConflictResultRow(line, kind, index + 1));
        }
        return rows;
    }

    private IReadOnlyList<ConflictDisplayRow> BuildSideRows(bool right)
    {
        var rows = new List<ConflictDisplayRow>();
        var lineNumber = 0;
        foreach (var chunk in _chunks)
        {
            if (chunk is ContextChunk context)
            {
                foreach (var line in context.Lines)
                {
                    rows.Add(new ConflictDisplayRow(line, ++lineNumber, null));
                }
            }
            else if (chunk is ConflictChunk conflict)
            {
                foreach (var row in conflict.Rows)
                {
                    var text = right ? row.RightLine : row.LeftLine;
                    rows.Add(new ConflictDisplayRow(text, text is null ? null : ++lineNumber, row));
                }
            }
        }
        return rows;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            var result = await GitBranchService.SaveResolvedConflictAsync(RepositoryPath, ConflictPath, _result, _fingerprint, _lineEnding, _hasUtf8Bom);
            if (!result.Success)
            {
                Snackbar.Add(result.Message, Severity.Error);
                return;
            }
            Snackbar.Add(L.T("Conflict resolved and staged."), Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        finally { _saving = false; }
    }

    private void Close() => MudDialog.Close();

    private static List<ConflictChunkBase> ParseConflictChunks(string content)
    {
        var hasTrailingNewline = content.EndsWith('\n') || content.EndsWith('\r');
        var lines = content.Split('\n').Select(line => line.TrimEnd('\r')).ToArray();
        if (hasTrailingNewline && lines.Length > 0 && lines[^1].Length == 0)
            lines = lines[..^1];
        var chunks = new List<ConflictChunkBase>();
        var context = new List<string>();
        for (var i = 0; i < lines.Length;)
        {
            if (!lines[i].StartsWith("<<<<<<<", StringComparison.Ordinal))
            {
                context.Add(lines[i++]);
                continue;
            }

            if (context.Count > 0) { chunks.Add(new ContextChunk(context)); context = []; }
            i++;
            var left = new List<string>();
            while (i < lines.Length && !lines[i].StartsWith("|||||||", StringComparison.Ordinal) && !lines[i].StartsWith("=======", StringComparison.Ordinal))
                left.Add(lines[i++]);
            if (i < lines.Length && lines[i].StartsWith("|||||||", StringComparison.Ordinal))
            {
                while (i < lines.Length && !lines[i].StartsWith("=======", StringComparison.Ordinal)) i++;
            }
            if (i < lines.Length && lines[i].StartsWith("=======", StringComparison.Ordinal)) i++;
            var right = new List<string>();
            while (i < lines.Length && !lines[i].StartsWith(">>>>>>>", StringComparison.Ordinal)) right.Add(lines[i++]);
            if (i < lines.Length) i++;
            chunks.Add(new ConflictChunk(AlignLines(string.Join("\n", left), string.Join("\n", right))));
        }
        if (context.Count > 0) chunks.Add(new ContextChunk(context));
        return chunks;
    }

    private static List<ConflictLine> AlignLines(string left, string right)
    {
        var leftLines = SplitLines(left);
        var rightLines = SplitLines(right);
        if ((long)leftLines.Length * rightLines.Length > 1_000_000)
        {
            var fallback = new List<ConflictLine>(Math.Max(leftLines.Length, rightLines.Length));
            for (var i = 0; i < Math.Max(leftLines.Length, rightLines.Length); i++)
                fallback.Add(new ConflictLine(i < leftLines.Length ? leftLines[i] : null, i < rightLines.Length ? rightLines[i] : null));
            return AlignChangedRows(fallback);
        }

        var lengths = new int[leftLines.Length + 1, rightLines.Length + 1];
        for (var i = leftLines.Length - 1; i >= 0; i--)
            for (var j = rightLines.Length - 1; j >= 0; j--)
                lengths[i, j] = leftLines[i] == rightLines[j]
                    ? lengths[i + 1, j + 1] + 1
                    : Math.Max(lengths[i + 1, j], lengths[i, j + 1]);

        var rows = new List<ConflictLine>();
        var leftIndex = 0;
        var rightIndex = 0;
        while (leftIndex < leftLines.Length || rightIndex < rightLines.Length)
        {
            if (leftIndex < leftLines.Length && rightIndex < rightLines.Length && leftLines[leftIndex] == rightLines[rightIndex])
            {
                rows.Add(new ConflictLine(leftLines[leftIndex++], rightLines[rightIndex++], requiresSelection: false, selection: false));
            }
            else if (leftIndex < leftLines.Length && (rightIndex >= rightLines.Length || lengths[leftIndex + 1, rightIndex] >= lengths[leftIndex, rightIndex + 1]))
            {
                rows.Add(new ConflictLine(leftLines[leftIndex++], null));
            }
            else
            {
                rows.Add(new ConflictLine(null, rightLines[rightIndex++]));
            }
        }
        return AlignChangedRows(rows);
    }

    private static List<ConflictLine> AlignChangedRows(List<ConflictLine> rows)
    {
        var alignedRows = new List<ConflictLine>(rows.Count);
        for (var index = 0; index < rows.Count;)
        {
            if (!rows[index].RequiresSelection)
            {
                alignedRows.Add(rows[index++]);
                continue;
            }

            var changedRows = new List<ConflictLine>();
            while (index < rows.Count && rows[index].RequiresSelection)
                changedRows.Add(rows[index++]);
            var leftChanges = changedRows.Where(row => row.LeftLine is not null).Select(row => row.LeftLine).ToArray();
            var rightChanges = changedRows.Where(row => row.RightLine is not null).Select(row => row.RightLine).ToArray();
            for (var changeIndex = 0; changeIndex < Math.Max(leftChanges.Length, rightChanges.Length); changeIndex++)
                alignedRows.Add(new ConflictLine(
                    changeIndex < leftChanges.Length ? leftChanges[changeIndex] : null,
                    changeIndex < rightChanges.Length ? rightChanges[changeIndex] : null));
        }
        return alignedRows;
    }

    private static string[] SplitLines(string value) => value.Length == 0 ? [] : value.TrimEnd('\n').Split('\n').Select(line => line.TrimEnd('\r')).ToArray();

    private abstract record ConflictChunkBase;
    private sealed record ContextChunk(IReadOnlyList<string> Lines) : ConflictChunkBase;
    private sealed record ConflictChunk(List<ConflictLine> Rows) : ConflictChunkBase;
    private sealed class ConflictLine(string? leftLine, string? rightLine, bool requiresSelection = true, bool? selection = null)
    {
        public string? LeftLine { get; } = leftLine;
        public string? RightLine { get; } = rightLine;
        public bool RequiresSelection { get; } = requiresSelection;
        public bool? Selection { get; set; } = selection;
    }

    private sealed record ConflictDisplayRow(string? Text, int? LineNumber, ConflictLine? Conflict);
    private sealed record ConflictResultRow(string Text, string Kind, int LineNumber);
}
