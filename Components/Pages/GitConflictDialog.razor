@implements IAsyncDisposable
@inject LocalizationService L
@inject GitBranchService GitBranchService
@inject AiCommitMessageService AiCommitMessageService
@inject LauncherSettingsService LauncherSettingsService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudDialog Class="git-conflict-dialog">
    <DialogContent>
        <div class="git-conflict-editor">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="git-conflict-toolbar">
                <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle1">@L.T("Resolve conflict")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@ConflictPath</MudText>
                    </MudStack>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="git-conflict-navigation">
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" aria-label="@L.T("Previous conflict")" title="@L.T("Previous conflict")" OnClick="PreviousConflict" Disabled="@(_saving || _conflictChunks.Count == 0 || _activeConflictIndex <= 0)" />
                    <MudText Typo="Typo.caption">@(_conflictChunks.Count == 0 ? L.T("No conflicts") : L.T("Conflict {0} of {1}", _activeConflictIndex + 1, _conflictChunks.Count))</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" aria-label="@L.T("Next conflict")" title="@L.T("Next conflict")" OnClick="NextConflict" Disabled="@(_saving || _conflictChunks.Count == 0 || _activeConflictIndex >= _conflictChunks.Count - 1)" />
                </MudStack>
                <MudStack Row="true" Spacing="1">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AutoAwesome" OnClick="ResolveWithAiAsync" Disabled="@(_loading || _saving || _isResolvingWithAi)">
                @(_isResolvingWithAi ? L.T("AI is preparing a proposal...") : L.T("AI resolve"))
            </MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="TakeAllOurs" Disabled="@(_loading || _saving)">@L.T("Take all left")</MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="TakeAllTheirs" Disabled="@(_loading || _saving)">@L.T("Take all right")</MudButton>
                </MudStack>
            </MudStack>

            @if (_loading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
            }
            else
            {
                <div class="git-conflict-sides">
                    <section class="git-conflict-side git-conflict-side-current">
                        <header><MudText Typo="Typo.subtitle2"><span class="git-conflict-source-badge git-conflict-source-a">A</span>@L.T("Current (left)")</MudText><MudButton Size="Size.Small" OnClick="TakeAllOurs">@L.T("Take all")</MudButton></header>
                        <div class="git-conflict-code" @ref="_leftCode">
                            @foreach (var displayChunk in BuildSideChunks(false))
                            {
                                @if (displayChunk.Conflict is { } conflict)
                                {
                    <section @key="conflict" class="git-conflict-area">
                                        <header><MudText Typo="Typo.caption">@L.T("Conflicting changes")</MudText><label class="git-conflict-area-select"><input type="checkbox" checked="@IsBlockSelected(conflict, false)" aria-label="@L.T("Select entire left conflict block")" @onchange="args => SelectBlock(conflict, false, args)" /></label></header>
                                        @foreach (var row in displayChunk.Rows)
                                        {
                                            @if (row.Conflict is { RequiresSelection: true } line)
                                            {
                                                <div data-conflict-row="true" data-source-row-index="@row.SourceRowIndex" class="git-conflict-code-line git-conflict-diff-line git-conflict-change @(row.Text is null ? "git-conflict-empty-line" : "") @(line.Selection == false ? "selected" : "")">
                                                    <button type="button" class="git-conflict-line-add @(line.Selection == false ? "selected" : "")" aria-label="@L.T("Add left line")" title="@L.T("Add left line")" @onclick="() => SelectLine(line, false)"><MudIcon Icon="@(line.Selection == false ? Icons.Material.Filled.Check : Icons.Material.Filled.Add)" Size="Size.Small" /></button>
                                                    <span class="git-conflict-line-number">@row.LineNumber</span><code>@row.Text</code>
                                                </div>
                                            }
                                            else
                                            {
                                                <div data-source-row-index="@row.SourceRowIndex" class="git-conflict-code-line"><span class="git-conflict-selector-placeholder"></span><span class="git-conflict-line-number">@row.LineNumber</span><code>@row.Text</code></div>
                                            }
                                        }
                                    </section>
                                }
                                else
                                {
                                    @foreach (var row in displayChunk.Rows)
                                    {
                                        <div data-source-row-index="@row.SourceRowIndex" class="git-conflict-code-line"><span class="git-conflict-selector-placeholder"></span><span class="git-conflict-line-number">@row.LineNumber</span><code>@row.Text</code></div>
                                    }
                                }
                            }
                        </div>
                    </section>
                    <section class="git-conflict-side git-conflict-side-incoming">
                        <header><MudText Typo="Typo.subtitle2"><span class="git-conflict-source-badge git-conflict-source-b">B</span>@L.T("Incoming (right)")</MudText><MudButton Size="Size.Small" OnClick="TakeAllTheirs">@L.T("Take all")</MudButton></header>
                        <div class="git-conflict-code" @ref="_rightCode">
                            @foreach (var displayChunk in BuildSideChunks(true))
                            {
                                @if (displayChunk.Conflict is { } conflict)
                                {
                    <section @key="conflict" class="git-conflict-area">
                                        <header><MudText Typo="Typo.caption">@L.T("Conflicting changes")</MudText><label class="git-conflict-area-select"><input type="checkbox" checked="@IsBlockSelected(conflict, true)" aria-label="@L.T("Select entire right conflict block")" @onchange="args => SelectBlock(conflict, true, args)" /></label></header>
                                        @foreach (var row in displayChunk.Rows)
                                        {
                                            @if (row.Conflict is { RequiresSelection: true } line)
                                            {
                                                <div data-conflict-row="true" data-source-row-index="@row.SourceRowIndex" class="git-conflict-code-line git-conflict-diff-line git-conflict-change @(row.Text is null ? "git-conflict-empty-line" : "") @(line.Selection == true ? "selected" : "")">
                                                    <button type="button" class="git-conflict-line-add @(line.Selection == true ? "selected" : "")" aria-label="@L.T("Add right line")" title="@L.T("Add right line")" @onclick="() => SelectLine(line, true)"><MudIcon Icon="@(line.Selection == true ? Icons.Material.Filled.Check : Icons.Material.Filled.Add)" Size="Size.Small" /></button>
                                                    <span class="git-conflict-line-number">@row.LineNumber</span><code>@row.Text</code>
                                                </div>
                                            }
                                            else
                                            {
                                                <div data-source-row-index="@row.SourceRowIndex" class="git-conflict-code-line"><span class="git-conflict-selector-placeholder"></span><span class="git-conflict-line-number">@row.LineNumber</span><code>@row.Text</code></div>
                                            }
                                        }
                                    </section>
                                }
                                else
                                {
                                    @foreach (var row in displayChunk.Rows)
                                    {
                                        <div data-source-row-index="@row.SourceRowIndex" class="git-conflict-code-line"><span class="git-conflict-selector-placeholder"></span><span class="git-conflict-line-number">@row.LineNumber</span><code>@row.Text</code></div>
                                    }
                                }
                            }
                        </div>
                    </section>
                </div>

                <section class="git-conflict-result">
                    <MudText Typo="Typo.subtitle2">@L.T("Result (editable)")</MudText>
                    <div class="git-conflict-result-editor">
                        <div class="git-conflict-result-preview" aria-hidden="true"></div>
                        <textarea @ref="_resultEditor" class="git-conflict-result-textarea" spellcheck="false" aria-label="@L.T("Result (editable)")" value="@_result" @oninput="HandleResultInput"></textarea>
                    </div>
                </section>

                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="git-conflict-footer">
                    <MudText Typo="Typo.caption" Color="@(AllConflictAreasSelected ? Color.Success : Color.Warning)">
                        @(AllConflictAreasSelected ? L.T("All conflict areas have a selection. You can still edit the result.") : L.T("Choose at least one side in every conflict area before saving."))
                    </MudText>
                    <MudStack Row="true" Spacing="1">
                        <MudButton Variant="Variant.Text" OnClick="Close" Disabled="@_saving">@L.T("Cancel")</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check" OnClick="SaveAsync" Disabled="@(_saving || !AllConflictAreasSelected)">@L.T("Save and mark resolved")</MudButton>
                    </MudStack>
                </MudStack>
            }
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string RepositoryPath { get; set; } = string.Empty;
    [Parameter] public string ConflictPath { get; set; } = string.Empty;

    private string _ours = string.Empty;
    private string _theirs = string.Empty;
    private string _result = string.Empty;
    private string _workingContent = string.Empty;
    private string _aiOriginalResult = string.Empty;
    private string _fingerprint = string.Empty;
    private string _lineEnding = "\n";
    private bool _hasUtf8Bom;
    private bool _hasTrailingNewline;
    private List<ConflictChunkBase> _chunks = [];
    private bool _loading = true;
    private bool _saving;
    private bool _isResolvingWithAi;
    private bool _hasAiConflictProposal;
    private bool _hasDefaultConflictProposal;
    private string? _error;
    private int _activeConflictIndex;
    private int? _pendingConflictSourceRow;
    private bool _aiDefaultApplied;
    private ConflictChunk? _aiDefaultChunk;
    private ElementReference _leftCode;
    private ElementReference _rightCode;
    private ElementReference _resultEditor;
    private IJSObjectReference? _conflictModule;
    private bool _scrollSyncInitialized;
    private bool _resultRenderPending;
    private string? _pendingResultEditorValue;
    private bool _alignResultOnNextRender;

    private List<ConflictChunk> _conflictChunks => _chunks.OfType<ConflictChunk>().ToList();
    private bool AllConflictAreasSelected => _hasAiConflictProposal || _conflictChunks.All(chunk =>
        !chunk.Rows.Any(row => row.RequiresSelection) || chunk.Rows.Any(row => row.RequiresSelection && row.Selection is not null));

    protected override async Task OnInitializedAsync()
    {
        var response = await GitBranchService.GetConflictVersionsAsync(RepositoryPath, ConflictPath);
        if (response.Versions is null)
        {
            _error = response.Result.Message;
            _loading = false;
            return;
        }

        _ours = response.Versions.Ours;
        _theirs = response.Versions.Theirs;
        _fingerprint = response.Versions.Fingerprint;
        _lineEnding = response.Versions.LineEnding;
        _hasUtf8Bom = response.Versions.HasUtf8Bom;
        _hasTrailingNewline = HasTrailingNewline(response.Versions.WorkingContent);
        _workingContent = response.Versions.WorkingContent;
        _chunks = ParseConflictChunks(response.Versions.WorkingContent);
        if (!_chunks.OfType<ConflictChunk>().Any())
            _chunks = [new ConflictChunk(AlignLines(_ours, _theirs))];
        InitializeDefaultConflictProposal();
        _pendingResultEditorValue = _result;
        _resultRenderPending = true;
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loading || _error is not null)
            return;

        if (!_scrollSyncInitialized)
        {
            _conflictModule = await JS.InvokeAsync<IJSObjectReference>("import", "./git-conflict.js");
            await _conflictModule.InvokeVoidAsync("initializeConflictScroll", _leftCode, _rightCode, _resultEditor);
            _scrollSyncInitialized = true;
            _resultRenderPending = true;
            _pendingResultEditorValue = _result;
            _alignResultOnNextRender = true;
        }

        if (_resultRenderPending && _conflictModule is not null)
        {
            var resultRows = BuildResultRows();
            await _conflictModule.InvokeVoidAsync("renderConflictResult", _resultEditor, resultRows, _pendingResultEditorValue);
            if (_alignResultOnNextRender)
            {
                var sourceRowToShow = _pendingConflictSourceRow ?? await _conflictModule.InvokeAsync<int>("getVisibleConflictSourceRowIndex", _leftCode);
                await _conflictModule.InvokeVoidAsync("alignConflictResultToSourceRow", _resultEditor, sourceRowToShow);
                _alignResultOnNextRender = false;
            }
            _resultRenderPending = false;
            _pendingResultEditorValue = null;
        }

        if (_pendingConflictSourceRow is int sourceRow && _conflictModule is not null)
        {
            await _conflictModule.InvokeVoidAsync("scrollConflictSidesToSourceRow", _leftCode, _rightCode, sourceRow);
            _resultRenderPending = true;
            _pendingResultEditorValue = _result;
            _alignResultOnNextRender = true;
            _pendingConflictSourceRow = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_conflictModule is not null)
        {
            try { await _conflictModule.InvokeVoidAsync("disposeConflictScroll", _leftCode, _rightCode, _resultEditor); }
            catch (JSDisconnectedException) { }
            try { await _conflictModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }

    private void SetLineSelection(ConflictLine row, bool takeRight, ChangeEventArgs args)
    {
        var wasDefaultProposal = _hasDefaultConflictProposal && ReferenceEquals(_aiDefaultChunk, row.Chunk);
        if (!_aiDefaultApplied && wasDefaultProposal)
        {
            foreach (var blockLine in row.Chunk.Rows.Where(blockLine => blockLine.RequiresSelection))
                blockLine.Selection = null;
            _aiDefaultChunk = null;
            _aiDefaultApplied = true;
        }
        var selected = args.Value is bool value && value;
        var selectedChunk = row.Chunk;
        if (selected)
        {
            foreach (var line in selectedChunk.Rows.Where(candidate => candidate.RequiresSelection))
                line.Selection = takeRight;
        }
        else
        {
            foreach (var line in selectedChunk.Rows.Where(candidate => candidate.RequiresSelection && candidate.Selection == takeRight))
                line.Selection = null;
        }
        _hasAiConflictProposal = false;
        _hasDefaultConflictProposal = false;
        _aiOriginalResult = string.Empty;
        UpdateResult();
        _resultRenderPending = true;
        _pendingResultEditorValue = _result;
        _alignResultOnNextRender = false;
    }

    private void SelectLine(ConflictLine row, bool takeRight)
    {
        if (!row.RequiresSelection)
            return;
        var isDefaultProposal = _hasDefaultConflictProposal && ReferenceEquals(_aiDefaultChunk, row.Chunk);
        if (!_aiDefaultApplied && isDefaultProposal)
        {
            foreach (var blockLine in row.Chunk.Rows.Where(blockLine => blockLine.RequiresSelection))
                blockLine.Selection = null;
            _aiDefaultChunk = null;
            _aiDefaultApplied = true;
        }
        row.Selection = takeRight;
        _hasAiConflictProposal = false;
        _hasDefaultConflictProposal = false;
        _aiOriginalResult = string.Empty;
        UpdateResult();
        _resultRenderPending = true;
        _pendingResultEditorValue = _result;
        _alignResultOnNextRender = false;
    }

    private void SelectBlock(ConflictChunk chunk, bool takeRight, ChangeEventArgs args)
    {
        var selected = args.Value is bool value && value;
        var isDefaultProposal = _hasDefaultConflictProposal && ReferenceEquals(_aiDefaultChunk, chunk);
        if (selected)
        {
            if (!_aiDefaultApplied && isDefaultProposal && takeRight)
            {
                foreach (var blockLine in chunk.Rows.Where(blockLine => blockLine.RequiresSelection))
                    blockLine.Selection = null;
                _aiDefaultChunk = null;
                _aiDefaultApplied = true;
            }
            else if (!_aiDefaultApplied && isDefaultProposal && !takeRight)
            {
                foreach (var blockLine in chunk.Rows.Where(blockLine => blockLine.RequiresSelection))
                    blockLine.Selection = null;
                _aiDefaultChunk = null;
                _aiDefaultApplied = true;
            }
            foreach (var row in chunk.Rows.Where(row => row.RequiresSelection))
                row.Selection = takeRight;
        }
        else
        {
            foreach (var row in chunk.Rows.Where(row => row.RequiresSelection && row.Selection == takeRight))
                row.Selection = null;
        }

        _hasAiConflictProposal = false;
        _hasDefaultConflictProposal = false;
        _aiOriginalResult = string.Empty;
        UpdateResult();
        _resultRenderPending = true;
        _pendingResultEditorValue = _result;
        _alignResultOnNextRender = false;
    }

    private static bool IsBlockSelected(ConflictChunk chunk, bool takeRight)
    {
        var rows = chunk.Rows.Where(row => row.RequiresSelection && (takeRight ? row.RightLine is not null : row.LeftLine is not null)).ToArray();
        return rows.Length > 0 && rows.All(row => row.Selection == takeRight);
    }

    private void InitializeDefaultConflictProposal()
    {
        var defaultChunk = _conflictChunks.FirstOrDefault(chunk => chunk.Rows.Any(row => row.RequiresSelection));
        _aiDefaultChunk = defaultChunk;
        if (defaultChunk is null)
        {
            _hasAiConflictProposal = false;
            UpdateResult();
            return;
        }

        foreach (var row in defaultChunk.Rows.Where(row => row.RequiresSelection))
            row.Selection = true;
        _aiDefaultApplied = false;
        _hasAiConflictProposal = false;
        _hasDefaultConflictProposal = true;
        UpdateResult();
        _aiOriginalResult = _result;
        _pendingResultEditorValue = _result;
        _resultRenderPending = true;
    }

    private async Task HandleResultInput(ChangeEventArgs args)
    {
        _result = args.Value?.ToString() ?? string.Empty;
        if (_hasAiConflictProposal && _result != _aiOriginalResult)
        {
            _hasAiConflictProposal = false;
            _aiOriginalResult = string.Empty;
        }
        _hasTrailingNewline = HasTrailingNewline(_result);
        _resultRenderPending = true;
        _pendingResultEditorValue = null;
        await InvokeAsync(StateHasChanged);
    }

    private void TakeAllOurs() => SelectAll(false);
    private void TakeAllTheirs() => SelectAll(true);

    private void PreviousConflict() => NavigateConflict(-1);
    private void NextConflict() => NavigateConflict(1);

    private void NavigateConflict(int offset)
    {
        if (_conflictChunks.Count == 0)
            return;
        _activeConflictIndex = Math.Clamp(_activeConflictIndex + offset, 0, _conflictChunks.Count - 1);
        _pendingConflictSourceRow = GetConflictSourceRowIndex(_activeConflictIndex);
        _ = InvokeAsync(StateHasChanged);
    }

    private int GetConflictSourceRowIndex(int conflictIndex)
    {
        var sourceRowIndex = 0;
        foreach (var chunk in _chunks)
        {
            if (chunk is ConflictChunk conflict)
            {
                if (conflictIndex-- == 0)
                    return sourceRowIndex;
                sourceRowIndex += conflict.Rows.Count;
            }
            else if (chunk is ContextChunk context)
            {
                sourceRowIndex += context.Lines.Count;
            }
        }

        return sourceRowIndex;
    }

    private void SelectAll(bool takeRight)
    {
        _hasAiConflictProposal = false;
        _aiOriginalResult = string.Empty;
        _aiDefaultApplied = true;
        _aiDefaultChunk = null;
        var conflicts = _chunks.OfType<ConflictChunk>().ToArray();
        foreach (var row in conflicts.SelectMany(chunk => chunk.Rows).Where(row => row.RequiresSelection))
            row.Selection = takeRight;
        _hasAiConflictProposal = false;
        _hasDefaultConflictProposal = false;
        UpdateResult();
        _resultRenderPending = true;
        _pendingResultEditorValue = _result;
        _alignResultOnNextRender = true;
    }

    private async Task ResolveWithAiAsync()
    {
        _isResolvingWithAi = true;
        try
        {
            var settings = await LauncherSettingsService.LoadAsync();
            var result = await AiCommitMessageService.ResolveConflictAsync(settings, _workingContent);
            if (!result.Success)
            {
                Snackbar.Add(result.Error, Severity.Error);
                return;
            }

            _result = result.Title;
            _hasTrailingNewline = HasTrailingNewline(_result);
        _hasAiConflictProposal = true;
        _hasDefaultConflictProposal = false;
        _aiDefaultChunk = null;
        _aiDefaultApplied = true;
        foreach (var row in _conflictChunks.SelectMany(chunk => chunk.Rows).Where(row => row.RequiresSelection))
            row.Selection = null;
        _resultRenderPending = true;
            _pendingResultEditorValue = _result;
            _alignResultOnNextRender = true;
            Snackbar.Add(L.T("AI conflict proposal ready. Review it before saving."), Severity.Success);
        }
        finally
        {
            _isResolvingWithAi = false;
        }
    }

    private void UpdateResult()
    {
        var lines = new List<string>();
        foreach (var chunk in _chunks)
        {
            if (chunk is ContextChunk context)
                lines.AddRange(context.Lines);
            else if (chunk is ConflictChunk conflict)
            {
                foreach (var row in conflict.Rows)
                {
                    if (row.RequiresSelection && row.Selection is null)
                        continue;
                    var line = row.Selection == true ? row.RightLine : row.LeftLine;
                    if (line is not null)
                        lines.Add(line);
                }
            }
        }
        var result = string.Join(_lineEnding, lines);
        _result = _hasTrailingNewline ? result + _lineEnding : result;
    }

    private static bool HasTrailingNewline(string value) => value.Length > 0 && (value.EndsWith('\n') || value.EndsWith('\r'));

    private IReadOnlyList<ConflictResultRow> BuildResultRows()
    {
        var selectedRows = new List<ConflictResultRow>();
        var sourceRowIndex = 0;
        foreach (var chunk in _chunks)
        {
            if (chunk is ContextChunk context)
            {
                foreach (var line in context.Lines)
                {
                    selectedRows.Add(new ConflictResultRow(line, "context", selectedRows.Count + 1, sourceRowIndex));
                    sourceRowIndex++;
                }
            }
            else if (chunk is ConflictChunk conflict)
            {
                foreach (var row in conflict.Rows)
                {
                    if (row.RequiresSelection && row.Selection is null)
                    {
                        sourceRowIndex++;
                        continue;
                    }
                    var text = row.Selection == true ? row.RightLine : row.LeftLine;
                    if (text is not null)
                    {
                        var rowKind = !row.RequiresSelection ? "context" : _hasAiConflictProposal ? "ai" : _hasDefaultConflictProposal && ReferenceEquals(_aiDefaultChunk, row.Chunk) ? "ai" : row.Selection == false ? "left" : "right";
                        selectedRows.Add(new ConflictResultRow(text, rowKind, selectedRows.Count + 1, sourceRowIndex, row.RequiresSelection, row.Chunk));
                    }
                    sourceRowIndex++;
                }
            }
        }

        if (_hasDefaultConflictProposal && !_hasAiConflictProposal)
            return selectedRows.Select(row => ReferenceEquals(row.ConflictChunk, _aiDefaultChunk) && row.IsConflictLine
                ? row with { Kind = "ai" }
                : row).ToArray();

        var editedLines = SplitLines(_result);
        if (_hasAiConflictProposal)
        {
            var proposalRows = new List<ConflictResultRow>(editedLines.Length);
            var searchFrom = 0;
            for (var index = 0; index < editedLines.Length; index++)
            {
                var line = editedLines[index];
                var matchedSourceRow = (int?)null;
                for (var candidate = searchFrom; candidate < sourceRowIndex; candidate++)
                {
                    if (GetSourceLine(candidate) != line)
                        continue;
                    matchedSourceRow = candidate;
                    searchFrom = candidate + 1;
                    break;
                }
                proposalRows.Add(new ConflictResultRow(line, "ai", index + 1, matchedSourceRow, true));
            }
            return proposalRows;
        }

        var rows = new List<ConflictResultRow>(editedLines.Length);
        var sourceIndex = 0;
        for (var resultIndex = 0; resultIndex < editedLines.Length; resultIndex++)
        {
            var line = editedLines[resultIndex];
            var matchIndex = -1;
            for (var candidate = sourceIndex; candidate < selectedRows.Count; candidate++)
            {
                if (selectedRows[candidate].Text != line)
                    continue;
                matchIndex = candidate;
                break;
            }

            var matchedRow = matchIndex >= 0 ? selectedRows[matchIndex] : null;
            if (matchIndex >= 0)
                sourceIndex = matchIndex + 1;
            rows.Add(new ConflictResultRow(line, matchedRow?.Kind ?? "context", resultIndex + 1, matchedRow?.SourceRowIndex, matchedRow?.IsConflictLine ?? false));
        }
        return rows;
    }

    private static string[] SplitLines(string value)
    {
        if (value.Length == 0)
            return [];
        var normalized = value.Replace("\r\n", "\n", StringComparison.Ordinal).Replace('\r', '\n');
        var lines = normalized.Split('\n');
        return lines.Length > 0 && lines[^1].Length == 0 ? lines[..^1] : lines;
    }

    private string? GetSourceLine(int sourceRowIndex)
    {
        var currentIndex = 0;
        foreach (var chunk in _chunks)
        {
            if (chunk is ContextChunk context)
            {
                foreach (var line in context.Lines)
                {
                    if (currentIndex++ == sourceRowIndex)
                        return line;
                }
            }
            else if (chunk is ConflictChunk conflict)
            {
                foreach (var row in conflict.Rows)
                {
                    if (currentIndex++ == sourceRowIndex)
                        return row.LeftLine ?? row.RightLine;
                }
            }
        }
        return null;
    }

    private IReadOnlyList<ConflictDisplayChunk> BuildSideChunks(bool right)
    {
        var chunks = new List<ConflictDisplayChunk>();
        var lineNumber = 0;
        var sourceRowIndex = 0;
        foreach (var chunk in _chunks)
        {
            if (chunk is ContextChunk context)
            {
                var rows = new List<ConflictDisplayRow>();
                foreach (var line in context.Lines)
                    rows.Add(new ConflictDisplayRow(line, ++lineNumber, null, sourceRowIndex++));
                chunks.Add(new ConflictDisplayChunk(null, rows));
            }
            else if (chunk is ConflictChunk conflict)
            {
                var rows = new List<ConflictDisplayRow>();
                foreach (var row in conflict.Rows)
                {
                    var text = right ? row.RightLine : row.LeftLine;
                    rows.Add(new ConflictDisplayRow(text, text is null ? null : ++lineNumber, row, sourceRowIndex++));
                }
                chunks.Add(new ConflictDisplayChunk(conflict, rows));
            }
        }
        return chunks;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            var result = await GitBranchService.SaveResolvedConflictAsync(RepositoryPath, ConflictPath, _result, _fingerprint, _lineEnding, _hasUtf8Bom);
            if (!result.Success)
            {
                Snackbar.Add(result.Message, Severity.Error);
                return;
            }
            Snackbar.Add(L.T("Conflict resolved and staged."), Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        finally { _saving = false; }
    }

    private void Close() => MudDialog.Close();

    private static List<ConflictChunkBase> ParseConflictChunks(string content)
    {
        var hasTrailingNewline = content.EndsWith('\n') || content.EndsWith('\r');
        var lines = content.Split('\n').Select(line => line.TrimEnd('\r')).ToArray();
        if (hasTrailingNewline && lines.Length > 0 && lines[^1].Length == 0)
            lines = lines[..^1];
        var chunks = new List<ConflictChunkBase>();
        var context = new List<string>();
        for (var i = 0; i < lines.Length;)
        {
            if (!lines[i].StartsWith("<<<<<<<", StringComparison.Ordinal))
            {
                context.Add(lines[i++]);
                continue;
            }

            if (context.Count > 0) { chunks.Add(new ContextChunk(context)); context = []; }
            i++;
            var left = new List<string>();
            while (i < lines.Length && !lines[i].StartsWith("|||||||", StringComparison.Ordinal) && !lines[i].StartsWith("=======", StringComparison.Ordinal))
                left.Add(lines[i++]);
            if (i < lines.Length && lines[i].StartsWith("|||||||", StringComparison.Ordinal))
            {
                while (i < lines.Length && !lines[i].StartsWith("=======", StringComparison.Ordinal)) i++;
            }
            if (i < lines.Length && lines[i].StartsWith("=======", StringComparison.Ordinal)) i++;
            var right = new List<string>();
            while (i < lines.Length && !lines[i].StartsWith(">>>>>>>", StringComparison.Ordinal)) right.Add(lines[i++]);
            if (i < lines.Length) i++;
            var conflictChunk = new ConflictChunk([]);
            conflictChunk.Rows.AddRange(AlignLines(string.Join("\n", left), string.Join("\n", right), conflictChunk));
            chunks.Add(conflictChunk);
        }
        if (context.Count > 0) chunks.Add(new ContextChunk(context));
        return chunks;
    }

    private static List<ConflictLine> AlignLines(string left, string right, ConflictChunk? owner = null)
    {
        var leftLines = SplitLines(left);
        var rightLines = SplitLines(right);
        var chunk = owner ?? new ConflictChunk([]);
        if ((long)leftLines.Length * rightLines.Length > 1_000_000)
        {
            var fallback = new List<ConflictLine>(Math.Max(leftLines.Length, rightLines.Length));
            for (var i = 0; i < Math.Max(leftLines.Length, rightLines.Length); i++)
                fallback.Add(new ConflictLine(i < leftLines.Length ? leftLines[i] : null, i < rightLines.Length ? rightLines[i] : null, chunk));
            return AlignChangedRows(fallback);
        }

        var lengths = new int[leftLines.Length + 1, rightLines.Length + 1];
        for (var i = leftLines.Length - 1; i >= 0; i--)
            for (var j = rightLines.Length - 1; j >= 0; j--)
                lengths[i, j] = leftLines[i] == rightLines[j]
                    ? lengths[i + 1, j + 1] + 1
                    : Math.Max(lengths[i + 1, j], lengths[i, j + 1]);

        var rows = new List<ConflictLine>();
        var leftIndex = 0;
        var rightIndex = 0;
        while (leftIndex < leftLines.Length || rightIndex < rightLines.Length)
        {
            if (leftIndex < leftLines.Length && rightIndex < rightLines.Length && leftLines[leftIndex] == rightLines[rightIndex])
            {
                rows.Add(new ConflictLine(leftLines[leftIndex++], rightLines[rightIndex++], chunk, requiresSelection: false, selection: false));
            }
            else if (leftIndex < leftLines.Length && (rightIndex >= rightLines.Length || lengths[leftIndex + 1, rightIndex] >= lengths[leftIndex, rightIndex + 1]))
            {
                rows.Add(new ConflictLine(leftLines[leftIndex++], null, chunk));
            }
            else
            {
                rows.Add(new ConflictLine(null, rightLines[rightIndex++], chunk));
            }
        }
        return AlignChangedRows(rows);
    }

    private static List<ConflictLine> AlignChangedRows(List<ConflictLine> rows)
    {
        var alignedRows = new List<ConflictLine>(rows.Count);
        for (var index = 0; index < rows.Count;)
        {
            if (!rows[index].RequiresSelection)
            {
                alignedRows.Add(rows[index++]);
                continue;
            }

            var changedRows = new List<ConflictLine>();
            while (index < rows.Count && rows[index].RequiresSelection)
                changedRows.Add(rows[index++]);
            var leftChanges = changedRows.Where(row => row.LeftLine is not null).Select(row => row.LeftLine).ToArray();
            var rightChanges = changedRows.Where(row => row.RightLine is not null).Select(row => row.RightLine).ToArray();
            for (var changeIndex = 0; changeIndex < Math.Max(leftChanges.Length, rightChanges.Length); changeIndex++)
                alignedRows.Add(new ConflictLine(
                    changeIndex < leftChanges.Length ? leftChanges[changeIndex] : null,
                    changeIndex < rightChanges.Length ? rightChanges[changeIndex] : null,
                    changedRows[0].Chunk));
        }
        return alignedRows;
    }

    private abstract record ConflictChunkBase;
    private sealed record ContextChunk(IReadOnlyList<string> Lines) : ConflictChunkBase;
    private sealed record ConflictChunk(List<ConflictLine> Rows) : ConflictChunkBase;
    private sealed class ConflictLine(string? leftLine, string? rightLine, ConflictChunk chunk, bool requiresSelection = true, bool? selection = null)
    {
        public string? LeftLine { get; } = leftLine;
        public string? RightLine { get; } = rightLine;
        public ConflictChunk Chunk { get; } = chunk;
        public bool RequiresSelection { get; } = requiresSelection;
        public bool? Selection { get; set; } = selection;
    }

    private sealed record ConflictDisplayRow(string? Text, int? LineNumber, ConflictLine? Conflict, int SourceRowIndex);
    private sealed record ConflictDisplayChunk(ConflictChunk? Conflict, IReadOnlyList<ConflictDisplayRow> Rows);
    private sealed record ConflictResultRow(string Text, string Kind, int LineNumber, int? SourceRowIndex, bool IsConflictLine = false, ConflictChunk? ConflictChunk = null);
}
