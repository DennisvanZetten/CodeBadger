@inherits LayoutComponentBase
@implements IDisposable
@inject LauncherSettingsService SettingsService
@inject LocalizationService L
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject StartupDetectionService StartupDetection
@inject OpenCodeActivityService OpenCodeActivity
@inject AgentUpdateService AgentUpdates
@inject WindowTitleBarService WindowTitleBar
@inject RepositoryDetachedWindowService DetachedWindows
@inject NavigationManager Navigation
@inject ILogger<MainLayout> Logger
@using CodeBadger.Components.Pages

<MudThemeProvider Theme="@_theme.Theme" IsDarkMode="@_theme.IsDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
@if (_isStarting && !IsDocumentationWindowRoute())
{
    <div class="startup-splash" role="status" aria-live="polite">
        <div class="startup-logo-halo">
            <img class="startup-logo" src="codebadger.svg" alt="CodeBadger" />
        </div>
        <MudText Typo="Typo.h5">CodeBadger</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L.T(_startupStage)</MudText>
        <MudProgressLinear Value="_startupProgress" Color="Color.Primary" Rounded="true" />
        <MudText Typo="Typo.caption" Color="Color.Secondary">@((int)_startupProgress)%</MudText>
        @{
            var warningText = _startupWarning ?? StartupDetection.OpenCodeHealth.Warning;
        }
        @if (warningText is not null)
        {
            <MudPaper Class="ma-4 pa-4" Outlined="true" Elevation="0" Style="max-width: 52rem;">
                <MudStack Spacing="2">
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                        <MudText Typo="Typo.subtitle1">@L.T("OpenCode installation conflict")</MudText>
                        <MudText Typo="Typo.body2">@L.T(warningText)</MudText>
                    </MudAlert>
                    @foreach (var instance in StartupDetection.OpenCodeHealth.Instances)
                    {
                        <MudPaper Class="pa-2" Outlined="true" Elevation="0">
                            <MudText Typo="Typo.body2">
                                <strong>@(instance.IsWorking ? L.T("Working instance") : L.T("Not responding"))</strong>
                                @if (instance.IsSelected)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">@L.T("Used by CodeBadger")</MudChip>
                                }
                            </MudText>
                            @if (instance.NodeVersion is { } nodeVersion)
                            {
                                <MudText Typo="Typo.caption">@L.T("NVM Node version: {0}", nodeVersion)</MudText>
                            }
                            <MudText Typo="Typo.caption">@L.T("Version {0} · installed with {1}", instance.Version ?? "?", instance.InstallMethod)</MudText>
                            <MudText Typo="Typo.caption" Style="overflow-wrap:anywhere">@instance.ExecutablePath</MudText>
                            @if (!instance.IsWorking && !string.IsNullOrWhiteSpace(instance.Failure))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Error">@instance.Failure</MudText>
                            }
                        </MudPaper>
                    }
                    <MudText Typo="Typo.body2">@L.T("CodeBadger uses the PATH-selected executable and probes only the managed OpenCode service once at startup. A failed database health check disables activity polling; OpenCode CLI sessions may continue independently, but activity indicators and Slack completion detection will not work.")</MudText>
                    @if (StartupDetection.OpenCodeHealth.ServiceHealthy)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="RecheckOpenCodeActivityAsync">@L.T("Try OpenCode activity check again")</MudButton>
                    }
                    <MudText Typo="Typo.body2">@L.T("Existing sessions and history remain in the shared OpenCode data directory, but sessions may not appear if the selected installation uses a different data directory. Avoid uninstalling or deleting OpenCode data until you have backed it up.")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L.T("To resolve the conflict, choose one installation method, keep its command first on PATH, and update or uninstall the other using that same package manager. NVM/nvm4w installations are linked to a Node version; global packages may exist separately in each Node version.")</MudText>
                </MudStack>
            </MudPaper>
        }
    </div>
}
else
{
    <MudLayout>
        @if (!WindowTitleBar.UsesNativeTitleBar)
        {
            <MudAppBar Elevation="0" Color="Color.Surface" Dense="true">
                <img class="appbar-logo mr-3" src="codebadger.svg" alt="CodeBadger" />
                <MudText Typo="Typo.h6">CodeBadger</MudText>
                <MudSpacer />
                <MudBadge Dot="true" Visible="@AgentUpdates.HasUpdates" Color="Color.Warning" Class="settings-update-badge" Overlap="true" Origin="Origin.TopRight">
                    <MudIconButton Class="appbar-action-button" Icon="@Icons.Material.Filled.Settings" Color="Color.Default" Size="Size.Small"
                                    aria-label="@L.T("Open settings")" OnClick="OpenSettingsAsync" />
                </MudBadge>
                <MudTooltip Text="@L.T("Ideas and tasks")">
                    <MudIconButton Class="appbar-action-button" Icon="@Icons.Material.Filled.Checklist" Color="Color.Default" Size="Size.Small"
                                   aria-label="@L.T("Ideas and tasks")" title="@L.T("Ideas and tasks")" OnClick="OpenIdeasAsync" />
                </MudTooltip>
                <MudTooltip Text="@L.T("Help menu")">
                    <MudIconButton Class="appbar-action-button help-menu-trigger" Icon="@Icons.Material.Filled.HelpOutline" Color="Color.Default" Size="Size.Small"
                                   aria-label="@L.T("Help menu")" title="@L.T("Help menu")" OnClick="OpenHelpMenuAsync" />
                </MudTooltip>
            </MudAppBar>
        }
        <MudMainContent Class="@(WindowTitleBar.UsesNativeTitleBar ? "native-titlebar-content" : null)"
                        Style="@(WindowTitleBar.UsesNativeTitleBar ? "padding-top: 0;" : null)">
            <CascadingValue Value="_startupSettings" IsFixed="true">
                @Body
            </CascadingValue>
        </MudMainContent>
    </MudLayout>
}

@code {
    private string? _appliedLanguage;
    private string? _appliedTheme;
    private LauncherTheme _theme = LauncherThemes.Get(null);
    private LauncherSettings? _startupSettings;
    private bool _isStarting = true;
    private string _startupStage = "Detecting OpenCode...";
    private double _startupProgress;
    private string? _startupWarning;
    private IDialogReference? _activeDialog;
    private AppDialog? _activeDialogKind;
    private int _dialogGeneration;

    private enum AppDialog
    {
        Settings,
        Ideas,
        Help
    }

    protected override async Task OnInitializedAsync()
    {
        L.LanguageChanged += HandleLanguageChanged;
        SettingsService.SettingsSaved += HandleSettingsSaved;
        AgentUpdates.UpdatesChanged += HandleAgentUpdatesChanged;
        StartupDetection.OpenCodeStartupHealthChanged += HandleOpenCodeStartupHealthChanged;
        if (IsMainWindowRoute())
            WindowTitleBar.SetSettingsState(false, L.T("Open settings"));
    }

    private void HandleSettingsRequested() => _ = InvokeAsync(OpenSettingsAsync);
    private void HandleHelpRequested() => _ = InvokeAsync(OpenHelpMenuAsync);
    private void HandleIdeasRequested() => _ = InvokeAsync(OpenIdeasAsync);
    private void HandleAgentUpdatesChanged() => _ = InvokeAsync(() =>
    {
        WindowTitleBar.SetAgentUpdateAvailable(AgentUpdates.HasUpdates);
        StateHasChanged();
    });
    private void HandleOpenCodeStartupHealthChanged(OpenCodeStartupHealth health) => _ = InvokeAsync(async () =>
    {
        StateHasChanged();
        await Task.Yield();
    });

    protected override void OnInitialized()
    {
        if (IsDocumentationWindowRoute())
            _isStarting = false;
    }

    protected override void OnParametersSet()
    {
        WindowTitleBar.SettingsRequested -= HandleSettingsRequested;
        WindowTitleBar.HelpRequested -= HandleHelpRequested;
        WindowTitleBar.IdeasRequested -= HandleIdeasRequested;
        WindowTitleBar.SetHelpDescription(L.T("Help menu"));
        WindowTitleBar.SetIdeasDescription(L.T("Ideas and tasks"));
        if (IsMainWindowRoute())
        {
            WindowTitleBar.SettingsRequested += HandleSettingsRequested;
            WindowTitleBar.HelpRequested += HandleHelpRequested;
            WindowTitleBar.IdeasRequested += HandleIdeasRequested;
        }
    }

    private bool IsMainWindowRoute() => !IsDetachedRepositoryRoute() && !IsDocumentationWindowRoute() && !IsShareViewerRoute();

    private bool IsDetachedRepositoryRoute() =>
        Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("repository/", StringComparison.OrdinalIgnoreCase);

    private bool IsShareViewerRoute() =>
        Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("s/", StringComparison.OrdinalIgnoreCase);

    private void HandleLanguageChanged() => _ = InvokeAsync(() =>
    {
        if (IsMainWindowRoute())
            WindowTitleBar.SetSettingsState(!_isStarting, L.T("Open settings"));
        WindowTitleBar.SetHelpDescription(L.T("Help menu"));
        WindowTitleBar.SetIdeasDescription(L.T("Ideas and tasks"));
        StateHasChanged();
    });

    private void HandleSettingsSaved() => _ = InvokeAsync(async () =>
    {
        var settings = await SettingsService.LoadAsync();
        _theme = LauncherThemes.Get(settings.Theme);
        WindowTitleBar.ApplyTheme(_theme);
        Snackbar.Configuration.VisibleStateDuration = settings.ToastDurationSeconds * 1000;
        StateHasChanged();
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && IsMainWindowRoute())
            WindowTitleBar.SetSettingsState(!_isStarting || StartupDetection.OpenCodeHealth.Warning is not null, L.T("Open settings"));
        if (firstRender && IsMainWindowRoute() && _isStarting)
            _ = PrepareStartupOpenCodeWarningAsync();
        if (firstRender && IsDocumentationWindowRoute())
            await InitializeDocumentationWindowAsync();
        else if (firstRender && _isStarting)
        {
            if (IsDetachedRepositoryRoute())
                await InitializeDetachedWindowAsync();
            else
                await RunStartupDetectionAsync();
        }

        if (_appliedLanguage != L.CurrentLanguage)
        {
            _appliedLanguage = L.CurrentLanguage;
            await ApplyLanguageToDocumentAsync();
        }
        if (_appliedTheme != _theme.Id)
        {
            try
            {
                await JS.InvokeVoidAsync("codeBadger.setTheme", _theme.Id, _theme.IsDark,
                    _theme.TerminalBackground, _theme.TerminalForeground, _theme.TerminalCursor, _theme.TerminalSelection);
                _appliedTheme = _theme.Id;
            }
            catch (JSException)
            {
                // Theme selection must never prevent the main page from rendering.
            }
        }
    }

    private async Task PrepareStartupOpenCodeWarningAsync()
    {
        try
        {
            await StartupDetection.DetectOpenCodeInstancesAsync(CancellationToken.None, force: true);
            _startupWarning = StartupDetection.OpenCodeHealth.Warning;
            if (_startupWarning is not null)
                await InvokeAsync(StateHasChanged);
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Could not check OpenCode instances during startup.");
        }
        _startupWarning ??= StartupDetection.OpenCodeHealth.Warning;
        await InvokeAsync(StateHasChanged);
        if (_startupWarning is not null && IsMainWindowRoute())
            WindowTitleBar.SetSettingsState(true, L.T("Open settings"));
    }

    private async Task RecheckOpenCodeActivityAsync()
    {
        StartupDetection.RecheckOpenCodeActivityEndpoint();
        try
        {
            if (!await StartupDetection.RecheckOpenCodeActivityAsync(CancellationToken.None))
                throw new InvalidOperationException("OpenCode service health check failed.");
            var activity = await OpenCodeActivity.GetActivityAsync(CancellationToken.None);
            if (activity is not null && activity.Sessions.Count > 0)
            {
                OpenCodeExecutableLocator.SetHealthCheckResult(StartupDetection.OpenCodeHealth.SelectedExecutablePath);
                StartupDetection.RefreshOpenCodeStartupWarning(null);
                _startupWarning = null;
            }
            else
            {
                StartupDetection.RefreshOpenCodeStartupWarning("OpenCode activity check did not find a session response. Polling stays disabled until a session is visible.");
            }
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Manual OpenCode activity health check failed.");
            StartupDetection.RefreshOpenCodeStartupWarning("The OpenCode activity check failed again; activity polling remains disabled.");
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task InitializeDetachedWindowAsync()
    {
        var settings = await SettingsService.LoadAsync();
        _startupSettings = settings;
        _theme = LauncherThemes.Get(settings.Theme);
        WindowTitleBar.ApplyTheme(_theme);
        Snackbar.Configuration.VisibleStateDuration = settings.ToastDurationSeconds * 1000;
        _isStarting = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task InitializeDocumentationWindowAsync()
    {
        var settings = await SettingsService.LoadAsync();
        _startupSettings = settings;
        _theme = LauncherThemes.Get(settings.Theme);
        WindowTitleBar.ApplyTheme(_theme);
        Snackbar.Configuration.VisibleStateDuration = settings.ToastDurationSeconds * 1000;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RunStartupDetectionAsync()
    {
        try
        {
            Logger.LogInformation("CodeBadger startup initialization started.");
            var settings = await SettingsService.LoadAsync();
            _startupSettings = settings;
            _theme = LauncherThemes.Get(settings.Theme);
            WindowTitleBar.ApplyTheme(_theme);
            Snackbar.Configuration.VisibleStateDuration = settings.ToastDurationSeconds * 1000;

            if (!settings.Repositories.Any(repository => repository.IsActive))
            {
                // With nothing to load, show Home immediately while agent detection continues.
                _isStarting = false;
                WindowTitleBar.SetSettingsState(true, L.T("Open settings"));
            }

            await InvokeAsync(StateHasChanged);
            await Task.Yield();
            await StartupDetection.DetectAsync(settings, async (stage, progress) =>
            {
                _startupStage = stage;
                _startupProgress = progress;
                _startupWarning = StartupDetection.OpenCodeHealth.Warning;
                await InvokeAsync(StateHasChanged);
                await Task.Yield();
            });
            _startupWarning = StartupDetection.OpenCodeHealth.Warning;
            Logger.LogInformation("CodeBadger startup initialization completed.");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "CodeBadger startup initialization failed.");
            throw;
        }
        finally
        {
            _isStarting = false;
            _startupWarning = StartupDetection.OpenCodeHealth.Warning;
            WindowTitleBar.SetSettingsState(true, L.T("Open settings"));
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ApplyLanguageToDocumentAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("codeBadger.setLanguage", L.CurrentLanguage, L.GetBootstrapTranslations());
        }
        catch (JSException)
        {
            // Language selection must never prevent the main page from rendering.
        }
    }

    private async Task OpenSettingsAsync()
    {
        var generation = BeginDialog(AppDialog.Settings);
        if (generation is null)
            return;

        var settings = await SettingsService.LoadAsync();
        if (generation != _dialogGeneration)
            return;

        var parameters = new DialogParameters<SettingsDialog>
        {
            { dialog => dialog.Settings, settings }
        };
        var options = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Large, CloseButton = true };
        var dialog = await DialogService.ShowAsync<SettingsDialog>(L.T("Settings"), parameters, options);
        if (!SetActiveDialog(generation.Value, dialog))
            return;

        var result = await dialog.Result;
        ClearActiveDialog(dialog);
        if (result is { Canceled: false, Data: true })
        {
            _appliedLanguage = null;
            await InvokeAsync(StateHasChanged);
            await ApplyLanguageToDocumentAsync();
        }
    }

    private async Task OpenHelpMenuAsync()
    {
        var showAbout = false;
        while (true)
        {
            var generation = BeginDialog(AppDialog.Help);
            if (generation is null)
                return;

            IDialogReference dialog = showAbout
                ? await DialogService.ShowAsync<About>(L.T("About CodeBadger"),
                    options: new DialogOptions { CloseButton = true, CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true })
                : await DialogService.ShowAsync<HelpMenuDialog>(L.T("Help menu"),
                    options: new DialogOptions { CloseButton = true, CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });

            if (!SetActiveDialog(generation.Value, dialog))
                return;

            var result = await dialog.Result;
            ClearActiveDialog(dialog);
            if (result is not { Canceled: false, Data: string destination })
                return;

            if (!showAbout && destination == "about")
            {
                showAbout = true;
                continue;
            }

            if (showAbout && destination == "back")
            {
                showAbout = false;
                continue;
            }

            if (!showAbout && destination == "manual")
            {
                if (WindowTitleBar.UsesNativeTitleBar)
                    DetachedWindows.OpenManualWindow();
                else
                    Navigation.NavigateTo("/manual");
            }
            else if (!showAbout && destination == "logs")
            {
                if (WindowTitleBar.UsesNativeTitleBar)
                    DetachedWindows.OpenLogsWindow();
                else
                    Navigation.NavigateTo("/logs");
            }
            return;
        }
    }

    private async Task OpenIdeasAsync()
    {
        var generation = BeginDialog(AppDialog.Ideas);
        if (generation is null)
            return;

        var dialog = await DialogService.ShowAsync<IdeaListDialog>(L.T("Ideas and tasks"),
            options: new DialogOptions { CloseButton = true, CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (!SetActiveDialog(generation.Value, dialog))
            return;

        await dialog.Result;
        ClearActiveDialog(dialog);
    }

    private int? BeginDialog(AppDialog kind)
    {
        if (_activeDialogKind == kind)
        {
            _dialogGeneration++;
            _activeDialog?.Close();
            _activeDialog = null;
            _activeDialogKind = null;
            return null;
        }

        _dialogGeneration++;
        _activeDialog?.Close();
        _activeDialog = null;
        _activeDialogKind = kind;
        return _dialogGeneration;
    }

    private bool SetActiveDialog(int generation, IDialogReference dialog)
    {
        if (generation != _dialogGeneration)
        {
            dialog.Close();
            return false;
        }

        _activeDialog = dialog;
        return true;
    }

    private void ClearActiveDialog(IDialogReference dialog)
    {
        if (!ReferenceEquals(_activeDialog, dialog))
            return;

        _activeDialog = null;
        _activeDialogKind = null;
        _dialogGeneration++;
    }

    private bool IsDocumentationWindowRoute() =>
        GetCurrentRoutePath() is var route && (route.Equals("manual", StringComparison.OrdinalIgnoreCase) ||
                                               route.Equals("logs", StringComparison.OrdinalIgnoreCase));

    private string GetCurrentRoutePath() => Navigation.ToBaseRelativePath(Navigation.Uri)
        .TrimStart('/')
        .Split('?', '#')[0];

    public void Dispose()
    {
        L.LanguageChanged -= HandleLanguageChanged;
        SettingsService.SettingsSaved -= HandleSettingsSaved;
        AgentUpdates.UpdatesChanged -= HandleAgentUpdatesChanged;
        StartupDetection.OpenCodeStartupHealthChanged -= HandleOpenCodeStartupHealthChanged;
        WindowTitleBar.SettingsRequested -= HandleSettingsRequested;
        WindowTitleBar.HelpRequested -= HandleHelpRequested;
        WindowTitleBar.IdeasRequested -= HandleIdeasRequested;
    }
}
