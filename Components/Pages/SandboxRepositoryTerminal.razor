@implements IAsyncDisposable
@inject WindowsSandboxSessionService Sessions
@inject SandboxOpenCodeProviderService Providers
@inject SandboxNetworkBroker Broker
@inject SandboxApprovalService Approvals
@inject IDialogService Dialogs
@inject IJSRuntime JS
@inject LocalizationService L

<MudStack Spacing="0" Class="sandbox-terminal-layout">
    @if (_busy)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" role="status" aria-live="polite">
            <MudIcon Icon="@Icons.Material.Filled.HourglassTop" Color="Color.Warning" />
            <MudText>@L.T(_stage)</MudText>
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        </MudStack>
    }
    @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
    @if (!_started && Sessions.GetChanges(RepositoryId, RepositoryPath).Count > 0)
    {
        <MudButton Color="Color.Warning" Disabled="@_busy" OnClick="DiscardAsync">@L.T("Discard captured sandbox changes")</MudButton>
    }
    <div class="repository-terminal" @ref="_element"></div>
</MudStack>

@code {
    [Parameter] public Guid RepositoryId { get; set; }
    [Parameter] public string RepositoryPath { get; set; } = string.Empty;
    [Parameter] public string RepositoryName { get; set; } = string.Empty;
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string ModelReference { get; set; } = "bonzai/gpt-6-luna";
    [Parameter] public string ReviewedFiles { get; set; } = string.Empty;
    private bool _busy = true;
    private string _stage = "Preparing sandbox terminal...";
    private bool _started;
    private bool _disposed;
    private string? _error;
    private ElementReference _element;
    private DotNetObjectReference<SandboxRepositoryTerminal>? _reference;
    private IJSObjectReference? _module;

    protected override void OnInitialized()
    {
        Sessions.OutputReceived += Output;
        Sessions.StateChanged += State;
        Sessions.ProviderFailed += ProviderFailure;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./terminal.js");
                _reference = DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync("create", RepositoryId.ToString(), _element, _reference);
                await _module.InvokeVoidAsync("setVisible", RepositoryId.ToString(), IsVisible);
                if (!_disposed) await StartAsync();
            }
            catch (Exception exception) { _error = exception.Message; _busy = false; }
            if (!_disposed) await InvokeAsync(StateHasChanged);
        }
        if (_module is not null) await _module.InvokeVoidAsync("setVisible", RepositoryId.ToString(), IsVisible);
    }

    private async Task StartAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            _stage = "Detecting OpenCode...";
            await InvokeAsync(StateHasChanged);
            string executable = OpenCodeExecutableLocator.Find();
            _stage = "Loading sandbox startup model...";
            await InvokeAsync(StateHasChanged);
            var provider = await Providers.ResolveAsync(RepositoryPath, ModelReference);
            if (_disposed) return;
            var files = ReviewedFiles.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            _stage = "Copying reviewed files and starting isolated OpenCode...";
            await InvokeAsync(StateHasChanged);
            await Sessions.StartOpenCodeAsync(RepositoryId, RepositoryPath, executable, files, provider.Endpoint,
                provider.Model, provider.ApiKey, Broker, Approvals);
            if (_disposed) { await Sessions.StopAsync(RepositoryId); return; }
            _started = true;
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _busy = false; }
    }

    private async Task StopAndReviewAsync()
    {
        _busy = true;
        _stage = "Stopping sandbox and capturing changes...";
        try
        {
            await Sessions.StopAsync(RepositoryId);
            _started = false;
            var dialog = await Dialogs.ShowAsync<SandboxChangesDialog>(L.T("Review sandbox changes"),
                new DialogParameters<SandboxChangesDialog>
                {
                    { component => component.RepositoryName, RepositoryName },
                    { component => component.RepositoryPath, RepositoryPath },
                    { component => component.Changes, Sessions.GetChanges(RepositoryId, RepositoryPath) }
                }, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Large, CloseButton = true });
            await dialog.Result;
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _busy = false; }
    }

    private async Task DiscardAsync()
    {
        if (await Dialogs.ShowMessageBoxAsync(L.T("Discard captured sandbox changes"),
            L.T("Discard the captured changes? They will no longer be available for review."),
            yesText: L.T("Discard"), cancelText: L.T("Cancel")) == true)
            await Sessions.DiscardReviewAsync(RepositoryId);
    }

    [JSInvokable] public Task SendInput(string input) => Sessions.WriteInputAsync(RepositoryId, input);
    [JSInvokable] public void Resize(int columns, int rows) => Sessions.Resize(RepositoryId, columns, rows);

    private void Output(Guid id, string text)
    {
        if (id == RepositoryId && !_disposed) _ = InvokeAsync(async () =>
        {
            if (_module is not null) await _module.InvokeVoidAsync("write", RepositoryId.ToString(), text);
        });
    }
    private void State(Guid id)
    {
        if (id == RepositoryId && !_disposed) _ = InvokeAsync(() => { _started = Sessions.IsRunning(id); StateHasChanged(); });
    }
    private void ProviderFailure(Guid id, string message)
    {
        if (id == RepositoryId && !_disposed) _ = InvokeAsync(() => { _error = message; StateHasChanged(); });
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Sessions.OutputReceived -= Output;
        Sessions.StateChanged -= State;
        Sessions.ProviderFailed -= ProviderFailure;
        try { await Sessions.StopAsync(RepositoryId); }
        finally
        {
            if (_module is not null)
            {
                try { await _module.InvokeVoidAsync("dispose", RepositoryId.ToString()); await _module.DisposeAsync(); } catch (JSException) { }
            }
            _reference?.Dispose();
        }
    }
}
