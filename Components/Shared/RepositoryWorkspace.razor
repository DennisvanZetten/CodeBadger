    private static readonly (string Command, string Description)[] TerminalCommands =
    [
        ("/help", "Show this command list"),
        ("/model", "Change the model for the active role"),
        ("/plan", "Switch to Plan mode; add a task to ask for a plan"),
        ("/build", "Switch to Build mode; add a task to implement it"),
        ("/ask", "Ask a question without requesting code changes"),
        ("/explain", "Explain a topic without changing files"),
        ("/fix", "Fix a specific problem in the repository"),
        ("/review", "Review current repository changes"),
        ("/test", "Identify and run relevant tests"),
        ("/commit", "Review changes and suggest a commit message"),
        ("/clear", "Clear this CodeBadger session")
    ];

    private IReadOnlyList<(string Command, string Description)> GetAvailableTerminalCommands() =>
        AgentTools.Normalize(Repository.AgentTool) == AgentTools.OpenCode
            ? TerminalCommands.Where(command => command.Command != "/commit" || !Repository.OpenCodeSandboxEnabled).ToArray()
            : TerminalCommands.Where(command => command.Command is not ("/model" or "/commit")).ToArray();

    private IReadOnlyList<OpenCodeActivityService.AvailableModel> GetTerminalModelOptions(CodeBadgerTerminalSession session, string query) =>
        _availableOpenCodeModels
            .Where(model => model.Enabled && model.Status == "active" &&
                (query.Length == 0 || model.Name.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                 model.Reference.Contains(query, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(model =>
            {
                var index = session.State.RecentModels.FindIndex(reference =>
                    string.Equals(reference, model.Reference, StringComparison.OrdinalIgnoreCase));
                return index >= 0 ? index : int.MaxValue;
            })
            .ThenBy(model => model.Reference, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private async Task ShowTerminalHelpAsync(CodeBadgerTerminalSession session)
    {
        session.Messages.RemoveAll(message => message.IsCommandHelp);
        session.Messages.Add(new CodeBadgerTerminalMessage
        {
            Role = "assistant",
            IsCodeBadgerMessage = true,
            IsCommandHelp = true
        });
        await PersistTerminalStateAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenTerminalModelPickerAsync(CodeBadgerTerminalSession session)
    {
        if (AgentTools.Normalize(Repository.AgentTool) != AgentTools.OpenCode)
        {
            Snackbar.Add(L.T("Model switching is currently available for OpenCode only."), Severity.Info);
            return;
        }

        try
        {
            _availableOpenCodeModels = await OpenCodeActivity.GetAvailableModelsAsync(Repository.Path, CancellationToken.None);
            if (!_availableOpenCodeModels.Any(model => model.Enabled && model.Status == "active"))
            {
                Snackbar.Add(L.T("No active OpenCode models are available."), Severity.Warning);
                return;
            }

            session.Messages.Add(new CodeBadgerTerminalMessage
            {
                Role = "assistant",
                IsCodeBadgerMessage = true,
                IsModelPicker = true
            });
            session.Input = string.Empty;
            await PersistTerminalStateAsync();
            await InvokeAsync(StateHasChanged);
            if (_composerModule is not null)
                await _composerModule.InvokeVoidAsync("clear", _terminalStack, session.Id.ToString());
        }
        catch (Exception exception)
        {
            Snackbar.Add(L.T("Could not load OpenCode models: {0}", exception.Message), Severity.Error);
        }
    }

    private bool IsCurrentTerminalModel(CodeBadgerTerminalSession session, string modelReference)
    {
        var role = GetModelSelectionRole(session);
        var key = CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode) == CodeBadgerOrchestrationModes.SingleAgent
            ? "SingleAgent" : role;
        if (session.State.RoleModelOverrides.TryGetValue(key, out var selected) ||
            session.State.AgentContextModels.TryGetValue(key, out selected))
            return string.Equals(selected, modelReference, StringComparison.OrdinalIgnoreCase);

        var preferred = !string.IsNullOrWhiteSpace(_settings.CodeBadgerTerminalModel)
            ? _settings.CodeBadgerTerminalModel : _agentModelReference;
        if (string.IsNullOrWhiteSpace(preferred))
        {
            var preferences = GetAgentPreferences(Repository.AgentTool);
            preferred = CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode) switch
            {
                CodeBadgerOrchestrationModes.SingleAgent => preferences.SingleAgentPreferredModels.FirstOrDefault(),
                CodeBadgerOrchestrationModes.PlanBuild when role == CodeBadgerRoles.Planner => preferences.PlanPreferredModels.FirstOrDefault(),
                CodeBadgerOrchestrationModes.PlanBuild when role == CodeBadgerRoles.Worker => preferences.BuildPreferredModels.FirstOrDefault(),
                _ => preferences.RolePreferences.FirstOrDefault(item => item.Role == role)?.PreferredModels.FirstOrDefault()
            };
        }
        return string.Equals(preferred, modelReference, StringComparison.OrdinalIgnoreCase);
    }

    private async Task HandleHelpCommandAsync(CodeBadgerTerminalSession session, string command)
    {
        if (command == "/help")
        {
            await ShowTerminalHelpAsync(session);
            return;
        }
        if (command == "/model")
        {
            await OpenTerminalModelPickerAsync(session);
            return;
        }
        session.Input = command + " ";
        await InvokeAsync(StateHasChanged);
    }

    private async Task SelectTerminalModelAsync(CodeBadgerTerminalSession session, string modelReference)
    {
        if (AgentTools.Normalize(Repository.AgentTool) != AgentTools.OpenCode)
            return;

        if (_availableOpenCodeModels.Count == 0)
            _availableOpenCodeModels = await OpenCodeActivity.GetAvailableModelsAsync(Repository.Path, CancellationToken.None);

        var model = _availableOpenCodeModels.FirstOrDefault(candidate => candidate.Enabled && candidate.Status == "active" &&
            string.Equals(candidate.Reference, modelReference, StringComparison.OrdinalIgnoreCase));
        if (model is null)
        {
            Snackbar.Add(L.T("That OpenCode model is no longer available."), Severity.Warning);
            return;
        }

        var role = GetModelSelectionRole(session);
        var orchestrationMode = CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode);
        var roleOverrideKey = orchestrationMode == CodeBadgerOrchestrationModes.SingleAgent ? "SingleAgent" : role;
        var sessionKey = orchestrationMode == CodeBadgerOrchestrationModes.SingleAgent ? "SingleAgent" : role;
        var modelStateKey = orchestrationMode == CodeBadgerOrchestrationModes.SingleAgent ? "Model:SingleAgent" : "Model:" + role;
        try
        {
            if (session.State.AgentSessionIds.TryGetValue(sessionKey, out var agentSessionId))
            {
                await OpenCodeActivity.SwitchModelAsync(agentSessionId, Repository.Path, model.Reference, CancellationToken.None);
                session.State.AgentSessionIds[modelStateKey] = model.Reference;
                session.State.AgentContextModels[sessionKey] = model.Reference;
            }
        }
        catch (Exception exception)
        {
            Snackbar.Add(L.T("Could not switch the OpenCode model: {0}", exception.Message), Severity.Error);
            return;
        }

        session.State.RoleModelOverrides[roleOverrideKey] = model.Reference;
        RememberTerminalModel(session, model.Reference);
        session.Messages.Add(new CodeBadgerTerminalMessage
        {
            Role = "assistant",
            IsCodeBadgerMessage = true,
            Text = L.T("Model for {0} changed to {1}.", RoleDisplayName(role), model.Name)
        });

        session.Input = string.Empty;
        await PersistTerminalStateAsync();
        await InvokeAsync(StateHasChanged);
        if (_composerModule is not null)
            await _composerModule.InvokeVoidAsync("clear", _terminalStack, session.Id.ToString());
    }

    private string GetModelSelectionRole(CodeBadgerTerminalSession session)
    {
        if (CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode) == CodeBadgerOrchestrationModes.Full &&
            !string.IsNullOrWhiteSpace(session.State.ActiveAgentRole))
            return session.State.ActiveAgentRole;

        if (CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode) == CodeBadgerOrchestrationModes.Full)
            return CodeBadgerRoles.Orchestrator;

        if (CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode) == CodeBadgerOrchestrationModes.SingleAgent)
            return session.Mode == TerminalMode.Plan ? CodeBadgerRoles.Planner : CodeBadgerRoles.Worker;
        if (CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode) == CodeBadgerOrchestrationModes.PlanBuild)
            return session.Mode == TerminalMode.Plan ? CodeBadgerRoles.Planner : CodeBadgerRoles.Worker;
        return CodeBadgerRoles.Orchestrator;
    }

    private static void RememberTerminalModel(CodeBadgerTerminalSession session, string modelReference)
    {
        session.State.RecentModels.RemoveAll(reference => string.Equals(reference, modelReference, StringComparison.OrdinalIgnoreCase));
        session.State.RecentModels.Insert(0, modelReference);
        if (session.State.RecentModels.Count > 12)
            session.State.RecentModels.RemoveRange(12, session.State.RecentModels.Count - 12);
    }

    private async Task AddTerminalSessionAsync()
    {
        var sessionState = new CodeBadgerTerminalSessionState
        {
            Id = Guid.NewGuid(),
            Mode = "Plan"
        };
        _terminalState.Sessions.Add(sessionState);
        var session = new CodeBadgerTerminalSession(sessionState);
        _terminalSessions.Add(session);
        _selectedTerminalSessionId = session.Id;
        _terminalState.SelectedSessionId = session.Id;
        await PersistTerminalStateAsync();
    }

    private Task AddTerminalSession() => AddTerminalSessionAsync();

    private void OpenTerminalSessionContextMenu(Guid sessionId, MouseEventArgs args)
    {
        _terminalContextMenuSessionId = sessionId;
        _terminalContextMenuX = Math.Max(8, args.ClientX);
        _terminalContextMenuY = Math.Max(8, args.ClientY);
    }

    private void CloseTerminalSessionContextMenu() => _terminalContextMenuSessionId = null;

    private async Task CloseAllTerminalSessionsAsync()
    {
        CloseTerminalSessionContextMenu();
        RememberClosedTerminalSessions(_terminalState.Sessions);
        _terminalSessions.Clear();
        _terminalState.Sessions.Clear();
        _terminalState.SelectedSessionId = Guid.Empty;
        await AddTerminalSessionAsync();
    }

    private async Task CloseOtherTerminalSessionsAsync()
    {
        var keepSessionId = _terminalContextMenuSessionId;
        CloseTerminalSessionContextMenu();
        if (keepSessionId is not { } id || !_terminalSessions.Any(session => session.Id == id))
            return;

        var removedStates = _terminalState.Sessions.Where(session => session.Id != id).ToArray();
        RememberClosedTerminalSessions(removedStates);
        _terminalSessions.RemoveAll(session => session.Id != id);
        _terminalState.Sessions.RemoveAll(session => session.Id != id);
        _selectedTerminalSessionId = id;
        _terminalState.SelectedSessionId = id;
        await PersistTerminalStateAsync();
    }

    private void RememberClosedTerminalSessions(IEnumerable<CodeBadgerTerminalSessionState> sessions)
    {
        foreach (var session in sessions)
        {
            _terminalState.RecentlyClosedSessions.RemoveAll(closed => closed.Id == session.Id);
            _terminalState.RecentlyClosedSessions.Insert(0, session);
        }

        const int maxRecentlyClosedSessions = 10;
        if (_terminalState.RecentlyClosedSessions.Count > maxRecentlyClosedSessions)
            _terminalState.RecentlyClosedSessions.RemoveRange(maxRecentlyClosedSessions,
                _terminalState.RecentlyClosedSessions.Count - maxRecentlyClosedSessions);
    }

    private async Task RestoreTerminalSessionAsync(Guid id)
    {
        var closedSession = _terminalState.RecentlyClosedSessions.FirstOrDefault(session => session.Id == id);
        if (closedSession is null)
            return;

        CloseTerminalSessionContextMenu();
        _terminalState.RecentlyClosedSessions.Remove(closedSession);
        _terminalState.Sessions.Add(closedSession);
        var session = new CodeBadgerTerminalSession(closedSession)
        {
            Mode = closedSession.Mode == "Build" ? TerminalMode.Build : TerminalMode.Plan
        };
        _terminalSessions.Add(session);
        _selectedTerminalSessionId = session.Id;
        _terminalState.SelectedSessionId = session.Id;
        await PersistTerminalStateAsync();
    }

    private async Task AddTerminalSessionFromContextMenuAsync()
    {
        CloseTerminalSessionContextMenu();
        await AddTerminalSessionAsync();
    }

    private string GetPreferredOpenCodeSessionId()
    {
        if (_terminalSessions.FirstOrDefault(session => session.Id == _selectedTerminalSessionId) is not { } selected)
            return string.Empty;

        var modeRole = !string.IsNullOrWhiteSpace(selected.State.ActiveAgentRole)
            ? selected.State.ActiveAgentRole
            : selected.Mode == TerminalMode.Plan ? CodeBadgerRoles.Planner : CodeBadgerRoles.Worker;
        var roleKey = GetRoleSessionKey(selected, modeRole);
        if (selected.State.AgentSessionIds.TryGetValue(roleKey, out var preferred) && OpenCodeSessions.ContainsKey(preferred))
            return preferred;
        if (selected.State.AgentSessionIds.TryGetValue("SingleAgent", out preferred) && OpenCodeSessions.ContainsKey(preferred))
            return preferred;
        return selected.State.AgentSessionIds
            .Where(entry => IsOpenCodeSessionKey(entry.Key) && OpenCodeSessions.ContainsKey(entry.Value))
            .Select(entry => entry.Value)
            .FirstOrDefault() ?? string.Empty;
    }

    private void SynchronizeOpenCodeSessionSelection() =>
        _terminalState.SelectedOpenCodeSessionId = GetPreferredOpenCodeSessionId();

    private async Task SelectOpenCodeSessionAsync(string sessionId)
    {
        if (!OpenCodeSessions.ContainsKey(sessionId))
            return;
        _terminalState.SelectedOpenCodeSessionId = sessionId;
        await PersistTerminalStateAsync(synchronizeOpenCodeSelection: false);
        await InvokeAsync(StateHasChanged);
    }

    private void SelectTerminalSession(Guid id)
    {
        _selectedTerminalSessionId = id;
        _terminalState.SelectedSessionId = id;
        SynchronizeOpenCodeSessionSelection();
        _ = PersistTerminalStateAsync();
    }

    private async Task CloseTerminalSessionAsync(Guid id)
    {
        var index = _terminalSessions.FindIndex(session => session.Id == id);
        if (index < 0)
            return;
        if (_terminalState.Sessions.FirstOrDefault(session => session.Id == id) is { } closedSession)
            RememberClosedTerminalSessions(new[] { closedSession });
        _terminalSessions.RemoveAt(index);
        _terminalState.Sessions.RemoveAll(session => session.Id == id);
        if (_terminalSessions.Count == 0)
        {
            _terminalState.SelectedSessionId = Guid.Empty;
            await AddTerminalSessionAsync();
            return;
        }
        if (_selectedTerminalSessionId == id)
            _selectedTerminalSessionId = _terminalSessions[Math.Min(index, _terminalSessions.Count - 1)].Id;
        _terminalState.SelectedSessionId = _selectedTerminalSessionId;
        await PersistTerminalStateAsync();
    }

    private async Task ToggleSessionMode(CodeBadgerTerminalSession session)
    {
        session.Mode = session.Mode == TerminalMode.Plan ? TerminalMode.Build : TerminalMode.Plan;
        session.State.Mode = session.Mode == TerminalMode.Plan ? "Plan" : "Build";
        await PersistTerminalStateAsync();
    }

    [JSInvokable]
    public async Task ToggleTerminalModeAsync(string sessionId)
    {
        if (CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode) == CodeBadgerOrchestrationModes.Full ||
            !Guid.TryParse(sessionId, out var id) ||
            _terminalSessions.FirstOrDefault(candidate => candidate.Id == id) is not { } session)
            return;
        await ToggleSessionMode(session);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task SubmitTerminalInputAsync(string sessionId)
    {
        if (!Guid.TryParse(sessionId, out var id) || _terminalSessions.FirstOrDefault(candidate => candidate.Id == id) is not { } session ||
            session.IsBusy || session.IsSubmitting || session.IsRotatingAgentRole ||
            string.IsNullOrWhiteSpace(session.Input) && session.InputImages.Count == 0)
            return;

        var prompt = session.Input.Trim();
        var images = session.InputImages.ToArray();

        if (session.PendingCommitMessage)
        {
            var commitReply = session.Input.Trim();
            session.IsSubmitting = true;
            session.Messages.Add(new CodeBadgerTerminalMessage { Role = "user", Text = commitReply });
            session.Input = string.Empty;
            session.InputImages.Clear();
            await PersistTerminalStateAsync();
            await InvokeAsync(StateHasChanged);
            _ = CompleteTerminalCommitAsync(session, commitReply);
            if (_composerModule is not null)
                await _composerModule.InvokeVoidAsync("clear", _terminalStack, sessionId);
            return;
        }

        var forceBuildRequest = false;
        string? forcedRole = null;
        if (images.Length == 0)
        {
            if (prompt.Equals("/help", StringComparison.OrdinalIgnoreCase))
            {
                session.Input = string.Empty;
                await ShowTerminalHelpAsync(session);
                if (_composerModule is not null)
                    await _composerModule.InvokeVoidAsync("clear", _terminalStack, sessionId);
                return;
            }

            if (prompt.Equals("/model", StringComparison.OrdinalIgnoreCase))
            {
                session.Input = string.Empty;
                await OpenTerminalModelPickerAsync(session);
                return;
            }

            if (prompt.StartsWith("/model ", StringComparison.OrdinalIgnoreCase))
            {
                var modelReference = prompt["/model ".Length..].Trim();
                if (_availableOpenCodeModels.Count == 0)
                    _availableOpenCodeModels = await OpenCodeActivity.GetAvailableModelsAsync(Repository.Path, CancellationToken.None);
                var match = _availableOpenCodeModels.FirstOrDefault(model => model.Enabled && model.Status == "active" &&
                    string.Equals(model.Reference, modelReference, StringComparison.OrdinalIgnoreCase));
                if (match is null)
                {
                    Snackbar.Add(L.T("No available model matches {0}.", modelReference), Severity.Warning);
                    session.Input = string.Empty;
                    await InvokeAsync(StateHasChanged);
                    if (_composerModule is not null)
                        await _composerModule.InvokeVoidAsync("clear", _terminalStack, sessionId);
                    return;
                }
                await SelectTerminalModelAsync(session, match.Reference);
                return;
            }

            var commandResult = ProcessTerminalCommand(session, ref prompt, ref forceBuildRequest, ref forcedRole);
            if (commandResult == TerminalCommandResult.Handled)
            {
                session.Input = string.Empty;
                await PersistTerminalStateAsync();
                await InvokeAsync(StateHasChanged);
                if (_composerModule is not null)
                    await _composerModule.InvokeVoidAsync("clear", _terminalStack, sessionId);
                return;
            }

            if (commandResult == TerminalCommandResult.Commit)
            {
                session.IsSubmitting = true;
                session.Messages.Add(new CodeBadgerTerminalMessage { Role = "user", Text = session.Input.Trim() });
                session.Input = string.Empty;
                await PersistTerminalStateAsync();
                await InvokeAsync(StateHasChanged);
                _ = RunTerminalCommitAsync(session, prompt);
                if (_composerModule is not null)
                    await _composerModule.InvokeVoidAsync("clear", _terminalStack, sessionId);
                return;
            }
        }

        session.IsSubmitting = true;
        if (string.IsNullOrWhiteSpace(prompt))
        {
            prompt = L.T("Please inspect the attached image and help me with it.");
        }
        session.State.Mode = session.Mode == TerminalMode.Plan ? "Plan" : "Build";
        session.State.Messages.Add(new CodeBadgerTerminalMessage { Role = "user", Text = session.Input.Trim(), Images = images.ToList() });
        session.Input = string.Empty;
        session.InputImages.Clear();
        session.IsSubmitting = false;
        await PersistTerminalStateAsync();
        await InvokeAsync(StateHasChanged);
        _ = RunPromptAsync(session, prompt, images, forceBuildRequest, forcedRole);
        if (_composerModule is not null)
            await _composerModule.InvokeVoidAsync("clear", _terminalStack, sessionId);
    }

    private static bool IsGenericTerminalSessionTitle(string? title)
    {
        if (string.IsNullOrWhiteSpace(title))
            return true;

        foreach (var prefix in new[] { "Terminal session ", "Terminalsessie ", "Terminalsitzung ", "Session de terminal " })
        {
            if (title.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) &&
                title[prefix.Length..].All(char.IsAsciiDigit))
                return true;
        }

        return false;
    }

    private string GetTerminalSessionDisplayTitle(CodeBadgerTerminalSession session) =>
        GetTerminalSessionDisplayTitle(session.State);

    private string GetTerminalSessionDisplayTitle(CodeBadgerTerminalSessionState session) =>
        string.IsNullOrWhiteSpace(session.Title) ? L.T("Terminal session") : session.Title;

    private TerminalCommandResult ProcessTerminalCommand(CodeBadgerTerminalSession session, ref string prompt,
        ref bool forceBuildRequest, ref string? forcedRole)
    {
        var separator = prompt.IndexOf(' ');
        var command = (separator < 0 ? prompt : prompt[..separator]).ToLowerInvariant();
        var argument = separator < 0 ? string.Empty : prompt[(separator + 1)..].Trim();

        switch (command)
        {
            case "/help":
                session.State.Messages.Add(new CodeBadgerTerminalMessage
                {
                    Role = "assistant",
                    IsCodeBadgerMessage = true,
                    IsCommandHelp = true
                });
                return TerminalCommandResult.Handled;

            case "/clear":
                ClearTerminalSession(session);
                return TerminalCommandResult.Handled;

            case "/plan":
                session.Mode = TerminalMode.Plan;
                session.State.Mode = "Plan";
                if (argument.Length == 0)
                    return TerminalCommandResult.Handled;
                forcedRole = CodeBadgerRoles.Planner;
                prompt = L.T("Create a clear, actionable plan for this request. Do not edit files or make changes yet.\n\nRequest:\n{0}", argument);
                return TerminalCommandResult.SubmitPrompt;

            case "/build":
                session.Mode = TerminalMode.Build;
                session.State.Mode = "Build";
                if (argument.Length == 0)
                    return TerminalCommandResult.Handled;
                forceBuildRequest = true;
                prompt = argument;
                return TerminalCommandResult.SubmitPrompt;

            case "/review":
                forcedRole = CodeBadgerRoles.Critic;
                prompt = L.T("Review the current repository changes. Look for correctness issues, regressions, security concerns, and missing tests. Do not modify files. Report findings first, ordered by severity. {0}", argument);
                return TerminalCommandResult.SubmitPrompt;

            case "/test":
                forcedRole = CodeBadgerRoles.Worker;
                session.Mode = TerminalMode.Build;
                session.State.Mode = "Build";
                prompt = L.T("Identify and run the relevant tests for the current repository changes. If a test fails, explain why; do not modify files unless asked. {0}", argument);
                return TerminalCommandResult.SubmitPrompt;

            case "/ask":
                session.Mode = TerminalMode.Plan;
                session.State.Mode = "Plan";
                forcedRole = CodeBadgerRoles.Planner;
                prompt = L.T("Answer the question directly and clearly. Do not modify files or make code changes.\n\nQuestion:\n{0}", argument);
                return TerminalCommandResult.SubmitPrompt;

            case "/explain":
                forcedRole = CodeBadgerRoles.Planner;
                session.Mode = TerminalMode.Plan;
                session.State.Mode = "Plan";
                prompt = L.T("Explain the following topic in the context of this repository. Describe relevant code and behavior. Do not modify files.\n\nTopic:\n{0}", argument);
                return TerminalCommandResult.SubmitPrompt;

            case "/fix":
                forcedRole = CodeBadgerRoles.Worker;
                forceBuildRequest = true;
                session.Mode = TerminalMode.Build;
                session.State.Mode = "Build";
                prompt = L.T("Investigate and fix the following problem in this repository. Make a focused change and run relevant checks.\n\nProblem:\n{0}", argument);
                return TerminalCommandResult.SubmitPrompt;

            case "/commit":
                prompt = argument;
                return TerminalCommandResult.Commit;

            default:
                return TerminalCommandResult.NotACommand;
        }
    }

    private void ClearTerminalSession(CodeBadgerTerminalSession session)
    {
        foreach (var agentSessionId in session.State.AgentSessionIds.Values)
            _pendingTerminalInteractions.Remove(agentSessionId);
        session.State.Messages.Clear();
        session.State.AgentSessionIds.Clear();
        session.State.AgentSessionGenerations.Clear();
        session.State.AgentContextTokens.Clear();
        session.State.AgentContextModels.Clear();
        session.State.ActiveAgentRole = string.Empty;
        session.Mode = TerminalMode.Plan;
        session.State.Mode = "Plan";
        session.RoleProgress.Clear();
        session.Error = null;
    }

    [JSInvokable]
    public async Task AddClipboardImageAsync(string sessionId, string dataUrl)
    {
        if (!Guid.TryParse(sessionId, out var id) || _terminalSessions.FirstOrDefault(candidate => candidate.Id == id) is not { } session)
            return;
        if (session.InputImages.Count >= 3 || dataUrl.Length > 160_000 ||
            !dataUrl.StartsWith("data:image/jpeg;base64,", StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add(L.T("Could not add image. Use up to three smaller images."), Severity.Warning);
            return;
        }
        session.InputImages.Add(dataUrl);
        await InvokeAsync(StateHasChanged);
    }

    private void RemoveDraftImage(CodeBadgerTerminalSession session, int index)
    {
        if (index >= 0 && index < session.InputImages.Count)
            session.InputImages.RemoveAt(index);
    }

    private static string FormatUsd(decimal amount) =>
        amount.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-US"));

    private static decimal GetSessionCostProgress(decimal cost, decimal limit) =>
        limit <= 0 || cost <= 0 ? 0 : cost >= limit ? 100 : cost / limit * 100;

    private void EnsureSessionBudgetAvailable(CodeBadgerTerminalSession session)
    {
        var limit = Repository.CodeBadgerSessionCostLimitUsd.GetValueOrDefault();
        if (limit > 0 && session.State.CostUsd >= limit)
            throw new SessionCostLimitReachedException(L.T("The CodeBadger session cost limit of {0} has been reached. No more agent requests will be started.", FormatUsd(limit)));
    }

    private async Task RunTerminalCommitAsync(CodeBadgerTerminalSession session, string customInstruction)
    {
        try
        {
            if (AgentTools.Normalize(Repository.AgentTool) != AgentTools.OpenCode || Repository.OpenCodeSandboxEnabled)
            {
                AddTerminalCommandResponse(session,
                    L.T("The /commit command requires a configured, non-sandboxed OpenCode repository."));
                return;
            }

            var settings = await SettingsService.LoadAsync();
            var repository = settings.Repositories.FirstOrDefault(candidate =>
                AgentTools.Normalize(candidate.AgentTool) == AgentTools.OpenCode && !candidate.OpenCodeSandboxEnabled &&
                string.Equals(OpenCodeActivityService.NormalizePath(candidate.Path),
                    OpenCodeActivityService.NormalizePath(Repository.Path), StringComparison.OrdinalIgnoreCase));
            if (repository is null)
            {
                AddTerminalCommandResponse(session,
                    L.T("The /commit command requires a configured, non-sandboxed OpenCode repository."));
                return;
            }

            var stage = await GitBranchService.StageAllChangesAsync(Repository.Path);
            if (!stage.Success)
            {
                AddTerminalCommandResponse(session, L.T("Could not stage repository changes: {0}", stage.Message));
                return;
            }

            var diff = await GitBranchService.GetStagedDiffAsync(Repository.Path);
            if (!diff.Success)
            {
                AddTerminalCommandResponse(session, L.T("Could not read staged changes: {0}", diff.Message));
                return;
            }
            if (string.IsNullOrWhiteSpace(diff.Output))
            {
                AddTerminalCommandResponse(session, L.T("There are no changes to commit."));
                return;
            }

            var canGenerate = !string.IsNullOrWhiteSpace(settings.AiApiKey) ||
                settings.AiProvider.Equals("Ollama", StringComparison.OrdinalIgnoreCase) ||
                settings.AiProvider.Equals("Custom URL", StringComparison.OrdinalIgnoreCase) &&
                !string.IsNullOrWhiteSpace(settings.AiCustomUrl);
            if (canGenerate)
            {
                var branch = await GitBranchService.GetCurrentBranchAsync(Repository.Path);
                var generated = await AiCommitMessageService.GenerateAsync(settings, diff.Output, branch.Branch,
                    string.Join("\n", new[] { repository.AiCustomInstruction, customInstruction }
                        .Where(instruction => !string.IsNullOrWhiteSpace(instruction))), Repository.Path);
                if (generated.Success && !string.IsNullOrWhiteSpace(generated.Title) && generated.Title.Trim().Length <= 72)
                {
                    await CommitTerminalStagedChangesAsync(session, generated.Title, generated.Description);
                    return;
                }

                AddTerminalCommandResponse(session, L.T(
                    "AI could not generate a valid commit message ({0}). Reply with a commit title of 1–72 characters; you may add a description on the next line.",
                    generated.Success ? L.T("The provider returned no commit title.") : generated.Error));
                session.PendingCommitMessage = true;
                return;
            }

            AddTerminalCommandResponse(session,
                L.T("Changes are staged. Reply with a commit title of 1–72 characters; you may add a description on the next line."));
            session.PendingCommitMessage = true;
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Could not run the CodeBadger terminal commit command for repository {RepositoryPath}.", Repository.Path);
            AddTerminalCommandResponse(session, L.T("Could not run the commit command: {0}", exception.Message));
        }
        finally
        {
            session.IsSubmitting = false;
            await PersistTerminalStateAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CompleteTerminalCommitAsync(CodeBadgerTerminalSession session, string message)
    {
        try
        {
            var lines = message.Split('\n', 2, StringSplitOptions.TrimEntries);
            var title = lines[0].Trim();
            if (string.IsNullOrWhiteSpace(title) || title.Length > 72)
            {
                AddTerminalCommandResponse(session,
                    L.T("Commit title must contain 1–72 characters. Reply with a title and optional description."));
                return;
            }

            var description = lines.Length > 1 ? lines[1].Trim() : string.Empty;
            await CommitTerminalStagedChangesAsync(session, title, description);
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Could not complete the CodeBadger terminal commit for repository {RepositoryPath}.", Repository.Path);
            AddTerminalCommandResponse(session, L.T("Commit failed: {0}", exception.Message));
        }
        finally
        {
            session.IsSubmitting = false;
            await PersistTerminalStateAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CommitTerminalStagedChangesAsync(CodeBadgerTerminalSession session, string title, string description)
    {
        var message = string.IsNullOrWhiteSpace(description) ? title.Trim() : $"{title.Trim()}\n\n{description.Trim()}";
        var result = await GitBranchService.CommitAsync(Repository.Path, message);
        if (result.Success)
            session.PendingCommitMessage = false;
        AddTerminalCommandResponse(session, result.Success
            ? L.T("Commit created successfully: {0}", title.Trim())
            : L.T("Commit failed: {0}", result.Message));
    }

    private void AddTerminalCommandResponse(CodeBadgerTerminalSession session, string text) =>
        session.Messages.Add(new CodeBadgerTerminalMessage
        {
            Role = "assistant",
            Text = text,
            IsCodeBadgerMessage = true
        });

    private async Task RecordPromptCostsAsync(CodeBadgerTerminalSession session, string agentSessionId,
        string promptMessageId, IReadOnlySet<string> previousMessageIds, CancellationToken cancellationToken)
    {
        var costs = await OpenCodeActivity.GetCompletedPromptCostsAsync(agentSessionId, Repository.Path,
            promptMessageId, previousMessageIds, cancellationToken);
        var knownIds = session.State.CostMessageIds.ToHashSet(StringComparer.Ordinal);
        var added = false;
        foreach (var cost in costs)
        {
            var key = agentSessionId + ":" + cost.Id;
            if (!knownIds.Add(key))
                continue;
            session.State.CostMessageIds.Add(key);
            session.State.CostUsd += cost.CostUsd;
            added = true;
        }
        if (added)
        {
            await PersistTerminalStateAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RunPromptAsync(CodeBadgerTerminalSession session, string prompt, IReadOnlyList<string> images,
        bool forceBuildRequest = false, string? forcedRole = null)
    {
        session.IsBusy = true;
        session.RoleProgress.Clear();
        session.Error = null;
        session.RunCancellation?.Dispose();
        session.RunCancellation = new CancellationTokenSource();
        var cancellationToken = session.RunCancellation.Token;
        await InvokeAsync(StateHasChanged);
        try
        {
            if (AgentTools.Normalize(Repository.AgentTool) != AgentTools.OpenCode)
                throw new NotSupportedException(L.T("The CodeBadger connector currently supports OpenCode. Other agent connectors will be added later."));

            _availableOpenCodeModels = await OpenCodeActivity.GetAvailableModelsAsync(Repository.Path, cancellationToken);
            if (_availableOpenCodeModels.Count == 0)
                throw new InvalidOperationException(L.T("OpenCode did not return any available models for this repository."));
            cancellationToken.ThrowIfCancellationRequested();
            _settings = await SettingsService.LoadAsync();
            var agentPreferences = GetAgentPreferences(Repository.AgentTool);
            var preferences = agentPreferences.RolePreferences;
            if (forcedRole is not null)
            {
                await RunRoleAsync(session, forcedRole, prompt, parentRole: null, preferences, cancellationToken, images);
                return;
            }
            switch (CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode))
            {
                case CodeBadgerOrchestrationModes.SingleAgent:
                    await RunSingleAgentPromptAsync(session, prompt, preferences, cancellationToken, images);
                    break;
                case CodeBadgerOrchestrationModes.PlanBuild:
                    var requestedMode = session.Mode;
                    var currentUserIndex = session.State.Messages.FindLastIndex(message => message.Role == "user");
                    var priorPlan = !forceBuildRequest && currentUserIndex > 0
                        ? session.State.Messages.Take(currentUserIndex)
                            .LastOrDefault(message => message.Role == "assistant" && message.AgentRole == CodeBadgerRoles.Planner)?.Text
                        : null;
                    var plan = session.Mode == TerminalMode.Build && !string.IsNullOrWhiteSpace(priorPlan)
                        ? priorPlan
                        : await RunRoleAsync(session, CodeBadgerRoles.Planner,
                            session.Mode == TerminalMode.Plan ? prompt : "First produce an actionable plan for this implementation request. Do not edit files yet.\n\n" + prompt,
                            parentRole: null, preferences, cancellationToken, images);
                    if (requestedMode == TerminalMode.Plan)
                        break;
                    await RunRoleAsync(session, CodeBadgerRoles.Worker,
                        $"Implement the following plan in this repository. Make the required code changes, run appropriate checks, and report the result.\n\nPlan:\n{plan}",
                        CodeBadgerRoles.Planner, preferences, cancellationToken, images);
                    session.Mode = TerminalMode.Build;
                    session.State.Mode = "Build";
                    break;
                case CodeBadgerOrchestrationModes.Full:
                    await RunFullOrchestrationAsync(session, prompt, preferences, cancellationToken, images);
                    break;
            }
            if (forcedRole is null && CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode) != CodeBadgerOrchestrationModes.SingleAgent)
            {
                session.State.Mode = "Build";
                session.Mode = TerminalMode.Build;
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            if (!string.IsNullOrWhiteSpace(session.State.ActiveAgentRole))
                session.RoleProgress[session.State.ActiveAgentRole] = AgentRoleProgress.Stopped;
            Snackbar.Add(L.T("The agent request was stopped."), Severity.Info);
        }
        catch (SessionCostLimitReachedException exception)
        {
            session.Error = exception.Message;
            Snackbar.Add(exception.Message, Severity.Warning);
        }
        catch (Exception exception)
        {
            if (!string.IsNullOrWhiteSpace(session.State.ActiveAgentRole))
                session.RoleProgress[session.State.ActiveAgentRole] = AgentRoleProgress.Failed;
            session.Error = exception.Message;
            Snackbar.Add(L.T("The AI request failed: {0}", exception.Message), Severity.Error);
        }
        finally
        {
            session.IsBusy = false;
            if (!string.IsNullOrWhiteSpace(session.ActiveAgentSessionId))
                _pendingTerminalInteractions.Remove(session.ActiveAgentSessionId);
            session.ActiveAgentSessionId = null;
            session.ActiveAgentTool = string.Empty;
            session.RunCancellation?.Dispose();
            session.RunCancellation = null;
            await PersistTerminalStateAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CancelPromptAsync(CodeBadgerTerminalSession session)
    {
        var cancellation = session.RunCancellation;
        if (cancellation is null || !session.IsBusy)
            return;

        cancellation.Cancel();
        if (session.ActiveAgentSessionId is { Length: > 0 } sessionId &&
            GetInteractionProvider(session.ActiveAgentTool) is { } provider)
        {
            try
            {
                await provider.InterruptAsync(sessionId, Repository.Path, CancellationToken.None);
            }
            catch (Exception exception)
            {
                Logger.LogWarning(exception, "Could not interrupt {Agent} session {SessionId} after a terminal stop request.",
                    session.ActiveAgentTool, sessionId);
            }
        }
    }

    private async Task RunSingleAgentPromptAsync(CodeBadgerTerminalSession session, string prompt,
        IReadOnlyList<CodeBadgerRolePreference> preferences, CancellationToken cancellationToken, IReadOnlyList<string> images)
    {
        var role = session.Mode == TerminalMode.Plan ? CodeBadgerRoles.Planner : CodeBadgerRoles.Worker;
        await RunRoleAsync(session, role, prompt, parentRole: null, preferences, cancellationToken, images);
    }

    private async Task<string> RunRoleAsync(CodeBadgerTerminalSession session, string role, string prompt,
        string? parentRole, IReadOnlyList<CodeBadgerRolePreference> preferences, CancellationToken cancellationToken,
        IReadOnlyList<string>? images = null)
    {
        cancellationToken.ThrowIfCancellationRequested();
        EnsureSessionBudgetAvailable(session);
        session.State.ActiveAgentRole = role;
        session.RoleProgress[role] = AgentRoleProgress.Working;
        if (session.Id == _selectedTerminalSessionId)
            SynchronizeOpenCodeSessionSelection();
        await InvokeAsync(StateHasChanged);
        var preference = preferences.FirstOrDefault(item => item.Role == role)
            ?? new CodeBadgerRolePreference { Role = role, AgentType = CodeBadgerRoles.DefaultAgentType(role) };
        var preferenceAgent = await ResolvePreferenceAgentAsync(preference, role, cancellationToken);
        var model = await ResolveRoleModelAsync(session, preference, role, prompt, preferences, cancellationToken);
        cancellationToken.ThrowIfCancellationRequested();
        EnsureSessionBudgetAvailable(session);
        var parentId = parentRole is not null && session.State.AgentSessionIds.TryGetValue(parentRole, out var existingParent)
            ? existingParent : null;
        var orchestrationMode = CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode);
        var sessionKey = orchestrationMode == CodeBadgerOrchestrationModes.SingleAgent
            ? "SingleAgent" : role;
        var isNewAgentSession = !session.State.AgentSessionIds.TryGetValue(sessionKey, out var agentSessionId);
        if (isNewAgentSession)
        {
            var created = await OpenCodeActivity.CreateOrchestrationSessionAsync(Repository.Path, preferenceAgent,
                string.Empty, parentId, model, cancellationToken);
            agentSessionId = created.Id;
            session.State.AgentSessionIds[sessionKey] = agentSessionId;
            await PersistTerminalStateAsync();
        }
        else
        {
            if (!string.IsNullOrWhiteSpace(model))
                await OpenCodeActivity.SwitchModelAsync(agentSessionId!, Repository.Path, model, cancellationToken);
            await OpenCodeActivity.SwitchAgentAsync(agentSessionId!, Repository.Path, preferenceAgent, cancellationToken);
        }
        if (string.IsNullOrWhiteSpace(agentSessionId))
            throw new InvalidOperationException("OpenCode did not return an agent session ID.");
        cancellationToken.ThrowIfCancellationRequested();
        session.ActiveAgentSessionId = agentSessionId;
        session.ActiveAgentTool = Repository.AgentTool;
        session.State.ActiveAgentRole = role;
        var modelStateKey = orchestrationMode == CodeBadgerOrchestrationModes.SingleAgent
            ? "Model:SingleAgent" : "Model:" + role;
        if (!string.IsNullOrWhiteSpace(model))
        {
            session.State.AgentSessionIds[modelStateKey] = model;
            session.State.AgentContextModels[sessionKey] = model;
            RememberTerminalModel(session, model);
        }

        var pendingMessage = new CodeBadgerTerminalMessage
        {
            Role = "assistant", AgentRole = role, ModelReference = model ?? string.Empty,
            Text = L.T("Sending to {0}...", RoleDisplayName(role))
        };
        session.State.Messages.Add(pendingMessage);
        await PersistTerminalStateAsync();
        await InvokeAsync(StateHasChanged);
        string response;
        try
        {
            var previousMessageIds = await OpenCodeActivity.GetSessionMessageIdsAsync(agentSessionId, Repository.Path, cancellationToken)
                ?? throw new InvalidOperationException(L.T("Could not read the existing OpenCode session messages before sending the request."));
            var promptMessageId = await OpenCodeActivity.SendPromptAsync(agentSessionId, Repository.Path, prompt,
                cancellationToken, preferenceAgent, images);
            if (string.IsNullOrWhiteSpace(promptMessageId))
                throw new InvalidOperationException(L.T("OpenCode accepted the request but did not return a message ID, so its reply cannot be matched safely."));
            var interimMessages = new Dictionary<string, CodeBadgerTerminalMessage>(StringComparer.Ordinal);
            async Task RefreshPromptMessagesAsync()
            {
                var messages = await OpenCodeActivity.GetPromptTextMessagesAsync(agentSessionId, Repository.Path,
                    promptMessageId, previousMessageIds, cancellationToken);
                await InvokeAsync(() =>
                {
                    var changed = false;
                    foreach (var message in messages)
                    {
                        if (message.IsFinal)
                        {
                            if (interimMessages.Remove(message.Id, out var interimMessage))
                            {
                                session.State.Messages.Remove(interimMessage);
                                changed = true;
                            }
                            continue;
                        }
                        if (!interimMessages.TryGetValue(message.Id, out var displayedMessage))
                        {
                            displayedMessage = new CodeBadgerTerminalMessage
                            {
                                Role = "assistant", AgentRole = role, ModelReference = model ?? string.Empty,
                                Text = message.Text
                            };
                            interimMessages[message.Id] = displayedMessage;
                            session.State.Messages.Insert(session.State.Messages.IndexOf(pendingMessage), displayedMessage);
                            changed = true;
                        }
                        else if (displayedMessage.Text != message.Text)
                        {
                            displayedMessage.Text = message.Text;
                            changed = true;
                        }
                    }
                    var finalText = string.Join("\n\n", messages.Where(message => message.IsFinal).Select(message => message.Text));
                    if (finalText.Length > 0 && pendingMessage.Text != finalText)
                    {
                        pendingMessage.Text = finalText;
                        changed = true;
                    }
                    if (changed)
                        StateHasChanged();
                });
            }
            await WaitForAgentCompletionAsync(session, role, Repository.AgentTool, agentSessionId, cancellationToken,
                RefreshPromptMessagesAsync);
            var completedResponse = await WaitForPromptAnswerAsync(agentSessionId, promptMessageId, previousMessageIds, cancellationToken);
            await RecordPromptCostsAsync(session, agentSessionId, promptMessageId, previousMessageIds, cancellationToken);
            response = completedResponse
                ?? throw new InvalidOperationException(L.T("The AI session finished without a completed text response for this request."));
            await RefreshPromptMessagesAsync();
            await RefreshAgentContextAsync(session, role, sessionKey, agentSessionId, cancellationToken);
            if (isNewAgentSession)
            {
                try
                {
                    var generatedTitle = await OpenCodeActivity.GenerateSessionTitleAsync(agentSessionId,
                        Repository.Path, cancellationToken);
                    if (!string.IsNullOrWhiteSpace(generatedTitle) && !IsGenericTerminalSessionTitle(generatedTitle))
                    {
                        // The first role session names the CodeBadger terminal; all
                        // OpenCode role sessions get their own generated subject.
                        if (session.State.Messages.Count(message => message.Role == "user") == 1 &&
                            IsGenericTerminalSessionTitle(session.State.Title))
                            session.State.Title = generatedTitle.Trim();
                    }
                }
                catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
                {
                    throw;
                }
                catch (Exception exception)
                {
                    Logger.LogWarning(exception, "Could not generate an OpenCode title for terminal session {SessionId}.", agentSessionId);
                }
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            pendingMessage.Text = L.T("The agent request was stopped.");
            session.RoleProgress[role] = AgentRoleProgress.Stopped;
            await PersistTerminalStateAsync();
            await InvokeAsync(StateHasChanged);
            throw;
        }
        catch (Exception exception)
        {
            pendingMessage.Text = L.T("Agent request failed: {0}", exception.Message);
            session.RoleProgress[role] = AgentRoleProgress.Failed;
            await PersistTerminalStateAsync();
            await InvokeAsync(StateHasChanged);
            throw;
        }
        pendingMessage.Text = response;
        session.RoleProgress[role] = AgentRoleProgress.Completed;
        await PersistTerminalStateAsync();
        await InvokeAsync(StateHasChanged);
        return response;
    }

    private async Task WaitForAgentCompletionAsync(CodeBadgerTerminalSession session, string role, string agentTool, string agentSessionId,
        CancellationToken cancellationToken, Func<Task>? onProgress = null)
    {
        // Poll for questions while the agent runs. A provider-specific API adapter can
        // surface interactions without leaking OpenCode protocol details into the UI.
        if (GetInteractionProvider(agentTool) is not { } provider)
            throw new NotSupportedException(L.T("No interaction provider is registered for {0}.", AgentTools.GetDisplayName(agentTool)));

        await provider.WaitForCompletionAsync(agentSessionId, Repository.Path,
            async interactions =>
            {
                if (onProgress is not null)
                    await onProgress();
                await InvokeAsync(() =>
                {
                    var terminalSession = _terminalSessions.FirstOrDefault(candidate =>
                        string.Equals(candidate.ActiveAgentSessionId, agentSessionId, StringComparison.Ordinal));
                    var current = interactions.ToHashSet();
                    var changed = !_pendingTerminalInteractions.TryGetValue(agentSessionId, out var previous) ||
                        !previous.SetEquals(current);
                    if (interactions.Count > 0)
                    {
                        _pendingTerminalInteractions[agentSessionId] = current;
                        session.RoleProgress[role] = AgentRoleProgress.Waiting;
                        if (terminalSession is not null)
                            foreach (var field in interactions.SelectMany(interaction => interaction.Fields.Select(field => (interaction, field))))
                            {
                                terminalSession.InteractionAnswers.TryAdd(InteractionAnswerKey(field.interaction, field.field), null);
                                if (field.field.AllowsCustomValue)
                                    terminalSession.InteractionAnswers.TryAdd(CustomInteractionAnswerKey(field.interaction, field.field), null);
                            }
                    }
                    else
                    {
                        changed |= _pendingTerminalInteractions.Remove(agentSessionId);
                        if (session.RoleProgress.GetValueOrDefault(role) == AgentRoleProgress.Waiting)
                            session.RoleProgress[role] = AgentRoleProgress.Working;
                    }
                    if (changed)
                        StateHasChanged();
                });
            }, cancellationToken);
    }

    private async Task<string?> WaitForPromptAnswerAsync(string sessionId, string promptMessageId,
        IReadOnlySet<string> previousMessageIds,
        CancellationToken cancellationToken)
    {
        // Some OpenCode versions return from wait just before the completed message is
        // visible through message.list. Only accept a reply correlated to this prompt.
        for (var attempt = 0; attempt < 10; attempt++)
        {
            cancellationToken.ThrowIfCancellationRequested();
            var answer = await OpenCodeActivity.GetCompletedAnswerForPromptAsync(
                sessionId, Repository.Path, promptMessageId, previousMessageIds, cancellationToken);
            if (!string.IsNullOrWhiteSpace(answer))
                return answer;
            if (attempt < 9)
                await Task.Delay(TimeSpan.FromMilliseconds(300), cancellationToken);
        }
        return null;
    }

    private async Task<string> ResolvePreferenceAgentAsync(CodeBadgerRolePreference preference, string role,
        CancellationToken cancellationToken)
    {
        var agents = await OpenCodeActivity.GetAvailableAgentOptionsAsync(Repository.Path, cancellationToken);
        string? requestedId = preference.AgentType switch
        {
            "Plan" => "plan",
            "Build" => "build",
            "Custom" => preference.CustomAgentId,
            _ => await OpenCodeActivity.GetDefaultAgentIdAsync(Repository.Path, CancellationToken.None)
        };

        if (!string.IsNullOrWhiteSpace(requestedId))
        {
            var requestedAgent = agents.FirstOrDefault(agent => string.Equals(agent.Id, requestedId, StringComparison.OrdinalIgnoreCase));
            if (requestedAgent is not null)
            {
                if (preference.AgentType == "Primary" && requestedAgent.Mode is not ("primary" or "all"))
                    throw new InvalidOperationException(L.T("The configured OpenCode default agent is not a primary agent."));
                if (preference.AgentType == "Custom" && requestedAgent.Mode is not ("subagent" or "all"))
                    throw new InvalidOperationException(L.T("Choose a custom OpenCode subagent for this role."));
                return requestedAgent.Id;
            }
        }

        if (preference.AgentType == "Primary")
        {
            // Prefer a primary agent explicitly named primary; otherwise the mode="primary" agents
            // returned by OpenCode are the only stable contract we have across installations.
            var primary = agents.FirstOrDefault(agent => string.Equals(agent.Id, requestedId, StringComparison.OrdinalIgnoreCase))
                ?? agents.FirstOrDefault(agent => agent.Mode == "primary");
            if (primary is not null) return primary.Id;
        }

        if (preference.AgentType == "Custom")
        {
            var custom = agents.FirstOrDefault(agent => agent.Mode is "subagent" or "all");
            if (custom is not null) return custom.Id;
        }

        var safeFallback = role is CodeBadgerRoles.Orchestrator or CodeBadgerRoles.Router or CodeBadgerRoles.Planner
            ? "plan" : "build";
        if (agents.Any(agent => string.Equals(agent.Id, safeFallback, StringComparison.OrdinalIgnoreCase)))
            return safeFallback;
        return agents.FirstOrDefault()?.Id
            ?? throw new InvalidOperationException(L.T("OpenCode returned no available agents."));
    }

    private async Task RunFullOrchestrationAsync(CodeBadgerTerminalSession session, string prompt,
        IReadOnlyList<CodeBadgerRolePreference> preferences, CancellationToken cancellationToken, IReadOnlyList<string> images)
    {
        var route = await RunRoleAsync(session, CodeBadgerRoles.Router,
            "Classify this user request. Reply with concise JSON containing task_type, needs_research (boolean), needs_implementation (boolean), and summary. Do not perform the task yet.\n\nRequest:\n" + prompt,
            null, preferences, cancellationToken, images);
        var assignments = await RunRoleAsync(session, CodeBadgerRoles.Orchestrator,
            $"Act as manager. Break the task into subtasks for planning, research, implementation, and review. Return concise JSON listing subtasks and dependencies. Do not inspect or modify files; CodeBadger dispatches roles. Routing analysis: {route}\n\nRequest:\n{prompt}",
            null, preferences, cancellationToken, images);
        var needsResearch = ReadBooleanField(route, "needs_research");
        var needsImplementation = ReadBooleanField(route, "needs_implementation");
        if (needsResearch)
            await RunRoleAsync(session, CodeBadgerRoles.Rag,
                "Research relevant repository context, files, and available knowledge sources. Report evidence and paths.\n\n" + prompt,
                CodeBadgerRoles.Orchestrator, preferences, cancellationToken, images);

        var plan = await RunRoleAsync(session, CodeBadgerRoles.Planner,
            $"Develop an actionable plan based on the manager's task breakdown. Manager breakdown: {assignments}\nRouting analysis: {route}\n\nRequest:\n{prompt}",
            CodeBadgerRoles.Orchestrator, preferences, cancellationToken, images);
        var context = new StringBuilder().AppendLine("Request:").AppendLine(prompt).AppendLine().AppendLine("Plan:").AppendLine(plan);
        if (session.State.Messages.LastOrDefault(message => message.AgentRole == CodeBadgerRoles.Rag) is { } research)
            context.AppendLine().AppendLine("Research findings:").AppendLine(research.Text);
        var build = needsImplementation
            ? await RunRoleAsync(session, CodeBadgerRoles.Worker,
                $"Execute this plan in the repository, update files, run relevant checks, then summarize changed files and test results.\n\n{context}",
                CodeBadgerRoles.Orchestrator, preferences, cancellationToken, images)
            : L.T("No implementation was requested by the triage agent.");
        var review = await RunRoleAsync(session, CodeBadgerRoles.Critic,
            $"Review the plan and any implementation/test report. Reply only with JSON {{\"needs_changes\": boolean, \"findings\": [strings]}}. Do not edit files.\n\nRequest:\n{prompt}\n\nPlan:\n{plan}\n\nImplementation report:\n{build}",
            CodeBadgerRoles.Orchestrator, preferences, cancellationToken, images);
        if (needsImplementation && ReadBooleanField(review, "needs_changes"))
            await RunRoleAsync(session, CodeBadgerRoles.Worker,
                "Address these review findings, run relevant checks, and report what changed:\n\n" + ReadStringField(review, "findings"),
                CodeBadgerRoles.Orchestrator, preferences, cancellationToken, images);
        await RunRoleAsync(session, CodeBadgerRoles.Orchestrator,
            "Provide a concise final user-facing summary based on the completed plan, implementation, and review.\n\nRequest:\n" + prompt,
            null, preferences, cancellationToken, images);
    }

    private static bool ReadBooleanField(string json, string field)
    {
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(json);
            return document.RootElement.TryGetProperty(field, out var value) && value.ValueKind == System.Text.Json.JsonValueKind.True;
        }
        catch (System.Text.Json.JsonException) { return false; }
    }

    private static string ReadStringField(string json, string field)
    {
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(json);
            if (!document.RootElement.TryGetProperty(field, out var value)) return json;
            return value.ValueKind == System.Text.Json.JsonValueKind.Array
                ? string.Join("\n", value.EnumerateArray().Where(item => item.ValueKind == System.Text.Json.JsonValueKind.String)
                    .Select(item => item.GetString()))
                : value.ToString();
        }
        catch (System.Text.Json.JsonException) { return json; }
    }

    private string RoleDisplayName(string role) => role switch
    {
        CodeBadgerRoles.Orchestrator => L.T("Orchestrator / Manager"),
        CodeBadgerRoles.Router => L.T("Router / Triage-agent"),
        CodeBadgerRoles.Planner => L.T("Planner / Reasoning-agent"),
        CodeBadgerRoles.Worker => L.T("Worker / Tool-use agent"),
        CodeBadgerRoles.Rag => L.T("RAG / Knowledge-agent"),
        CodeBadgerRoles.Critic => L.T("Critic / Evaluator-agent"),
        _ => role
    };

    private async Task<string> ResolveRoleModelAsync(CodeBadgerTerminalSession session,
        CodeBadgerRolePreference preference, string role, string taskDescription,
        IReadOnlyList<CodeBadgerRolePreference> preferences, CancellationToken cancellationToken)
    {
        var available = _availableOpenCodeModels.Where(model => model.Enabled && model.Status == "active").ToArray();
        var roleOverrideKey = CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode) == CodeBadgerOrchestrationModes.SingleAgent
            ? "SingleAgent" : role;
        if (session.State.RoleModelOverrides.TryGetValue(roleOverrideKey, out var roleOverride) &&
            available.FirstOrDefault(model => string.Equals(model.Reference, roleOverride, StringComparison.OrdinalIgnoreCase)) is { } overriddenModel)
            return overriddenModel.Reference;

        var orchestrationMode = CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode);
        var agentPreferences = GetAgentPreferences(Repository.AgentTool);
        var preferredModels = orchestrationMode switch
        {
            CodeBadgerOrchestrationModes.SingleAgent => agentPreferences.SingleAgentPreferredModels,
            CodeBadgerOrchestrationModes.PlanBuild when role == CodeBadgerRoles.Planner => agentPreferences.PlanPreferredModels,
            CodeBadgerOrchestrationModes.PlanBuild when role == CodeBadgerRoles.Worker => agentPreferences.BuildPreferredModels,
            _ => preference.PreferredModels
        };
        if (!string.IsNullOrWhiteSpace(_settings.CodeBadgerTerminalModel) &&
            available.FirstOrDefault(model => string.Equals(model.Reference, _settings.CodeBadgerTerminalModel, StringComparison.OrdinalIgnoreCase)) is { } terminalModel)
            return terminalModel.Reference;
        foreach (var preferred in preferredModels.Where(model => !string.IsNullOrWhiteSpace(model)))
            if (available.Any(model => string.Equals(model.Reference, preferred, StringComparison.OrdinalIgnoreCase)))
                return available.First(model => string.Equals(model.Reference, preferred, StringComparison.OrdinalIgnoreCase)).Reference;

        if (available.Length > 0)
        {
            try
            {
                var routerPreference = preferences.FirstOrDefault(item => item.Role == CodeBadgerRoles.Router)
                    ?? new CodeBadgerRolePreference { Role = CodeBadgerRoles.Router, AgentType = "Plan" };
                var routerAgent = await ResolvePreferenceAgentAsync(routerPreference, CodeBadgerRoles.Router, cancellationToken);
                var routerModel = routerPreference?.PreferredModels.FirstOrDefault(value => available.Any(model =>
                    string.Equals(model.Reference, value, StringComparison.OrdinalIgnoreCase)));
                const string selectorRolePrefix = "ModelSelector:";
                var selectorKey = selectorRolePrefix + role;
                if (!session.State.AgentSessionIds.TryGetValue(selectorKey, out var selectorSessionId))
                {
                    var seedModel = !string.IsNullOrWhiteSpace(routerModel) ? routerModel :
                        !string.IsNullOrWhiteSpace(_agentModelReference) && available.Any(model => model.Reference == _agentModelReference)
                            ? _agentModelReference
                            : available.OrderBy(model => EstimatedCost(model, CodeBadgerRoles.Router)).First().Reference;
                    var selector = await OpenCodeActivity.CreateOrchestrationSessionAsync(Repository.Path,
                        routerAgent, $"{session.Title} · Model selector · {role}", null, seedModel, cancellationToken);
                    selectorSessionId = selector.Id;
                    session.State.AgentSessionIds[selectorKey] = selectorSessionId;
                    await PersistTerminalStateAsync();
                }
                session.ActiveAgentSessionId = selectorSessionId;
                session.ActiveAgentTool = Repository.AgentTool;

                var previousMessageIds = await OpenCodeActivity.GetSessionMessageIdsAsync(
                    selectorSessionId, Repository.Path, cancellationToken);
                if (previousMessageIds is null)
                    throw new InvalidOperationException("Could not read the existing OpenCode model selector messages.");

                var candidates = available.Take(24).Select(model => new
                {
                    model.Reference, model.Name, model.Context, model.OutputLimit,
                    model.InputCost, model.OutputCost, model.HasPublishedCost
                });
                var request = $"Choose the best model for the AI role '{RoleDisplayName(role)}' and the task below. Infer task suitability from model name/family and context/output limits. Treat price as a cost tradeoff, never assume an unpriced model is free. Prefer a priced model when quality looks comparable; choose an unpriced model only when its likely task quality is materially better. Choose exactly one Reference from the candidate JSON; if metadata cannot establish a quality advantage, choose the cheapest capable model with a published price. Return only JSON {{\"model\":\"provider/model\"}}.\nTask:\n{taskDescription}\nCandidates (prices USD per million tokens):\n{System.Text.Json.JsonSerializer.Serialize(candidates)}";
                EnsureSessionBudgetAvailable(session);
                var selectorPromptId = await OpenCodeActivity.SendPromptAsync(selectorSessionId, Repository.Path,
                    request, cancellationToken, routerAgent);
                if (string.IsNullOrWhiteSpace(selectorPromptId))
                    throw new InvalidOperationException("OpenCode did not return a message ID for model selection.");
                await OpenCodeActivity.WaitForSessionAsync(selectorSessionId, Repository.Path, cancellationToken);
                var result = await WaitForPromptAnswerAsync(selectorSessionId, selectorPromptId, previousMessageIds, cancellationToken);
                await RecordPromptCostsAsync(session, selectorSessionId, selectorPromptId, previousMessageIds, cancellationToken);
                var selected = ReadStringField(result ?? string.Empty, "model");
                var match = available.FirstOrDefault(model => string.Equals(model.Reference, selected, StringComparison.OrdinalIgnoreCase));
                if (match is not null) return match.Reference;
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
            {
                throw;
            }
            catch (SessionCostLimitReachedException)
            {
                throw;
            }
            catch (Exception exception)
            {
                Logger.LogWarning(exception, "AI model routing failed for role {Role}; use the capability/cost fallback.", role);
            }
        }

        return ResolveRoleModelFallback(available, role);
    }

    private string ResolveRoleModelFallback(IReadOnlyList<OpenCodeActivityService.AvailableModel> available, string role)
    {

        var taskWords = role switch
        {
            CodeBadgerRoles.Orchestrator or CodeBadgerRoles.Router => new[] { "reason", "pro", "opus", "think" },
            CodeBadgerRoles.Planner or CodeBadgerRoles.Critic => new[] { "reason", "opus", "pro", "think" },
            CodeBadgerRoles.Worker => new[] { "code", "coder", "dev", "instruct" },
            CodeBadgerRoles.Rag => new[] { "fast", "flash", "mini", "lite" },
            _ => Array.Empty<string>()
        };
        return available
            .OrderByDescending(model => TaskFit(model, taskWords))
            .ThenBy(model => EstimatedCost(model, role))
            .ThenByDescending(model => model.Context)
            .FirstOrDefault()?.Reference
            ?? _availableOpenCodeModels.FirstOrDefault(model => model.Enabled)?.Reference
            ?? throw new InvalidOperationException(L.T("No enabled OpenCode model is available."));
    }

    private static int TaskFit(OpenCodeActivityService.AvailableModel model, IReadOnlyList<string> taskWords)
    {
        var name = model.Name + " " + model.Reference;
        var affinity = taskWords.Count(word => name.Contains(word, StringComparison.OrdinalIgnoreCase));
        if (model.OutputLimit >= 16000) affinity += 1;
        if (model.Context >= 64000) affinity += 1;
        return affinity;
    }

    private static double EstimatedCost(OpenCodeActivityService.AvailableModel model, string role)
    {
        // Rough screening estimate per million total tokens: give output more weight for reasoning roles.
        if (!model.HasPublishedCost)
            return double.PositiveInfinity;
        var outputWeight = role is CodeBadgerRoles.Planner or CodeBadgerRoles.Orchestrator or CodeBadgerRoles.Critic ? 2.0 : 1.0;
        return model.InputCost + model.OutputCost * outputWeight;
    }

    private string SessionAgentModelLabel(CodeBadgerTerminalSession session)
    {
        var role = GetModelSelectionRole(session);
        var orchestrationMode = CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode);
        var agentPreferences = GetAgentPreferences(Repository.AgentTool);
        var preference = agentPreferences.RolePreferences.FirstOrDefault(item => item.Role == role);
        var selectedRole = role;
        preference = agentPreferences.RolePreferences.FirstOrDefault(item => item.Role == selectedRole) ?? preference;
        var modelStateKey = CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode) switch
        {
            CodeBadgerOrchestrationModes.SingleAgent => "Model:SingleAgent",
            CodeBadgerOrchestrationModes.PlanBuild => "Model:" + (session.Mode == TerminalMode.Plan ? CodeBadgerRoles.Planner : CodeBadgerRoles.Worker),
            _ => "Model:" + selectedRole
        };
        var roleOverrideKey = orchestrationMode == CodeBadgerOrchestrationModes.SingleAgent ? "SingleAgent" : role;
        var storedModel = session.State.RoleModelOverrides.TryGetValue(roleOverrideKey, out var roleOverride) ? roleOverride :
            session.State.AgentSessionIds.TryGetValue(modelStateKey, out var activeModel) ? activeModel : null;
        var fallbackModel = CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode) switch
        {
            CodeBadgerOrchestrationModes.SingleAgent => agentPreferences.SingleAgentPreferredModels.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)),
            CodeBadgerOrchestrationModes.PlanBuild when role == CodeBadgerRoles.Planner => agentPreferences.PlanPreferredModels.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)),
            CodeBadgerOrchestrationModes.PlanBuild when role == CodeBadgerRoles.Worker => agentPreferences.BuildPreferredModels.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)),
            _ => preference?.PreferredModels.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))
        };
        var model = storedModel ??
            (!string.IsNullOrWhiteSpace(_settings.CodeBadgerTerminalModel) ? _settings.CodeBadgerTerminalModel : null) ??
            fallbackModel ?? _agentModelReference;
        var currentAgent = Repository.AgentTool == AgentTools.OpenCode ? "OpenCode" : AgentTools.GetDisplayName(Repository.AgentTool);
        var agent = preference is null ? "Build" : AgentTypeLabel(preference.AgentType, preference.CustomAgentId);
        return $"{currentAgent} · {RoleDisplayName(selectedRole)} · {agent}{(string.IsNullOrWhiteSpace(model) ? string.Empty : " · " + FormatModelName(model.Split('/').Last()))}";
    }

    private static string AgentTypeLabel(string agentType, string customAgentId) => agentType switch
    {
        "Primary" => "Primary",
        "Plan" => "Plan",
        "Build" => "Build",
        "Custom" => string.IsNullOrWhiteSpace(customAgentId) ? "Custom" : customAgentId,
        _ => agentType
    };

    private async Task PersistTerminalStateAsync(bool synchronizeOpenCodeSelection = true)
    {
        // Agent sessions are created/rotated internally, without a parameter update.
        // Keep the visible TUI attached to the selected tab's current role before rendering.
        if (synchronizeOpenCodeSelection)
            SynchronizeOpenCodeSessionSelection();
        if (_terminalState.RepositoryId == Guid.Empty) return;
        try { await TerminalStateService.SaveAsync(_terminalState); }
        catch (Exception exception) { Logger.LogWarning(exception, "Could not persist CodeBadger terminal state for repository {RepositoryId}.", Repository.Id); }
    }

    [JSInvokable]
    public Task SetAiPanelSize(double percent) => InvokeAsync(() =>
    {
        _aiPanelHeight = Math.Clamp(percent, 0, 100);
        _aiPanelMode = _aiPanelHeight <= 5 ? AiPanelMode.Collapsed
            : _aiPanelHeight >= 95 ? AiPanelMode.Expanded : AiPanelMode.Split;
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;
        _agentStatusRotationTimer?.Dispose();
        _agentStatusRotationTimer = null;

        if (_splitterModule is not null)
        {
            try
            {
                await _splitterModule.InvokeVoidAsync("detach", _terminalStack);
                await _splitterModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        if (_conversationScrollModule is not null)
        {
            try { await _conversationScrollModule.InvokeVoidAsync("detach", _terminalStack); }
            catch (JSDisconnectedException) { }
            await _conversationScrollModule.DisposeAsync();
        }
        if (_composerModule is not null)
        {
            try { await _composerModule.InvokeVoidAsync("detach", _terminalStack); }
            catch (JSDisconnectedException) { }
            await _composerModule.DisposeAsync();
        }
        _selfReference?.Dispose();
    }

    private enum AiPanelMode { Split, Collapsed, Expanded }
    private enum TerminalMode { Plan, Build }
    private enum TerminalCommandResult { NotACommand, Handled, SubmitPrompt, Commit }
    private enum AgentRoleProgress { NotStarted, Working, Waiting, Completed, Stopped, Failed }

    private sealed class SessionCostLimitReachedException(string message) : InvalidOperationException(message);

    private sealed class CodeBadgerTerminalSession
    {
        public CodeBadgerTerminalSession(CodeBadgerTerminalSessionState state) => State = state;
        public CodeBadgerTerminalSessionState State { get; }
        public Guid Id => State.Id;
        public string Title => State.Title;
        public string Input { get; set; } = string.Empty;
        public List<string> InputImages { get; } = [];
        public Dictionary<string, string?> InteractionAnswers { get; } = new(StringComparer.Ordinal);
        public TerminalMode Mode { get; set; } = TerminalMode.Plan;
        public List<CodeBadgerTerminalMessage> Messages => State.Messages;
        public bool IsBusy { get; set; }
        public Dictionary<string, AgentRoleProgress> RoleProgress { get; } = new(StringComparer.Ordinal);
        public bool IsRotatingAgentRole { get; set; }
        public bool IsSubmitting { get; set; }
        public bool PendingCommitMessage { get; set; }
        public string? Error { get; set; }
        public CancellationTokenSource? RunCancellation { get; set; }
        public string? ActiveAgentSessionId { get; set; }
        public string ActiveAgentTool { get; set; } = string.Empty;
    }

