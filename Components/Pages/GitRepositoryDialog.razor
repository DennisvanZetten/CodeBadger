    private static string GetFileStatusIcon(GitFileChange file)
    {
        if (file.IsConflicted)
            return Icons.Material.Filled.Warning;

        var status = file.Status;
        if (file.IsUntracked || status.Contains('A') || status.Contains('?'))
            return Icons.Material.Filled.Add;
        if (status.Contains('D'))
            return Icons.Material.Filled.Remove;
        return Icons.Material.Filled.Edit;
    }

    private async Task StashChangesAsync()
    {
        _isOperating = true;
        try
        {
            var result = await GitBranchService.StashChangesAsync(RepositoryPath);
            Snackbar.Add(result.Success ? L.T("Changes stashed.") : result.Message,
                result.Success ? Severity.Success : Severity.Error);
            await RefreshAsync();
            await RefreshStashesAsync();
            if (result.Success)
            {
                _view = GitView.History;
                await InvokeAsync(StateHasChanged);
            }
        }
