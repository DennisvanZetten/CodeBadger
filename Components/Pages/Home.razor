@page "/"
@inject LauncherSettingsService SettingsService
@inject GitBranchService GitBranchService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Repo Launcher</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-5 repository-home">
    @if (_activeRepositories.Count == 0)
    {
        <MudPaper Class="pa-6" Outlined="true" Elevation="0">
            <MudStack Spacing="2" AlignItems="AlignItems.Center">
                <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.h6">Nog geen actieve repositories</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Open Instellingen rechtsboven en voeg repositories toe of activeer ze.</MudText>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <MudTabs @bind-ActivePanelIndex="_activeTabIndex" KeepPanelsAlive="true" Rounded="true" Border="true" ApplyEffectsToContainer="true" Class="repository-tabs">
            @foreach (var repository in _activeRepositories)
            {
                <MudTabPanel @key="repository.Id" Text="@RepositoryTitle(repository)" Icon="@Icons.Material.Filled.Folder">
                    <div class="repository-workspace">
                        @if (!Directory.Exists(repository.Path))
                        {
                            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">Repositorypad bestaat niet: @repository.Path. Pas het pad aan via Instellingen.</MudAlert>
                        }
                        else
                        {
                            <MudPaper Outlined="true" Elevation="0" Class="repository-terminal-panel">
                                <RepositoryTerminal @key="repository.Id" SessionId="repository.Id" RepositoryPath="@repository.Path"
                                                    Command="@_settings.ToolCommand" IsVisible="@(_activeRepositories.IndexOf(repository) == _activeTabIndex)" />
                            </MudPaper>
                            <MudPaper Outlined="true" Elevation="0" Class="pa-4 repository-git-panel">
                                <MudStack Spacing="2">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="flex-wrap">
                                            <MudText Typo="Typo.subtitle1">Git</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@BranchLabel(repository)</MudText>
                                            @if (_gitSnapshots.TryGetValue(repository, out var snapshot) && snapshot.IsValid)
                                            {
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@snapshot.ChangedFiles gewijzigd</MudChip>
                                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">↑ @snapshot.Ahead</MudChip>
                                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">↓ @snapshot.Behind</MudChip>
                                            }
                                        </MudStack>
                                        <MudStack Row="true" Spacing="1">
                                            <MudIconButton Icon="@Icons.Material.Filled.Refresh" aria-label="Git-status vernieuwen" Disabled="@_isRefreshingBranches" OnClick="@(() => RefreshRepositoryAsync(repository))" />
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AccountTree"
                                                       Disabled="@(!_gitSnapshots.TryGetValue(repository, out var gitSnapshot) || !gitSnapshot.IsValid)"
                                                       OnClick="@(() => OpenGitDialogAsync(repository))">Git-overzicht</MudButton>
                                        </MudStack>
                                    </MudStack>
                                    @if (_gitSnapshots.TryGetValue(repository, out var status) && !status.IsValid)
                                    {
                                        <MudAlert Dense="true" Severity="Severity.Warning" Variant="Variant.Outlined">@status.Error — controleer of Git is geïnstalleerd en het pad een repository is.</MudAlert>
                                    }
                                </MudStack>
                            </MudPaper>
                        }
                    </div>
                </MudTabPanel>
            }
        </MudTabs>
    }
</MudContainer>

@code {
    private LauncherSettings _settings = new();
    private List<RepositoryEntry> _activeRepositories = [];
    private readonly Dictionary<RepositoryEntry, GitBranchInfo> _branches = [];
    private readonly Dictionary<RepositoryEntry, GitRepositorySnapshot> _gitSnapshots = [];
    private bool _isRefreshingBranches;
    private int _activeTabIndex;

    protected override async Task OnInitializedAsync()
    {
        _settings = await SettingsService.LoadAsync();
        SettingsService.SettingsSaved += HandleSettingsSaved;
        SyncRepositories();
        await RefreshBranches();
    }

    private void HandleSettingsSaved()
    {
        _ = InvokeAsync(async () =>
        {
            var oldTab = _activeTabIndex;
            _settings = await SettingsService.LoadAsync();
            SyncRepositories();
            _activeTabIndex = Math.Clamp(oldTab, 0, Math.Max(0, _activeRepositories.Count - 1));
            await RefreshBranches();
            StateHasChanged();
        });
    }

    private void SyncRepositories()
    {
        foreach (var repository in _settings.Repositories)
            if (repository.Id == Guid.Empty)
                repository.Id = Guid.NewGuid();
        _activeRepositories = _settings.Repositories.Where(repository => repository.IsActive).ToList();
        _activeTabIndex = Math.Clamp(_activeTabIndex, 0, Math.Max(0, _activeRepositories.Count - 1));
        foreach (var repository in _branches.Keys.Where(repository => !_settings.Repositories.Contains(repository)).ToList())
            _branches.Remove(repository);
        foreach (var repository in _gitSnapshots.Keys.Where(repository => !_settings.Repositories.Contains(repository)).ToList())
            _gitSnapshots.Remove(repository);
    }

    private static string RepositoryTitle(RepositoryEntry repository) => string.IsNullOrWhiteSpace(repository.Name)
        ? Path.GetFileName(Path.TrimEndingDirectorySeparator(repository.Path))
        : repository.Name;

    private async Task RefreshBranches(bool force = false)
    {
        if (_isRefreshingBranches && !force)
            return;

        _isRefreshingBranches = true;
        try
        {
            var results = await Task.WhenAll(_activeRepositories.Select(async repository =>
                (Repository: repository,
                 Snapshot: await GitBranchService.GetRepositorySnapshotAsync(repository.Path),
                 Branch: await GitBranchService.GetCurrentBranchAsync(repository.Path))));

            _branches.Clear();
            _gitSnapshots.Clear();
            foreach (var result in results)
            {
                _branches[result.Repository] = result.Branch;
                _gitSnapshots[result.Repository] = result.Snapshot;
            }
        }
        finally
        {
            _isRefreshingBranches = false;
        }
    }

    private async Task OpenGitDialogAsync(RepositoryEntry repository)
    {
        var parameters = new DialogParameters<GitRepositoryDialog>
        {
            { dialog => dialog.RepositoryName, repository.Name },
            { dialog => dialog.RepositoryPath, repository.Path },
            { dialog => dialog.AiSettings, _settings }
        };
        var options = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.ExtraExtraLarge, CloseButton = true, NoHeader = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<GitRepositoryDialog>("Git-overzicht", parameters, options);
        await dialog.Result;
        await RefreshBranches();
    }

    private async Task RefreshAllAsync()
    {
        if (_isRefreshingBranches)
            return;

        _isRefreshingBranches = true;
        try
        {
            var fetchResults = await Task.WhenAll(_activeRepositories
                .Where(repository => !string.IsNullOrWhiteSpace(repository.Path) && Directory.Exists(repository.Path))
                .Select(repository => GitBranchService.FetchAsync(repository.Path)));
            var failures = fetchResults.Count(result => !result.Success);
            if (failures > 0)
                Snackbar.Add($"Fetch mislukt voor {failures} repository(s).", Severity.Warning);

            await RefreshBranches(force: true);
        }
        finally
        {
            _isRefreshingBranches = false;
        }
    }

    private async Task RefreshRepositoryAsync(RepositoryEntry repository)
    {
        _isRefreshingBranches = true;
        try
        {
            if (Directory.Exists(repository.Path))
            {
                var fetch = await GitBranchService.FetchAsync(repository.Path);
                if (!fetch.Success)
                    Snackbar.Add($"Git fetch mislukt: {fetch.Message}", Severity.Warning);
            }
            await RefreshBranches(force: true);
        }
        finally
        {
            _isRefreshingBranches = false;
        }
    }

    private string BranchLabel(RepositoryEntry repository)
    {
        if (_isRefreshingBranches)
            return "Branch: ophalen...";

        if (!_branches.TryGetValue(repository, out var branchInfo))
            return "Branch: nog niet opgehaald";

        return branchInfo.Branch is not null
            ? $"Branch: {branchInfo.Branch}"
            : $"Branch: {branchInfo.Status}";
    }

    public void Dispose() => SettingsService.SettingsSaved -= HandleSettingsSaved;
}
