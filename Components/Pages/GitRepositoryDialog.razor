    private Task PopContextStashAsync()
    {
        var stash = _contextMenuStash;
        CloseStashContextMenu();
        return stash is null ? Task.CompletedTask : PopStashAsync(stash);
    }

    private async Task DeleteContextStashAsync()
    {
        var stash = _contextMenuStash;
        CloseStashContextMenu();
        if (stash is null || _isOperating)
            return;

        var confirmed = await DialogService.ShowMessageBoxAsync(
            L.T("Delete stash"), L.T("Delete stash '{0}'? This cannot be undone.", stash.Message),
            yesText: L.T("Delete"), cancelText: L.T("Cancel"));
        if (confirmed != true)
            return;

        _isOperating = true;
        try
        {
            var result = await GitBranchService.DropStashAsync(RepositoryPath, GetCurrentStashReference(stash));
            Snackbar.Add(result.Success ? L.T("Stash deleted.") : L.T("Could not delete stash: {0}", result.Message),
                result.Success ? Severity.Success : Severity.Error);
            if (result.Success)
                _hiddenStashCommitHashes.Remove(stash.CommitHash);
            await SaveHiddenStashesAsync();
            await RefreshAsync();
            await RefreshStashesAsync();
        }
        finally
        {
            _isOperating = false;
        }
    }

    private void EditContextStashMessage()
    {
        _stashBeingEdited = _contextMenuStash;
        _editedStashMessage = GetStashMessageForEditing(_stashBeingEdited?.Message);
        CloseStashContextMenu();
    }

    private static string GetStashMessageForEditing(string? message)
    {
        if (string.IsNullOrWhiteSpace(message))
            return string.Empty;

        var separator = message.IndexOf(": ", StringComparison.Ordinal);
        return separator >= 0 && (message.StartsWith("On ", StringComparison.Ordinal) || message.StartsWith("WIP on ", StringComparison.Ordinal))
            ? message[(separator + 2)..]
            : message;
    }

    private void CloseEditStashDialog()
    {
        if (_isOperating)
            return;
        _stashBeingEdited = null;
        _editedStashMessage = string.Empty;
    }

    private void HandleEditStashKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            _ = SaveStashMessageAsync();
        else if (args.Key == "Escape")
            CloseEditStashDialog();
    }

    private async Task SaveStashMessageAsync()
    {
        var stash = _stashBeingEdited;
        if (stash is null || _isOperating || string.IsNullOrWhiteSpace(_editedStashMessage))
            return;

        _isOperating = true;
        try
        {
            var result = await GitBranchService.EditStashMessageAsync(RepositoryPath, stash, _editedStashMessage);
            Snackbar.Add(result.Success ? L.T("Stash message updated.") : result.Message,
                result.Success ? Severity.Success : Severity.Error);
            if (result.Success)
            {
                _stashBeingEdited = null;
                _editedStashMessage = string.Empty;
                await RefreshStashesAsync();
            }
        }
        finally
        {
            _isOperating = false;
        }
    }

    private string GetCurrentStashReference(GitStashEntry stash)
    {
        var currentIndex = _stashes.ToList().FindIndex(entry =>
            string.Equals(entry.Reference, stash.Reference, StringComparison.Ordinal) &&
            string.Equals(entry.CommitHash, stash.CommitHash, StringComparison.Ordinal));
        if (currentIndex < 0)
            currentIndex = _stashes.ToList().FindIndex(entry => string.Equals(entry.CommitHash, stash.CommitHash, StringComparison.Ordinal));
        return currentIndex >= 0 ? $"stash@{{{currentIndex}}}" : stash.Reference;
    }

    private void ToggleHiddenStashes() => _showHiddenStashes = !_showHiddenStashes;

    private async Task ToggleContextStashHidden()
    {
        var stash = _contextMenuStash;
        CloseStashContextMenu();
        if (stash is null)
            return;

        if (!_hiddenStashCommitHashes.Add(stash.CommitHash))
            _hiddenStashCommitHashes.Remove(stash.CommitHash);
        await SaveHiddenStashesAsync();
    }

    private async Task SaveHiddenStashesAsync()
    {
        if (RepositorySettings is null)
            return;
        RepositorySettings.HiddenStashCommitHashes = _hiddenStashCommitHashes.ToList();
        var settings = await LauncherSettingsService.LoadAsync();
        var repository = settings.Repositories.FirstOrDefault(entry => entry.Id == RepositorySettings.Id);
        if (repository is null)
            return;
        repository.HiddenStashCommitHashes = RepositorySettings.HiddenStashCommitHashes.ToList();
        await LauncherSettingsService.SaveAsync(settings);
    }

    private Task HandleStashKeyDownAsync(KeyboardEventArgs args, GitStashEntry stash) =>
        args.Key is "Enter" or " " ? PopStashAsync(stash) : Task.CompletedTask;

    private async Task RefreshStashesAsync()
    {
        _stashes = await GitBranchService.GetStashesAsync(RepositoryPath);
        await InvokeAsync(StateHasChanged);
    }

    private static Color GetFileStatusColor(GitFileChange file)
    {
        if (file.IsConflicted)
            return Color.Error;

        var status = file.Status;
        if (file.IsUntracked || status.Contains('A') || status.Contains('?'))
            return Color.Success;
        if (status.Contains('D'))
            return Color.Error;
        return Color.Warning;
    }

