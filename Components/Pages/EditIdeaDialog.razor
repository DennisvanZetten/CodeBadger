@inject IdeaListService Ideas
@inject LocalizationService L
@inject LauncherSettingsService SettingsService

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@L.T("Edit item")</MudText></TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_title" Label="@L.T("Title")" Required="true" MaxLength="160" AutoFocus="true" />
            <MudSelect T="IdeaType" @bind-Value="_type" Label="@L.T("Type")">
                <MudSelectItem Value="IdeaType.Idea">@L.T("Idea")</MudSelectItem>
                <MudSelectItem Value="IdeaType.Wish">@L.T("Wish")</MudSelectItem>
                <MudSelectItem Value="IdeaType.Task">@L.T("Task")</MudSelectItem>
                <MudSelectItem Value="IdeaType.Bug">@L.T("Bug")</MudSelectItem>
                <MudSelectItem Value="IdeaType.Story">@L.T("Story")</MudSelectItem>
            </MudSelect>
            <MudTextField @bind-Value="_description" Label="@L.T("Description (optional)")" Lines="4" MaxLength="2000" />
            <MudSelect T="IdeaStatus" @bind-Value="_status" Label="@L.T("Status")">
                <MudSelectItem Value="IdeaStatus.Open">@L.T("Open")</MudSelectItem>
                <MudSelectItem Value="IdeaStatus.InProgress">@L.T("In progress")</MudSelectItem>
                <MudSelectItem Value="IdeaStatus.Done">@L.T("Done")</MudSelectItem>
            </MudSelect>
            @if (string.IsNullOrWhiteSpace(Item.SessionId))
            {
                <MudSelect T="string" @bind-Value="_repositoryId" Label="@L.T("Repository")" Clearable="true">
                    @foreach (var repository in _repositories)
                    {
                        <MudSelectItem Value="repository.Id.ToString()">@RepositoryName(repository)</MudSelectItem>
                    }
                </MudSelect>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L.T("Cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@(_saving || string.IsNullOrWhiteSpace(_title))" OnClick="SaveAsync">
            @L.T("Save")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public IdeaItem Item { get; set; } = null!;

    private List<RepositoryEntry> _repositories = [];
    private string _title = string.Empty;
    private string _description = string.Empty;
    private string? _repositoryId;
    private IdeaType _type;
    private IdeaStatus _status;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        _title = Item.Title;
        _description = Item.Description;
        _type = Item.Type;
        _status = Item.Status;
        _repositoryId = Item.RepositoryId?.ToString();

        if (!string.IsNullOrWhiteSpace(Item.SessionId))
            return;

        var settings = await SettingsService.LoadAsync();
        _repositories = settings.Repositories
            .Where(repository => repository.IsActive && !repository.OpenCodeSandboxEnabled &&
                AgentTools.Normalize(repository.AgentTool) == AgentTools.OpenCode && Directory.Exists(repository.Path))
            .OrderBy(RepositoryName, StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (_repositoryId is not null && !_repositories.Any(repository => repository.Id.ToString() == _repositoryId))
            _repositoryId = null;
    }

    private async Task SaveAsync()
    {
        if (_saving || string.IsNullOrWhiteSpace(_title))
            return;

        _saving = true;
        var repository = Guid.TryParse(_repositoryId, out var id)
            ? _repositories.FirstOrDefault(candidate => candidate.Id == id)
            : null;
        if (await Ideas.UpdateEditableFieldsAsync(Item.Id, _title, _description, _type, _status, repository))
        {
            Item.Title = _title.Trim();
            Item.Description = _description.Trim();
            Item.Type = _type;
            Item.Status = _status;
            if (string.IsNullOrWhiteSpace(Item.SessionId))
            {
                Item.RepositoryId = repository?.Id;
                Item.RepositoryName = repository is null ? string.Empty : RepositoryName(repository);
                Item.RepositoryPath = repository?.Path ?? string.Empty;
            }
            MudDialog.Close(DialogResult.Ok(true));
        }
        _saving = false;
    }

    private string RepositoryName(RepositoryEntry repository) => string.IsNullOrWhiteSpace(repository.Name)
        ? Path.GetFileName(Path.TrimEndingDirectorySeparator(repository.Path))
        : repository.Name;

    private void Cancel() => MudDialog.Cancel();
}
