    </MudButton>;

    private static IReadOnlyList<BranchFolder> GroupBranchesIntoFolders(IReadOnlyList<GitBranchEntry> branches) => branches
        .Select(branch =>
        {
            var separator = branch.Name.LastIndexOf('/');
            return separator < 0
                ? new BranchFolder(null, new[] { branch })
                : new BranchFolder(branch.Name[..separator], new[] { branch });
        })
        .GroupBy(item => item.Name, StringComparer.OrdinalIgnoreCase)
        .Select(group => new BranchFolder(group.Key, group.SelectMany(item => item.Branches).ToList()))
        .OrderBy(folder => folder.Name is null ? 1 : 0)
        .ThenBy(folder => folder.Name, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private static string BranchLeafName(string branchName)
    {
        var separator = branchName.LastIndexOf('/');
        return separator < 0 ? branchName : branchName[(separator + 1)..];
    }

    private void ToggleBranchPanel() => _isBranchPanelCollapsed = !_isBranchPanelCollapsed;

    private void ExpandBranchPanel() => _isBranchPanelCollapsed = false;

    private void ToggleCommitFilesPanel() => _isCommitFilesPanelCollapsed = !_isCommitFilesPanelCollapsed;

    private bool IsSelectedCommit(GitCommitEntry commit) => _selectedCommitHash == commit.Hash;

    private void ToggleSoloBranch(GitCommitBranchLabel label)
    {
        _soloBranchName = string.Equals(_soloBranchName, label.Name, StringComparison.Ordinal) ? null : label.Name;
        RefreshSoloBranchCommits();
        CloseCommitContextMenu();
    }

    private void RefreshSoloBranchCommits()
    {
        _soloBranchCommitHashes.Clear();
        if (_soloBranchName is null || _snapshot is null)
            return;

        var branch = _snapshot.Commits
            .SelectMany(commit => commit.BranchLabels ?? [])
            .FirstOrDefault(label => string.Equals(label.Name, _soloBranchName, StringComparison.Ordinal));
        if (branch is null)
        {
            _soloBranchName = null;
            return;
        }

        var commitsByHash = _snapshot.Commits.ToDictionary(commit => commit.Hash, StringComparer.Ordinal);
        var pending = new Stack<string>();
        pending.Push(branch.TipHash);
        while (pending.TryPop(out var hash))
        {
            if (!_soloBranchCommitHashes.Add(hash) || !commitsByHash.TryGetValue(hash, out var commit))
                continue;

            foreach (var parent in commit.Parents)
                pending.Push(parent);
        }
    }

    private bool IsSoloDimmedCommit(GitCommitEntry commit) =>
        _soloBranchName is not null && !_soloBranchCommitHashes.Contains(commit.Hash);

    private bool IsSoloDimmedBranchLabel(GitCommitBranchLabel label) =>
        _soloBranchName is not null && !string.Equals(label.Name, _soloBranchName, StringComparison.Ordinal);

    private bool IsSoloDimmedGraphEdge(GitGraphEdge edge) =>
        _soloBranchName is not null && !_soloBranchCommitHashes.Contains(edge.PathHash);

    private async Task HandleCommitRowClickAsync(MouseEventArgs args, GitCommitEntry commit)
    {
        if (args.Detail >= 2)
        {
            await CheckoutCommitBranchAsync(commit);
            return;
        }

        await SelectCommit(commit);
    }

    private async Task CheckoutCommitBranchAsync(GitCommitEntry commit)
    {
        if (_isOperating || _snapshot is null)
            return;

        var label = commit.BranchLabels?
            .Where(branchLabel => branchLabel.IsLocal)
            .OrderBy(branchLabel => string.Equals(branchLabel.Name, _snapshot.Branch, StringComparison.Ordinal))
            .FirstOrDefault()
            ?? GetPathBranchLabel(commit);
        var branch = label is { IsLocal: true }
            ? LocalBranches.FirstOrDefault(candidate => string.Equals(candidate.Name, label.Name, StringComparison.Ordinal))?.Name
            : label is { IsRemote: true }
                ? RemoteBranches.FirstOrDefault(candidate => candidate.Name == label.Name)?.Name
                : null;

        branch ??= RemoteBranches.FirstOrDefault(candidate => candidate.TipHash == commit.Hash)?.Name;
        if (branch is null)
        {
            Snackbar.Add(L.T("No branch is attached to this commit."), Severity.Warning);
            return;
        }

        await CheckoutBranchAsync(branch);
    }

    private async Task SelectCommit(GitCommitEntry commit)
    {
        if (IsSelectedCommit(commit))
        {
            _selectedCommitHash = null;
            _selectedCommit = null;
            _commitFiles = [];
            _selectedCommitFile = null;
            _selectedCommitFileDiff = string.Empty;
            return;
        }

        _selectedCommitHash = commit.Hash;
        _selectedCommit = commit;
        _selectedCommitFile = null;
        _selectedCommitFileDiff = string.Empty;
        _isCommitFilesPanelCollapsed = false;
        _isLoadingCommitFiles = true;
        try
        {
            var result = await GitBranchService.GetCommitFilesAsync(RepositoryPath, commit.Hash);
            _commitFiles = result.Success ? ParseCommitFiles(result.Output) : [];
            if (!result.Success)
                _selectedCommitFileDiff = result.Message;
        }
        finally
        {
            _isLoadingCommitFiles = false;
        }
    }

    private async Task SelectCommitFileAsync(GitCommitFile file)
    {
        if (_selectedCommit is null)
            return;

        _selectedCommitFile = file;
        _isLoadingCommitFileDiff = true;
        try
        {
            var result = await GitBranchService.GetCommitFileDiffAsync(RepositoryPath, _selectedCommit.Hash, file.Path);
            _selectedCommitFileDiff = result.Success ? result.Output : result.Message;
        }
        finally
        {
            _isLoadingCommitFileDiff = false;
        }
    }

    private async Task OpenCommitContextMenuAsync(GitCommitEntry commit, MouseEventArgs args)
    {
        _contextMenuCommit = commit;
        _contextMenuX = args.ClientX;
        _contextMenuY = args.ClientY;
        _contextMenuNeedsPosition = true;
        _isCommitOnCurrentBranch = null;
        _isCheckingCherryPick = true;
        _contextMenuTargetBranch = _snapshot?.Branch;
        _contextMenuMergeBranch = ResolveMergeBranch(commit);
        _isCheckingMergeBranch = _contextMenuMergeBranch is not null && !string.IsNullOrWhiteSpace(_contextMenuTargetBranch);
        _mergeBranchReady = false;
        _mergeBranchError = null;
        await InvokeAsync(StateHasChanged);

        var check = await GitBranchService.IsCommitOnCurrentBranchAsync(RepositoryPath, commit.Hash);
        if (_contextMenuCommit?.Hash != commit.Hash)
            return;
        _isCommitOnCurrentBranch = check.IsOnCurrentBranch;
        _isCheckingCherryPick = false;
        if (check.Error is not null)
            Snackbar.Add(check.Error, Severity.Error);
        var sourceBranch = _contextMenuMergeBranch;
        if (sourceBranch is not null && _isCheckingMergeBranch)
        {
            var mergeCheck = await GitBranchService.CheckBranchCanMergeAsync(RepositoryPath, sourceBranch);
            if (_contextMenuCommit?.Hash != commit.Hash || !string.Equals(_contextMenuMergeBranch, sourceBranch, StringComparison.Ordinal))
                return;

            _isCheckingMergeBranch = false;
            _mergeBranchReady = mergeCheck.CanMerge && !string.IsNullOrWhiteSpace(_contextMenuTargetBranch);
            _mergeBranchError = mergeCheck.Error;
        }
    }

    private string? ResolveMergeBranch(GitCommitEntry commit)
    {
        var labels = commit.BranchLabels ?? [];
        var candidates = labels.Where(label => label.IsLocal && !string.Equals(label.Name, _snapshot?.Branch, StringComparison.Ordinal));
        var label = candidates.FirstOrDefault() ?? GetPathBranchLabel(commit);
        return label is { IsLocal: true } && !string.Equals(label.Name, _snapshot?.Branch, StringComparison.Ordinal) &&
               LocalBranches.Any(branch => string.Equals(branch.Name, label.Name, StringComparison.Ordinal))
            ? label.Name
            : null;
    }

    private void CloseCommitContextMenu()
    {
        _contextMenuCommit = null;
        _isCommitOnCurrentBranch = null;
        _contextMenuMergeBranch = null;
        _contextMenuTargetBranch = null;
        _isCheckingMergeBranch = false;
        _mergeBranchReady = false;
        _mergeBranchError = null;
    }

    private async Task CopyCommitBranchNamesAsync(GitCommitEntry commit)
    {
        var branchNames = await GitBranchService.GetBranchesContainingCommitAsync(RepositoryPath, commit.Hash);
        var currentBranch = _snapshot?.Branch;
        if (branchNames.Count > 1 && !string.IsNullOrWhiteSpace(currentBranch))
        {
            var current = branchNames.FirstOrDefault(branch =>
                string.Equals(branch, currentBranch, StringComparison.Ordinal) ||
                branch.EndsWith('/' + currentBranch, StringComparison.Ordinal));
            if (current is not null)
                branchNames = new[] { current };
        }
        if (branchNames.Count == 0)
        {
            Snackbar.Add(L.T("No branch name is associated with this commit."), Severity.Info);
            return;
        }

        await CopyCommitValueAsync(string.Join(Environment.NewLine, branchNames), L.T("Branch name copied."));
    }

    private async Task CopyCommitInfoAsync(GitCommitEntry commit)
    {
        var commitInfo = $"{commit.Subject}\n{commit.Author} · {FormatDate(commit.Date)}";
        await CopyCommitValueAsync(commitInfo, L.T("Commit info copied."));
    }

    private Task CopyCommitMessageAsync(GitCommitEntry commit) =>
        CopyCommitValueAsync(commit.Subject, L.T("Commit message copied."));

    private Task CopyCommitShaAsync(GitCommitEntry commit) =>
        CopyCommitValueAsync(commit.Hash, L.T("Commit SHA copied."));

    private async Task CopyCommitValueAsync(string value, string successMessage)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", value);
            Snackbar.Add(successMessage, Severity.Success);
        }
        catch (JSException)
        {
            Snackbar.Add(L.T("Could not copy to clipboard."), Severity.Error);
        }
        CloseCommitContextMenu();
    }

    private void OpenCreateBranchDialog(string startPoint)
    {
        var commit = _snapshot?.Commits.FirstOrDefault(item => item.Hash == startPoint);
        _createBranchStartPoint = startPoint;
        _createBranchStartPointLabel = commit is null
            ? _snapshot?.Branch ?? "HEAD"
            : $"{commit.ShortHash} · {commit.Subject}";
        _newBranchName = string.Empty;
        CloseCommitContextMenu();
        _contextMenuNeedsPosition = false;
        _isCreateBranchDialogOpen = true;
    }

    private void CloseCreateBranchDialog()
    {
        if (_isCreatingBranch)
            return;
        _isCreateBranchDialogOpen = false;
    }

    private void HandleCreateBranchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !string.IsNullOrWhiteSpace(_newBranchName) && !_isCreatingBranch)
            _ = CreateBranchAsync();
        else if (args.Key == "Escape")
            CloseCreateBranchDialog();
    }

    private async Task CreateBranchAsync()
    {
        if (_isCreatingBranch || string.IsNullOrWhiteSpace(_newBranchName))
            return;

        _isCreatingBranch = true;
        try
        {
            var result = await GitBranchService.CreateAndCheckoutBranchAsync(RepositoryPath, _newBranchName, _createBranchStartPoint);
            if (!result.Success)
            {
                Snackbar.Add(L.T("Could not create branch: {0}", result.Message), Severity.Error);
                return;
            }

            _isCreateBranchDialogOpen = false;
            Snackbar.Add(L.T("Branch '{0}' created and checked out.", _newBranchName.Trim()), Severity.Success);
            await RefreshAsync();
        }
        finally
        {
            _isCreatingBranch = false;
        }
    }

    private async Task MergeSelectedBranchAsync()
    {
        var sourceBranch = _contextMenuMergeBranch;
        var targetBranch = _contextMenuTargetBranch;
        if (string.IsNullOrWhiteSpace(sourceBranch) || string.IsNullOrWhiteSpace(targetBranch) || !_mergeBranchReady || _isOperating)
            return;

        CloseCommitContextMenu();
        _isOperating = true;
        try
        {
            var result = await GitBranchService.MergeBranchIntoCurrentAsync(RepositoryPath, sourceBranch, targetBranch);
            Snackbar.Add(result.Success
                    ? L.T("Branch '{0}' merged into '{1}'.", sourceBranch, targetBranch)
                    : L.T("Merge failed: {0}", result.Message),
                result.Success ? Severity.Success : Severity.Error);
            await RefreshAsync();
        }
        finally
        {
            _isOperating = false;
        }
    }

    private async Task CheckoutSelectedCommitAsync()
    {
        var commit = _contextMenuCommit;
        if (commit is null || _isOperating)
            return;

        CloseCommitContextMenu();
        _contextMenuNeedsPosition = false;
        _isOperating = true;
        try
        {
            var result = await GitBranchService.CheckoutCommitAsync(RepositoryPath, commit.Hash);
            Snackbar.Add(result.Success
                    ? L.T("Checked out commit {0} in detached HEAD.", commit.ShortHash)
                    : L.T("Could not check out commit: {0}", result.Message),
                result.Success ? Severity.Success : Severity.Error);
            await RefreshAsync();
        }
        finally
        {
            _isOperating = false;
        }
    }

    private async Task CherryPickSelectedCommitAsync()
    {
        var commit = _contextMenuCommit;
        if (commit is null || _isCheckingCherryPick || _isCommitOnCurrentBranch != false || _isOperating)
            return;

        CloseCommitContextMenu();
        _isOperating = true;
        try
        {
            var branchCheck = await GitBranchService.IsCommitOnCurrentBranchAsync(RepositoryPath, commit.Hash);
            if (branchCheck.IsOnCurrentBranch != false)
            {
                Snackbar.Add(branchCheck.IsOnCurrentBranch == true
                        ? L.T("Commit is already on the current branch.")
                        : branchCheck.Error ?? L.T("Git status unavailable."),
                    branchCheck.Error is null ? Severity.Warning : Severity.Error);
                return;
            }

            var result = await GitBranchService.CherryPickCommitAsync(RepositoryPath, commit.Hash);
            Snackbar.Add(result.Success
                    ? L.T("Cherry-pick completed for commit {0}.", commit.ShortHash)
                    : L.T("Cherry-pick failed: {0}", result.Message),
                result.Success ? Severity.Success : Severity.Error);
            await RefreshAsync();
        }
        finally
        {
            _isOperating = false;
        }
    }

    private async Task RevertSelectedCommitAsync()
    {
        var commit = _contextMenuCommit;
        if (commit is null || _isOperating)
            return;

        var confirmed = await DialogService.ShowMessageBoxAsync(
            L.T("Revert commit?"),
            (MarkupString)string.Format(L.T("Revert commit confirmation"), commit.ShortHash, commit.Subject),
            yesText: L.T("Revert commit"),
            cancelText: L.T("Cancel"),
            options: new DialogOptions { CloseOnEscapeKey = true });
        if (confirmed != true || _contextMenuCommit?.Hash != commit.Hash)
            return;

        CloseCommitContextMenu();
        _isOperating = true;
        try
        {
            var result = await GitBranchService.RevertCommitAsync(RepositoryPath, commit.Hash);
            Snackbar.Add(result.Success
                    ? L.T("Revert commit completed for {0}.", commit.ShortHash)
                    : L.T("Revert commit failed: {0}", result.Message),
                result.Success ? Severity.Success : Severity.Error);
            await RefreshAsync();
        }
        finally
        {
            _isOperating = false;
        }
    }

    private async Task ResetSelectedCommitAsync(string mode)
    {
        var commit = _contextMenuCommit;
        if (commit is null || _isOperating || mode is not ("soft" or "mixed" or "hard"))
            return;

        var title = mode == "hard" ? L.T("Hard reset branch?") : L.T("Reset branch?");
        var confirmation = mode switch
        {
            "soft" => L.T("Reset soft confirmation"),
            "mixed" => L.T("Reset mixed confirmation"),
            _ => L.T("Reset hard confirmation")
        };
        var confirmed = await DialogService.ShowMessageBoxAsync(
            title,
            (MarkupString)string.Format(confirmation, commit.ShortHash, commit.Subject),
            yesText: mode == "hard" ? L.T("Hard reset") : L.T("Reset branch"),
            cancelText: L.T("Cancel"),
            options: new DialogOptions { CloseOnEscapeKey = true });
        if (confirmed != true || _contextMenuCommit?.Hash != commit.Hash)
            return;

        CloseCommitContextMenu();
        _isOperating = true;
        try
        {
            var result = await GitBranchService.ResetToCommitAsync(RepositoryPath, commit.Hash, mode);
            Snackbar.Add(result.Success
                    ? L.T("Reset {0} completed for commit {1}.", mode, commit.ShortHash)
                    : L.T("Reset failed: {0}", result.Message),
                result.Success ? Severity.Success : Severity.Error);
            await RefreshAsync();
        }
        finally
        {
            _isOperating = false;
        }
    }

    private static IReadOnlyList<GitCommitFile> ParseCommitFiles(string output) => output
        .Split('\n', StringSplitOptions.RemoveEmptyEntries)
        .Select(line => line.TrimEnd('\r').Split('\t'))
        .Where(parts => parts.Length >= 2)
        .Select(parts => new GitCommitFile(parts[^1], parts[0]))
        .ToList();

    private void HandleCommitRowKeyDown(KeyboardEventArgs args, GitCommitEntry commit)
    {
        if (args.Key is "Enter" or " ")
            _ = SelectCommit(commit);
    }

    private GitCommitBranchLabel? GetPathBranchLabel(GitCommitEntry commit)
    {
        if (commit.BranchLabels is { Count: > 0 })
            return commit.BranchLabels[0];

        if (_snapshot is null)
            return null;

        var currentIndex = _snapshot.Commits.ToList().FindIndex(candidate => candidate.Hash == commit.Hash);
        if (currentIndex < 0)
            return null;

        return _snapshot.Commits
            .SelectMany((candidate, index) => (candidate.BranchLabels ?? [])
                .Where(label => label.Color == commit.GraphColor)
                .Select(label => (Label: label, Distance: Math.Abs(index - currentIndex), Index: index)))
            .OrderBy(item => item.Distance)
            .ThenBy(item => item.Index < currentIndex ? 1 : 0)
            .Select(item => item.Label)
            .FirstOrDefault();
    }

