@using System.Globalization
@inject LocalizationService L
@inject GitBranchService GitBranchService
@inject AiCommitMessageService AiCommitMessageService
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@implements IAsyncDisposable

<MudDialog Class="git-overview-dialog">
    <DialogContent>
        <div class="git-overview-content">
            @if (_isLoading && _snapshot is null)
            {
                <MudStack Spacing="3" Class="git-overview-main git-overview-initial-loading">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap">
                        <MudText Typo="Typo.subtitle1">@RepositoryName</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" aria-label="@L.T("Close")" OnClick="Close" />
                    </MudStack>
                    <div class="git-overview-progress git-overview-progress-active" aria-live="polite">
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                        <span>@L.T(_loadingStage)</span>
                        @if (_loadedBranchCount is not null)
                        {
                            <span class="git-overview-progress-count">@L.T("Branches loaded: {0}", _loadedBranchCount.Value)</span>
                        }
                    </div>
                    <div class="git-overview-loading-space"></div>
                </MudStack>
            }
            else if (_snapshot is null || !_snapshot.IsValid)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@(_snapshot?.Error ?? L.T("Git status unavailable."))</MudAlert>
                <MudIconButton Class="git-overview-close" Icon="@Icons.Material.Filled.Close" aria-label="@L.T("Close")" OnClick="Close" />
            }
            else
            {
              <MudStack Spacing="3" Class="git-overview-main">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.CallSplit">@_snapshot.Branch</MudChip>
                    </MudStack>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download"
                                   Disabled="@_isOperating" OnClick="PullAsync">@L.T("Pull ({0})", _snapshot.Behind)</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Upload"
                                   Disabled="@_isOperating" OnClick="PushAsync">@L.T("Push ({0})", _snapshot.Ahead)</MudButton>
                                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" aria-label="@L.T("Refresh Git status")"
                                       Disabled="@_isOperating" OnClick="@(() => RefreshAsync(fetch: true))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" aria-label="@L.T("Close")" OnClick="Close" />
                    </MudStack>
                </MudStack>
                <div class="git-overview-progress @(_isLoading ? "git-overview-progress-active" : "")" aria-live="polite">
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    <span>@L.T(_loadingStage)</span>
                    @if (_loadedBranchCount is not null)
                    {
                        <span class="git-overview-progress-count">@L.T("Branches loaded: {0}", _loadedBranchCount.Value)</span>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(_snapshot.Warning))
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@_snapshot.Warning</MudAlert>
                }

                <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" Class="git-view-switch">
                    <MudButton Class="@(_view == GitView.History ? "git-view-active" : "git-view-inactive")"
                               StartIcon="@Icons.Material.Filled.AccountTree" Color="@(_view == GitView.History ? Color.Primary : Color.Default)" Variant="@(_view == GitView.History ? Variant.Filled : Variant.Outlined)"
                                OnClick="@(() => _view = GitView.History)">@L.T("Branches & commits")</MudButton>
                    <MudButton Class="@(_view == GitView.Commit ? "git-view-active" : "git-view-inactive")"
                               StartIcon="@Icons.Material.Filled.EditNote" Color="@(_view == GitView.Commit ? Color.Primary : Color.Default)" Variant="@(_view == GitView.Commit ? Variant.Filled : Variant.Outlined)"
                                OnClick="@(() => SwitchToCommitViewAsync())">@L.T("Create commit")</MudButton>
                </MudButtonGroup>

                @if (_snapshot.Conflicts.Count > 0)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Warning">
                        <MudText Typo="Typo.subtitle2">@L.T("Conflicts found ({0})", _snapshot.Conflicts.Count)</MudText>
                        <MudStack Spacing="1" Class="mt-2">
                            @foreach (var conflict in _snapshot.Conflicts)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" @key="conflict">
                                    <MudText Typo="Typo.body2" Class="text-break">@conflict</MudText>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.CompareArrows"
                                                OnClick="@(() => OpenConflictAsync(conflict))">@L.T("Compare in VS Code")</MudButton>
                                </MudStack>
                            }
                        </MudStack>
                    </MudAlert>
                }

                @if (_view == GitView.History)
                {
                    <div class="git-history-workspace @(_isBranchPanelCollapsed ? "git-history-workspace-collapsed" : "")">
                        <MudPaper Class="pa-3 git-dialog-panel git-branch-panel" Outlined="true" Elevation="0">
                            <div class="git-branch-header">
                                <MudIconButton Class="git-branch-collapse-button" Icon="@Icons.Material.Filled.ChevronLeft"
                                               aria-label="@L.T("Collapse branch panel")" OnClick="ToggleBranchPanel" />
                            </div>
                            <div class="git-branch-groups">
                                <details class="git-branch-group" open>
                                    <summary><span>@L.T("Local branches")</span><span class="git-branch-count">@LocalBranches.Count</span></summary>
                                    <div class="git-dialog-list git-branch-list">
                                        @foreach (var folder in LocalBranchFolders)
                                        {
                                            @BranchFolderContent(folder, false)
                                        }
                                        @if (LocalBranches.Count == 0)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L.T("No local branches.")</MudText>
                                        }
                                    </div>
                                </details>
                                <details class="git-branch-group" open>
                                    <summary><span>@L.T("Remote branches")</span><span class="git-branch-count">@RemoteBranches.Count</span></summary>
                                    <div class="git-dialog-list git-branch-list">
                                        @foreach (var folder in RemoteBranchFolders)
                                        {
                                            @BranchFolderContent(folder, true)
                                        }
                                        @if (RemoteBranches.Count == 0)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L.T("No remote branches.")</MudText>
                                        }
                                    </div>
                                </details>
                            </div>
                            <div class="git-branch-collapsed-rail">
                                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" aria-label="@L.T("Expand branch panel")" OnClick="ToggleBranchPanel" />
                                <button class="git-branch-rail-item" aria-label="@L.T("Local branches") — @LocalBranches.Count" title="@L.T("Local branches")" @onclick="ExpandBranchPanel">
                                    <MudIcon Icon="@Icons.Material.Filled.CallSplit" Size="Size.Small" />
                                    <span>@LocalBranches.Count</span>
                                </button>
                                <button class="git-branch-rail-item" aria-label="@L.T("Remote branches") — @RemoteBranches.Count" title="@L.T("Remote branches")" @onclick="ExpandBranchPanel">
                                    <MudIcon Icon="@Icons.Material.Filled.Cloud" Size="Size.Small" />
                                    <span>@RemoteBranches.Count</span>
                                </button>
                            </div>
                        </MudPaper>
                        <div class="git-history-splitter" role="separator" aria-orientation="vertical" aria-label="Resize branch panel" tabindex="0"></div>
                        <MudPaper Class="pa-3 git-dialog-panel git-commit-history-panel" Outlined="true" Elevation="0">
                                <MudText Typo="Typo.subtitle1" Class="mb-2">@L.T("Recent commits")</MudText>
                                 <MudStack Spacing="0" Class="git-dialog-list git-commit-list">
                                    @foreach (var commit in _snapshot.Commits)
                                    {
                                        <div @key="commit.Hash"
                                             class="git-commit-row @(IsSelectedCommit(commit) ? "git-commit-row-selected" : "")"
                                             role="button" tabindex="0" aria-pressed="@IsSelectedCommit(commit)"
                                             @onclick="@(() => SelectCommit(commit))"
                                             @onkeydown="@(args => HandleCommitRowKeyDown(args, commit))">
                                            <div class="git-commit-branch-labels">
                                                @if (IsSelectedCommit(commit) && GetPathBranchLabel(commit) is { } pathLabel)
                                                {
                                                    <span class="git-commit-branch-label git-commit-branch-label-context"
                                                          style="--branch-color: @GraphColor(pathLabel.Color)" title="@pathLabel.Name">
                                                        @if (pathLabel.IsLocal)
                                                        {
                                                            <MudIcon Icon="@Icons.Material.Filled.CallSplit" Size="Size.Small" aria-label="@L.T("Local")" Class="git-branch-label-icon" />
                                                        }
                                                        @if (pathLabel.IsRemote)
                                                        {
                                                            <MudIcon Icon="@Icons.Material.Filled.Cloud" Size="Size.Small" aria-label="@L.T("Remote")" Class="git-branch-label-icon" />
                                                        }
                                                        <span class="git-commit-branch-name">@pathLabel.Name</span>
                                                    </span>
                                                }
                                                else if (commit.BranchLabels is { Count: > 0 })
                                                {
                                                    @foreach (var label in commit.BranchLabels)
                                                    {
                                                        <span @key="label.Name" class="git-commit-branch-label"
                                                              style="--branch-color: @GraphColor(label.Color)" title="@label.Name">
                                                            @if (label.IsLocal)
                                                            {
                                                                <MudIcon Icon="@Icons.Material.Filled.CallSplit" Size="Size.Small" aria-label="@L.T("Local")" Class="git-branch-label-icon" />
                                                            }
                                                            @if (label.IsRemote)
                                                            {
                                                                <MudIcon Icon="@Icons.Material.Filled.Cloud" Size="Size.Small" aria-label="@L.T("Remote")" Class="git-branch-label-icon" />
                                                            }
                                                            <span class="git-commit-branch-name">@label.Name</span>
                                                        </span>
                                                    }
                                                }
                                            </div>
                                             <svg class="git-commit-graph" width="@GraphPixelWidth" height="52"
                                                  viewBox="0 0 @GraphPixelWidth 52" preserveAspectRatio="xMinYMid meet" aria-hidden="true">
                                                @if (commit.GraphEdges is not null)
                                                {
                                                    @foreach (var edge in commit.GraphEdges)
                                                    {
                                                        <path d="@GraphPath(edge)" fill="none" stroke="@GraphColor(edge.Color)" style="@GraphStrokeStyle(edge.Color)" stroke-width="2.5" stroke-linecap="round" />
                                                    }
                                                }
                                                <circle cx="@GraphX(commit.GraphColumn)" cy="26" r="5.5" fill="var(--mud-palette-surface)" stroke="@GraphColor(commit.GraphColor)" style="@GraphStrokeStyle(commit.GraphColor)" stroke-width="3" />
                                            </svg>
                                            <div class="git-commit-content">
                                                <MudText Typo="Typo.body2" Class="git-commit-subject" title="@commit.Subject">@commit.Subject</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="git-commit-metadata" title="@($"{commit.ShortHash} · {commit.Author} · {FormatDate(commit.Date)}")">@commit.ShortHash · @commit.Author · @FormatDate(commit.Date)</MudText>
                                            </div>
                                        </div>
                                    }
                                    @if (_snapshot.Commits.Count == 0)
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L.T("No commits found.")</MudText>
                                    }
                                </MudStack>
                        </MudPaper>
                    </div>
                }
                else
                {
                    <div class="git-commit-workspace">
                            <MudPaper Class="pa-3 git-dialog-panel git-diff-panel" Outlined="true" Elevation="0">
                                <MudStack Spacing="2" Class="git-diff-section">
                                    <MudText Typo="Typo.subtitle1">@L.T("Diff {0}", _selectedFile is null ? "" : $"— {_selectedFile.Path}")</MudText>
                                    @if (_selectedFile is null)
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L.T("Select a file to view its diff.")</MudText>
                                    }
                                    else if (_isLoadingDiff)
                                    {
                                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                                    }
                                    else
                                    {
                                        <pre class="git-diff-view">@foreach (var line in GetDiffLines(_selectedDiff))
                                        {
                                            <span class="git-diff-line git-diff-@line.Kind">@line.Text
</span>
                                        }</pre>
                                    }
                                </MudStack>
                            </MudPaper>
                            <div class="git-commit-side-panel">
                                <MudPaper Class="pa-3 git-dialog-panel git-file-panel" Outlined="true" Elevation="0">
                                    <MudStack Spacing="1" Class="git-file-list-section">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                            <MudText Typo="Typo.subtitle1">@L.T("Unstaged ({0})", UnstagedFiles.Count)</MudText>
                                            <MudButton Size="Size.Small" Disabled="@(_isOperating || UnstagedFiles.Count == 0)" OnClick="StageAllAsync">@L.T("Stage all")</MudButton>
                                        </MudStack>
                                        @if (UnstagedFiles.Count == 0)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L.T("No unstaged changes.")</MudText>
                                        }
                                        <div class="git-file-list-scroll">
                                            @foreach (var file in UnstagedFiles)
                                            {
                                                @FileRow(file, false)
                                            }
                                        </div>
                                    </MudStack>
                                </MudPaper>
                                <MudPaper Class="pa-3 git-dialog-panel git-file-panel" Outlined="true" Elevation="0">
                                    <MudStack Spacing="1" Class="git-file-list-section">
                                        <MudText Typo="Typo.subtitle1">@L.T("Staged ({0})", StagedFiles.Count)</MudText>
                                        @if (StagedFiles.Count == 0)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L.T("No staged changes.")</MudText>
                                        }
                                        <div class="git-file-list-scroll">
                                            @foreach (var file in StagedFiles)
                                            {
                                                @FileRow(file, true)
                                            }
                                        </div>
                                    </MudStack>
                                </MudPaper>
                                <MudPaper Class="pa-3 git-dialog-panel git-message-panel" Outlined="true" Elevation="0">
                                    <MudStack Spacing="2">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                            <MudText Typo="Typo.subtitle1">@L.T("Commit message")</MudText>
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AutoAwesome"
                                                       Disabled="@(_isGeneratingMessage || StagedFiles.Count == 0)" OnClick="GenerateCommitMessageAsync">
                                                @(_isGeneratingMessage ? L.T("Generating...") : L.T("Generate with AI"))
                                            </MudButton>
                                        </MudStack>
                                        <MudTextField @bind-Value="_commitTitle" Label="@L.T("Title (required)")" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                      Placeholder="@L.T("Short summary of the change")" MaxLength="72" Counter="72" Required="true" />
                                        <MudTextField @bind-Value="_commitDescription" Label="@L.T("Description (optional)")" Lines="2" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                      Placeholder="@L.T("More context about the change...")" />
                                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check"
                                                   Disabled="@(_isOperating || StagedFiles.Count == 0 || string.IsNullOrWhiteSpace(_commitTitle))"
                                                    OnClick="CommitChangesAsync">@L.T("Commit ({0} files)", StagedFiles.Count)</MudButton>
                                    </MudStack>
                                </MudPaper>
                            </div>
                    </div>
                }

                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="git-overview-status">
                    @_snapshot.ChangedFiles @L.T("changed") · @_snapshot.StagedFiles @L.T("Staged changes") · @_snapshot.UnstagedFiles @L.T("Unstaged changes") · @_snapshot.Ahead @L.T("Ahead") / @_snapshot.Behind @L.T("Behind")
                </MudText>
              </MudStack>
            }
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string RepositoryName { get; set; } = string.Empty;
    [Parameter] public string RepositoryPath { get; set; } = string.Empty;
    [Parameter] public LauncherSettings AiSettings { get; set; } = new();

    private GitRepositorySnapshot? _snapshot;
    private IReadOnlyList<GitFileChange> _files = [];
    private GitFileChange? _selectedFile;
    private bool _selectedFileIsStaged;
    private string _selectedDiff = string.Empty;
    private string _commitTitle = string.Empty;
    private string _commitDescription = string.Empty;
    private bool _isLoading = true;
    private string _loadingStage = "Checking repository...";
    private int? _loadedBranchCount;
    private bool _isLoadingDiff;
    private bool _isOperating;
    private bool _isGeneratingMessage;
    private GitView _view = GitView.History;
    private bool _isBranchPanelCollapsed;
    private IJSObjectReference? _gitHistoryModule;
    private string? _selectedCommitHash;
    private IReadOnlyList<GitBranchEntry> LocalBranches => _snapshot?.Branches.Where(branch => !branch.IsRemote).ToList() ?? [];
    private IReadOnlyList<GitBranchEntry> RemoteBranches => _snapshot?.Branches.Where(branch => branch.IsRemote).ToList() ?? [];
    private IReadOnlyList<BranchFolder> LocalBranchFolders => GroupBranchesIntoFolders(LocalBranches);
    private IReadOnlyList<BranchFolder> RemoteBranchFolders => GroupBranchesIntoFolders(RemoteBranches);
    private IReadOnlyList<GitFileChange> StagedFiles => _files.Where(file => file.IsStaged).ToList();
    private IReadOnlyList<GitFileChange> UnstagedFiles => _files.Where(file => file.IsUnstaged || file.IsUntracked).ToList();

    protected override Task OnInitializedAsync() => Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            _gitHistoryModule = await JS.InvokeAsync<IJSObjectReference>("import", "./git-history.js");

        if (_view == GitView.History && _snapshot?.IsValid == true && _gitHistoryModule is not null)
            await _gitHistoryModule.InvokeVoidAsync("attachHistorySplitter");

        if (!firstRender)
            return;
        await RefreshAsync(fetch: true);
        _view = _files.Count > 0 ? GitView.Commit : GitView.History;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshAsync(bool fetch = false)
    {
        _isLoading = true;
        _loadingStage = fetch ? "Fetching remotes..." : "Checking repository...";
        _loadedBranchCount = null;
        try
        {
            _snapshot = await GitBranchService.GetRepositorySnapshotAsync(RepositoryPath, fetch, ReportSnapshotProgressAsync);
            _files = await GitBranchService.GetFileChangesAsync(RepositoryPath);
            if (_snapshot?.IsValid == true && _files.Count > 0)
                _view = GitView.Commit;
            else if (_snapshot?.IsValid == true && _view == GitView.Commit)
                _view = GitView.History;
            if (_selectedFile is not null)
            {
                _selectedFile = _files.FirstOrDefault(file => file.Path == _selectedFile.Path);
                if (_selectedFile is not null)
                    await LoadDiffAsync(_selectedFile);
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ReportSnapshotProgressAsync(GitSnapshotProgress progress)
    {
        _loadingStage = progress.Stage;
        if (progress.BranchCount is not null)
            _loadedBranchCount = progress.BranchCount;

        await InvokeAsync(StateHasChanged);
        await Task.Yield();
    }

    private async Task SwitchToCommitViewAsync()
    {
        _view = GitView.Commit;
        await RefreshAsync();
    }

    private async Task SelectFileAsync(GitFileChange file, bool staged)
    {
        _selectedFile = file;
        _selectedFileIsStaged = staged;
        await LoadDiffAsync(file);
    }

    private async Task LoadDiffAsync(GitFileChange file)
    {
        _isLoadingDiff = true;
        try
        {
            var result = await GitBranchService.GetFileDiffAsync(RepositoryPath, file, _selectedFileIsStaged);
            _selectedDiff = result.Success ? result.Output : result.Message;
        }
        finally
        {
            _isLoadingDiff = false;
        }
    }

    private async Task StageAsync(GitFileChange file)
    {
        await RunFileOperationAsync(() => GitBranchService.StageFileAsync(RepositoryPath, file.Path));
    }

    private async Task UnstageAsync(GitFileChange file)
    {
        await RunFileOperationAsync(() => GitBranchService.UnstageFileAsync(RepositoryPath, file.Path));
    }

    private async Task StageAllAsync()
    {
        _isOperating = true;
        try
        {
            var failed = 0;
            foreach (var file in UnstagedFiles)
            {
                var result = await GitBranchService.StageFileAsync(RepositoryPath, file.Path);
                if (!result.Success)
                    failed++;
            }
            if (failed > 0)
                Snackbar.Add(L.T("Stage failed for {0} file(s).", failed), Severity.Error);
            await RefreshAsync();
        }
        finally
        {
            _isOperating = false;
        }
    }

    private async Task RunFileOperationAsync(Func<Task<GitOperationResult>> operation)
    {
        _isOperating = true;
        try
        {
            var result = await operation();
            if (!result.Success)
                Snackbar.Add(result.Message, Severity.Error);
            await RefreshAsync();
        }
        finally
        {
            _isOperating = false;
        }
    }

    private async Task GenerateCommitMessageAsync()
    {
        _isGeneratingMessage = true;
        try
        {
            var diff = await GitBranchService.GetStagedDiffAsync(RepositoryPath);
            if (!diff.Success)
            {
                Snackbar.Add(L.T("Failed to load staged diff: {0}", diff.Message), Severity.Error);
                return;
            }

            var result = await AiCommitMessageService.GenerateAsync(AiSettings, diff.Output);
            if (result.Success)
            {
                _commitTitle = result.Title;
                _commitDescription = result.Description;
            }
            else
                Snackbar.Add(result.Error, Severity.Error, config => config.VisibleStateDuration = 10000);
        }
        finally
        {
            _isGeneratingMessage = false;
        }
    }

    private async Task CommitChangesAsync()
    {
        _isOperating = true;
        try
        {
            var commitMessage = string.IsNullOrWhiteSpace(_commitDescription)
                ? _commitTitle.Trim()
                : $"{_commitTitle.Trim()}\n\n{_commitDescription.Trim()}";
            var result = await GitBranchService.CommitAsync(RepositoryPath, commitMessage);
            Snackbar.Add(result.Success ? L.T("Commit created.") : L.T("Commit failed: {0}", result.Message),
                result.Success ? Severity.Success : Severity.Error, config => config.VisibleStateDuration = 8000);
            if (result.Success)
            {
                _commitTitle = string.Empty;
                _commitDescription = string.Empty;
                _selectedFile = null;
                _selectedDiff = string.Empty;
                await RefreshAsync();
            }
        }
        finally
        {
            _isOperating = false;
        }
    }

    private RenderFragment FileRow(GitFileChange file, bool staged) => @<div @key="@(staged + file.Path)" class="git-file-row @( _selectedFile?.Path == file.Path ? "selected" : "")">
        <button class="git-file-select" @onclick="@(() => SelectFileAsync(file, staged))" title="@file.Path">
            <MudIcon Icon="@(file.IsConflicted ? Icons.Material.Filled.Warning : staged ? Icons.Material.Filled.CheckCircleOutline : Icons.Material.Filled.Description)"
                     Size="Size.Small" Color="@(file.IsConflicted ? Color.Error : Color.Default)" />
            <span class="git-file-path">@file.Path</span>
            <span class="git-file-status">@file.Status</span>
        </button>
        @if (!file.IsConflicted)
        {
            <MudIconButton Size="Size.Small" Icon="@(staged ? Icons.Material.Filled.Remove : Icons.Material.Filled.Add)"
                            aria-label="@(staged ? L.T("Unstage file") : L.T("Stage file"))"
                           Disabled="@_isOperating" OnClick="@(staged ? (() => UnstageAsync(file)) : (() => StageAsync(file)))" />
        }
    </div>;

    private RenderFragment BranchFolderContent(BranchFolder folder, bool remote) => @<div>
        @if (folder.Name is not null)
        {
            <details class="git-branch-folder">
                <summary><MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" /><span>@folder.Name</span><span class="git-branch-count">@folder.Branches.Count</span></summary>
                <MudStack Spacing="1" Class="git-branch-folder-children">
                    @foreach (var branch in folder.Branches)
                    {
                        @BranchButton(branch, remote)
                    }
                </MudStack>
            </details>
        }
        else
        {
            @foreach (var branch in folder.Branches)
            {
                @BranchButton(branch, remote)
            }
        }
    </div>;

    private RenderFragment BranchButton(GitBranchEntry branch, bool remote) => @<MudButton @key="branch.Name" FullWidth="true"
        Variant="@(branch.IsCurrent ? Variant.Filled : Variant.Text)"
        Color="@(branch.IsCurrent ? Color.Primary : Color.Default)" Size="Size.Small"
        StartIcon="@(remote ? Icons.Material.Filled.Cloud : Icons.Material.Filled.CallSplit)"
        Disabled="@(_isOperating || (!remote && branch.IsCurrent))"
        OnClick="@(() => CheckoutBranchAsync(branch.Name))">
        <span class="git-branch-name">@BranchLeafName(branch.Name)</span>
    </MudButton>;

    private static IReadOnlyList<BranchFolder> GroupBranchesIntoFolders(IReadOnlyList<GitBranchEntry> branches) => branches
        .Select(branch =>
        {
            var separator = branch.Name.LastIndexOf('/');
            return separator < 0
                ? new BranchFolder(null, new[] { branch })
                : new BranchFolder(branch.Name[..separator], new[] { branch });
        })
        .GroupBy(item => item.Name, StringComparer.OrdinalIgnoreCase)
        .Select(group => new BranchFolder(group.Key, group.SelectMany(item => item.Branches).ToList()))
        .OrderBy(folder => folder.Name is null ? 1 : 0)
        .ThenBy(folder => folder.Name, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private static string BranchLeafName(string branchName)
    {
        var separator = branchName.LastIndexOf('/');
        return separator < 0 ? branchName : branchName[(separator + 1)..];
    }

    private void ToggleBranchPanel() => _isBranchPanelCollapsed = !_isBranchPanelCollapsed;

    private void ExpandBranchPanel() => _isBranchPanelCollapsed = false;

    private bool IsSelectedCommit(GitCommitEntry commit) => _selectedCommitHash == commit.Hash;

    private void SelectCommit(GitCommitEntry commit) =>
        _selectedCommitHash = IsSelectedCommit(commit) ? null : commit.Hash;

    private void HandleCommitRowKeyDown(KeyboardEventArgs args, GitCommitEntry commit)
    {
        if (args.Key is "Enter" or " ")
            SelectCommit(commit);
    }

    private GitCommitBranchLabel? GetPathBranchLabel(GitCommitEntry commit)
    {
        if (commit.BranchLabels is { Count: > 0 })
            return commit.BranchLabels[0];

        if (_snapshot is null)
            return null;

        var currentIndex = _snapshot.Commits.ToList().FindIndex(candidate => candidate.Hash == commit.Hash);
        if (currentIndex < 0)
            return null;

        return _snapshot.Commits
            .SelectMany((candidate, index) => (candidate.BranchLabels ?? [])
                .Where(label => label.Color == commit.GraphColor)
                .Select(label => (Label: label, Distance: Math.Abs(index - currentIndex), Index: index)))
            .OrderBy(item => item.Distance)
            .ThenBy(item => item.Index < currentIndex ? 1 : 0)
            .Select(item => item.Label)
            .FirstOrDefault();
    }

    private static IReadOnlyList<DiffDisplayLine> GetDiffLines(string diff)
    {
        var lines = diff.Split('\n').Select(line => line.TrimEnd('\r')).ToArray();
        var result = new List<DiffDisplayLine>(lines.Length);

        for (var index = 0; index < lines.Length; index++)
        {
            var line = lines[index];
            if (line.StartsWith("+++", StringComparison.Ordinal) || line.StartsWith("---", StringComparison.Ordinal))
            {
                result.Add(new DiffDisplayLine(line, "meta"));
                continue;
            }

            if (line.StartsWith("-", StringComparison.Ordinal))
            {
                if (index + 1 < lines.Length && lines[index + 1].StartsWith("+", StringComparison.Ordinal))
                {
                    result.Add(new DiffDisplayLine(line, "changed"));
                    result.Add(new DiffDisplayLine(lines[++index], "changed"));
                }
                else
                {
                    result.Add(new DiffDisplayLine(line, "removed"));
                }
                continue;
            }

            result.Add(new DiffDisplayLine(line,
                line.StartsWith("+", StringComparison.Ordinal) ? "added" :
                line.StartsWith("@@", StringComparison.Ordinal) ? "hunk" : "context"));
        }

        return result;
    }

    private sealed record BranchFolder(string? Name, IReadOnlyList<GitBranchEntry> Branches);
    private sealed record DiffDisplayLine(string Text, string Kind);
    private enum GitView { History, Commit }

    private Task PullAsync() => RunGitOperationAsync(() => GitBranchService.PullAsync(RepositoryPath), "Pull");
    private Task PushAsync() => RunGitOperationAsync(() => GitBranchService.PushWhenUpToDateAsync(RepositoryPath), "Push");

    private async Task RunGitOperationAsync(Func<Task<GitOperationResult>> operation, string name)
    {
        _isOperating = true;
        try
        {
            var result = await operation();
            Snackbar.Add(result.Success ? L.T($"{name} completed.") : L.T($"{name} failed: {{0}}", result.Message),
                result.Success ? Severity.Success : Severity.Error, config => config.VisibleStateDuration = 8000);
            await RefreshAsync(fetch: true);
        }
        finally
        {
            _isOperating = false;
        }
    }

    private async Task CheckoutBranchAsync(string branch)
    {
        _isOperating = true;
        try
        {
            var result = await GitBranchService.CheckoutBranchAsync(RepositoryPath, branch);
            Snackbar.Add(result.Success ? L.T("Branch '{0}' checked out.", branch) : result.Message,
                result.Success ? Severity.Success : Severity.Error);
            await RefreshAsync();
        }
        finally
        {
            _isOperating = false;
        }
    }

    private async Task OpenConflictAsync(string path)
    {
        var result = await GitBranchService.OpenConflictInVsCodeAsync(RepositoryPath, path);
        Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error, config => config.VisibleStateDuration = 8000);
    }

    private static string FormatDate(string date) => DateTimeOffset.TryParse(date, CultureInfo.InvariantCulture, out var parsed)
        ? parsed.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)
        : date;
    private int GraphX(int column) => 10 + column * 24;

    private static readonly int[] GraphPalette = [0xB38CFF, 0x55A6FF, 0xFFB454, 0x42D6B5, 0xFF6B81, 0xD6D95A, 0x53C7D9, 0xF080D0];
    private static string GraphColor(int color)
    {
        var index = Math.Abs(color % GraphPalette.Length);
        return $"var(--git-graph-{index}, #{GraphPalette[index]:X6})";
    }

    public async ValueTask DisposeAsync()
    {
        if (_gitHistoryModule is not null)
        {
            try
            {
                await _gitHistoryModule.InvokeVoidAsync("detachHistorySplitter");
                await _gitHistoryModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
    }
    private static string GraphStrokeStyle(int color) => $"stroke: {GraphColor(color)}";
    private string GraphPath(GitGraphEdge edge)
    {
        var startX = GraphX(edge.FromColumn);
        var endX = GraphX(edge.ToColumn);
        if (edge.FromColumn == edge.ToColumn)
            return $"M {startX} {edge.FromY} L {endX} {edge.ToY}";

        // Use two short rounded corners around a horizontal bridge. This keeps the
        // graph lanes mostly vertical and routes merges between commit nodes rather
        // than drawing a broad S-curve past their centers.
        const double cornerRadius = 6;
        var direction = Math.Sign(endX - startX);
        var cornerY = (edge.FromY + edge.ToY) / 2d;
        var firstCornerY = cornerY - cornerRadius;
        var secondCornerY = cornerY + cornerRadius;
        var firstHorizontalX = startX + direction * cornerRadius;
        var secondHorizontalX = endX - direction * cornerRadius;

        return $"M {startX} {edge.FromY} L {startX} {firstCornerY:0.##} " +
               $"Q {startX} {cornerY:0.##} {firstHorizontalX} {cornerY:0.##} " +
               $"L {secondHorizontalX} {cornerY:0.##} " +
               $"Q {endX} {cornerY:0.##} {endX} {secondCornerY:0.##} " +
               $"L {endX} {edge.ToY}";
    }

    private int GraphPixelWidth => Math.Max(220, (_snapshot?.Commits.Select(commit => Math.Max(commit.GraphWidth, commit.GraphColumn + 1)).DefaultIfEmpty(1).Max() ?? 1) * 24 + 20);

    private void Close() => MudDialog.Close();
}
