@inject SandboxOpenCodeProviderService Providers
@inject LocalizationService L

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@L.T("Sandbox settings") — @Repository.Name</MudText></TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudSelect T="string" @bind-Value="_model" Label="@L.T("Sandbox startup model")" Disabled="@_loading">
                @foreach (var model in _models)
                {
                    <MudSelectItem T="string" Value="@model.Reference">@model.Name (@model.Reference)</MudSelectItem>
                }
            </MudSelect>
            @if (_loadingTree)
            {
                <MudProgressLinear Indeterminate="true" />
            }
            else if (_tree.Count == 0)
            {
                <MudAlert Severity="Severity.Info">@L.T("No selectable files or folders were found in this repository.")</MudAlert>
            }
            else
            {
                <MudPaper Outlined="true" Class="sandbox-file-tree-container pa-2">
                    <SandboxFileTree Entries="@_tree" Selected="@_selectedFiles" SelectionChanged="SelectionChanged" />
                </MudPaper>
            }
            <MudAlert Severity="Severity.Warning">@L.T("Selections within the general sandbox size limits are copied for review. Larger selections use temporary access to real selected files: changes are immediate, and creating, deleting and renaming files is blocked. Review selected content for secrets; detection is not guaranteed.")</MudAlert>
            @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L.T("Cancel")</MudButton>
        <MudButton Color="Color.Primary" Disabled="@(_loading || !_models.Any(model => model.Reference == _model))" OnClick="Save">@L.T("Save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public RepositoryEntry Repository { get; set; } = null!;
    private string _model = string.Empty;
    private readonly HashSet<string> _selectedFiles = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<SandboxWorkspace.BrowserEntry> _tree = [];
    private IReadOnlyList<SandboxOpenCodeProviderService.ModelChoice> _models = [];
    private bool _loading = true;
    private bool _loadingTree = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _model = Repository.OpenCodeSandboxModel;
        foreach (string path in Repository.OpenCodeSandboxFiles.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            _selectedFiles.Add(path);
        try
        {
            var models = Providers.GetModelsAsync(Repository.Path);
            var tree = Task.Run(() => SandboxWorkspace.GetBrowserTree(Repository.Path));
            await Task.WhenAll(models, tree);
            _models = await models;
            _tree = await tree;
        }
        catch (Exception exception) { _error = L.T("Could not read sandbox settings: {0}", exception.Message); }
        finally { _loading = false; _loadingTree = false; }
    }

    private Task SelectionChanged((string Path, bool Selected) selection)
    {
        var entry = Find(_tree, selection.Path);
        if (entry is null) return Task.CompletedTask;
        var files = Flatten(entry);
        if (selection.Selected) _selectedFiles.UnionWith(files);
        else _selectedFiles.ExceptWith(files);
        return Task.CompletedTask;
    }

    private static SandboxWorkspace.BrowserEntry? Find(IEnumerable<SandboxWorkspace.BrowserEntry> entries, string path)
    {
        foreach (var entry in entries)
        {
            if (string.Equals(entry.RelativePath, path, StringComparison.OrdinalIgnoreCase)) return entry;
            var child = Find(entry.Children, path);
            if (child is not null) return child;
        }
        return null;
    }

    private static IEnumerable<string> Flatten(SandboxWorkspace.BrowserEntry entry) => entry.IsDirectory
        ? entry.Children.SelectMany(Flatten)
        : new[] { entry.RelativePath };
    private void Save()
    {
        Repository.OpenCodeSandboxModel = _model;
        Repository.OpenCodeSandboxFiles = string.Join(Environment.NewLine, _selectedFiles.OrderBy(path => path, StringComparer.OrdinalIgnoreCase));
        MudDialog.Close(DialogResult.Ok(true));
    }
    private void Cancel() => MudDialog.Cancel();
}
