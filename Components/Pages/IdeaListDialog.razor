@inject IdeaListService Ideas
@inject LocalizationService L
@inject IDialogService Dialogs
@inject LauncherSettingsService SettingsService
@inject OpenCodeActivityService OpenCodeActivity
@inject GitBranchService Git
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudDialog Class="idea-list-dialog">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Checklist" Color="Color.Primary" />
            <MudText Typo="Typo.h6">@L.T("Ideas and tasks")</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L.T("A local list of things to remember.")</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddItemAsync">
                    @L.T("New")
                </MudButton>
            </MudStack>
            @if (_loading)
            {
                <MudProgressLinear Indeterminate="true" />
            }
            else if (_items.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="py-4">@L.T("No ideas or tasks yet.")</MudText>
            }
            else
            {
                <MudStack Spacing="1" Class="idea-list-items">
                    @foreach (var item in _items.OrderBy(item => item.Status).ThenByDescending(item => item.CreatedAt))
                    {
                        <MudPaper Outlined="true" Class="pa-3">
                            <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                                <MudStack Spacing="1" Style="flex: 1; min-width: 0;">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudText Typo="Typo.subtitle1">@item.Title</MudText>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@TypeLabel(item.Type)</MudChip>
                                    </MudStack>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@item.Description</MudText>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.TicketNumber))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L.T("Ticket: {0}", item.TicketNumber)</MudText>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.BranchName))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L.T("Branch: {0}", item.BranchName)</MudText>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.SessionId))
                                    {
                                        <MudStack Spacing="0" Class="mt-1">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L.T("Repository: {0}", item.RepositoryName)</MudText>
                                            <MudLink Href="@SessionHref(item)" Color="Color.Primary" Underline="Underline.Hover" Target="_self">
                                                @L.T("Open session: {0}", string.IsNullOrWhiteSpace(item.SessionTitle) ? item.Title : item.SessionTitle)
                                            </MudLink>
                                        </MudStack>
                                    }
                                    else
                                    {
                                        @if (_repositories.Count > 0)
                                        {
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-1">
                                                <MudSelect T="string" Value="GetSelectedRepositoryId(item)"
                                                           ValueChanged="@(id => SelectRepository(item, id))"
                                                           Label="@L.T("Repository")" Dense="true" Margin="Margin.Dense"
                                                           Placeholder="@L.T("Select a repository")"
                                                           Disabled="@(_startingTasks.Contains(item.Id) || !string.IsNullOrWhiteSpace(item.SessionId))"
                                                           Class="idea-repository-select">
                                                    @foreach (var repository in _repositories)
                                                    {
                                                        <MudSelectItem Value="repository.Id.ToString()">@RepositoryName(repository)</MudSelectItem>
                                                    }
                                                </MudSelect>
                                                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                                           StartIcon="@Icons.Material.Filled.PlayArrow"
                                                           Disabled="@(!CanStartTask(item))"
                                                           OnClick="@(() => StartTaskAsync(item))">
                                                    @(_startingTasks.Contains(item.Id) ? L.T("Starting...") : L.T("Start in new session"))
                                                </MudButton>
                                            </MudStack>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L.T("No eligible OpenCode repositories are available.")</MudText>
                                        }
                                    }
                                    <MudSelect T="IdeaStatus" Value="item.Status" ValueChanged="@(status => UpdateStatusAsync(item, status))" Dense="true" Margin="Margin.Dense" Class="idea-status-select">
                                        <MudSelectItem Value="IdeaStatus.Open">@L.T("Open")</MudSelectItem>
                                        <MudSelectItem Value="IdeaStatus.InProgress">@L.T("In progress")</MudSelectItem>
                                        <MudSelectItem Value="IdeaStatus.Done">@L.T("Done")</MudSelectItem>
                                    </MudSelect>
                                </MudStack>
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Default" Size="Size.Small"
                                               aria-label="@L.T("Delete")" OnClick="@(() => DeleteItemAsync(item))" />
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Size="Size.Small" OnClick="Close">@L.T("Close")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private List<IdeaItem> _items = [];
    private List<RepositoryEntry> _repositories = [];
    private readonly Dictionary<Guid, string?> _selectedRepositories = [];
    private readonly HashSet<Guid> _startingTasks = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _items = (await Ideas.GetAllAsync()).ToList();
        var settings = await SettingsService.LoadAsync();
        _repositories = settings.Repositories
            .Where(repository => repository.IsActive && !repository.OpenCodeSandboxEnabled &&
                AgentTools.Normalize(repository.AgentTool) == AgentTools.OpenCode && Directory.Exists(repository.Path))
            .OrderBy(RepositoryName, StringComparer.OrdinalIgnoreCase)
            .ToList();
        foreach (var item in _items)
        {
            var repositoryExists = item.RepositoryId is { } savedId && _repositories.Any(repository => repository.Id == savedId);
            _selectedRepositories[item.Id] = repositoryExists ? item.RepositoryId!.Value.ToString() : null;
        }
        _loading = false;
    }

    private async Task AddItemAsync()
    {
        var dialog = await Dialogs.ShowAsync<NewIdeaDialog>(L.T("New item"),
            options: new DialogOptions { CloseButton = true, CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: IdeaItem item })
        {
            _items.Add(item);
            _selectedRepositories[item.Id] = null;
        }
    }

    private string? GetSelectedRepositoryId(IdeaItem item) => _selectedRepositories.GetValueOrDefault(item.Id);

    private void SelectRepository(IdeaItem item, string? repositoryId) => _selectedRepositories[item.Id] = repositoryId;

    private bool CanStartTask(IdeaItem item) => !_startingTasks.Contains(item.Id) &&
        string.IsNullOrWhiteSpace(item.SessionId) &&
        _selectedRepositories.TryGetValue(item.Id, out var repositoryId) &&
        Guid.TryParse(repositoryId, out var id) && _repositories.Any(repository => repository.Id == id);

    private async Task StartTaskAsync(IdeaItem item)
    {
        if (!CanStartTask(item) || !_startingTasks.Add(item.Id))
            return;

        var stage = "preparing the task start";
        try
        {
            var repositoryId = Guid.Parse(_selectedRepositories[item.Id]!);
            var repository = _repositories.First(candidate => candidate.Id == repositoryId);
            var settings = await SettingsService.LoadAsync();
            var parameters = new DialogParameters<StartTaskDialog>
            {
                { dialog => dialog.Task, item },
                { dialog => dialog.Repository, repository },
                { dialog => dialog.TicketRequired, repository.TicketRequired }
            };
            var dialog = await Dialogs.ShowAsync<StartTaskDialog>(L.T("Prepare task start"), parameters,
                new DialogOptions { CloseButton = true, CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true });
            var dialogResult = await dialog.Result;
            if (dialogResult is not { Canceled: false, Data: StartTaskDialog.TaskStartPlan plan })
                return;
            item.TicketNumber = plan.TicketNumber;
            await Ideas.SaveTicketAsync(item.Id, plan.TicketNumber);

            string branchName;
            stage = "creating or checking out the branch";
            if (plan.ExistingBranch is not null)
            {
                var checkout = await Git.CheckoutBranchAsync(repository.Path, plan.ExistingBranch);
                if (!checkout.Success)
                    throw new InvalidOperationException(checkout.Message);
                branchName = plan.ExistingBranch;
            }
            else
            {
                branchName = BuildTaskBranchName(settings.TaskBranchPrefix, plan.TicketNumber, item.Title);
                var branchResult = await Git.CreateAndCheckoutBranchAsync(repository.Path, branchName, plan.StartPoint!);
                if (!branchResult.Success)
                    throw new InvalidOperationException(branchResult.Message);
            }

            stage = "creating the OpenCode session";
            var session = await OpenCodeActivity.CreateSessionAsync(repository.Path, CancellationToken.None);
            var ticketContext = string.IsNullOrWhiteSpace(plan.TicketNumber) ? string.Empty : $"Ticket: {plan.TicketNumber}\n";
            var storyTemplate = string.IsNullOrWhiteSpace(repository.TaskStoryTemplate)
                ? RepositoryEntry.DefaultTaskStoryTemplate
                : repository.TaskStoryTemplate.Trim();
            var prompt = $"{ticketContext}Branch: {branchName}\n\n" +
                $"{L.T("Shape the requested work as a story using the repository's template below. Preserve its sections and fill them with details grounded in the task.")}\n\n" +
                $"{L.T("Story template:")}\n{storyTemplate}\n\n{L.T("Task:")}\n{item.Title}" +
                (string.IsNullOrWhiteSpace(item.Description) ? string.Empty : $"\n\n{item.Description}");
            stage = "sending the initial task prompt";
            await OpenCodeActivity.SendPromptAsync(session.Id, session.Directory, prompt, CancellationToken.None, "plan");
            if (await Ideas.LinkSessionAsync(item.Id, repository, session.Id,
                    string.IsNullOrWhiteSpace(session.Title) ? item.Title : session.Title,
                    plan.TicketNumber, branchName))
            {
                item.Status = IdeaStatus.InProgress;
                item.RepositoryId = repository.Id;
                item.RepositoryName = RepositoryName(repository);
                item.RepositoryPath = repository.Path;
                item.SessionId = session.Id;
                item.SessionTitle = session.Title;
                _selectedRepositories[item.Id] = repository.Id.ToString();
            }
            await InvokeAsync(StateHasChanged);
            Snackbar.Add(L.T("Task started in a new session."), Severity.Success);
        }
        catch (Exception exception)
        {
            var repository = _repositories.FirstOrDefault(candidate => candidate.Id ==
                (Guid.TryParse(_selectedRepositories.GetValueOrDefault(item.Id), out var id) ? id : Guid.Empty));
            var summary = L.T("Task start failed.");
            var errorDetails = string.Join(Environment.NewLine,
                "Task start failed",
                $"Stage: {stage}",
                $"Task: {item.Title}",
                $"Repository: {repository?.Name ?? repository?.Path ?? "unknown"}",
                $"Repository path: {repository?.Path ?? "unknown"}",
                $"Agent: {(repository is null ? "unknown" : AgentTools.GetDisplayName(AgentTools.Normalize(repository.AgentTool)))}",
                $"Ticket system: {repository?.TicketSystem ?? "unknown"}",
                $"Selected MCP server: {repository?.TicketMcpServerName ?? "unknown"}",
                $"Exception: {exception}");
            Snackbar.Add(summary, Severity.Error, options =>
            {
                options.RequireInteraction = true;
                options.ShowCloseIcon = true;
                options.VisibleStateDuration = 30000;
                options.Action = L.T("Copy details");
                options.ActionColor = Color.Inherit;
                options.OnClick = snackbar => CopyTaskStartErrorDetailsAsync(errorDetails);
            });
        }
        finally
        {
            _startingTasks.Remove(item.Id);
        }
    }

    private async Task CopyTaskStartErrorDetailsAsync(string errorDetails)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", errorDetails);
            Snackbar.Add(L.T("Error details copied."), Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add(L.T("Could not copy error details."), Severity.Error);
        }
    }

    private static string BuildTaskBranchName(string prefix, string ticketNumber, string title)
    {
        static string Slug(string value) => string.Join('-', value.Trim().ToLowerInvariant()
            .Split([' ', '\t', '/', '\\', ':', '.', '_'], StringSplitOptions.RemoveEmptyEntries)
            .Select(part => new string(part.Where(char.IsAsciiLetterOrDigit).ToArray()))
            .Where(part => part.Length > 0));

        var parts = new[] { prefix.Trim('/'), ticketNumber, Slug(title) }
            .Where(part => !string.IsNullOrWhiteSpace(part));
        return string.Join('/', parts);
    }

    private string RepositoryName(RepositoryEntry repository) => string.IsNullOrWhiteSpace(repository.Name)
        ? Path.GetFileName(Path.TrimEndingDirectorySeparator(repository.Path))
        : repository.Name;

    private string SessionHref(IdeaItem item)
    {
        var repository = _repositories.FirstOrDefault(candidate => candidate.Id == item.RepositoryId) ??
            new RepositoryEntry { Id = item.RepositoryId ?? Guid.Empty, Name = item.RepositoryName, Path = item.RepositoryPath };
        return $"/?repository={Uri.EscapeDataString(repository.Id.ToString())}&session={Uri.EscapeDataString(item.SessionId)}";
    }

    private async Task UpdateStatusAsync(IdeaItem item, IdeaStatus status)
    {
        if (await Ideas.UpdateStatusAsync(item.Id, status))
            item.Status = status;
    }

    private async Task DeleteItemAsync(IdeaItem item)
    {
        if (await Ideas.DeleteAsync(item.Id))
            _items.Remove(item);
    }

    private string TypeLabel(IdeaType type) => L.T(type switch
    {
        IdeaType.Idea => "Idea",
        IdeaType.Wish => "Wish",
        IdeaType.Bug => "Bug",
        IdeaType.Story => "Story",
        _ => "Task"
    });

    private void Close() => MudDialog.Cancel();
}
