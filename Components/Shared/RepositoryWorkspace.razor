@implements IAsyncDisposable
@using System.Text
@using CodeBadger.Components.Pages
@inject LocalizationService L
@inject RepositoryDetachedWindowService DetachedWindows
@inject AgentSessionNotificationService AgentSessionNotifications
@inject Microsoft.Extensions.Logging.ILogger<RepositoryWorkspace> Logger
@inject SandboxOpenCodeProviderService OpenCodeProviders
@inject OpenCodeActivityService OpenCodeActivity
@inject CodeBadgerTerminalStateService TerminalStateService
@inject LauncherSettingsService SettingsService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudPaper Outlined="true" Elevation="0" Class="repository-workspace" data-repository-id="@Repository.Id">
    @if (!RepositoryExists)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
            @L.T("Repository path does not exist: {0}. Update it in Settings.", Repository.Path)
        </MudAlert>
    }
    else
    {
        @if (Repository.CodeBadgerTerminalEnabled)
        {
            <div class="repository-terminal-stack @AiPaneModeClass" @ref="_terminalStack"
                 style="--ai-terminal-height: @_aiPanelHeight.ToString(System.Globalization.CultureInfo.InvariantCulture)%">
                <section class="repository-ai-pane" aria-label="@L.T("AI terminal")">
                    <div class="repository-terminal-panel">
                        @if (!string.IsNullOrWhiteSpace(_notificationSetupError))
                        {
                            <MudAlert Dense="true" Severity="Severity.Warning" Variant="Variant.Outlined">
                                @L.T("Session notifications could not be configured: {0}", _notificationSetupError)
                            </MudAlert>
                        }
                        @if (AgentTools.Normalize(Repository.AgentTool) == AgentTools.OpenCode && Repository.OpenCodeSandboxEnabled)
                        {
                            <SandboxRepositoryTerminal @key="TerminalKey" RepositoryId="Repository.Id"
                                RepositoryPath="@Repository.Path" RepositoryName="@RepositoryTitle"
                                ModelReference="@Repository.OpenCodeSandboxModel" ReviewedFiles="@Repository.OpenCodeSandboxFiles"
                                IsVisible="@IsVisible" />
                        }
                        else if (AgentAvailable)
                        {
                            <RepositoryTerminal @key="TerminalKey" SessionId="Repository.Id" RepositoryPath="@Repository.Path"
                                                Command="@_agentCommand"
                                                OpenCodeSandboxEnabled="@(AgentTools.Normalize(Repository.AgentTool) == AgentTools.OpenCode && Repository.OpenCodeSandboxEnabled)"
                                                OpenCodeSessionId="@OpenCodeSessionId"
                                                IsVisible="@IsVisible" />
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                                @L.T("{0} was not detected. The agent cannot start; install it or choose another agent in Settings, then restart CodeBadger.", AgentTools.Normalize(Repository.AgentTool))
                            </MudAlert>
                        }
                    </div>
                </section>

                <div class="repository-terminal-splitter">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="repository-codebadger-session-tabs">
                        @foreach (var session in _terminalSessions)
                        {
                            <div class="repository-codebadger-session-tab @(session.Id == _selectedTerminalSessionId ? "selected" : string.Empty)">
                                <button type="button" class="repository-codebadger-session-select" @onclick="() => SelectTerminalSession(session.Id)">
                                    @session.Title
                                </button>
                                @if (_terminalSessions.Count > 1)
                                {
                                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Close"
                                                   aria-label="@L.T("Close session {0}", session.Title)"
                                                   OnClick="@(() => CloseTerminalSessionAsync(session.Id))" />
                                }
                            </div>
                        }
                        <MudTooltip Text="@L.T("New session")">
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Add"
                                           aria-label="@L.T("New session")" OnClick="AddTerminalSession" />
                        </MudTooltip>
                        @if (_terminalSessions.FirstOrDefault(session => session.Id == _selectedTerminalSessionId) is { } currentTerminalSession)
                        {
                            <div class="repository-codebadger-agent-links">
                                @foreach (var role in GetTrackedAgentRoles(currentTerminalSession))
                                {
                                    var roleSessionKey = GetRoleSessionKey(currentTerminalSession, role);
                                    if (currentTerminalSession.State.AgentSessionIds.TryGetValue(roleSessionKey, out var agentSessionId))
                                    {
                                        var contextUsage = GetContextUsage(currentTerminalSession, roleSessionKey, agentSessionId);
                                        var progress = contextUsage?.Percent ?? 0;
                                            <div class="repository-codebadger-agent-context" title="@(contextUsage is not { Limit: > 0 }
                                                ? L.T("Context usage unavailable")
                                                : L.T("{0}% used: {1} of {2} tokens", progress, contextUsage.Used.ToString("N0"), contextUsage.Limit.ToString("N0")))">
                                            <div class="repository-codebadger-agent-context-label">
                                                <span>@RoleDisplayName(role)</span>
                                                @if (!IsAgentRoleBusy(currentTerminalSession, role) && !currentTerminalSession.IsRotatingAgentRole)
                                                {
                                                    <MudTooltip Text="@L.T("Continue in a new session with a summary")">
                                                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.AutoAwesome"
                                                                       Color="Color.Primary" aria-label="@L.T("Continue in a new session with a summary")"
                                                                       OnClick="() => RotateAgentSessionAsync(currentTerminalSession, role)" />
                                                    </MudTooltip>
                                                }
                                            </div>
                                            @if (contextUsage is not { Limit: > 0 })
                                            {
                                                <div class="repository-codebadger-agent-context-track unavailable"><span></span></div>
                                            }
                                            else
                                            {
                                                var level = progress >= 85 ? "high" : progress >= 70 ? "medium" : "low";
                                                <div class="repository-codebadger-agent-context-track @level">
                                                    <span style="width:@(progress)%"></span>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </MudStack>
                    <div class="repository-terminal-splitter-grip" role="separator" aria-orientation="horizontal"
                         aria-label="@L.T("Resize terminal panels")" tabindex="0"></div>
                    <div class="repository-terminal-splitter-actions">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="repository-codebadger-mode-label"
                                 title="@L.T(Repository.CodeBadgerOrchestrationMode switch { CodeBadgerOrchestrationModes.PlanBuild => "Plan and build", CodeBadgerOrchestrationModes.Full => "Full orchestration", _ => "One agent for everything" })">
                            @L.T(Repository.CodeBadgerOrchestrationMode switch { CodeBadgerOrchestrationModes.PlanBuild => "Plan and build", CodeBadgerOrchestrationModes.Full => "Full orchestration", _ => "One agent for everything" })
                        </MudText>
                        <MudTooltip Text="@L.T(_aiPanelMode == AiPanelMode.Collapsed ? "Show AI terminal" : "Hide AI terminal")">
                            <MudIconButton Size="Size.Small" Icon="@(_aiPanelMode == AiPanelMode.Collapsed ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                           aria-label="@L.T(_aiPanelMode == AiPanelMode.Collapsed ? "Show AI terminal" : "Hide AI terminal")"
                                           OnClick="ToggleAiPanel" />
                        </MudTooltip>
                        <MudTooltip Text="@L.T(_aiPanelMode == AiPanelMode.Expanded ? "Restore split view" : "Expand AI terminal")">
                            <MudIconButton Size="Size.Small" Icon="@(_aiPanelMode == AiPanelMode.Expanded ? Icons.Material.Filled.CloseFullscreen : Icons.Material.Filled.OpenInFull)"
                                           aria-label="@L.T(_aiPanelMode == AiPanelMode.Expanded ? "Restore split view" : "Expand AI terminal")"
                                           OnClick="ToggleAiPanelExpanded" />
                        </MudTooltip>
                    </div>
                </div>

                <section class="repository-codebadger-pane" aria-label="@L.T("CodeBadger terminal")">
                    <div class="repository-codebadger-session-content">
                        @foreach (var session in _terminalSessions)
                        {
                            <div @key="session.Id" class="repository-codebadger-terminal-view" style="display:@(session.Id == _selectedTerminalSessionId ? "flex" : "none")">
                                <div class="repository-codebadger-conversation-shell">
                                    <div class="repository-codebadger-conversation" aria-live="polite">
                                        @if (session.Messages.Count == 0)
                                        {
                                            <div class="repository-codebadger-empty-state">
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                    @L.T("Your submitted commands will appear here, followed by the assistant response.")
                                                </MudText>
                                            </div>
                                        }
                                        else
                                        {
                                            @foreach (var message in session.Messages)
                                            {
                                                <article class="repository-codebadger-message @(message.Role == "user" ? "repository-codebadger-user-message" : "repository-codebadger-assistant-message")">
                                                    <div class="repository-codebadger-message-author">
                                                        @if (message.Role == "assistant")
                                                        {
                                                            <img class="repository-agent-logo" src="@AgentLogoPath" alt="" />
                                                            @L.T("Assistant")
                                                            @if (!string.IsNullOrWhiteSpace(message.AgentRole))
                                                            {
                                                                <span>· @RoleDisplayName(message.AgentRole)</span>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            @L.T("You")
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(message.ModelReference))
                                                        {
                                                            <span>· @FormatModelReference(message.ModelReference)</span>
                                                        }
                                                    </div>
                                                    <div class="repository-codebadger-message-content">
                                                        @if (message.Role == "assistant")
                                                        {
                                                            <MarkdownContent Content="@message.Text" Compact="true" />
                                                        }
                                                        else
                                                        {
                                                            <div class="repository-codebadger-user-text">@message.Text</div>
                                                            @if (message.Images.Count > 0)
                                                            {
                                                                <div class="repository-codebadger-message-images">
                                                                    @foreach (var image in message.Images)
                                                                    {
                                                                        <img src="@image" alt="@L.T("Pasted image")" />
                                                                    }
                                                                </div>
                                                            }
                                                        }
                                                    </div>
                                                </article>
                                            }
                                        }
                                        @if (session.IsBusy)
                                        {
                                            <div class="repository-codebadger-working">
                                                <span>@L.T("Agents are working...")</span>
                                                <img class="repository-codebadger-working-logo" src="codebadger.svg" alt="" aria-hidden="true" />
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(session.Error))
                                        {
                                            <MudAlert Dense="true" Severity="Severity.Error" Variant="Variant.Outlined">@session.Error</MudAlert>
                                        }
                                    </div>
                                    <button type="button" class="repository-codebadger-scroll-latest" hidden>
                                        @L.T("Scroll to latest")
                                    </button>
                                </div>
                                <div class="repository-codebadger-composer">
                                    <div class="repository-codebadger-composer-body">
                                        @if (session.InputImages.Count > 0)
                                        {
                                            <div class="repository-codebadger-image-drafts">
                                                @for (var imageIndex = 0; imageIndex < session.InputImages.Count; imageIndex++)
                                                {
                                                    var capturedIndex = imageIndex;
                                                    <div class="repository-codebadger-image-draft">
                                                        <img src="@session.InputImages[capturedIndex]" alt="@L.T("Pasted image")" />
                                                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Close"
                                                                       aria-label="@L.T("Remove image")"
                                                                       OnClick="() => RemoveDraftImage(session, capturedIndex)" />
                                                    </div>
                                                }
                                            </div>
                                        }
                                        <div class="repository-codebadger-input-row">
                                            <span class="repository-codebadger-prompt" aria-hidden="true">›</span>
                                            <textarea class="repository-codebadger-input" data-session-id="@session.Id" rows="1" autocomplete="off" spellcheck="false"
                                                      data-mode-toggle-enabled="@(CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode) != CodeBadgerOrchestrationModes.Full ? "true" : "false")"
                                                      disabled="@session.IsRotatingAgentRole"
                                                      aria-label="@L.T("Universal command")" placeholder="@L.T("Type a universal command...")"
                                                      @bind="session.Input" @bind:event="oninput"></textarea>
                                        </div>
                                    </div>
                                </div>
                                <footer class="repository-codebadger-statusbar">
                                    @if (CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode) != CodeBadgerOrchestrationModes.Full)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.SwapHoriz"
                                                   aria-label="@L.T("Switch between Plan and Build mode")"
                                                   title="@L.T("Switch between Plan and Build mode (Shift+Tab)")"
                                                   OnClick="() => ToggleSessionMode(session)">
                                            @L.T(session.Mode == TerminalMode.Plan ? "Plan" : "Build")
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.button">@L.T("Full orchestration")</MudText>
                                    }
                                    @if (session.IsBusy)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                                   StartIcon="@Icons.Material.Filled.StopCircle" OnClick="() => CancelPromptAsync(session)">
                                            @L.T("Stop agent")
                                        </MudButton>
                                    }
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@SessionAgentModelLabel(session)</MudText>
                                </footer>
                            </div>
                        }
                    </div>
                </section>
            </div>
        }
        else
        {
        <div class="repository-terminal-panel">
            @if (!string.IsNullOrWhiteSpace(_notificationSetupError))
            {
                <MudAlert Dense="true" Severity="Severity.Warning" Variant="Variant.Outlined">
                    @L.T("Session notifications could not be configured: {0}", _notificationSetupError)
                </MudAlert>
            }
            @if (AgentTools.Normalize(Repository.AgentTool) == AgentTools.OpenCode && Repository.OpenCodeSandboxEnabled)
            {
                <SandboxRepositoryTerminal @key="TerminalKey" RepositoryId="Repository.Id"
                    RepositoryPath="@Repository.Path" RepositoryName="@RepositoryTitle"
                    ModelReference="@Repository.OpenCodeSandboxModel" ReviewedFiles="@Repository.OpenCodeSandboxFiles"
                    IsVisible="@IsVisible" />
            }
            else if (AgentAvailable)
            {
                <RepositoryTerminal @key="TerminalKey" SessionId="Repository.Id" RepositoryPath="@Repository.Path"
                                    Command="@_agentCommand"
                                    OpenCodeSandboxEnabled="@(AgentTools.Normalize(Repository.AgentTool) == AgentTools.OpenCode && Repository.OpenCodeSandboxEnabled)"
                                    OpenCodeSessionId="@OpenCodeSessionId"
                                    IsVisible="@IsVisible" />
            }
            else
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                    @L.T("{0} was not detected. The agent cannot start; install it or choose another agent in Settings, then restart CodeBadger.", AgentTools.Normalize(Repository.AgentTool))
                </MudAlert>
            }
        </div>
        }

        <div class="repository-git-panel">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap" Spacing="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="flex-wrap">
                    <MudText Typo="Typo.subtitle1">@L.T("Git")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@GitBranchLabel</MudText>
                    @if (GitSnapshot is { IsValid: true } snapshot)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@snapshot.ChangedFiles @L.T("changed")</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">↑ @snapshot.Ahead</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">↓ @snapshot.Behind</MudChip>
                    }
                </MudStack>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AccountTree"
                           Disabled="@(GitSnapshot is not { IsValid: true })" OnClick="OnOpenGitOverview">
                    @L.T("Git overview")
                </MudButton>
            </MudStack>
            @if (GitSnapshot is { IsValid: false } status)
            {
                <MudAlert Dense="true" Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-2">
                    @status.Error — controleer of Git is geïnstalleerd en het pad een repository is.
                </MudAlert>
            }
        </div>

    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public RepositoryEntry Repository { get; set; } = null!;
    [Parameter, EditorRequired] public string RepositoryTitle { get; set; } = string.Empty;
    [Parameter] public bool RepositoryExists { get; set; }
    [Parameter] public bool AgentAvailable { get; set; }
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string GitBranchLabel { get; set; } = string.Empty;
    [Parameter] public GitRepositorySnapshot? GitSnapshot { get; set; }
    [Parameter] public string? OpenCodeSessionId { get; set; }
    [Parameter, EditorRequired] public EventCallback OnOpenGitOverview { get; set; }

    private string TerminalKey =>
        $"{Repository.Id}:{Repository.Path}:{AgentTools.Normalize(Repository.AgentTool)}:{Repository.OpenCodeSandboxEnabled}:{Repository.OpenCodeSandboxModel}:{Repository.OpenCodeSandboxFiles}:{OpenCodeSessionId}";

    private string _agentCommand = "opencode";
    private ElementReference _terminalStack;
    private IJSObjectReference? _splitterModule;
    private IJSObjectReference? _conversationScrollModule;
    private IJSObjectReference? _composerModule;
    private DotNetObjectReference<RepositoryWorkspace>? _selfReference;
    private readonly List<CodeBadgerTerminalSession> _terminalSessions = [];
    private CodeBadgerTerminalState _terminalState = new();
    private LauncherSettings _settings = new();
    private IReadOnlyList<OpenCodeActivityService.AvailableModel> _availableOpenCodeModels = [];
    private Guid _selectedTerminalSessionId;
    private int _nextTerminalSessionNumber;
    private double _aiPanelHeight = 38;
    private AiPanelMode _aiPanelMode = AiPanelMode.Collapsed;
    private bool _splitterAttached;
    private bool _conversationScrollAttached;
    private bool _composerAttached;
    private bool _wasCodeBadgerTerminalEnabled;
    private string? _agentModelReference;
    private string _agentModelLookupKey = string.Empty;
    private string _contextModelLookupKey = string.Empty;
    private readonly Dictionary<string, AgentContextSnapshot> _agentContextSnapshots = new(StringComparer.Ordinal);

    private string AiPaneModeClass => _aiPanelMode switch
    {
        AiPanelMode.Collapsed => "ai-pane-collapsed",
        AiPanelMode.Expanded => "ai-pane-expanded",
        _ => string.Empty
    };
    private string SessionStatusLabel(CodeBadgerTerminalSession session)
    {
        var mode = L.T(session.Mode == TerminalMode.Plan ? "Plan" : "Build");
        var agent = AgentTools.GetDisplayName(Repository.AgentTool);
        if (!string.IsNullOrWhiteSpace(_agentModelReference))
            agent += "-" + FormatModelName(_agentModelReference.Split('/').Last());
        return $"{mode} · {agent}";
    }

    private string AgentLogoPath => AgentTools.Normalize(Repository.AgentTool) switch
    {
        AgentTools.ClaudeCode => "claude-code.svg",
        AgentTools.OpenCode => "opencode.svg",
        _ => "codebadger.svg"
    };

    private static string FormatModelName(string model)
    {
        var words = model.Split(['-', '_', '.'], StringSplitOptions.RemoveEmptyEntries);
        return string.Join(' ', words.Select(word => string.Equals(word, "gpt", StringComparison.OrdinalIgnoreCase)
            ? "GPT"
            : char.ToUpperInvariant(word[0]) + word[1..]));
    }

    private static string FormatModelReference(string modelReference) =>
        $"{modelReference.Split('/').FirstOrDefault()} · {FormatModelName(modelReference.Split('/').Last())}";

    private CodeBadgerAgentPreferences GetAgentPreferences(string? agentTool)
    {
        _settings.CodeBadgerAgentPreferences ??= CodeBadgerRoles.CreateAgentDefaults();
        CodeBadgerRoles.NormalizeAgentPreferences(_settings.CodeBadgerAgentPreferences);
        var normalized = AgentTools.Normalize(agentTool);
        return _settings.CodeBadgerAgentPreferences.First(item => item.AgentTool == normalized);
    }

    private IEnumerable<string> GetTrackedAgentRoles(CodeBadgerTerminalSession session)
    {
        if (CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode) == CodeBadgerOrchestrationModes.SingleAgent)
        {
            if (session.State.AgentSessionIds.ContainsKey("SingleAgent"))
                return new[] { session.Mode == TerminalMode.Plan ? CodeBadgerRoles.Planner : CodeBadgerRoles.Worker };
            return Array.Empty<string>();
        }
        return session.State.AgentSessionIds.Keys
        .Where(role => !role.StartsWith("ModelSelector:", StringComparison.Ordinal) &&
            !role.StartsWith("Model:", StringComparison.Ordinal) && role != "SingleAgent")
        .OrderBy(role => role, StringComparer.Ordinal)
        .Concat(session.IsBusy && !string.IsNullOrWhiteSpace(session.State.ActiveAgentRole)
            ? new[] { session.State.ActiveAgentRole } : Array.Empty<string>())
        .Distinct(StringComparer.Ordinal);
    }

    private string GetRoleSessionKey(CodeBadgerTerminalSession session, string role) =>
        CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode) == CodeBadgerOrchestrationModes.SingleAgent
            ? "SingleAgent" : role;

    private bool IsAgentRoleBusy(CodeBadgerTerminalSession session, string role)
    {
        var activeRole = session.State.ActiveAgentRole;
        if (!session.IsBusy || string.IsNullOrWhiteSpace(activeRole))
            return false;
        return CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode) == CodeBadgerOrchestrationModes.SingleAgent
            ? true
            : string.Equals(activeRole, role, StringComparison.Ordinal);
    }

    private AgentContextSnapshot? GetContextUsage(CodeBadgerTerminalSession session, string sessionKey, string sessionId)
    {
        var model = session.State.AgentContextModels.TryGetValue(sessionKey, out var modelReference)
            ? modelReference
            : session.State.AgentSessionIds.TryGetValue("Model:" + sessionKey, out var storedModel) ? storedModel : string.Empty;
        if (session.State.AgentContextTokens.TryGetValue(sessionKey, out var tokens) &&
            !string.IsNullOrWhiteSpace(model) && GetModelContextLimit(model) is var limit && limit > 0)
            return new AgentContextSnapshot(tokens, limit, model);
        if (_agentContextSnapshots.TryGetValue(sessionId, out var snapshot))
            return snapshot;
        return null;
    }

    private long GetModelContextLimit(string modelReference) =>
        _availableOpenCodeModels.FirstOrDefault(model =>
            string.Equals(model.Reference, modelReference, StringComparison.OrdinalIgnoreCase))?.Context ?? 0;

    private async Task RefreshAgentContextAsync(CodeBadgerTerminalSession session, string role, string sessionKey,
        string sessionId, CancellationToken cancellationToken)
    {
        try
        {
            var usage = await OpenCodeActivity.GetLatestContextUsageAsync(sessionId, Repository.Path, cancellationToken);
            if (usage is null)
                return;
            var model = string.IsNullOrWhiteSpace(usage.ModelReference) && session.State.AgentContextModels.TryGetValue(sessionKey, out var previousModel)
                ? previousModel : usage.ModelReference;
            if (string.IsNullOrWhiteSpace(model))
                return;
            session.State.AgentContextTokens[sessionKey] = usage.Tokens;
            session.State.AgentContextModels[sessionKey] = model;
            var limit = GetModelContextLimit(model);
            if (limit > 0)
                _agentContextSnapshots[sessionId] = new AgentContextSnapshot(usage.Tokens, limit, model);
            await PersistTerminalStateAsync();
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (Exception exception)
        {
            Logger.LogDebug(exception, "Could not refresh context usage for CodeBadger role {Role}.", role);
        }
    }

    private async Task RotateAgentSessionAsync(CodeBadgerTerminalSession session, string role)
    {
        if (IsAgentRoleBusy(session, role) || session.IsRotatingAgentRole)
            return;
        var agentPreferences = GetAgentPreferences(Repository.AgentTool);
        var preference = agentPreferences.RolePreferences.FirstOrDefault(item => item.Role == role)
            ?? new CodeBadgerRolePreference { Role = role, AgentType = CodeBadgerRoles.DefaultAgentType(role) };
        if (!session.State.AgentSessionIds.TryGetValue(GetRoleSessionKey(session, role), out var oldSessionId))
            return;

        session.IsRotatingAgentRole = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            using var cancellation = new CancellationTokenSource(TimeSpan.FromMinutes(2));
            var summary = await OpenCodeActivity.GenerateSessionHandoffSummaryAsync(oldSessionId, Repository.Path, cancellation.Token);
            var agent = await ResolvePreferenceAgentAsync(preference, role, cancellation.Token);
            var modelKey = CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode) == CodeBadgerOrchestrationModes.SingleAgent
                ? "Model:SingleAgent" : "Model:" + role;
            var model = session.State.AgentSessionIds.TryGetValue(modelKey, out var storedModel) ? storedModel : null;
            var roleSessionKey = GetRoleSessionKey(session, role);
            var title = $"{session.Title} · {RoleDisplayName(role)} · {L.T("Session {0}", session.State.AgentSessionGenerations.GetValueOrDefault(roleSessionKey) + 2)}";
            var created = await OpenCodeActivity.CreateOrchestrationSessionAsync(Repository.Path, agent, title,
                parentSessionId: null, modelReference: model, cancellationToken: cancellation.Token);
            await OpenCodeActivity.AddSessionHandoffSummaryAsync(created.Id, Repository.Path, summary, cancellation.Token);
            session.State.AgentSessionIds[roleSessionKey] = created.Id;
            session.State.AgentSessionGenerations[roleSessionKey] = session.State.AgentSessionGenerations.GetValueOrDefault(roleSessionKey) + 1;
            if (CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode) == CodeBadgerOrchestrationModes.SingleAgent)
            {
                var handoffRole = session.Mode == TerminalMode.Plan ? CodeBadgerRoles.Planner : CodeBadgerRoles.Worker;
                session.State.AgentSessionGenerations[handoffRole] = session.State.AgentSessionGenerations.GetValueOrDefault(handoffRole) + 1;
            }
            session.State.AgentContextTokens.Remove(GetRoleSessionKey(session, role));
            session.State.AgentContextModels.Remove(GetRoleSessionKey(session, role));
            _agentContextSnapshots.Remove(oldSessionId);
            await PersistTerminalStateAsync();
            Snackbar.Add(L.T("A new agent session is ready with a handoff summary."), Severity.Success);
        }
        catch (Exception exception)
        {
            Snackbar.Add(L.T("Could not start a new agent session: {0}", exception.Message), Severity.Error);
        }
        finally
        {
            session.IsRotatingAgentRole = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private sealed record AgentContextSnapshot(long Used, long Limit, string ModelReference)
    {
        public int Percent => (int)Math.Clamp(Math.Round(Used * 100d / Limit), 0, 100);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Repository.CodeBadgerTerminalEnabled && !_wasCodeBadgerTerminalEnabled)
            _aiPanelMode = AiPanelMode.Collapsed;
        _wasCodeBadgerTerminalEnabled = Repository.CodeBadgerTerminalEnabled;

        if (Repository.CodeBadgerTerminalEnabled && _terminalState.RepositoryId != Repository.Id)
        {
            _settings = await SettingsService.LoadAsync();
            _terminalState = await TerminalStateService.LoadAsync(Repository.Id);
            _terminalSessions.Clear();
            foreach (var storedSession in _terminalState.Sessions)
            {
                var terminalSession = new CodeBadgerTerminalSession(storedSession)
                {
                    Mode = storedSession.Mode == "Build" ? TerminalMode.Build : TerminalMode.Plan
                };
                _terminalSessions.Add(terminalSession);
                var digits = storedSession.Title.Where(char.IsAsciiDigit).ToArray();
                if (int.TryParse(digits, out var number))
                    _nextTerminalSessionNumber = Math.Max(_nextTerminalSessionNumber, number);
            }
            if (_terminalSessions.Count == 0)
                await AddTerminalSessionAsync();
            _selectedTerminalSessionId = _terminalState.SelectedSessionId != Guid.Empty &&
                _terminalSessions.Any(session => session.Id == _terminalState.SelectedSessionId)
                    ? _terminalState.SelectedSessionId : _terminalSessions[0].Id;
        }

        var modelLookupKey = $"{Repository.Path}:{AgentTools.Normalize(Repository.AgentTool)}:{Repository.OpenCodeSandboxEnabled}:{Repository.OpenCodeSandboxModel}";
        if (!string.Equals(modelLookupKey, _agentModelLookupKey, StringComparison.Ordinal))
        {
            _agentModelLookupKey = modelLookupKey;
            _settings = await SettingsService.LoadAsync();
            _agentModelReference = GetAgentPreferences(Repository.AgentTool).TerminalModel;
            if (AgentTools.Normalize(Repository.AgentTool) == AgentTools.OpenCode)
            {
                try
                {
                    _agentModelReference = Repository.OpenCodeSandboxEnabled
                        ? Repository.OpenCodeSandboxModel
                        : !string.IsNullOrWhiteSpace(GetAgentPreferences(Repository.AgentTool).TerminalModel)
                            ? GetAgentPreferences(Repository.AgentTool).TerminalModel
                            : await OpenCodeProviders.GetDefaultModelAsync(Repository.Path);
                }
                catch (Exception exception)
                {
                    Logger.LogDebug(exception, "Could not resolve the OpenCode model for the CodeBadger terminal status bar.");
                }
            }
        }

        if (Repository.CodeBadgerTerminalEnabled && AgentTools.Normalize(Repository.AgentTool) == AgentTools.OpenCode &&
            !string.Equals(modelLookupKey, _contextModelLookupKey, StringComparison.Ordinal))
        {
            _contextModelLookupKey = modelLookupKey;
            try
            {
                _availableOpenCodeModels = await OpenCodeActivity.GetAvailableModelsAsync(Repository.Path, CancellationToken.None);
            }
            catch (Exception exception)
            {
                Logger.LogDebug(exception, "Could not load OpenCode model limits for CodeBadger context meters.");
            }
        }

        var terminalAlreadyStarted = false;
        _agentCommand = AgentTools.GetCommand(Repository.AgentTool);
        if (!terminalAlreadyStarted &&
            (AgentTools.Normalize(Repository.AgentTool) is AgentTools.ClaudeCode or AgentTools.Hermes))
        {
            try
            {
                _agentCommand = await AgentSessionNotifications.GetRepositoryCommandAsync(Repository);
            }
            catch (Exception exception)
            {
                _agentCommand = AgentTools.GetCommand(Repository.AgentTool);
                Logger.LogError(exception, "Could not configure session notifications for {Agent} in {RepositoryPath}.",
                    AgentTools.GetDisplayName(Repository.AgentTool), Repository.Path);
                _notificationSetupError = exception.Message;
            }
        }
        else
        {
            _notificationSetupError = null;
        }
    }

    private string? _notificationSetupError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && DetachedWindows.IsDocking(Repository.Id))
            DetachedWindows.MarkWorkspaceAttached(Repository.Id);

        if (!Repository.CodeBadgerTerminalEnabled)
        {
            if (_splitterAttached && _splitterModule is not null)
            {
                try { await _splitterModule.InvokeVoidAsync("detach", _terminalStack); }
                catch (JSDisconnectedException) { }
                _splitterAttached = false;
            }
            if (_conversationScrollAttached && _conversationScrollModule is not null)
            {
                try { await _conversationScrollModule.InvokeVoidAsync("detach", _terminalStack); }
                catch (JSDisconnectedException) { }
                _conversationScrollAttached = false;
            }
            if (_composerAttached && _composerModule is not null)
            {
                try { await _composerModule.InvokeVoidAsync("detach", _terminalStack); }
                catch (JSDisconnectedException) { }
                _composerAttached = false;
            }
            return;
        }

        if (!_splitterAttached)
        {
            try
            {
                _splitterModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./repository-terminal-splitter.js");
                _selfReference ??= DotNetObjectReference.Create(this);
                await _splitterModule.InvokeVoidAsync("attach", _terminalStack, _selfReference);
                _splitterAttached = true;
            }
            catch (JSException exception)
            {
                Logger.LogWarning(exception, "Repository terminal splitter could not be initialized.");
            }
        }

        if (!_conversationScrollAttached)
        {
            try
            {
                _conversationScrollModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./repository-codebadger-scroll.js");
                await _conversationScrollModule.InvokeVoidAsync("attach", _terminalStack);
                _conversationScrollAttached = true;
            }
            catch (JSException exception)
            {
                Logger.LogWarning(exception, "CodeBadger conversation scroll behavior could not be initialized.");
            }
        }

        if (!_composerAttached)
        {
            try
            {
                _selfReference ??= DotNetObjectReference.Create(this);
                _composerModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./repository-codebadger-composer.js");
                await _composerModule.InvokeVoidAsync("attach", _terminalStack, _selfReference);
                _composerAttached = true;
            }
            catch (JSException exception)
            {
                Logger.LogWarning(exception, "CodeBadger composer behavior could not be initialized.");
            }
        }
    }

    private void ToggleAiPanel() => _aiPanelMode = _aiPanelMode == AiPanelMode.Collapsed ? AiPanelMode.Split : AiPanelMode.Collapsed;

    private void ToggleAiPanelExpanded() => _aiPanelMode = _aiPanelMode == AiPanelMode.Expanded ? AiPanelMode.Split : AiPanelMode.Expanded;

    private async Task AddTerminalSessionAsync()
    {
        var sessionState = new CodeBadgerTerminalSessionState
        {
            Id = Guid.NewGuid(),
            Title = L.T("Terminal session {0}", ++_nextTerminalSessionNumber),
            Mode = "Plan"
        };
        _terminalState.Sessions.Add(sessionState);
        var session = new CodeBadgerTerminalSession(sessionState);
        _terminalSessions.Add(session);
        _selectedTerminalSessionId = session.Id;
        _terminalState.SelectedSessionId = session.Id;
        await PersistTerminalStateAsync();
    }

    private Task AddTerminalSession() => AddTerminalSessionAsync();

    private void SelectTerminalSession(Guid id)
    {
        _selectedTerminalSessionId = id;
        _terminalState.SelectedSessionId = id;
        _ = PersistTerminalStateAsync();
    }

    private Task CloseTerminalSessionAsync(Guid id)
    {
        if (_terminalSessions.Count <= 1)
            return Task.CompletedTask;
        var index = _terminalSessions.FindIndex(session => session.Id == id);
        if (index < 0)
            return Task.CompletedTask;
        _terminalSessions.RemoveAt(index);
        _terminalState.Sessions.RemoveAll(session => session.Id == id);
        if (_selectedTerminalSessionId == id)
            _selectedTerminalSessionId = _terminalSessions[Math.Min(index, _terminalSessions.Count - 1)].Id;
        _terminalState.SelectedSessionId = _selectedTerminalSessionId;
        return PersistTerminalStateAsync();
    }

    private async Task ToggleSessionMode(CodeBadgerTerminalSession session)
    {
        session.Mode = session.Mode == TerminalMode.Plan ? TerminalMode.Build : TerminalMode.Plan;
        session.State.Mode = session.Mode == TerminalMode.Plan ? "Plan" : "Build";
        await PersistTerminalStateAsync();
    }

    [JSInvokable]
    public async Task ToggleTerminalModeAsync(string sessionId)
    {
        if (CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode) == CodeBadgerOrchestrationModes.Full ||
            !Guid.TryParse(sessionId, out var id) ||
            _terminalSessions.FirstOrDefault(candidate => candidate.Id == id) is not { } session)
            return;
        await ToggleSessionMode(session);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task SubmitTerminalInputAsync(string sessionId)
    {
        if (!Guid.TryParse(sessionId, out var id) || _terminalSessions.FirstOrDefault(candidate => candidate.Id == id) is not { } session ||
            session.IsBusy || session.IsSubmitting || session.IsRotatingAgentRole ||
            string.IsNullOrWhiteSpace(session.Input) && session.InputImages.Count == 0)
            return;
        session.IsSubmitting = true;
        var prompt = session.Input.Trim();
        var images = session.InputImages.ToArray();
        if (string.IsNullOrWhiteSpace(prompt))
            prompt = L.T("Please inspect the attached image and help me with it.");
        session.State.Mode = session.Mode == TerminalMode.Plan ? "Plan" : "Build";
        session.State.Messages.Add(new CodeBadgerTerminalMessage { Role = "user", Text = prompt, Images = images.ToList() });
        session.Input = string.Empty;
        session.InputImages.Clear();
        session.IsSubmitting = false;
        await PersistTerminalStateAsync();
        await InvokeAsync(StateHasChanged);
        _ = RunPromptAsync(session, prompt, images);
        if (_composerModule is not null)
            await _composerModule.InvokeVoidAsync("clear", _terminalStack, sessionId);
    }

    [JSInvokable]
    public async Task AddClipboardImageAsync(string sessionId, string dataUrl)
    {
        if (!Guid.TryParse(sessionId, out var id) || _terminalSessions.FirstOrDefault(candidate => candidate.Id == id) is not { } session)
            return;
        if (session.InputImages.Count >= 3 || dataUrl.Length > 160_000 ||
            !dataUrl.StartsWith("data:image/jpeg;base64,", StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add(L.T("Could not add image. Use up to three smaller images."), Severity.Warning);
            return;
        }
        session.InputImages.Add(dataUrl);
        await InvokeAsync(StateHasChanged);
    }

    private void RemoveDraftImage(CodeBadgerTerminalSession session, int index)
    {
        if (index >= 0 && index < session.InputImages.Count)
            session.InputImages.RemoveAt(index);
    }

    private async Task RunPromptAsync(CodeBadgerTerminalSession session, string prompt, IReadOnlyList<string> images)
    {
        session.IsBusy = true;
        session.Error = null;
        session.RunCancellation?.Dispose();
        session.RunCancellation = new CancellationTokenSource();
        var cancellationToken = session.RunCancellation.Token;
        await InvokeAsync(StateHasChanged);
        try
        {
            if (AgentTools.Normalize(Repository.AgentTool) != AgentTools.OpenCode)
                throw new NotSupportedException(L.T("The CodeBadger connector currently supports OpenCode. Other agent connectors will be added later."));

            _availableOpenCodeModels = await OpenCodeActivity.GetAvailableModelsAsync(Repository.Path, cancellationToken);
            if (_availableOpenCodeModels.Count == 0)
                throw new InvalidOperationException(L.T("OpenCode did not return any available models for this repository."));
            cancellationToken.ThrowIfCancellationRequested();
            _settings = await SettingsService.LoadAsync();
            var agentPreferences = GetAgentPreferences(Repository.AgentTool);
            var preferences = agentPreferences.RolePreferences;
            switch (CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode))
            {
                case CodeBadgerOrchestrationModes.SingleAgent:
                    await RunSingleAgentPromptAsync(session, prompt, preferences, cancellationToken, images);
                    break;
                case CodeBadgerOrchestrationModes.PlanBuild:
                    var requestedMode = session.Mode;
                    var currentUserIndex = session.State.Messages.FindLastIndex(message => message.Role == "user");
                    var priorPlan = currentUserIndex > 0
                        ? session.State.Messages.Take(currentUserIndex)
                            .LastOrDefault(message => message.Role == "assistant" && message.AgentRole == CodeBadgerRoles.Planner)?.Text
                        : null;
                    var plan = session.Mode == TerminalMode.Build && !string.IsNullOrWhiteSpace(priorPlan)
                        ? priorPlan
                        : await RunRoleAsync(session, CodeBadgerRoles.Planner,
                            session.Mode == TerminalMode.Plan ? prompt : "First produce an actionable plan for this implementation request. Do not edit files yet.\n\n" + prompt,
                            parentRole: null, preferences, cancellationToken, images);
                    if (requestedMode == TerminalMode.Plan)
                        break;
                    await RunRoleAsync(session, CodeBadgerRoles.Worker,
                        $"Implement the following plan in this repository. Make the required code changes, run appropriate checks, and report the result.\n\nPlan:\n{plan}",
                        CodeBadgerRoles.Planner, preferences, cancellationToken, images);
                    session.Mode = TerminalMode.Build;
                    session.State.Mode = "Build";
                    break;
                case CodeBadgerOrchestrationModes.Full:
                    await RunFullOrchestrationAsync(session, prompt, preferences, cancellationToken, images);
                    break;
            }
            if (CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode) != CodeBadgerOrchestrationModes.SingleAgent)
            {
                session.State.Mode = "Build";
                session.Mode = TerminalMode.Build;
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            Snackbar.Add(L.T("The agent request was stopped."), Severity.Info);
        }
        catch (Exception exception)
        {
            session.Error = exception.Message;
            Snackbar.Add(L.T("The AI request failed: {0}", exception.Message), Severity.Error);
        }
        finally
        {
            session.IsBusy = false;
            session.ActiveOpenCodeSessionId = null;
            session.RunCancellation?.Dispose();
            session.RunCancellation = null;
            await PersistTerminalStateAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CancelPromptAsync(CodeBadgerTerminalSession session)
    {
        var cancellation = session.RunCancellation;
        if (cancellation is null || !session.IsBusy)
            return;

        cancellation.Cancel();
        if (session.ActiveOpenCodeSessionId is { } sessionId)
        {
            try
            {
                await OpenCodeActivity.InterruptSessionAsync(sessionId, Repository.Path, CancellationToken.None);
            }
            catch (Exception exception)
            {
                Logger.LogWarning(exception, "Could not interrupt OpenCode session {SessionId} after a terminal stop request.", sessionId);
            }
        }
    }

    private async Task RunSingleAgentPromptAsync(CodeBadgerTerminalSession session, string prompt,
        IReadOnlyList<CodeBadgerRolePreference> preferences, CancellationToken cancellationToken, IReadOnlyList<string> images)
    {
        var role = session.Mode == TerminalMode.Plan ? CodeBadgerRoles.Planner : CodeBadgerRoles.Worker;
        await RunRoleAsync(session, role, prompt, parentRole: null, preferences, cancellationToken, images);
    }

    private async Task<string> RunRoleAsync(CodeBadgerTerminalSession session, string role, string prompt,
        string? parentRole, IReadOnlyList<CodeBadgerRolePreference> preferences, CancellationToken cancellationToken,
        IReadOnlyList<string>? images = null)
    {
        cancellationToken.ThrowIfCancellationRequested();
        var preference = preferences.FirstOrDefault(item => item.Role == role)
            ?? new CodeBadgerRolePreference { Role = role, AgentType = CodeBadgerRoles.DefaultAgentType(role) };
        var preferenceAgent = await ResolvePreferenceAgentAsync(preference, role, cancellationToken);
        var model = await ResolveRoleModelAsync(session, preference, role, prompt, preferences, cancellationToken);
        cancellationToken.ThrowIfCancellationRequested();
        var parentId = parentRole is not null && session.State.AgentSessionIds.TryGetValue(parentRole, out var existingParent)
            ? existingParent : null;
        var orchestrationMode = CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode);
        var sessionKey = orchestrationMode == CodeBadgerOrchestrationModes.SingleAgent
            ? "SingleAgent" : role;
        if (!session.State.AgentSessionIds.TryGetValue(sessionKey, out var agentSessionId))
        {
            var created = await OpenCodeActivity.CreateOrchestrationSessionAsync(Repository.Path, preferenceAgent,
                $"{session.Title} · {RoleDisplayName(role)}", parentId, model, cancellationToken);
            agentSessionId = created.Id;
            session.State.AgentSessionIds[sessionKey] = agentSessionId;
            await PersistTerminalStateAsync();
        }
        else
        {
            if (!string.IsNullOrWhiteSpace(model))
                await OpenCodeActivity.SwitchModelAsync(agentSessionId, Repository.Path, model, cancellationToken);
            await OpenCodeActivity.SwitchAgentAsync(agentSessionId, Repository.Path, preferenceAgent, cancellationToken);
        }
        cancellationToken.ThrowIfCancellationRequested();
        session.ActiveOpenCodeSessionId = agentSessionId;
        session.State.ActiveAgentRole = role;
        var modelStateKey = orchestrationMode == CodeBadgerOrchestrationModes.SingleAgent
            ? "Model:SingleAgent" : "Model:" + role;
        if (!string.IsNullOrWhiteSpace(model))
        {
            session.State.AgentSessionIds[modelStateKey] = model;
            session.State.AgentContextModels[sessionKey] = model;
        }

        var pendingMessage = new CodeBadgerTerminalMessage
        {
            Role = "assistant", AgentRole = role, ModelReference = model ?? string.Empty,
            Text = L.T("Sending to {0}...", RoleDisplayName(role))
        };
        session.State.Messages.Add(pendingMessage);
        await PersistTerminalStateAsync();
        await InvokeAsync(StateHasChanged);
        string response;
        try
        {
            var previousMessageIds = await OpenCodeActivity.GetSessionMessageIdsAsync(agentSessionId, Repository.Path, cancellationToken)
                ?? throw new InvalidOperationException(L.T("Could not read the existing OpenCode session messages before sending the request."));
            var promptMessageId = await OpenCodeActivity.SendPromptAsync(agentSessionId, Repository.Path, prompt,
                cancellationToken, preferenceAgent, images);
            if (string.IsNullOrWhiteSpace(promptMessageId))
                throw new InvalidOperationException(L.T("OpenCode accepted the request but did not return a message ID, so its reply cannot be matched safely."));
            await OpenCodeActivity.WaitForSessionAsync(agentSessionId, Repository.Path, cancellationToken);
            response = await WaitForPromptAnswerAsync(agentSessionId, promptMessageId, previousMessageIds, cancellationToken)
                ?? throw new InvalidOperationException(L.T("The AI session finished without a completed text response for this request."));
            await RefreshAgentContextAsync(session, role, sessionKey, agentSessionId, cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            pendingMessage.Text = L.T("The agent request was stopped.");
            await PersistTerminalStateAsync();
            await InvokeAsync(StateHasChanged);
            throw;
        }
        catch (Exception exception)
        {
            pendingMessage.Text = L.T("Agent request failed: {0}", exception.Message);
            await PersistTerminalStateAsync();
            await InvokeAsync(StateHasChanged);
            throw;
        }
        pendingMessage.Text = response;
        await PersistTerminalStateAsync();
        await InvokeAsync(StateHasChanged);
        return response;
    }

    private async Task<string?> WaitForPromptAnswerAsync(string sessionId, string promptMessageId,
        IReadOnlySet<string> previousMessageIds,
        CancellationToken cancellationToken)
    {
        // Some OpenCode versions return from wait just before the completed message is
        // visible through message.list. Only accept a reply correlated to this prompt.
        for (var attempt = 0; attempt < 10; attempt++)
        {
            cancellationToken.ThrowIfCancellationRequested();
            var answer = await OpenCodeActivity.GetCompletedAnswerForPromptAsync(
                sessionId, Repository.Path, promptMessageId, previousMessageIds, cancellationToken);
            if (!string.IsNullOrWhiteSpace(answer))
                return answer;
            if (attempt < 9)
                await Task.Delay(TimeSpan.FromMilliseconds(300), cancellationToken);
        }
        return null;
    }

    private async Task<string> ResolvePreferenceAgentAsync(CodeBadgerRolePreference preference, string role,
        CancellationToken cancellationToken)
    {
        var agents = await OpenCodeActivity.GetAvailableAgentOptionsAsync(Repository.Path, cancellationToken);
        string? requestedId = preference.AgentType switch
        {
            "Plan" => "plan",
            "Build" => "build",
            "Custom" => preference.CustomAgentId,
            _ => await OpenCodeActivity.GetDefaultAgentIdAsync(Repository.Path, CancellationToken.None)
        };

        if (!string.IsNullOrWhiteSpace(requestedId))
        {
            var requestedAgent = agents.FirstOrDefault(agent => string.Equals(agent.Id, requestedId, StringComparison.OrdinalIgnoreCase));
            if (requestedAgent is not null)
            {
                if (preference.AgentType == "Primary" && requestedAgent.Mode is not ("primary" or "all"))
                    throw new InvalidOperationException(L.T("The configured OpenCode default agent is not a primary agent."));
                if (preference.AgentType == "Custom" && requestedAgent.Mode is not ("subagent" or "all"))
                    throw new InvalidOperationException(L.T("Choose a custom OpenCode subagent for this role."));
                return requestedAgent.Id;
            }
        }

        if (preference.AgentType == "Primary")
        {
            // Prefer a primary agent explicitly named primary; otherwise the mode="primary" agents
            // returned by OpenCode are the only stable contract we have across installations.
            var primary = agents.FirstOrDefault(agent => string.Equals(agent.Id, requestedId, StringComparison.OrdinalIgnoreCase))
                ?? agents.FirstOrDefault(agent => agent.Mode == "primary");
            if (primary is not null) return primary.Id;
        }

        if (preference.AgentType == "Custom")
        {
            var custom = agents.FirstOrDefault(agent => agent.Mode is "subagent" or "all");
            if (custom is not null) return custom.Id;
        }

        var safeFallback = role is CodeBadgerRoles.Orchestrator or CodeBadgerRoles.Router or CodeBadgerRoles.Planner
            ? "plan" : "build";
        if (agents.Any(agent => string.Equals(agent.Id, safeFallback, StringComparison.OrdinalIgnoreCase)))
            return safeFallback;
        return agents.FirstOrDefault()?.Id
            ?? throw new InvalidOperationException(L.T("OpenCode returned no available agents."));
    }

    private async Task RunFullOrchestrationAsync(CodeBadgerTerminalSession session, string prompt,
        IReadOnlyList<CodeBadgerRolePreference> preferences, CancellationToken cancellationToken, IReadOnlyList<string> images)
    {
        var route = await RunRoleAsync(session, CodeBadgerRoles.Router,
            "Classify this user request. Reply with concise JSON containing task_type, needs_research (boolean), needs_implementation (boolean), and summary. Do not perform the task yet.\n\nRequest:\n" + prompt,
            null, preferences, cancellationToken, images);
        var assignments = await RunRoleAsync(session, CodeBadgerRoles.Orchestrator,
            $"Act as manager. Break the task into subtasks for planning, research, implementation, and review. Return concise JSON listing subtasks and dependencies. Do not inspect or modify files; CodeBadger dispatches roles. Routing analysis: {route}\n\nRequest:\n{prompt}",
            null, preferences, cancellationToken, images);
        var needsResearch = ReadBooleanField(route, "needs_research");
        var needsImplementation = ReadBooleanField(route, "needs_implementation");
        if (needsResearch)
            await RunRoleAsync(session, CodeBadgerRoles.Rag,
                "Research relevant repository context, files, and available knowledge sources. Report evidence and paths.\n\n" + prompt,
                CodeBadgerRoles.Orchestrator, preferences, cancellationToken, images);

        var plan = await RunRoleAsync(session, CodeBadgerRoles.Planner,
            $"Develop an actionable plan based on the manager's task breakdown. Manager breakdown: {assignments}\nRouting analysis: {route}\n\nRequest:\n{prompt}",
            CodeBadgerRoles.Orchestrator, preferences, cancellationToken, images);
        var context = new StringBuilder().AppendLine("Request:").AppendLine(prompt).AppendLine().AppendLine("Plan:").AppendLine(plan);
        if (session.State.Messages.LastOrDefault(message => message.AgentRole == CodeBadgerRoles.Rag) is { } research)
            context.AppendLine().AppendLine("Research findings:").AppendLine(research.Text);
        var build = needsImplementation
            ? await RunRoleAsync(session, CodeBadgerRoles.Worker,
                $"Execute this plan in the repository, update files, run relevant checks, then summarize changed files and test results.\n\n{context}",
                CodeBadgerRoles.Orchestrator, preferences, cancellationToken, images)
            : L.T("No implementation was requested by the triage agent.");
        var review = await RunRoleAsync(session, CodeBadgerRoles.Critic,
            $"Review the plan and any implementation/test report. Reply only with JSON {{\"needs_changes\": boolean, \"findings\": [strings]}}. Do not edit files.\n\nRequest:\n{prompt}\n\nPlan:\n{plan}\n\nImplementation report:\n{build}",
            CodeBadgerRoles.Orchestrator, preferences, cancellationToken, images);
        if (needsImplementation && ReadBooleanField(review, "needs_changes"))
            await RunRoleAsync(session, CodeBadgerRoles.Worker,
                "Address these review findings, run relevant checks, and report what changed:\n\n" + ReadStringField(review, "findings"),
                CodeBadgerRoles.Orchestrator, preferences, cancellationToken, images);
        await RunRoleAsync(session, CodeBadgerRoles.Orchestrator,
            "Provide a concise final user-facing summary based on the completed plan, implementation, and review.\n\nRequest:\n" + prompt,
            null, preferences, cancellationToken, images);
    }

    private static bool ReadBooleanField(string json, string field)
    {
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(json);
            return document.RootElement.TryGetProperty(field, out var value) && value.ValueKind == System.Text.Json.JsonValueKind.True;
        }
        catch (System.Text.Json.JsonException) { return false; }
    }

    private static string ReadStringField(string json, string field)
    {
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(json);
            if (!document.RootElement.TryGetProperty(field, out var value)) return json;
            return value.ValueKind == System.Text.Json.JsonValueKind.Array
                ? string.Join("\n", value.EnumerateArray().Where(item => item.ValueKind == System.Text.Json.JsonValueKind.String)
                    .Select(item => item.GetString()))
                : value.ToString();
        }
        catch (System.Text.Json.JsonException) { return json; }
    }

    private string RoleDisplayName(string role) => role switch
    {
        CodeBadgerRoles.Orchestrator => L.T("Orchestrator / Manager"),
        CodeBadgerRoles.Router => L.T("Router / Triage-agent"),
        CodeBadgerRoles.Planner => L.T("Planner / Reasoning-agent"),
        CodeBadgerRoles.Worker => L.T("Worker / Tool-use agent"),
        CodeBadgerRoles.Rag => L.T("RAG / Knowledge-agent"),
        CodeBadgerRoles.Critic => L.T("Critic / Evaluator-agent"),
        _ => role
    };

    private async Task<string> ResolveRoleModelAsync(CodeBadgerTerminalSession session,
        CodeBadgerRolePreference preference, string role, string taskDescription,
        IReadOnlyList<CodeBadgerRolePreference> preferences, CancellationToken cancellationToken)
    {
        var available = _availableOpenCodeModels.Where(model => model.Enabled && model.Status == "active").ToArray();
        var orchestrationMode = CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode);
        var agentPreferences = GetAgentPreferences(Repository.AgentTool);
        var preferredModels = orchestrationMode switch
        {
            CodeBadgerOrchestrationModes.SingleAgent => agentPreferences.SingleAgentPreferredModels,
            CodeBadgerOrchestrationModes.PlanBuild when role == CodeBadgerRoles.Planner => agentPreferences.PlanPreferredModels,
            CodeBadgerOrchestrationModes.PlanBuild when role == CodeBadgerRoles.Worker => agentPreferences.BuildPreferredModels,
            _ => preference.PreferredModels
        };
        if (!string.IsNullOrWhiteSpace(agentPreferences.TerminalModel) &&
            available.FirstOrDefault(model => string.Equals(model.Reference, agentPreferences.TerminalModel, StringComparison.OrdinalIgnoreCase)) is { } terminalModel)
            return terminalModel.Reference;
        foreach (var preferred in preferredModels.Where(model => !string.IsNullOrWhiteSpace(model)))
            if (available.Any(model => string.Equals(model.Reference, preferred, StringComparison.OrdinalIgnoreCase)))
                return available.First(model => string.Equals(model.Reference, preferred, StringComparison.OrdinalIgnoreCase)).Reference;

        if (available.Length > 0)
        {
            try
            {
                var routerPreference = preferences.FirstOrDefault(item => item.Role == CodeBadgerRoles.Router)
                    ?? new CodeBadgerRolePreference { Role = CodeBadgerRoles.Router, AgentType = "Plan" };
                var routerAgent = await ResolvePreferenceAgentAsync(routerPreference, CodeBadgerRoles.Router, cancellationToken);
                var routerModel = routerPreference?.PreferredModels.FirstOrDefault(value => available.Any(model =>
                    string.Equals(model.Reference, value, StringComparison.OrdinalIgnoreCase)));
                const string selectorRolePrefix = "ModelSelector:";
                var selectorKey = selectorRolePrefix + role;
                if (!session.State.AgentSessionIds.TryGetValue(selectorKey, out var selectorSessionId))
                {
                    var seedModel = !string.IsNullOrWhiteSpace(routerModel) ? routerModel :
                        !string.IsNullOrWhiteSpace(_agentModelReference) && available.Any(model => model.Reference == _agentModelReference)
                            ? _agentModelReference
                            : available.OrderBy(model => EstimatedCost(model, CodeBadgerRoles.Router)).First().Reference;
                    var selector = await OpenCodeActivity.CreateOrchestrationSessionAsync(Repository.Path,
                        routerAgent, $"{session.Title} · Model selector · {role}", null, seedModel, cancellationToken);
                    selectorSessionId = selector.Id;
                    session.State.AgentSessionIds[selectorKey] = selectorSessionId;
                    await PersistTerminalStateAsync();
                }
                session.ActiveOpenCodeSessionId = selectorSessionId;

                var previousMessageIds = await OpenCodeActivity.GetSessionMessageIdsAsync(
                    selectorSessionId, Repository.Path, cancellationToken);
                if (previousMessageIds is null)
                    throw new InvalidOperationException("Could not read the existing OpenCode model selector messages.");

                var candidates = available.Take(24).Select(model => new
                {
                    model.Reference, model.Name, model.Context, model.OutputLimit,
                    model.InputCost, model.OutputCost, model.HasPublishedCost
                });
                var request = $"Choose the best model for the AI role '{RoleDisplayName(role)}' and the task below. Infer task suitability from model name/family and context/output limits. Treat price as a cost tradeoff, never assume an unpriced model is free. Prefer a priced model when quality looks comparable; choose an unpriced model only when its likely task quality is materially better. Choose exactly one Reference from the candidate JSON; if metadata cannot establish a quality advantage, choose the cheapest capable model with a published price. Return only JSON {{\"model\":\"provider/model\"}}.\nTask:\n{taskDescription}\nCandidates (prices USD per million tokens):\n{System.Text.Json.JsonSerializer.Serialize(candidates)}";
                var selectorPromptId = await OpenCodeActivity.SendPromptAsync(selectorSessionId, Repository.Path,
                    request, cancellationToken, routerAgent);
                if (string.IsNullOrWhiteSpace(selectorPromptId))
                    throw new InvalidOperationException("OpenCode did not return a message ID for model selection.");
                await OpenCodeActivity.WaitForSessionAsync(selectorSessionId, Repository.Path, cancellationToken);
                var result = await WaitForPromptAnswerAsync(selectorSessionId, selectorPromptId, previousMessageIds, cancellationToken);
                var selected = ReadStringField(result ?? string.Empty, "model");
                var match = available.FirstOrDefault(model => string.Equals(model.Reference, selected, StringComparison.OrdinalIgnoreCase));
                if (match is not null) return match.Reference;
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
            {
                throw;
            }
            catch (Exception exception)
            {
                Logger.LogWarning(exception, "AI model routing failed for role {Role}; use the capability/cost fallback.", role);
            }
        }

        return ResolveRoleModelFallback(available, role);
    }

    private string ResolveRoleModelFallback(IReadOnlyList<OpenCodeActivityService.AvailableModel> available, string role)
    {

        var taskWords = role switch
        {
            CodeBadgerRoles.Orchestrator or CodeBadgerRoles.Router => new[] { "reason", "pro", "opus", "think" },
            CodeBadgerRoles.Planner or CodeBadgerRoles.Critic => new[] { "reason", "opus", "pro", "think" },
            CodeBadgerRoles.Worker => new[] { "code", "coder", "dev", "instruct" },
            CodeBadgerRoles.Rag => new[] { "fast", "flash", "mini", "lite" },
            _ => Array.Empty<string>()
        };
        return available
            .OrderByDescending(model => TaskFit(model, taskWords))
            .ThenBy(model => EstimatedCost(model, role))
            .ThenByDescending(model => model.Context)
            .FirstOrDefault()?.Reference
            ?? _availableOpenCodeModels.FirstOrDefault(model => model.Enabled)?.Reference
            ?? throw new InvalidOperationException(L.T("No enabled OpenCode model is available."));
    }

    private static int TaskFit(OpenCodeActivityService.AvailableModel model, IReadOnlyList<string> taskWords)
    {
        var name = model.Name + " " + model.Reference;
        var affinity = taskWords.Count(word => name.Contains(word, StringComparison.OrdinalIgnoreCase));
        if (model.OutputLimit >= 16000) affinity += 1;
        if (model.Context >= 64000) affinity += 1;
        return affinity;
    }

    private static double EstimatedCost(OpenCodeActivityService.AvailableModel model, string role)
    {
        // Rough screening estimate per million total tokens: give output more weight for reasoning roles.
        if (!model.HasPublishedCost)
            return double.PositiveInfinity;
        var outputWeight = role is CodeBadgerRoles.Planner or CodeBadgerRoles.Orchestrator or CodeBadgerRoles.Critic ? 2.0 : 1.0;
        return model.InputCost + model.OutputCost * outputWeight;
    }

    private string SessionAgentModelLabel(CodeBadgerTerminalSession session)
    {
        var role = CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode) switch
        {
            CodeBadgerOrchestrationModes.Full => session.IsBusy && !string.IsNullOrWhiteSpace(session.State.ActiveAgentRole)
                ? session.State.ActiveAgentRole : CodeBadgerRoles.Orchestrator,
            CodeBadgerOrchestrationModes.PlanBuild => session.Mode == TerminalMode.Plan ? CodeBadgerRoles.Planner : CodeBadgerRoles.Worker,
            _ => session.Mode == TerminalMode.Plan ? CodeBadgerRoles.Planner : CodeBadgerRoles.Worker
        };
        var agentPreferences = GetAgentPreferences(Repository.AgentTool);
        var preference = agentPreferences.RolePreferences.FirstOrDefault(item => item.Role == role);
        var selectedRole = role;
        preference = agentPreferences.RolePreferences.FirstOrDefault(item => item.Role == selectedRole) ?? preference;
        var modelStateKey = CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode) switch
        {
            CodeBadgerOrchestrationModes.SingleAgent => "Model:SingleAgent",
            CodeBadgerOrchestrationModes.PlanBuild => "Model:" + (session.Mode == TerminalMode.Plan ? CodeBadgerRoles.Planner : CodeBadgerRoles.Worker),
            _ => "Model:" + selectedRole
        };
        var storedModel = session.State.AgentSessionIds.TryGetValue(modelStateKey, out var activeModel)
            ? activeModel : null;
        var fallbackModel = CodeBadgerOrchestrationModes.Normalize(Repository.CodeBadgerOrchestrationMode) switch
        {
            CodeBadgerOrchestrationModes.SingleAgent => agentPreferences.SingleAgentPreferredModels.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)),
            CodeBadgerOrchestrationModes.PlanBuild when role == CodeBadgerRoles.Planner => agentPreferences.PlanPreferredModels.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)),
            CodeBadgerOrchestrationModes.PlanBuild when role == CodeBadgerRoles.Worker => agentPreferences.BuildPreferredModels.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)),
            _ => preference?.PreferredModels.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))
        };
        var model = storedModel ?? fallbackModel ?? agentPreferences.TerminalModel ?? _agentModelReference;
        var currentAgent = Repository.AgentTool == AgentTools.OpenCode ? "OpenCode" : AgentTools.GetDisplayName(Repository.AgentTool);
        var agent = preference is null ? "Build" : AgentTypeLabel(preference.AgentType, preference.CustomAgentId);
        return $"{currentAgent} · {RoleDisplayName(selectedRole)} · {agent}{(string.IsNullOrWhiteSpace(model) ? string.Empty : " · " + FormatModelName(model.Split('/').Last()))}";
    }

    private static string AgentTypeLabel(string agentType, string customAgentId) => agentType switch
    {
        "Primary" => "Primary",
        "Plan" => "Plan",
        "Build" => "Build",
        "Custom" => string.IsNullOrWhiteSpace(customAgentId) ? "Custom" : customAgentId,
        _ => agentType
    };

    private async Task PersistTerminalStateAsync()
    {
        if (_terminalState.RepositoryId == Guid.Empty) return;
        try { await TerminalStateService.SaveAsync(_terminalState); }
        catch (Exception exception) { Logger.LogWarning(exception, "Could not persist CodeBadger terminal state for repository {RepositoryId}.", Repository.Id); }
    }

    [JSInvokable]
    public Task SetAiPanelSize(double percent) => InvokeAsync(() =>
    {
        _aiPanelHeight = Math.Clamp(percent, 15, 75);
        _aiPanelMode = AiPanelMode.Split;
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        if (_splitterModule is not null)
        {
            try
            {
                await _splitterModule.InvokeVoidAsync("detach", _terminalStack);
                await _splitterModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        if (_conversationScrollModule is not null)
        {
            try { await _conversationScrollModule.InvokeVoidAsync("detach", _terminalStack); }
            catch (JSDisconnectedException) { }
            await _conversationScrollModule.DisposeAsync();
        }
        if (_composerModule is not null)
        {
            try { await _composerModule.InvokeVoidAsync("detach", _terminalStack); }
            catch (JSDisconnectedException) { }
            await _composerModule.DisposeAsync();
        }
        _selfReference?.Dispose();
    }

    private enum AiPanelMode { Split, Collapsed, Expanded }
    private enum TerminalMode { Plan, Build }

    private sealed class CodeBadgerTerminalSession
    {
        public CodeBadgerTerminalSession(CodeBadgerTerminalSessionState state) => State = state;
        public CodeBadgerTerminalSessionState State { get; }
        public Guid Id => State.Id;
        public string Title => State.Title;
        public string Input { get; set; } = string.Empty;
        public List<string> InputImages { get; } = [];
        public TerminalMode Mode { get; set; } = TerminalMode.Plan;
        public List<CodeBadgerTerminalMessage> Messages => State.Messages;
        public bool IsBusy { get; set; }
        public bool IsRotatingAgentRole { get; set; }
        public bool IsSubmitting { get; set; }
        public string? Error { get; set; }
        public CancellationTokenSource? RunCancellation { get; set; }
        public string? ActiveOpenCodeSessionId { get; set; }
    }

}
