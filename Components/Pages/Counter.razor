@page "/counter"
@inject LocalizationService L

<h1>@L.T("Counter")</h1>

<p role="status">@L.T("Current count: {0}", currentCount)</p>

<button class="btn btn-primary" @onclick="IncrementCount">@L.T("Click me")</button>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
