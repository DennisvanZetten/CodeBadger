            _isOperating = false;
        }
    }

    private Task PopLatestStashAsync() => _stashes.Count > 0
        ? PopStashAsync(_stashes[0])
        : Task.CompletedTask;

    private async Task PopStashAsync(GitStashEntry stash)
    {
        if (_isOperating)
            return;

        _isOperating = true;
        try
        {
            var result = await GitBranchService.PopStashAsync(RepositoryPath, GetCurrentStashReference(stash));
            Snackbar.Add(result.Success ? L.T("Stash popped.") : L.T("Could not pop stash: {0}", result.Message),
                result.Success ? Severity.Success : Severity.Error);
            if (result.Success && _hiddenStashCommitHashes.Remove(stash.CommitHash))
                await SaveHiddenStashesAsync();
            await RefreshAsync();
            await RefreshStashesAsync();
        }
        finally
        {
            _isOperating = false;
        }
    }

    private void OpenStashContextMenu(GitStashEntry stash, MouseEventArgs args)
    {
        _contextMenuStash = stash;
        _stashContextMenuX = args.ClientX;
        _stashContextMenuY = args.ClientY;
        _stashContextMenuNeedsPosition = true;
    }

    private void CloseStashContextMenu()
    {
        _contextMenuStash = null;
        _stashContextMenuNeedsPosition = false;
    }

    private async Task ApplyContextStashAsync()
    {
        var stash = _contextMenuStash;
        CloseStashContextMenu();
        if (stash is null || _isOperating)
            return;

        _isOperating = true;
        try
        {
            var result = await GitBranchService.ApplyStashAsync(RepositoryPath, GetCurrentStashReference(stash));
            Snackbar.Add(result.Success ? L.T("Stash applied.") : L.T("Could not apply stash: {0}", result.Message),
                result.Success ? Severity.Success : Severity.Error);
            await RefreshAsync();
            await RefreshStashesAsync();
        }
        finally
        {
