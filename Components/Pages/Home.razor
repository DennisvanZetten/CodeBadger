@page "/"
@inject LauncherSettingsService SettingsService
@inject LocalizationService L
@inject GitBranchService GitBranchService
@inject OpenCodeActivityService OpenCodeActivity
@inject SlackNotificationService SlackNotifications
@inject StartupDetectionService StartupDetection
@inject WindowsSandboxSessionService SandboxSessions
@inject SandboxApprovalService SandboxApprovals
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject RepositoryDetachedWindowService DetachedWindows
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Logging.ILogger<Home> Logger
@inject SessionShareService SessionShares
@using Microsoft.Extensions.Logging
@using CodeBadger.Components.Pages
@implements IAsyncDisposable

<PageTitle>CodeBadger</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pt-4 pb-2 repository-home">
    @if (_activeRepositories.Count == 0)
    {
        <MudPaper Class="pa-6" Outlined="true" Elevation="0">
            <MudStack Spacing="2" AlignItems="AlignItems.Center">
                <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.h6">@L.T("No active repositories yet")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L.T("Open Settings in the top-right corner to add or activate repositories.")</MudText>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <MudTabs ActivePanelIndex="_activeTabIndex" ActivePanelIndexChanged="HandleActiveTabChanged" KeepPanelsAlive="true" Rounded="true" Border="true" ApplyEffectsToContainer="true" Class="repository-tabs">
            <Header>
                @foreach (var repository in _activeRepositories.Where(repository => DetachedWindows.IsDetached(repository.Id)))
                {
                    <div class="repository-detached-tab-indicator" data-repository-id="@repository.Id" title="@RepositoryTitle(repository)">
                        <img class="repository-agent-logo" src="@AgentLogo(repository)" alt="" />
                        <span>@RepositoryTitle(repository)</span>
                    </div>
                }
            </Header>
            <ChildContent>
            @foreach (var repository in DockedRepositories)
            {
                @* Changing the tag ensures the kept-alive tab panel renders updated Git status. *@
                <MudTabPanel @key="repository.Id" Tag="@(_gitSnapshots.TryGetValue(repository, out var panelSnapshot) ? panelSnapshot : null)">
                    <TabContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="repository-tab-header-content">
                            <span class="repository-tab-label" data-repository-id="@repository.Id">
                            @if (AgentTools.Normalize(repository.AgentTool) == AgentTools.OpenCode && repository.OpenCodeSandboxEnabled)
                            {
                                <MudTooltip Class="repository-sandbox-indicator" Text="@L.T(SandboxSessions.IsRunning(repository.Id) ? "Sandbox active" : "Sandbox enabled; not running")">
                                    <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small"
                                             Class="repository-sandbox-shield" @onclick="@(() => ReviewSandboxChangesAsync(repository))"
                                             Color="@(SandboxSessions.IsRunning(repository.Id) ? Color.Success : Color.Warning)"
                                             aria-label="@L.T(SandboxSessions.IsRunning(repository.Id) ? "Sandbox active" : "Sandbox enabled; not running")" />
                                </MudTooltip>
                            }
                            <img class="repository-agent-logo" src="@AgentLogo(repository)" alt="@AgentTools.GetDisplayName(repository.AgentTool)"
                                 title="@AgentTools.GetDisplayName(repository.AgentTool)" />
                            <MudText>@RepositoryTitle(repository)</MudText>
                            @if (SessionShares.CurrentShare is { } currentShare && currentShare.RepositoryId == repository.Id)
                            {
                                <MudTooltip Text="@($"{SessionShares.GetViewerCountForSession(currentShare.SessionId)} people viewing this session")">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                        <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" /> @SessionShares.GetViewerCountForSession(currentShare.SessionId)
                                    </MudChip>
                                </MudTooltip>
                                <MudTooltip Text="@L.T("Stop sharing")">
                                    <MudIconButton Icon="@Icons.Material.Filled.LinkOff" Size="Size.Small"
                                                   aria-label="@L.T("Stop sharing")" OnClick="StopSharingAsync" />
                                </MudTooltip>
                            }
                            @if (_questionSessions.Contains(repository.Id))
                            {
                                <MudTooltip Text="@L.T("Agent is waiting for your answer")">
                                    <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Small" Color="Color.Warning"
                                             Class="repository-question-icon"
                                             aria-label="@L.T("Agent is waiting for your answer")"
                                             title="@L.T("Agent is waiting for your answer")" />
                                </MudTooltip>
                            }
                            else if (_runningSessions.Contains(repository.Id))
                            {
                                <span class="repository-activity-spinner @AgentSpinnerClass(repository)" role="status"
                                       aria-label="@L.T("Agent session is working", AgentTools.GetDisplayName(repository.AgentTool))"
                                       title="@L.T("Agent session is working", AgentTools.GetDisplayName(repository.AgentTool))"></span>
                            }
                            </span>
                            <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small"
                                           Class="repository-undock-button" aria-label="@L.T("Undock tab")"
                                           title="@L.T("Undock tab")" OnClick="@(() => UndockRepository(repository))" />
                            @if (AgentTools.Normalize(repository.AgentTool) == AgentTools.OpenCode && !repository.OpenCodeSandboxEnabled)
                            {
                                <MudTooltip Text="@L.T("Share read-only session")">
                                    <MudIconButton Icon="@Icons.Material.Filled.Share" Size="Size.Small"
                                                   aria-label="@L.T("Share read-only session")"
                                                   OnClick="@(() => ShareSessionAsync(repository))" />
                                </MudTooltip>
                            }
                        </MudStack>
                    </TabContent>
                    <ChildContent>
                         <RepositoryWorkspace Repository="repository"
                                              RepositoryTitle="@RepositoryTitle(repository)"
                                               RepositoryExists="@Directory.Exists(repository.Path)"
                                               AgentAvailable="@StartupDetection.IsAgentAvailable(repository.AgentTool)"
                                               IsVisible="@(DockedRepositories.IndexOf(repository) == _activeTabIndex)"
                                               OpenCodeSessionId="@SelectedOpenCodeSession(repository)"
                                               GitBranchLabel="@BranchLabel(repository)"
                                              GitSnapshot="@(_gitSnapshots.TryGetValue(repository, out var workspaceSnapshot) ? workspaceSnapshot : null)"
                                              OnOpenGitOverview="@(() => OpenGitDialogAsync(repository))" />
                    </ChildContent>
                </MudTabPanel>
            }
            </ChildContent>
        </MudTabs>
        @if (_contextMenuRepository is not null && CanOpenRepositorySlackSessions(_contextMenuRepository))
        {
            <div class="repository-tab-context-backdrop" @onclick="CloseRepositoryContextMenu" @oncontextmenu:preventDefault="true"></div>
            <div class="repository-tab-context-menu git-commit-context-menu" style="left:@(_contextMenuX)px;top:@(_contextMenuY)px" @onclick:stopPropagation="true">
                <button class="git-commit-context-menu-item" @onclick="OpenRepositorySlackSessionsAsync">
                    <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Size="Size.Small" />
                    <span>@L.T("Session notifications")</span>
                </button>
            </div>
        }
        @if (_isDockDragActive)
        {
            <div class="repository-dock-drop-hint" role="status">@L.T("Drop tab here to dock")</div>
        }
    }
</MudContainer>

@code {
    private const string LastRepositoryPreferenceKey = "last-active-repository-id";
    private LauncherSettings _settings = new();
    private List<RepositoryEntry> _activeRepositories = [];
    private readonly Dictionary<RepositoryEntry, GitBranchInfo> _branches = [];
    private readonly Dictionary<RepositoryEntry, GitRepositorySnapshot> _gitSnapshots = [];
    private readonly HashSet<Guid> _runningSessions = [];
    private readonly HashSet<Guid> _questionSessions = [];
    private readonly Dictionary<string, OpenCodeActivityService.ActiveSession> _runningOpenCodeSessions = new(StringComparer.Ordinal);
    private readonly Dictionary<string, DateTime> _pendingSlackCompletions = new(StringComparer.Ordinal);
    private readonly Dictionary<string, DateTime> _lastSlackMessageSync = new(StringComparer.Ordinal);
    private readonly HashSet<string> _slackStartedSessions = new(StringComparer.Ordinal);
    private readonly Dictionary<Guid, string> _selectedOpenCodeSessions = [];
    private bool _isSharing;
    private bool _activityNeedsBaseline = true;
    private bool _isRefreshingBranches;
    private bool _isDockDragActive;
    private readonly HashSet<Guid> _repositoriesLoading = [];
    private int _activeTabIndex;
    private RepositoryEntry? _contextMenuRepository;
    private double _contextMenuX;
    private double _contextMenuY;
    private List<RepositoryEntry> DockedRepositories => _activeRepositories.Where(repository => !DetachedWindows.IsDetached(repository.Id)).ToList();
    private readonly CancellationTokenSource _statusMonitorCancellation = new();
    private IJSObjectReference? _tabsModule;
    private DotNetObjectReference<Home>? _selfReference;

    [CascadingParameter] public LauncherSettings? StartupSettings { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _settings = StartupSettings ?? await SettingsService.LoadAsync();
        try { await WindowsRepositoryAccessGuardian.RecoverPendingAsync(FileSystem.AppDataDirectory, FileSystem.OpenAppPackageFileAsync); }
        catch (Exception error) { Snackbar.Add("Repository access recovery failed: " + error.Message, Severity.Error); }
        SettingsService.SettingsSaved += HandleSettingsSaved;
        SlackNotifications.ReplyReceived += HandleSlackReplyReceived;
        SlackNotifications.SessionStarted += HandleSlackSessionStarted;
        SlackNotifications.SessionLinked += HandleSlackSessionLinked;
        SlackNotifications.SessionNotificationsChanged += HandleSlackSessionNotificationsChanged;
        SandboxApprovals.Requested += HandleSandboxApproval;
        SandboxSessions.StateChanged += HandleSandboxState;
        DetachedWindows.StateChanged += HandleDetachedWindowsChanged;
        DetachedWindows.DockRequested += HandleDockRequested;
        DetachedWindows.DockDragChanged += HandleDockDragChanged;
        L.LanguageChanged += HandleLanguageChanged;
        SyncRepositories();
        var hasLinkedSession = SelectLinkedSessionFromUri();
        await SlackNotifications.ConfigureAsync(_settings);
        if (_activeRepositories.Count > 0)
        {
            var lastRepositoryId = Preferences.Default.Get(LastRepositoryPreferenceKey, string.Empty);
            if (!hasLinkedSession)
            {
                var lastIndex = Guid.TryParse(lastRepositoryId, out var parsedRepositoryId)
                    ? DockedRepositories.FindIndex(repository => repository.Id == parsedRepositoryId)
                    : -1;
                _activeTabIndex = lastIndex >= 0 ? lastIndex : 0;
            }

            var selectedRepository = DockedRepositories.ElementAtOrDefault(_activeTabIndex);
            if (selectedRepository is not null)
            {
                Preferences.Default.Set(LastRepositoryPreferenceKey, selectedRepository.Id.ToString());
                var selectedLoad = LoadRepositoryStatusAsync(selectedRepository, _statusMonitorCancellation.Token);
                _ = LoadRemainingRepositoryStatusesAsync(selectedRepository.Id, selectedLoad, _statusMonitorCancellation.Token);
            }
        }
        _ = MonitorActiveRepositoryStatusAsync(_statusMonitorCancellation.Token);
        _ = MonitorOpenCodeActivityAsync(_statusMonitorCancellation.Token);
    }

    protected override void OnParametersSet()
    {
        if (_activeRepositories.Count > 0 && SelectLinkedSessionFromUri())
            StateHasChanged();
    }

    private bool SelectLinkedSessionFromUri()
    {
        var query = new Uri(Navigation.Uri).Query;
        if (!Guid.TryParse(GetQueryValue(query, "repository"), out var repositoryId))
            return false;

        var sessionId = GetQueryValue(query, "session");
        var repository = _activeRepositories.FirstOrDefault(candidate => candidate.Id == repositoryId &&
            AgentTools.Normalize(candidate.AgentTool) == AgentTools.OpenCode);
        if (repository is null || string.IsNullOrWhiteSpace(sessionId) ||
            !sessionId.StartsWith("ses_", StringComparison.Ordinal) ||
            !sessionId.All(character => char.IsAsciiLetterOrDigit(character) || character == '_'))
            return false;

        _selectedOpenCodeSessions[repository.Id] = sessionId;
        var tabIndex = DockedRepositories.FindIndex(candidate => candidate.Id == repository.Id);
        if (tabIndex >= 0)
        {
            _activeTabIndex = tabIndex;
            Preferences.Default.Set(LastRepositoryPreferenceKey, repository.Id.ToString());
        }
        return true;
    }

    private static string? GetQueryValue(string query, string key)
    {
        foreach (var pair in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var separator = pair.IndexOf('=');
            if (separator < 0 || !string.Equals(Uri.UnescapeDataString(pair[..separator]), key, StringComparison.Ordinal))
                continue;
            return Uri.UnescapeDataString(pair[(separator + 1)..].Replace('+', ' '));
        }
        return null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        try
        {
            _tabsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./repository-tabs.js");
            _selfReference = DotNetObjectReference.Create(this);
            await _tabsModule.InvokeVoidAsync("attach", _selfReference);
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Repository tab drag undocking could not be initialized.");
        }
    }

    [JSInvokable]
    public Task UndockRepository(string repositoryId, int pointerX, int pointerY)
    {
        return UndockRepositoryAsync(repositoryId, pointerX, pointerY);
    }

    [JSInvokable]
    public Task OpenRepositoryContextMenu(string repositoryId, double clientX, double clientY)
    {
        var repository = Guid.TryParse(repositoryId, out var id)
            ? DockedRepositories.FirstOrDefault(candidate => candidate.Id == id)
            : null;
        if (repository is null || !CanOpenRepositorySlackSessions(repository))
        {
            CloseRepositoryContextMenu();
            return InvokeAsync(StateHasChanged);
        }

        _contextMenuRepository = repository;
        _contextMenuX = Math.Max(8, clientX);
        _contextMenuY = Math.Max(8, clientY);
        return InvokeAsync(StateHasChanged);
    }

    private Task UndockRepositoryAsync(string repositoryId, int pointerX, int pointerY)
    {
        if (!Guid.TryParse(repositoryId, out var id) || DockedRepositories.FirstOrDefault(repository => repository.Id == id) is not { } repository)
            return Task.CompletedTask;
        DetachedWindows.Undock(repository, pointerX, pointerY);
        return Task.CompletedTask;
    }

    private void UndockRepository(RepositoryEntry repository)
    {
        var index = DockedRepositories.FindIndex(candidate => candidate.Id == repository.Id);
        if (index >= 0)
        {
            _activeTabIndex = index;
            Preferences.Default.Set(LastRepositoryPreferenceKey, repository.Id.ToString());
        }
        DetachedWindows.Undock(repository);
    }

    [JSInvokable]
    public bool DockAtCursor(string repositoryId) =>
        Guid.TryParse(repositoryId, out var id) && DetachedWindows.TryDockAtCursor(id);

    [JSInvokable]
    public Task DockRepository(string repositoryId)
    {
        if (Guid.TryParse(repositoryId, out var id))
            DetachedWindows.Dock(id);
        return Task.CompletedTask;
    }

    private void HandleSettingsSaved()
    {
        _ = InvokeAsync(async () =>
        {
            var dockedRepositories = DockedRepositories;
            var activeRepositoryId = _activeTabIndex >= 0 && _activeTabIndex < dockedRepositories.Count
                ? dockedRepositories[_activeTabIndex].Id
                : (Guid?)null;
            _settings = await SettingsService.LoadAsync();
            await SlackNotifications.ConfigureAsync(_settings);
            SyncRepositories();
            _runningSessions.Clear();
            _questionSessions.Clear();
            _activityNeedsBaseline = true;
            var selectedIndex = activeRepositoryId is { } repositoryId
                ? DockedRepositories.FindIndex(repository => repository.Id == repositoryId)
                : -1;
            _activeTabIndex = selectedIndex >= 0
                ? selectedIndex
                : Math.Clamp(_activeTabIndex, 0, Math.Max(0, DockedRepositories.Count - 1));
            await ReloadRepositoryStatusesAsync();
            StateHasChanged();
        });
    }

    private void HandleActiveTabChanged(int index)
    {
        _activeTabIndex = index;
        if (index < 0 || index >= DockedRepositories.Count)
            return;

        var repository = DockedRepositories[index];
        Preferences.Default.Set(LastRepositoryPreferenceKey, repository.Id.ToString());
        if (!_gitSnapshots.ContainsKey(repository))
            _ = LoadRepositoryStatusAsync(repository, _statusMonitorCancellation.Token);
    }

    private void HandleLanguageChanged() => _ = InvokeAsync(StateHasChanged);
    private void HandleDetachedWindowsChanged() => _ = InvokeAsync(() =>
    {
        _activeTabIndex = Math.Clamp(_activeTabIndex, 0, Math.Max(0, DockedRepositories.Count - 1));
        StateHasChanged();
    });

    private void HandleDockDragChanged(bool active) => _ = InvokeAsync(() =>
    {
        _isDockDragActive = active;
        StateHasChanged();
    });
    private void HandleDockRequested(Guid repositoryId) => _ = InvokeAsync(() =>
    {
        _activeTabIndex = Math.Max(0, DockedRepositories.FindIndex(repository => repository.Id == repositoryId));
        if (_activeTabIndex < DockedRepositories.Count)
            Preferences.Default.Set(LastRepositoryPreferenceKey, repositoryId.ToString());
        StateHasChanged();
    });
    private void HandleSandboxState(Guid id) => _ = InvokeAsync(StateHasChanged);

    private void CloseRepositoryContextMenu() => _contextMenuRepository = null;

    private bool CanOpenRepositorySlackSessions(RepositoryEntry repository) =>
        !repository.SlackNotificationsMuted && SlackNotifications.CanSendNotifications &&
        AgentTools.Normalize(repository.AgentTool) == AgentTools.OpenCode;

    private async Task OpenRepositorySlackSessionsAsync()
    {
        var repository = _contextMenuRepository;
        CloseRepositoryContextMenu();
        if (repository is null || !CanOpenRepositorySlackSessions(repository))
            return;

        var parameters = new DialogParameters<SlackSessionNotificationsDialog>
        {
            { dialog => dialog.RepositoryName, RepositoryTitle(repository) },
            { dialog => dialog.RepositoryPath, repository.Path },
            { dialog => dialog.RepositoryMuted, repository.SlackNotificationsMuted }
        };
        var dialog = await DialogService.ShowAsync<SlackSessionNotificationsDialog>(L.T("Session notifications"), parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium, CloseButton = true, CloseOnEscapeKey = true });
        await dialog.Result;
    }

    private void HandleSandboxApproval(SandboxApprovalRequest request)
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                var repository = _activeRepositories.FirstOrDefault(repository => repository.Id == request.RepositoryId &&
                    repository.OpenCodeSandboxEnabled && AgentTools.Normalize(repository.AgentTool) == AgentTools.OpenCode);
                if (repository is null || request.CancellationToken.IsCancellationRequested)
                {
                    request.Decide(false);
                    return;
                }
                var dialog = await DialogService.ShowAsync<SandboxNetworkApprovalDialog>(L.T("Allow sandbox network access?"),
                    new DialogParameters<SandboxNetworkApprovalDialog>
                    {
                        { component => component.Request, request },
                        { component => component.RepositoryName, RepositoryTitle(repository) }
                    }, new DialogOptions { CloseButton = true, CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true });
                await dialog.Result;
            }
            catch { request.Decide(false); }
            finally { request.Decide(false); }
        });
    }

    private async Task ReviewSandboxChangesAsync(RepositoryEntry repository)
    {
        if (SandboxSessions.IsRunning(repository.Id))
        {
            if (await DialogService.ShowMessageBoxAsync(L.T("Stop sandbox and review changes"),
                L.T("Stop sandbox and review changes"), yesText: L.T("Stop"), cancelText: L.T("Cancel")) != true)
                return;
            try { await SandboxSessions.StopAsync(repository.Id); }
            catch { Snackbar.Add(L.T("Could not load sandbox permissions."), Severity.Error); return; }
        }
        var parameters = new DialogParameters<SandboxChangesDialog>
        {
            { dialog => dialog.RepositoryName, RepositoryTitle(repository) },
            { dialog => dialog.RepositoryPath, repository.Path },
            { dialog => dialog.Changes, SandboxSessions.GetChanges(repository.Id, repository.Path) }
        };
        var dialog = await DialogService.ShowAsync<SandboxChangesDialog>(L.T("Review sandbox changes"), parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Large, CloseButton = true });
        await dialog.Result;
        await RefreshBranches();
    }

    private void SyncRepositories()
    {
        foreach (var repository in _settings.Repositories)
        {
            if (repository.Id == Guid.Empty)
                repository.Id = Guid.NewGuid();
            repository.AgentTool = AgentTools.Normalize(repository.AgentTool);
        }
        _activeRepositories = _settings.Repositories.Where(repository => repository.IsActive).ToList();
        _activeTabIndex = Math.Clamp(_activeTabIndex, 0, Math.Max(0, DockedRepositories.Count - 1));
        foreach (var repository in _branches.Keys.Where(repository => !_settings.Repositories.Contains(repository)).ToList())
            _branches.Remove(repository);
        foreach (var repository in _gitSnapshots.Keys.Where(repository => !_settings.Repositories.Contains(repository)).ToList())
            _gitSnapshots.Remove(repository);
        var validRepositoryIds = _activeRepositories.Select(repository => repository.Id).ToHashSet();
        _repositoriesLoading.RemoveWhere(repositoryId => !validRepositoryIds.Contains(repositoryId));
    }

    private static string RepositoryTitle(RepositoryEntry repository) => string.IsNullOrWhiteSpace(repository.Name)
        ? Path.GetFileName(Path.TrimEndingDirectorySeparator(repository.Path))
        : repository.Name;

    private static string AgentLogo(RepositoryEntry repository) => AgentTools.Normalize(repository.AgentTool) switch
    {
        AgentTools.ClaudeCode => "claude-code.svg",
        AgentTools.Codex => "codex.svg",
        AgentTools.Hermes => "hermes.svg",
        _ => "opencode.svg"
    };

    private static string AgentSpinnerClass(RepositoryEntry repository) => AgentTools.Normalize(repository.AgentTool) switch
    {
        AgentTools.ClaudeCode => "repository-activity-spinner-claude",
        AgentTools.Codex => "repository-activity-spinner-codex",
        AgentTools.Hermes => "repository-activity-spinner-hermes",
        _ => "repository-activity-spinner-opencode"
    };

    private async Task LoadRemainingRepositoryStatusesAsync(Guid? excludedRepositoryId, Task? initialLoad, CancellationToken cancellationToken)
    {
        if (initialLoad is not null)
            await initialLoad;

        foreach (var repository in _activeRepositories.Where(repository => repository.Id != excludedRepositoryId))
        {
            if (cancellationToken.IsCancellationRequested)
                return;
            await LoadRepositoryStatusAsync(repository, cancellationToken);
        }
    }

    private async Task LoadRepositoryStatusAsync(RepositoryEntry repository, CancellationToken cancellationToken = default)
    {
        if (!_repositoriesLoading.Add(repository.Id))
            return;

        await InvokeAsync(StateHasChanged);
        try
        {
            var result = await Task.Run(async () =>
                (Snapshot: await GitBranchService.GetRepositorySnapshotAsync(repository.Path),
                 Branch: await GitBranchService.GetCurrentBranchAsync(repository.Path)), cancellationToken);
            await InvokeAsync(() =>
            {
                _branches[repository] = result.Branch;
                _gitSnapshots[repository] = result.Snapshot;
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Unable to load Git status for repository {RepositoryPath}.", repository.Path);
            await InvokeAsync(() =>
            {
                _branches[repository] = new GitBranchInfo(null, L.T("Git status unavailable."));
                _gitSnapshots[repository] = GitRepositorySnapshot.Invalid(L.T("Git status unavailable."));
                StateHasChanged();
            });
        }
        finally
        {
            _repositoriesLoading.Remove(repository.Id);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenGitDialogAsync(RepositoryEntry repository)
    {
        var parameters = new DialogParameters<GitRepositoryDialog>
        {
            { dialog => dialog.RepositoryName, repository.Name },
            { dialog => dialog.RepositoryPath, repository.Path },
            { dialog => dialog.AiSettings, _settings },
            { dialog => dialog.RepositorySettings, _settings.Repositories.FirstOrDefault(entry => entry.Id == repository.Id) }
        };
        var options = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.False, CloseButton = true, NoHeader = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<GitRepositoryDialog>(L.T("Git overview"), parameters, options);
        await dialog.Result;
        await RefreshBranches();
    }

    private async Task RefreshAllAsync()
    {
        if (_isRefreshingBranches)
            return;

        _isRefreshingBranches = true;
        try
        {
            var fetchResults = await Task.WhenAll(_activeRepositories
                .Where(repository => !string.IsNullOrWhiteSpace(repository.Path) && Directory.Exists(repository.Path))
                .Select(repository => GitBranchService.FetchAsync(repository.Path)));
            var failures = fetchResults.Count(result => !result.Success);
            if (failures > 0)
                Snackbar.Add(L.T("Fetch failed for {0} repositories.", failures), Severity.Warning);

            await RefreshBranches(force: true);
        }
        finally
        {
            _isRefreshingBranches = false;
        }
    }

    private async Task RefreshRepositoryAsync(RepositoryEntry repository)
    {
        _isRefreshingBranches = true;
        try
        {
            if (Directory.Exists(repository.Path))
            {
                var fetch = await GitBranchService.FetchAsync(repository.Path);
                if (!fetch.Success)
                    Snackbar.Add(L.T("Git fetch failed: {0}", fetch.Message), Severity.Warning);
            }
            await RefreshBranches(force: true);
        }
        finally
        {
            _isRefreshingBranches = false;
        }
    }

    private async Task MonitorActiveRepositoryStatusAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                try
                {
                    var dockedRepositories = DockedRepositories;
                    if (_isRefreshingBranches || _activeTabIndex < 0 || _activeTabIndex >= dockedRepositories.Count)
                        continue;

                    var repository = dockedRepositories[_activeTabIndex];
                    if (!Directory.Exists(repository.Path))
                        continue;

                    var status = await GitBranchService.GetRepositoryStatusAsync(repository.Path);
                    if (!status.IsValid)
                        continue;

                    await InvokeAsync(() =>
                    {
                        if (_isRefreshingBranches || !_gitSnapshots.TryGetValue(repository, out var snapshot) || !snapshot.IsValid)
                            return;

                        _branches[repository] = status.Branch;
                        _gitSnapshots[repository] = snapshot with
                        {
                            Branch = status.Branch.Branch ?? snapshot.Branch,
                            ChangedFiles = status.ChangedFiles,
                            StagedFiles = status.StagedFiles,
                            UnstagedFiles = status.UnstagedFiles,
                            Ahead = status.Ahead,
                            Behind = status.Behind
                        };
                        StateHasChanged();
                    });
                }
                catch (Exception exception) when (!cancellationToken.IsCancellationRequested)
                {
                    Logger.LogWarning(exception, "Unable to refresh Git status; the next check will retry.");
                }
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (ObjectDisposedException) { }
    }

    private async Task MonitorOpenCodeActivityAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            do
            {
                var supported = _activeRepositories.Any(repository => AgentTools.Normalize(repository.AgentTool) == AgentTools.OpenCode);
                var monitoredDirectories = _activeRepositories
                    .Where(repository => AgentTools.Normalize(repository.AgentTool) == AgentTools.OpenCode)
                    .Select(repository => OpenCodeActivityService.NormalizePath(repository.Path))
                    .Where(path => path is not null).Cast<string>().Distinct(StringComparer.OrdinalIgnoreCase).ToArray();
                var activity = supported ? await OpenCodeActivity.GetActivityAsync(cancellationToken, monitoredDirectories) : null;
                await InvokeAsync(async () =>
                {
                    if (activity is null)
                    {
                        if (_runningSessions.Count > 0 || _questionSessions.Count > 0)
                        {
                            _runningSessions.Clear();
                            _questionSessions.Clear();
                            StateHasChanged();
                        }
                        return;
                    }
                    var running = _activeRepositories
                        .Where(repository => AgentTools.Normalize(repository.AgentTool) == AgentTools.OpenCode)
                        .Where(repository => !string.IsNullOrWhiteSpace(repository.Path) &&
                            OpenCodeActivityService.NormalizePath(repository.Path) is { } path && activity.ActiveDirectories.Contains(path))
                        .Select(repository => repository.Id).ToHashSet();
                    var questions = _activeRepositories
                        .Where(repository => AgentTools.Normalize(repository.AgentTool) == AgentTools.OpenCode)
                        .Where(repository => !string.IsNullOrWhiteSpace(repository.Path) &&
                            OpenCodeActivityService.NormalizePath(repository.Path) is { } path && activity.QuestionDirectories.Contains(path))
                        .Select(repository => repository.Id).ToHashSet();
                    var activeOpenCodeSessions = activity.Sessions.Values
                        .Where(session => _activeRepositories.Any(repository =>
                            AgentTools.Normalize(repository.AgentTool) == AgentTools.OpenCode &&
                            !string.IsNullOrWhiteSpace(repository.Path) &&
                            OpenCodeActivityService.NormalizePath(repository.Path) is { } path &&
                            string.Equals(path, session.Directory, StringComparison.OrdinalIgnoreCase)))
                        .ToDictionary(session => session.Id, StringComparer.Ordinal);
                    var completedSessions = _runningOpenCodeSessions
                        .Where(pair => !activeOpenCodeSessions.ContainsKey(pair.Key) &&
                            (!_activityNeedsBaseline || _slackStartedSessions.Contains(pair.Key)))
                        .Select(pair => pair.Value).ToArray();
                    var asked = !_activityNeedsBaseline && questions.Except(_questionSessions).Any();
                    _activityNeedsBaseline = false;
                    foreach (var pair in activeOpenCodeSessions)
                    {
                        _runningOpenCodeSessions[pair.Key] = pair.Value;
                        _pendingSlackCompletions.Remove(pair.Key);
                        _slackStartedSessions.Remove(pair.Key);
                    }
                    foreach (var session in completedSessions)
                        _pendingSlackCompletions.TryAdd(session.Id, DateTime.UtcNow);
                    var changed = !_runningSessions.SetEquals(running) || !_questionSessions.SetEquals(questions);
                    _runningSessions.Clear();
                    _runningSessions.UnionWith(running);
                    _questionSessions.Clear();
                    _questionSessions.UnionWith(questions);
                    if (changed)
                        StateHasChanged();
                    if (_settings.SlackNotificationsEnabled && SlackNotifications.CanSendNotifications)
                    {
                        foreach (var pair in activeOpenCodeSessions)
                        {
                            if (_lastSlackMessageSync.TryGetValue(pair.Key, out var lastSync) &&
                                DateTime.UtcNow - lastSync < TimeSpan.FromSeconds(9))
                                continue;
                            _lastSlackMessageSync[pair.Key] = DateTime.UtcNow;
                            try
                            {
                                var repository = _activeRepositories.FirstOrDefault(candidate =>
                                    AgentTools.Normalize(candidate.AgentTool) == AgentTools.OpenCode &&
                                    string.Equals(OpenCodeActivityService.NormalizePath(candidate.Path), pair.Value.Directory,
                                        StringComparison.OrdinalIgnoreCase));
                                if (repository?.SlackNotificationsMuted == true || SlackNotifications.IsSessionMuted(pair.Key))
                                    continue;
                                var initialMessage = await OpenCodeActivity.GetInitialUserMessageAsync(pair.Key, pair.Value.Directory, cancellationToken);
                                var messages = await OpenCodeActivity.GetRecentUserMessagesAsync(pair.Key, pair.Value.Directory, cancellationToken);
                                    await SlackNotifications.PublishApplicationMessagesAsync(pair.Value, initialMessage, messages, cancellationToken);
                            }
                            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
                            catch (Exception exception)
                            {
                                Logger.LogWarning(exception, "Could not synchronize user messages for OpenCode session {SessionId} to Slack.", pair.Key);
                            }
                        }
                        try
                        {
                            await SlackNotifications.UpdatePendingInteractionsAsync(activeOpenCodeSessions,
                                activity.PendingInteractions, cancellationToken);
                        }
                        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
                        catch (Exception exception)
                        {
                            Logger.LogWarning(exception, "Could not publish pending OpenCode questions to Slack.");
                        }
                    }
                    if (completedSessions.Length > 0 && _settings.CompletionSoundEnabled)
                    {
                        try { await JS.InvokeVoidAsync("codeBadgerSounds.play", CompletionSounds.Normalize(_settings.CompletionSound)); }
                        catch (JSException) { }
                    }
                    if (asked && _settings.QuestionSoundEnabled)
                    {
                        try { await JS.InvokeVoidAsync("codeBadgerSounds.play", CompletionSounds.Normalize(_settings.QuestionSound)); }
                        catch (JSException) { }
                    }
                    if (_settings.SlackNotificationsEnabled && SlackNotifications.CanSendNotifications)
                    {
                        foreach (var session in _runningOpenCodeSessions.Values
                                     .Where(session => _pendingSlackCompletions.ContainsKey(session.Id)).ToArray())
                        {
                            try
                            {
                                var repository = _activeRepositories.FirstOrDefault(candidate =>
                                    AgentTools.Normalize(candidate.AgentTool) == AgentTools.OpenCode &&
                                    string.Equals(OpenCodeActivityService.NormalizePath(candidate.Path), session.Directory,
                                        StringComparison.OrdinalIgnoreCase));
                                if (repository?.SlackNotificationsMuted == true || SlackNotifications.IsSessionMuted(session.Id))
                                {
                                    _pendingSlackCompletions.Remove(session.Id);
                                    _runningOpenCodeSessions.Remove(session.Id);
                                    continue;
                                }
                                if (repository is null)
                                    continue;
                                if (await OpenCodeActivity.HasPendingInteractionAsync(session.Id, session.Directory, cancellationToken))
                                    continue;
                                var answer = await OpenCodeActivity.GetLatestCompletedAnswerAsync(session.Id, session.Directory, cancellationToken);
                                if (string.IsNullOrWhiteSpace(answer))
                                {
                                    if (DateTime.UtcNow - _pendingSlackCompletions[session.Id] < TimeSpan.FromMinutes(2))
                                        continue;
                                    answer = L.T("OpenCode session completed, but no response text was available.");
                                }
                                if (!string.IsNullOrWhiteSpace(answer))
                                {
                                    var initialMessage = await OpenCodeActivity.GetInitialUserMessageAsync(session.Id, session.Directory, cancellationToken);
                                    var userMessages = await OpenCodeActivity.GetRecentUserMessagesAsync(session.Id, session.Directory, cancellationToken);
                                    await SlackNotifications.PublishApplicationMessagesAsync(session, initialMessage, userMessages, cancellationToken);
                                    await SlackNotifications.PublishCompletionAsync(session, answer, cancellationToken);
                                    _pendingSlackCompletions.Remove(session.Id);
                                    _runningOpenCodeSessions.Remove(session.Id);
                                    _slackStartedSessions.Remove(session.Id);
                                    _lastSlackMessageSync.Remove(session.Id);
                                }
                            }
                            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
                            catch (Exception exception)
                            {
                                Logger.LogWarning(exception, "Could not publish the completed OpenCode session {SessionId} to Slack.", session.Id);
                            }
                        }
                    }
                    else
                    {
                        // Keep completed sessions queued until Slack reconnects, so a transient
                        // connection interruption does not silently drop their completion reply.
                    }
                });
            } while (await timer.WaitForNextTickAsync(cancellationToken));
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (ObjectDisposedException) { }
    }

    private void HandleSlackReplyReceived(OpenCodeActivityService.ActiveSession session, string text) => _ = Task.Run(async () =>
    {
        try
        {
            var command = System.Text.RegularExpressions.Regex.Match(text, "^!(build|plan)(?:\\s+(.*))?$",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.Singleline);
            var prompt = text;
            if (command.Success)
            {
                var agent = command.Groups[1].Value.ToLowerInvariant();
                prompt = command.Groups[2].Value.Trim();
                if (string.IsNullOrWhiteSpace(prompt))
                    throw new InvalidOperationException("Add a message after !build or !plan.");
                await OpenCodeActivity.SwitchAgentAsync(session.Id, session.Directory, agent, _statusMonitorCancellation.Token);
                await SlackNotifications.UpdateSessionAgentAsync(session.Id, agent);
            }
            await OpenCodeActivity.SendPromptAsync(session.Id, session.Directory, prompt, _statusMonitorCancellation.Token,
                command.Success ? command.Groups[1].Value.ToLowerInvariant() : null);
            SlackNotifications.RememberSlackSubmittedMessage(session.Id, prompt);
            await SlackNotifications.PublishReplyStatusAsync(session.Id,
                "✅ OpenCode heeft je opdracht ontvangen en is gestart.", _statusMonitorCancellation.Token);
        }
        catch (Exception exception) when (!_statusMonitorCancellation.IsCancellationRequested)
        {
            Logger.LogWarning(exception, "Could not route a Slack reply to OpenCode session {SessionId}.", session.Id);
            try
            {
                await SlackNotifications.PublishReplyStatusAsync(session.Id,
                    "⚠️ Could not send this reply to the linked OpenCode session: " + exception.Message,
                    _statusMonitorCancellation.Token);
            }
            catch (Exception statusException)
            {
                Logger.LogWarning(statusException, "Could not report Slack reply routing failure for session {SessionId}.", session.Id);
            }
        }
    });

    private void HandleSlackSessionNotificationsChanged() => _ = InvokeAsync(StateHasChanged);

    private void HandleSlackSessionLinked(OpenCodeActivityService.ActiveSession session) =>
        _slackStartedSessions.Add(session.Id);

    private void HandleSlackSessionStarted(OpenCodeActivityService.ActiveSession session) => _ = InvokeAsync(() =>
    {
        var repository = _activeRepositories.FirstOrDefault(candidate =>
            AgentTools.Normalize(candidate.AgentTool) == AgentTools.OpenCode &&
            OpenCodeActivityService.NormalizePath(candidate.Path) is { } repositoryPath &&
            string.Equals(repositoryPath, session.Directory, StringComparison.OrdinalIgnoreCase));
        if (repository is not null)
        {
            var index = DockedRepositories.FindIndex(candidate => candidate.Id == repository.Id);
            if (index >= 0)
            {
                _selectedOpenCodeSessions[repository.Id] = session.Id;
                _activeTabIndex = index;
                Preferences.Default.Set(LastRepositoryPreferenceKey, repository.Id.ToString());
            }
        }
        _runningOpenCodeSessions[session.Id] = session;
        _slackStartedSessions.Add(session.Id);
        _pendingSlackCompletions.Remove(session.Id);
        StateHasChanged();
    });

    private string? SelectedOpenCodeSession(RepositoryEntry repository) =>
        _selectedOpenCodeSessions.TryGetValue(repository.Id, out var sessionId) ? sessionId : null;

    protected override void OnInitialized() => SessionShares.ShareChanged += HandleShareChanged;

    private void HandleShareChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task ShareSessionAsync(RepositoryEntry repository)
    {
        if (_isSharing)
            return;
        if (SessionShares.CurrentShare is { } activeShare && activeShare.RepositoryId == repository.Id)
        {
            var copyExisting = await DialogService.ShowMessageBoxAsync(L.T("Read-only session link"),
                L.T("The session is already being shared. Anyone with this link can read its transcript:\n\n{0}", activeShare.Url),
                yesText: L.T("Copy link"), cancelText: L.T("Close"),
                options: new DialogOptions { CloseOnEscapeKey = true });
            if (copyExisting == true)
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", activeShare.Url);
                Snackbar.Add(L.T("Share link copied."), Severity.Success);
            }
            return;
        }
        var selection = await DialogService.ShowAsync<SessionShareDialog>(L.T("Share a session"),
            new DialogParameters<SessionShareDialog>
            {
                { dialog => dialog.RepositoryPath, repository.Path },
                { dialog => dialog.RepositoryId, repository.Id }
            },
            new DialogOptions { CloseButton = true, CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true });
        var selectedSession = await selection.Result;
        if (selectedSession is not { Canceled: false, Data: string sessionId } || string.IsNullOrWhiteSpace(sessionId))
            return;

        if (!await SessionShares.IsInstalledAndRunnableAsync(_statusMonitorCancellation.Token))
        {
            var install = await DialogService.ShowMessageBoxAsync(L.T("Install cloudflared"),
                L.T("Sharing creates a temporary internet link through Cloudflare. CodeBadger will download cloudflared from Cloudflare's official GitHub release and verify its digital signature. Anyone with the link can read this session transcript, but cannot access the repository or send commands. Continue?"),
                yesText: L.T("Download and continue"), cancelText: L.T("Cancel"),
                options: new DialogOptions { CloseOnEscapeKey = true });
            if (install != true)
                return;
            try
            {
                _isSharing = true;
                StateHasChanged();
                await SessionShares.InstallCloudflaredAsync(_statusMonitorCancellation.Token);
                Snackbar.Add(L.T("cloudflared installed and verified."), Severity.Success);
            }
            catch (Exception exception)
            {
                Snackbar.Add(L.T("Could not install cloudflared: {0}", exception.Message), Severity.Error);
                return;
            }
            finally
            {
                _isSharing = false;
            }
        }

        var activeSession = _runningOpenCodeSessions.GetValueOrDefault(sessionId);
        var title = string.IsNullOrWhiteSpace(activeSession?.Title) ? RepositoryTitle(repository) : activeSession.Title;
        try
        {
            _isSharing = true;
            var share = await SessionShares.StartAsync(repository.Id, sessionId, repository.Path, title,
                token => OpenCodeActivity.GetShareableSessionMessagesAsync(sessionId, repository.Path, token),
                _statusMonitorCancellation.Token);
            _selectedOpenCodeSessions[repository.Id] = sessionId;
            var result = await DialogService.ShowMessageBoxAsync(L.T("Read-only session link"),
                L.T("Anyone with this link can read the selected session. It does not grant access to the repository or allow sending prompts. The link stops working when you stop sharing or close CodeBadger.\n\n{0}", share.Url),
                yesText: L.T("Copy link"), cancelText: L.T("Close"),
                options: new DialogOptions { CloseOnEscapeKey = true });
            if (result == true)
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", share.Url);
                Snackbar.Add(L.T("Share link copied."), Severity.Success);
            }
        }
        catch (Exception exception)
        {
            Snackbar.Add(L.T("Could not start session sharing: {0}", exception.Message), Severity.Error);
        }
        finally
        {
            _isSharing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StopSharingAsync()
    {
        await SessionShares.StopAsync();
        Snackbar.Add(L.T("Session sharing stopped. The link has been revoked."), Severity.Success);
        await InvokeAsync(StateHasChanged);
    }

    private string BranchLabel(RepositoryEntry repository)
    {
        if (_repositoriesLoading.Contains(repository.Id))
            return L.T("Branch: loading...");

        if (!_branches.TryGetValue(repository, out var branchInfo))
            return L.T("Branch: not loaded yet");

        return branchInfo.Branch is not null
            ? L.T("Branch: {0}", branchInfo.Branch ?? string.Empty)
            : L.T("Branch: {0}", branchInfo.Status ?? string.Empty);
    }

    public async ValueTask DisposeAsync()
    {
        SandboxApprovals.Requested -= HandleSandboxApproval;
        SessionShares.ShareChanged -= HandleShareChanged;
        SandboxSessions.StateChanged -= HandleSandboxState;
        DetachedWindows.StateChanged -= HandleDetachedWindowsChanged;
        DetachedWindows.DockRequested -= HandleDockRequested;
        DetachedWindows.DockDragChanged -= HandleDockDragChanged;
        _statusMonitorCancellation.Cancel();
        _statusMonitorCancellation.Dispose();
        SettingsService.SettingsSaved -= HandleSettingsSaved;
        SlackNotifications.ReplyReceived -= HandleSlackReplyReceived;
        SlackNotifications.SessionStarted -= HandleSlackSessionStarted;
        SlackNotifications.SessionLinked -= HandleSlackSessionLinked;
        SlackNotifications.SessionNotificationsChanged -= HandleSlackSessionNotificationsChanged;
        L.LanguageChanged -= HandleLanguageChanged;
        _selfReference?.Dispose();
        if (_tabsModule is not null)
        {
            try { await _tabsModule.InvokeVoidAsync("detach"); await _tabsModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }

    private async Task ReloadRepositoryStatusesAsync()
    {
        _branches.Clear();
        _gitSnapshots.Clear();
        var selectedRepository = DockedRepositories.ElementAtOrDefault(_activeTabIndex);
        var selectedLoad = selectedRepository is null
            ? null
            : LoadRepositoryStatusAsync(selectedRepository, _statusMonitorCancellation.Token);
        var remainingLoad = LoadRemainingRepositoryStatusesAsync(selectedRepository?.Id, selectedLoad, _statusMonitorCancellation.Token);
        if (selectedLoad is not null)
            await selectedLoad;
        await remainingLoad;
    }

    private async Task RefreshBranches(bool force = false)
    {
        if (_isRefreshingBranches && !force)
            return;

        _isRefreshingBranches = true;
        try
        {
            await ReloadRepositoryStatusesAsync();
        }
        finally
        {
            _isRefreshingBranches = false;
        }
    }
}
