    private RenderFragment BranchButton(GitBranchEntry branch, bool remote) => @<MudButton @key="branch.Name" FullWidth="true"
        Class="@(branch.IsCurrent ? "git-branch-current" : string.Empty)"
        data-branch-name="@(!remote && branch.IsCurrent ? branch.Name : null)"
        Variant="@(branch.IsCurrent ? Variant.Filled : Variant.Text)"
        Color="@(branch.IsCurrent ? Color.Primary : Color.Default)" Size="Size.Small"
        StartIcon="@(remote ? Icons.Material.Filled.Cloud : Icons.Material.Filled.CallSplit)"
        EndIcon="@(branch.IsCurrent ? Icons.Material.Filled.CheckCircle : null)"
