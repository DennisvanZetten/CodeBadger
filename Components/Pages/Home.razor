@page "/"
@inject LauncherSettingsService SettingsService
@inject LocalizationService L
@inject GitBranchService GitBranchService
@inject OpenCodeActivityService OpenCodeActivity
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Repo Launcher</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-5 repository-home">
    @if (_activeRepositories.Count == 0)
    {
        <MudPaper Class="pa-6" Outlined="true" Elevation="0">
            <MudStack Spacing="2" AlignItems="AlignItems.Center">
                <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.h6">@L.T("No active repositories yet")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L.T("Open Settings in the top-right corner to add or activate repositories.")</MudText>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <MudTabs @bind-ActivePanelIndex="_activeTabIndex" KeepPanelsAlive="true" Rounded="true" Border="true" ApplyEffectsToContainer="true" Class="repository-tabs">
            @foreach (var repository in _activeRepositories)
            {
                <MudTabPanel @key="repository.Id">
                    <TabContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <img class="repository-agent-logo" src="@AgentLogo(repository)" alt="@AgentTools.Normalize(repository.AgentTool)"
                                 title="@AgentTools.Normalize(repository.AgentTool)" />
                            <MudText>@RepositoryTitle(repository)</MudText>
                            @if (_runningSessions.Contains(repository.Id))
                            {
                                <span class="repository-activity-spinner" role="status" aria-label="@L.T("OpenCode session is working")" title="@L.T("OpenCode session is working")"></span>
                            }
                        </MudStack>
                    </TabContent>
                    <ChildContent>
                    <div class="repository-workspace">
                        @if (!Directory.Exists(repository.Path))
                        {
                            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@L.T("Repository path does not exist: {0}. Update it in Settings.", repository.Path)</MudAlert>
                        }
                        else
                        {
                            <MudPaper Outlined="true" Elevation="0" Class="repository-terminal-panel">
                                <RepositoryTerminal @key="TerminalKey(repository)" SessionId="repository.Id" RepositoryPath="@repository.Path"
                                                    Command="@AgentTools.GetCommand(repository.AgentTool)" IsVisible="@(_activeRepositories.IndexOf(repository) == _activeTabIndex)" />
                            </MudPaper>
                            <MudPaper Outlined="true" Elevation="0" Class="pa-4 repository-git-panel">
                                <MudStack Spacing="2">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="flex-wrap">
                                             <MudText Typo="Typo.subtitle1">@L.T("Git")</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@BranchLabel(repository)</MudText>
                                            @if (_gitSnapshots.TryGetValue(repository, out var snapshot) && snapshot.IsValid)
                                            {
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@snapshot.ChangedFiles @L.T("changed")</MudChip>
                                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">↑ @snapshot.Ahead</MudChip>
                                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">↓ @snapshot.Behind</MudChip>
                                            }
                                        </MudStack>
                                        <MudStack Row="true" Spacing="1">
                                            <MudIconButton Icon="@Icons.Material.Filled.Refresh" aria-label="@L.T("Refresh Git status")" Disabled="@_isRefreshingBranches" OnClick="@(() => RefreshRepositoryAsync(repository))" />
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AccountTree"
                                                       Disabled="@(!_gitSnapshots.TryGetValue(repository, out var gitSnapshot) || !gitSnapshot.IsValid)"
                                                        OnClick="@(() => OpenGitDialogAsync(repository))">@L.T("Git overview")</MudButton>
                                        </MudStack>
                                    </MudStack>
                                    @if (_gitSnapshots.TryGetValue(repository, out var status) && !status.IsValid)
                                    {
                                        <MudAlert Dense="true" Severity="Severity.Warning" Variant="Variant.Outlined">@status.Error — controleer of Git is geïnstalleerd en het pad een repository is.</MudAlert>
                                    }
                                </MudStack>
                            </MudPaper>
                        }
                    </div>
                    </ChildContent>
                </MudTabPanel>
            }
        </MudTabs>
    }
</MudContainer>

@code {
    private LauncherSettings _settings = new();
    private List<RepositoryEntry> _activeRepositories = [];
    private readonly Dictionary<RepositoryEntry, GitBranchInfo> _branches = [];
    private readonly Dictionary<RepositoryEntry, GitRepositorySnapshot> _gitSnapshots = [];
    private readonly HashSet<Guid> _runningSessions = [];
    private bool _activityNeedsBaseline = true;
    private bool _isRefreshingBranches;
    private int _activeTabIndex;
    private readonly CancellationTokenSource _statusMonitorCancellation = new();

    protected override async Task OnInitializedAsync()
    {
        _settings = await SettingsService.LoadAsync();
        SettingsService.SettingsSaved += HandleSettingsSaved;
        L.LanguageChanged += HandleLanguageChanged;
        SyncRepositories();
        await RefreshBranches();
        _ = MonitorActiveRepositoryStatusAsync(_statusMonitorCancellation.Token);
        _ = MonitorOpenCodeActivityAsync(_statusMonitorCancellation.Token);
    }

    private void HandleSettingsSaved()
    {
        _ = InvokeAsync(async () =>
        {
            var oldTab = _activeTabIndex;
            _settings = await SettingsService.LoadAsync();
            SyncRepositories();
            _runningSessions.Clear();
            _activityNeedsBaseline = true;
            _activeTabIndex = Math.Clamp(oldTab, 0, Math.Max(0, _activeRepositories.Count - 1));
            await RefreshBranches();
            StateHasChanged();
        });
    }

    private void HandleLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    private void SyncRepositories()
    {
        foreach (var repository in _settings.Repositories)
        {
            if (repository.Id == Guid.Empty)
                repository.Id = Guid.NewGuid();
            repository.AgentTool = AgentTools.Normalize(repository.AgentTool);
        }
        _activeRepositories = _settings.Repositories.Where(repository => repository.IsActive).ToList();
        _activeTabIndex = Math.Clamp(_activeTabIndex, 0, Math.Max(0, _activeRepositories.Count - 1));
        foreach (var repository in _branches.Keys.Where(repository => !_settings.Repositories.Contains(repository)).ToList())
            _branches.Remove(repository);
        foreach (var repository in _gitSnapshots.Keys.Where(repository => !_settings.Repositories.Contains(repository)).ToList())
            _gitSnapshots.Remove(repository);
    }

    private static string RepositoryTitle(RepositoryEntry repository) => string.IsNullOrWhiteSpace(repository.Name)
        ? Path.GetFileName(Path.TrimEndingDirectorySeparator(repository.Path))
        : repository.Name;

    private static string AgentLogo(RepositoryEntry repository) => AgentTools.Normalize(repository.AgentTool) == AgentTools.ClaudeCode
        ? "claude-code.svg"
        : "opencode.svg";

    private static string TerminalKey(RepositoryEntry repository) => $"{repository.Id}:{AgentTools.Normalize(repository.AgentTool)}";

    private async Task RefreshBranches(bool force = false)
    {
        if (_isRefreshingBranches && !force)
            return;

        _isRefreshingBranches = true;
        try
        {
            var results = await Task.WhenAll(_activeRepositories.Select(async repository =>
                (Repository: repository,
                 Snapshot: await GitBranchService.GetRepositorySnapshotAsync(repository.Path),
                 Branch: await GitBranchService.GetCurrentBranchAsync(repository.Path))));

            _branches.Clear();
            _gitSnapshots.Clear();
            foreach (var result in results)
            {
                _branches[result.Repository] = result.Branch;
                _gitSnapshots[result.Repository] = result.Snapshot;
            }
        }
        finally
        {
            _isRefreshingBranches = false;
        }
    }

    private async Task OpenGitDialogAsync(RepositoryEntry repository)
    {
        var parameters = new DialogParameters<GitRepositoryDialog>
        {
            { dialog => dialog.RepositoryName, repository.Name },
            { dialog => dialog.RepositoryPath, repository.Path },
            { dialog => dialog.AiSettings, _settings }
        };
        var options = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.ExtraExtraLarge, CloseButton = true, NoHeader = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<GitRepositoryDialog>(L.T("Git overview"), parameters, options);
        await dialog.Result;
        await RefreshBranches();
    }

    private async Task RefreshAllAsync()
    {
        if (_isRefreshingBranches)
            return;

        _isRefreshingBranches = true;
        try
        {
            var fetchResults = await Task.WhenAll(_activeRepositories
                .Where(repository => !string.IsNullOrWhiteSpace(repository.Path) && Directory.Exists(repository.Path))
                .Select(repository => GitBranchService.FetchAsync(repository.Path)));
            var failures = fetchResults.Count(result => !result.Success);
            if (failures > 0)
                Snackbar.Add(L.T("Fetch failed for {0} repositories.", failures), Severity.Warning);

            await RefreshBranches(force: true);
        }
        finally
        {
            _isRefreshingBranches = false;
        }
    }

    private async Task RefreshRepositoryAsync(RepositoryEntry repository)
    {
        _isRefreshingBranches = true;
        try
        {
            if (Directory.Exists(repository.Path))
            {
                var fetch = await GitBranchService.FetchAsync(repository.Path);
                if (!fetch.Success)
                    Snackbar.Add(L.T("Git fetch failed: {0}", fetch.Message), Severity.Warning);
            }
            await RefreshBranches(force: true);
        }
        finally
        {
            _isRefreshingBranches = false;
        }
    }

    private async Task MonitorActiveRepositoryStatusAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (_isRefreshingBranches || _activeTabIndex < 0 || _activeTabIndex >= _activeRepositories.Count)
                    continue;

                var repository = _activeRepositories[_activeTabIndex];
                if (!Directory.Exists(repository.Path))
                    continue;

                var status = await GitBranchService.GetRepositoryStatusAsync(repository.Path);
                if (!status.IsValid || !_gitSnapshots.TryGetValue(repository, out var snapshot) || !snapshot.IsValid)
                    continue;

                await InvokeAsync(() =>
                {
                    _branches[repository] = status.Branch;
                    _gitSnapshots[repository] = snapshot with
                    {
                        Branch = status.Branch.Branch ?? snapshot.Branch,
                        ChangedFiles = status.ChangedFiles,
                        StagedFiles = status.StagedFiles,
                        UnstagedFiles = status.UnstagedFiles,
                        Ahead = status.Ahead,
                        Behind = status.Behind
                    };
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (ObjectDisposedException) { }
    }

    private async Task MonitorOpenCodeActivityAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            do
            {
                var supported = _activeRepositories.Any(repository => AgentTools.Normalize(repository.AgentTool) == AgentTools.OpenCode);
                var directories = supported ? await OpenCodeActivity.GetActiveDirectoriesAsync(cancellationToken) : null;
                await InvokeAsync(async () =>
                {
                    if (directories is null)
                    {
                        _activityNeedsBaseline = true;
                        if (_runningSessions.Count > 0)
                        {
                            _runningSessions.Clear();
                            StateHasChanged();
                        }
                        return;
                    }
                    var running = _activeRepositories
                        .Where(repository => AgentTools.Normalize(repository.AgentTool) == AgentTools.OpenCode)
                        .Where(repository => !string.IsNullOrWhiteSpace(repository.Path) &&
                            OpenCodeActivityService.NormalizePath(repository.Path) is { } path && directories.Contains(path))
                        .Select(repository => repository.Id).ToHashSet();
                    var finished = !_activityNeedsBaseline && _runningSessions.Except(running).Any();
                    _activityNeedsBaseline = false;
                    var changed = !_runningSessions.SetEquals(running);
                    _runningSessions.Clear();
                    _runningSessions.UnionWith(running);
                    if (changed)
                        StateHasChanged();
                    if (finished && _settings.CompletionSoundEnabled)
                    {
                        try { await JS.InvokeVoidAsync("repoLauncherSounds.play", CompletionSounds.Normalize(_settings.CompletionSound)); }
                        catch (JSException) { }
                    }
                });
            } while (await timer.WaitForNextTickAsync(cancellationToken));
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (ObjectDisposedException) { }
    }

    private string BranchLabel(RepositoryEntry repository)
    {
        if (_isRefreshingBranches)
            return L.T("Branch: loading...");

        if (!_branches.TryGetValue(repository, out var branchInfo))
            return L.T("Branch: not loaded yet");

        return branchInfo.Branch is not null
            ? L.T("Branch: {0}", branchInfo.Branch ?? string.Empty)
            : L.T("Branch: {0}", branchInfo.Status ?? string.Empty);
    }

    public void Dispose()
    {
        _statusMonitorCancellation.Cancel();
        _statusMonitorCancellation.Dispose();
        SettingsService.SettingsSaved -= HandleSettingsSaved;
        L.LanguageChanged -= HandleLanguageChanged;
    }
}
