@inject LauncherSettingsService SettingsService
@inject LocalizationService L
@inject AiCommitMessageService AiCommitMessageService
@inject OpenCodeActivityService OpenCodeActivity
@inject AgentConfigService AgentConfigService
@inject SlackNotificationService SlackNotificationService
@inject StartupDetectionService StartupDetection
@inject AgentUpdateService AgentUpdates
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject ApplicationLogService ApplicationLogs
@implements IDisposable

<MudDialog Class="settings-dialog app-settings-dialog">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Settings" Color="Color.Primary" />
            <MudText Typo="Typo.h6">@L.T("Settings")</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudTabs Position="Position.Left" Rounded="true" Border="true" ApplyEffectsToContainer="true"
                 TabPanelsClass="settings-tab-panel" Class="settings-tabs">
            <MudTabPanel Text="@L.T("General")" Icon="@Icons.Material.Filled.Tune">
                <MudStack Spacing="3" Class="settings-content-stack">
                    <MudText Typo="Typo.h6">@L.T("General settings")</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L.T("Settings are stored locally. API keys are stored securely.")</MudText>
                    <MudTextField @bind-Value="Settings.TaskBranchPrefix" Label="@L.T("Task branch prefix")"
                                  HelperText="@L.T("New task branches use this prefix, for example feature/PROJ-123-task-title.")"
                                  Margin="Margin.Dense" Variant="Variant.Outlined" />
                    <MudSelect T="string" Label="@L.T("Language")" Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="Settings.Language">
                        <MudSelectItem T="string" Value="@("en")">@L.T("English")</MudSelectItem>
                        <MudSelectItem T="string" Value="@("nl")">@L.T("Dutch")</MudSelectItem>
                        <MudSelectItem T="string" Value="@("de")">@L.T("German")</MudSelectItem>
                        <MudSelectItem T="string" Value="@("fr")">@L.T("French")</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="string" Label="@L.T("Theme")" Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="Settings.Theme">
                        @foreach (var theme in LauncherThemes.All)
                        {
                            <MudSelectItem T="string" Value="@theme.Id">@theme.Name (@L.T(theme.IsDark ? "Dark" : "Light"))</MudSelectItem>
                        }
                    </MudSelect>
                    @if (OperatingSystem.IsMacCatalyst())
                    {
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.body2">@L.T("macOS interface scale"): @Settings.MacOsScalePercent%</MudText>
                            <MudSlider T="int" @bind-Value="Settings.MacOsScalePercent" Min="100" Max="160" Step="5" Color="Color.Primary" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L.T("Adjust the size of the app interface on macOS. Windows is not affected.")</MudText>
                        </MudStack>
                    }
                    <MudNumericField T="int" @bind-Value="Settings.ToastDurationSeconds" Label="@L.T("Toast duration (seconds)")"
                                     Min="1" Max="10" Margin="Margin.Dense" Variant="Variant.Outlined" />
                    <MudDivider Class="my-2" />
                    <MudSelect T="string" Label="@L.T("Completion sound")" Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="Settings.CompletionSound" @bind-Value:after="PreviewSoundAsync" Disabled="@(!Settings.CompletionSoundEnabled)">
                        @foreach (var sound in CompletionSounds.All)
                        {
                            <MudSelectItem T="string" Value="@sound">@L.T($"Sound: {sound}")</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSwitch @bind-Value="Settings.CompletionSoundEnabled" Color="Color.Primary" Label="@L.T("Play a sound when a session finishes")" />
                    <MudSelect T="string" Label="@L.T("Question sound")" Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="Settings.QuestionSound" @bind-Value:after="PreviewQuestionSoundAsync" Disabled="@(!Settings.QuestionSoundEnabled)">
                        @foreach (var sound in CompletionSounds.All)
                        {
                            <MudSelectItem T="string" Value="@sound">@L.T($"Sound: {sound}")</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSwitch @bind-Value="Settings.QuestionSoundEnabled" Color="Color.Primary" Label="@L.T("Play a sound when the agent asks a question")" />
                </MudStack>
            </MudTabPanel>
            <MudTabPanel Text="@L.T("Repositories")" Icon="@Icons.Material.Filled.Folder">
                <MudStack Spacing="3" Class="settings-content-stack">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <div>
                            <MudText Typo="Typo.h6">@L.T("Manage repositories")</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@L.T("Active repositories get their own tab on the home screen.")</MudText>
                        </div>
                         <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddRepositoryAsync">@L.T("Add")</MudButton>
                    </MudStack>
                    @if (Settings.Repositories.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@L.T("Add a repository folder to get started.")</MudAlert>
                    }
                    @foreach (var repository in Settings.Repositories)
                    {
                        <MudPaper @key="repository.Id" Class="pa-3 repository-setting-row" Outlined="true" Elevation="0">
                            <div class="repository-active-toggle">
                                <MudSwitch @bind-Value="repository.IsActive" Color="Color.Primary" aria-label="@L.T("Active")" />
                            </div>
                            <div class="repository-name-control">
                                <MudText Typo="Typo.body1" Class="repository-name-display">
                                    @(string.IsNullOrWhiteSpace(repository.Name) ? repository.Path : repository.Name)
                                </MudText>
                            </div>
                            <div class="repository-order-controls">
                                <MudTooltip Text="@L.T("Move up")">
                                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.KeyboardArrowUp" aria-label="@L.T("Move up")"
                                                   Disabled="@(Settings.Repositories.IndexOf(repository) == 0)"
                                                   OnClick="@(() => MoveRepository(repository, -1))" />
                                </MudTooltip>
                                <MudTooltip Text="@L.T("Move down")">
                                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.KeyboardArrowDown" aria-label="@L.T("Move down")"
                                                   Disabled="@(Settings.Repositories.IndexOf(repository) == Settings.Repositories.Count - 1)"
                                                   OnClick="@(() => MoveRepository(repository, 1))" />
                                </MudTooltip>
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" aria-label="@L.T("Edit")"
                                               OnClick="@(() => EditRepositoryAsync(repository))" />
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" aria-label="@L.T("Remove repository")"
                                               OnClick="@(() => RemoveRepositoryAsync(repository))" />
                            </div>
                        </MudPaper>
                    }
                </MudStack>
            </MudTabPanel>
            <MudTabPanel Text="@L.T("Agent management")" Icon="@Icons.Material.Filled.Terminal"
                         BadgeDot="@AgentUpdates.HasUpdates" BadgeColor="Color.Warning">
                 <MudStack Spacing="3" Class="settings-content-stack">
                     <MudText Typo="Typo.h6">@L.T("Agent management")</MudText>
                      @foreach (var pendingUpdate in AgentUpdates.Statuses.Where(status => status.IsUpdateAvailable && status.Agent != _selectedAgent))
                      {
                          <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                              <MudText>@L.T("Update {0} from {1} to {2} is available.", pendingUpdate.Agent, pendingUpdate.InstalledVersion ?? "?", pendingUpdate.LatestVersion ?? "?")</MudText>
                              <MudText Typo="Typo.body2">@L.T("Select {0} in the Agent tool dropdown below to review configuration warnings and update safely.", pendingUpdate.Agent)</MudText>
                          </MudAlert>
                      }
                     <MudSelect T="string" Value="_selectedAgent" ValueChanged="LoadAgentConfigAsync" Label="@L.T("Agent tool")" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(_isLoadingAgentConfig || _isSavingAgentConfig)">
                         <MudSelectItem T="string" Value="@AgentTools.OpenCode">OpenCode</MudSelectItem>
                         <MudSelectItem T="string" Value="@AgentTools.ClaudeCode">Claude Code</MudSelectItem>
                          <MudSelectItem T="string" Value="@AgentTools.Codex">Codex</MudSelectItem>
                          <MudSelectItem T="string" Value="@AgentTools.Hermes">Hermes</MudSelectItem>
                      </MudSelect>
                      <CodeBadgerAgentPreferencesPanel @key="_selectedAgent" Settings="Settings" AgentTool="@_selectedAgent" />
                      <MudText Typo="Typo.subtitle1">@_selectedAgent</MudText>
                      @if (GetAgentStartupState(_selectedAgent) is { } agentState)
                     {
                         <MudStack Row="true" Spacing="1" Class="flex-wrap">
                              <MudChip T="string" Size="Size.Small" Color="@(agentState.Installed ? Color.Success : Color.Warning)" Variant="Variant.Outlined">
                                  @L.T(agentState.Installed ? "Agent command ready" : "Agent command unavailable")
                              </MudChip>
                              <MudChip T="string" Size="Size.Small" Color="@(agentState.HasGlobalConfig ? Color.Info : Color.Default)" Variant="Variant.Outlined">
                                  @L.T(agentState.HasGlobalConfig ? "Global settings found" : "No global settings found")
                              </MudChip>
                          </MudStack>
                          @if (!string.IsNullOrWhiteSpace(agentState.Version))
                          {
                              <MudText Typo="Typo.caption" Color="Color.Secondary">@L.T("Detected version: {0}", agentState.Version)</MudText>
                          }
                          @if (!string.IsNullOrWhiteSpace(agentState.ExecutablePath))
                          {
                              <MudText Typo="Typo.caption" Color="Color.Secondary">@agentState.ExecutablePath</MudText>
                          }
                          @if (!string.IsNullOrWhiteSpace(agentState.Failure))
                          {
                              <MudAlert Dense="true" Severity="@(agentState.Installed ? Severity.Info : Severity.Warning)" Variant="Variant.Outlined">@agentState.Failure</MudAlert>
                          }
                          @if (OperatingSystem.IsMacCatalyst() && agentState.HasGlobalConfig)
                          {
                              <MudText Typo="Typo.caption" Color="Color.Secondary">@agentState.ConfigPath</MudText>
                          }
                       }
                      @if (GetAgentUpdateStatus(_selectedAgent) is { } updateStatus)
                      {
                          <MudPaper Outlined="true" Elevation="0" Class="pa-3">
                              <MudStack Spacing="2">
                                  <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                      <MudText Typo="Typo.subtitle1">@L.T("Agent update")</MudText>
                                      <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="@AgentUpdates.IsChecking"
                                                 OnClick="RefreshAgentUpdatesAsync">@L.T("Check again")</MudButton>
                                  </MudStack>
                                   <MudText Typo="Typo.body2">
                                       @if (updateStatus.InstalledVersion is { } installedVersion)
                                       {
                                           @L.T("Installed: {0}", installedVersion)
                                       }
                                       else
                                       {
                                           @L.T("The installed version could not be read from the detected command.")
                                       }
                                      @if (updateStatus.LatestVersion is { } latest)
                                      {
                                          <span> · @L.T("Latest: {0}", latest)</span>
                                      }
                                  </MudText>
                                   @if (updateStatus.InstalledVersion is null)
                                   {
                                       <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@L.T("The installed version could not be read from the detected command.")</MudAlert>
                                       <MudText Typo="Typo.caption" Color="Color.Secondary">@updateStatus.ExecutablePath</MudText>
                                   }
                                   else if (!updateStatus.IsCheckVerified)
                                  {
                                      <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@L.T("Could not verify the latest version from the official release source. Update status is unknown.")</MudAlert>
                                  }
                                  else if (updateStatus.IsUpdateAvailable)
                                  {
                                      <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                                          @if (!updateStatus.IsConfigImpactVerified)
                                          {
                                              @L.T("Release notes do not cover the installed version. Potential breaking changes could not be verified; review all notes before updating.")
                                          }
                                          else if (updateStatus.ConfigChangeMentioned)
                                          {
                                              @L.T("The release notes mention configuration, migration, deprecation, or breaking changes. Review the notes and check your config before updating.")
                                          }
                                          else
                                          {
                                              @L.T("No configuration-breaking changes were identified in the official release notes. This is not a guarantee; review the release notes before updating.")
                                          }
                                       </MudAlert>
                                      @if (updateStatus.IsMajorUpgrade)
                                      {
                                          <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@L.T("This update crosses a major version boundary. Review the migration guide and release notes carefully; configuration and behavior may change.")</MudAlert>
                                          @if (updateStatus.Agent == AgentTools.OpenCode)
                                          {
                                              <MudLink Href="https://opencode.ai/docs/migrate-v1" Target="_blank">@L.T("OpenCode major-version migration guide")</MudLink>
                                          }
                                      }
                                      <MudLink Href="@updateStatus.ReleaseNotesUrl" Target="_blank">@L.T("Review official release notes")</MudLink>
                                      <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                                 Disabled="@_isUpdatingAgent" OnClick="@(() => UpdateAgentAsync(_selectedAgent))">
                                          @(_isUpdatingAgent ? L.T("Preparing update...") : L.T("Back up config and open update terminal"))
                                      </MudButton>
                                  }
                                  else
                                  {
                                      <MudText Typo="Typo.caption" Color="Color.Success">@L.T("Agent is up to date.")</MudText>
                                  }
                              </MudStack>
                          </MudPaper>
                      }
                      else if (AgentUpdates.IsChecking)
                      {
                          <MudText Typo="Typo.caption" Color="Color.Secondary">@L.T("Checking official agent releases...")</MudText>
                      }
                      else if (!AgentUpdates.HasChecked)
                      {
                          <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@AgentUpdates.IsChecking"
                                     OnClick="RefreshAgentUpdatesAsync">@L.T("Check for agent updates")</MudButton>
                      }
                       <MudText Typo="Typo.caption" Color="Color.Secondary">@_agentConfigPath</MudText>
                     @if (!StartupDetection.IsAgentAvailable(_selectedAgent))
                     {
                         <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@L.T("{0} was not detected. Its settings are read-only until it is available.", _selectedAgent)</MudAlert>
                     }
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                           @L.T(_selectedAgent == AgentTools.Hermes
                               ? "Hermes uses YAML config files. MCP switches update mcp_servers.<name>.enabled."
                               : AgentTools.GetDisplayName(_selectedAgent) == "OpenCode"
                              ? "OpenCode MCP switches update the disabled value in this config file."
                              : _selectedAgent == AgentTools.ClaudeCode
                                  ? "Claude Code project config is managed from each repository."
                                  : "Codex uses TOML config files. MCP switches update mcp_servers.<name>.enabled.")
                         @L.T("A timestamped backup is created before each change to an existing config file.")
                    </MudAlert>
                    @if (_agentMcpServers.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle1">@L.T("MCP servers")</MudText>
                        @foreach (var server in _agentMcpServers)
                        {
                            <MudPaper @key="server.Name" Outlined="true" Elevation="0" Class="pa-2">
                                <MudSwitch T="bool" Value="server.Enabled" ValueChanged="@(enabled => ToggleMcpServerAsync(server.Name, enabled))"
                                             Color="Color.Primary" Label="@server.Name" Disabled="@(_isLoadingAgentConfig || _agentConfigLoadFailed || _isSavingAgentConfig || !StartupDetection.IsAgentAvailable(_selectedAgent))" />
                            </MudPaper>
                        }
                    }
                    else if (!_isLoadingAgentConfig)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@L.T("No MCP servers found in this config.")</MudAlert>
                    }
                    <MudExpansionPanels Elevation="0" Outlined="true">
                          <MudExpansionPanel Text="@L.T(_selectedAgent == AgentTools.Hermes ? "Agent configuration (YAML)" : _selectedAgent == AgentTools.Codex ? "Agent configuration (TOML)" : "Agent configuration (JSON)")">
                              <MudStack Spacing="2">
                                 <MudTextField @bind-Value="_agentConfigJson" Label="@L.T(_selectedAgent == AgentTools.Hermes ? "Agent configuration (YAML)" : _selectedAgent == AgentTools.Codex ? "Agent configuration (TOML)" : "Agent configuration (JSON)")"
                                              Lines="18" Sizing="InputSizing.Fixed" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                ReadOnly="@(!StartupDetection.IsAgentAvailable(_selectedAgent))" Disabled="@(_isLoadingAgentConfig || _agentConfigLoadFailed)" />
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Save"
                                             OnClick="SaveAgentConfigAsync" Disabled="@(_isLoadingAgentConfig || _agentConfigLoadFailed || _isSavingAgentConfig || !StartupDetection.IsAgentAvailable(_selectedAgent))" Class="align-self-start">
                                    @L.T("Save agent config")
                                </MudButton>
                            </MudStack>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                </MudStack>
            </MudTabPanel>
            <MudTabPanel Text="@L.T("AI provider")" Icon="@Icons.Material.Filled.AutoAwesome">
                <MudStack Spacing="3" Class="settings-content-stack">
                    <MudPaper Outlined="true" Elevation="0" Class="pa-4">
                    <MudStack Spacing="3" Class="settings-content-stack">
                    <MudText Typo="Typo.h6">@L.T("AI provider settings")</MudText>
                    <MudSelect T="string" Label="@L.T("Provider")" Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="Settings.AiProvider" @bind-Value:after="ResetModelList">
                        @foreach (var provider in AiProviders)
                        {
                            <MudSelectItem T="string" Value="@provider">@provider</MudSelectItem>
                        }
                    </MudSelect>
                    @if (Settings.AiProvider is "Custom URL" or "Azure OpenAI")
                    {
                        <MudTextField @bind-Value="Settings.AiCustomUrl" @bind-Value:after="ResetModelList" Label="@L.T("Provider URL")" Margin="Margin.Dense" Variant="Variant.Outlined"
                                      HelperText="@L.T("OpenAI-compatible base URL (e.g. https://host/v1) or full /chat/completions endpoint; Azure: deployment URL including api-version.")" />
                    }
                    <MudNumericField T="int" @bind-Value="Settings.AiMaxInputTokens" Label="@L.T("Max input tokens")"
                                      Min="256" Max="200000" Margin="Margin.Dense" Variant="Variant.Outlined" />
                    @if (Settings.AiProvider != "Ollama")
                    {
                        <MudTextField @bind-Value="Settings.AiApiKey" @bind-Value:after="ResetModelList" Label="@L.T("Provider API key")" Margin="Margin.Dense" Variant="Variant.Outlined"
                                      InputType="@(_showAiApiKey ? InputType.Text : InputType.Password)"
                                      Adornment="Adornment.End" AdornmentIcon="@(_showAiApiKey ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      OnAdornmentClick="ToggleAiApiKeyVisibility" HelperText="@L.T("Stored securely on this device.")" />
                    }
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.WifiTethering"
                               OnClick="@(() => TestAiConnectionAsync())" Disabled="@(_isTestingAi || !_aiConnectionChanged || !_aiProviderConfigurationComplete)" Class="align-self-start">
                         @(_isTestingAi ? L.T("Loading connection and models...") : L.T("Test connection & load models"))
                    </MudButton>
                    @if (!string.IsNullOrWhiteSpace(_aiConnectionError))
                    {
                        <MudAlert Dense="true" Severity="Severity.Warning" Variant="Variant.Outlined">@_aiConnectionError</MudAlert>
                    }
                    else if (!_aiProviderConfigurationComplete)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L.T("Complete the required provider settings to load models automatically.")</MudText>
                    }
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.subtitle1">@L.T("AI for CodeBadger terminal")</MudText>
                    @if (_terminalModels.Count > 0)
                    {
                        <MudSelect T="string" @bind-Value="Settings.CodeBadgerTerminalModel" Label="@L.T("CodeBadger terminal model")"
                                   Margin="Margin.Dense" Variant="Variant.Outlined" HelperText="@L.T("Choose the model used by the CodeBadger terminal, regardless of the selected agent.")">
                            <MudSelectItem T="string" Value="@string.Empty">@L.T("Automatic selection")</MudSelectItem>
                            @if (!string.IsNullOrWhiteSpace(Settings.CodeBadgerTerminalModel) &&
                                !_terminalModels.Any(model => string.Equals(model.Reference, Settings.CodeBadgerTerminalModel, StringComparison.OrdinalIgnoreCase)))
                            {
                                <MudSelectItem T="string" Value="@Settings.CodeBadgerTerminalModel">@Settings.CodeBadgerTerminalModel (@L.T("unavailable"))</MudSelectItem>
                            }
                            @foreach (var model in _terminalModels)
                            {
                                <MudSelectItem T="string" Value="@model.Reference" Disabled="@(!model.Enabled || model.Status != "active")">@TerminalModelLabel(model)</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else
                    {
                        <MudTextField @bind-Value="Settings.CodeBadgerTerminalModel" Label="@L.T("CodeBadger terminal model ID")"
                                      Margin="Margin.Dense" Variant="Variant.Outlined"
                                      HelperText="@L.T("Enter an OpenCode model reference, or add an OpenCode repository to load model choices.")" />
                    }
                    </MudStack>
                    </MudPaper>
                    <MudPaper Outlined="true" Elevation="0" Class="pa-4">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.h6">@L.T("AI for commit messages")</MudText>
                            <MudSelect T="string" Label="@L.T("Commit message model")" Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="Settings.AiModel"
                                       Disabled="@(!_hasTestedConnection || _availableModels.Count == 0)"
                                       HelperText="@(_hasTestedConnection ? L.T("Choose a model from the provider.") : L.T("Test the connection first to load models."))">
                                @foreach (var model in _availableModels)
                                {
                                    <MudSelectItem T="string" Value="@model">@model</MudSelectItem>
                                }
                            </MudSelect>
                        </MudStack>
                    </MudPaper>
                    <MudPaper Outlined="true" Elevation="0" Class="pa-4">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.h6">@L.T("AI conflict resolution")</MudText>
                            <MudSelect T="string" Label="@L.T("Conflict resolution model")" Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="Settings.AiConflictModel"
                                       Disabled="@(!_hasTestedConnection || _availableModels.Count == 0)"
                                       HelperText="@(_hasTestedConnection ? L.T("Choose the model to suggest resolved conflict content.") : L.T("Test the connection first to load models."))">
                                @foreach (var model in _availableModels)
                                {
                                    <MudSelectItem T="string" Value="@model">@model</MudSelectItem>
                                }
                            </MudSelect>
                        </MudStack>
                    </MudPaper>
                </MudStack>
            </MudTabPanel>
            <MudTabPanel Text="@L.T("Notifications")" Icon="@Icons.Material.Filled.NotificationsActive">
                <MudStack Spacing="3" Class="settings-content-stack">
                    <MudText Typo="Typo.h6">@L.T("Session notifications")</MudText>
                     <MudSelect T="string" Label="@L.T("Notification channel")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                @bind-Value="Settings.NotificationChannel">
                        <MudSelectItem T="string" Value="@("Slack")">Slack</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Discord")">Discord</MudSelectItem>
                     </MudSelect>
                    @if (Settings.NotificationChannel == "Slack")
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                            @L.T("Slack uses Socket Mode, so no public webhook is needed. Configure the Slack app as described below; tokens are stored securely on this device.")
                            <br /><br />
                            @L.T("Bot scopes: chat:write, channels:read, channels:history, groups:read, groups:history. Subscribe to message.channels and message.groups. Generate an app-level token with connections:write and enable Socket Mode.")
                            <br />
                            @L.T("Invite the bot to the channel you choose. Replies in the notification thread are sent to that OpenCode session.")
                        </MudAlert>
                        <MudTextField @bind-Value="Settings.SlackBotToken" Label="@L.T("Slack bot token")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      InputType="InputType.Password" HelperText="@L.T("Starts with xoxb-. Stored securely on this device.")" />
                        <MudTextField @bind-Value="Settings.SlackAppToken" Label="@L.T("Slack app-level token")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      InputType="InputType.Password" HelperText="@L.T("Starts with xapp-. Requires the connections:write scope.")" />
                        <MudTextField @bind-Value="Settings.SlackAllowedUserId" Label="@L.T("Your Slack member ID")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      HelperText="@L.T("Required for safety: only replies from this Slack user will be sent to OpenCode. Find it in your Slack profile under More → Copy member ID.")" />
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
                                       OnClick="LoadSlackChannelsAsync" Disabled="@_isLoadingSlackChannels">
                                @(_isLoadingSlackChannels ? L.T("Loading channels...") : L.T("Load Slack channels"))
                            </MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.WifiTethering"
                                       OnClick="TestSlackConnectionAsync" Disabled="@_isTestingSlack">
                                @(_isTestingSlack ? L.T("Testing Slack connection...") : L.T("Test Slack connection"))
                            </MudButton>
                        </MudStack>
                        <MudSelect T="string" @bind-Value="Settings.SlackChannelId" Label="@L.T("Slack channel")"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(_slackChannels.Count == 0)"
                                   HelperText="@L.T("Public and private channels are listed. Invite the bot first; only channels it joined can be used.")">
                            @foreach (var channel in _slackChannels)
                            {
                                <MudSelectItem T="string" Value="@channel.Id" Disabled="@(!channel.IsMember)">#@channel.Name@(channel.IsMember ? string.Empty : " · " + L.T("Bot not in channel"))</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSwitch @bind-Value="Settings.SlackNotificationsEnabled" Color="Color.Primary"
                                   Label="@L.T("Send OpenCode completion notifications to Slack")" />
                        <MudAlert Severity="@(_slackConnected ? Severity.Success : Severity.Info)" Variant="Variant.Outlined">
                            @L.T(_slackConnectionStatus)
                        </MudAlert>
                    }
                    else if (Settings.NotificationChannel == "Discord")
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                            @L.T("Only the selected notification channel is connected at a time. Add the bot to your Discord server and grant it View Channels, Send Messages, Send Messages in Threads, Create Public Threads, and Read Message History.")
                            <br /><br />
                            @L.T("Enable the Message Content Intent in the Discord Developer Portal. Replies are accepted only from the Discord user ID entered below. In Developer Mode, copy the server ID and enter it below to load channels.")
                        </MudAlert>
                        <MudTextField @bind-Value="Settings.DiscordBotToken" Label="@L.T("Discord bot token")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      InputType="InputType.Password" HelperText="@L.T("Stored securely on this device.")" />
                        <MudTextField @bind-Value="Settings.DiscordGuildId" Label="@L.T("Discord server (guild) ID")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      HelperText="@L.T("Enable Developer Mode in Discord, then use the server context menu to copy its ID.")" />
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
                                       OnClick="LoadDiscordChannelsAsync" Disabled="@(_isLoadingDiscordChannels || string.IsNullOrWhiteSpace(Settings.DiscordGuildId))">
                                @(_isLoadingDiscordChannels ? L.T("Loading channels...") : L.T("Load Discord channels"))
                            </MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.WifiTethering"
                                       OnClick="TestDiscordConnectionAsync" Disabled="@(!CanTestDiscordConnection)">
                                @(_isTestingDiscord ? L.T("Testing Discord connection...") : L.T("Test Discord connection"))
                            </MudButton>
                        </MudStack>
                        <MudSelect T="string" @bind-Value="Settings.DiscordChannelId" Label="@L.T("Discord channel")"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(_discordChannels.Count == 0)"
                                   HelperText="@L.T("Text and announcement channels the bot can access are listed.")">
                            @foreach (var channel in _discordChannels)
                            {
                                <MudSelectItem T="string" Value="@channel.Id">#@channel.Name · @channel.Type</MudSelectItem>
                            }
                        </MudSelect>
                        <MudTextField @bind-Value="Settings.DiscordAllowedUserId" Label="@L.T("Your Discord user ID")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      HelperText="@L.T("Only messages from this Discord user will be routed to OpenCode. Enable Developer Mode, then use your profile menu to copy your ID.")" />
                        <MudSwitch @bind-Value="Settings.SlackNotificationsEnabled" Color="Color.Primary"
                                   Label="@L.T("Enable session notifications")" />
                        <MudAlert Severity="@(_slackConnected ? Severity.Success : Severity.Info)" Variant="Variant.Outlined">
                            @L.T(_slackConnectionStatus)
                        </MudAlert>
                    }
                </MudStack>
            </MudTabPanel>
            <MudTabPanel Text="Sandbox" Icon="@Icons.Material.Filled.Security">
                <MudStack Spacing="3" Class="settings-content-stack">
                    <MudText Typo="Typo.h6">@L.T("General sandbox limits")</MudText>
                    <MudNumericField T="int" @bind-Value="Settings.SandboxMaxFileMb" Label="@L.T("Maximum per file (MB)")" Min="1" Max="512" Variant="Variant.Outlined" />
                    <MudNumericField T="int" @bind-Value="Settings.SandboxMaxTotalMb" Label="@L.T("Maximum total selection (MB)")" Min="1" Max="2048" Variant="Variant.Outlined" />
                    <MudText Typo="Typo.caption">@L.T("Applies to new sandbox sessions. Larger limits increase disk and memory use.")</MudText>
                    <MudAlert Severity="Severity.Info">@L.T("Automatic mode: selections within both limits use copy and review. Exceeding either limit uses direct SDK chat with immediate changes to existing selected files.")</MudAlert>
                </MudStack>
            </MudTabPanel>
            <MudTabPanel Text="@L.T("Logging")" Icon="@Icons.Material.Filled.Article">
                <MudStack Spacing="3" Class="settings-content-stack">
                    <MudText Typo="Typo.h6">@L.T("Logging")</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L.T("Choose the minimum log level independently for each category. Information enables diagnostic request and response details, including prompts and personal data. Secrets such as API keys and tokens are redacted before logs are stored.")</MudText>
                    @foreach (var category in ApplicationLogCategories.All)
                    {
                        <MudSelect T="string" Label="@L.T(category)" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_logLevelValues[category]">
                            @foreach (var level in ConfigurableLogLevels)
                            {
                                <MudSelectItem T="string" Value="@level">@L.T(level)</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    <MudNumericField T="int" @bind-Value="Settings.LogRetentionDays" Label="@L.T("Log retention (days)")"
                                     HelperText="@L.T("Older log files are deleted automatically.")" Min="1" Max="3650"
                                     Margin="Margin.Dense" Variant="Variant.Outlined" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteOutline" OnClick="ClearApplicationLogs">@L.T("Clear logs now")</MudButton>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L.T("Log files are stored locally. Information logging can include prompts and personal data. Credentials and tokens are redacted before storage; avoid sharing log files publicly.")</MudText>
                </MudStack>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton Size="Size.Small" OnClick="Cancel">@L.T("Cancel")</MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                   Disabled="@_isSaving" OnClick="SaveAsync">@L.T("Save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    protected override async Task OnInitializedAsync()
    {
        L.LanguageChanged += HandleLanguageChanged;
        SlackNotificationService.ConnectionChanged += HandleSlackConnectionChanged;
        _slackConnected = SlackNotificationService.IsConnected;
        _slackConnectionStatus = SlackNotificationService.ConnectionStatus;
    }

    private void HandleLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task PreviewSoundAsync()
    {
        try { await JS.InvokeVoidAsync("codeBadgerSounds.play", CompletionSounds.Normalize(Settings.CompletionSound)); }
        catch (JSException) { }
    }

    private async Task PreviewQuestionSoundAsync()
    {
        try { await JS.InvokeVoidAsync("codeBadgerSounds.play", CompletionSounds.Normalize(Settings.QuestionSound)); }
        catch (JSException) { }
    }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public LauncherSettings Settings { get; set; } = new();

    private bool _isTestingAi;
    private bool _isSaving;
    private bool _showAiApiKey;
    private bool _hasTestedConnection;
    private bool _aiConnectionChanged;
    private bool _initialModelLoadsStarted;
    private string _aiConnectionError = string.Empty;

    private void ToggleAiApiKeyVisibility() => _showAiApiKey = !_showAiApiKey;

    private IReadOnlyList<string> _availableModels = [];
    private IReadOnlyList<OpenCodeActivityService.AvailableModel> _terminalModels = [];
    private bool _aiProviderConfigurationComplete => Settings.AiProvider switch
    {
        "Ollama" => true,
        "Custom URL" => IsValidProviderUrl(Settings.AiCustomUrl),
        "Azure OpenAI" => IsValidProviderUrl(Settings.AiCustomUrl) && !string.IsNullOrWhiteSpace(Settings.AiApiKey),
        _ => !string.IsNullOrWhiteSpace(Settings.AiApiKey)
    };
    private static readonly string[] AiProviders = ["OpenAI", "Azure OpenAI", "Anthropic", "Google Gemini", "Ollama", "Custom URL"];
    private string _selectedAgent = AgentTools.OpenCode;
    private string _agentConfigJson = "{}";
    private string _agentConfigPath = string.Empty;
    private IReadOnlyList<AgentMcpServer> _agentMcpServers = [];
    private bool _isLoadingAgentConfig;
    private bool _isSavingAgentConfig;
    private bool _agentConfigLoadFailed;
    private bool _isUpdatingAgent;
    private bool _isLoadingSlackChannels;
    private bool _isTestingSlack;
    private bool _isTestingDiscord;
    private bool _isLoadingDiscordChannels;
    private bool CanTestDiscordConnection => !_isTestingDiscord && !_isLoadingDiscordChannels &&
        !string.IsNullOrWhiteSpace(Settings.DiscordBotToken) &&
        IsDiscordSnowflake(Settings.DiscordGuildId) &&
        IsDiscordSnowflake(Settings.DiscordChannelId) &&
        IsDiscordSnowflake(Settings.DiscordAllowedUserId);
    private bool _slackConnected;
    private string _slackConnectionStatus = "Slack notifications are not connected.";
    private IReadOnlyList<SlackNotificationService.SlackChannel> _slackChannels = [];
    private IReadOnlyList<SlackNotificationService.DiscordChannel> _discordChannels = [];
    private static readonly string[] ConfigurableLogLevels = ["None", "Trace", "Debug", "Information", "Warning", "Error", "Critical"];
    private readonly Dictionary<string, string> _logLevelValues = new(StringComparer.Ordinal);

    protected override void OnParametersSet()
    {
        _logLevelValues[ApplicationLogCategories.General] = Settings.GeneralLogLevel;
        _logLevelValues[ApplicationLogCategories.Git] = Settings.GitLogLevel;
        _logLevelValues[ApplicationLogCategories.Notifications] = Settings.NotificationsLogLevel;
        _logLevelValues[ApplicationLogCategories.Ai] = Settings.AiLogLevel;
    }

    protected override void OnInitialized()
    {
        AgentUpdates.UpdatesChanged += HandleAgentUpdatesChanged;
        Settings.CodeBadgerAgentPreferences ??= CodeBadgerRoles.CreateAgentDefaults();
        CodeBadgerRoles.NormalizeAgentPreferences(Settings.CodeBadgerAgentPreferences);
    }
    private void HandleAgentUpdatesChanged() => _ = InvokeAsync(StateHasChanged);

    private void ClearApplicationLogs() => ApplicationLogs.Clear();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!_initialModelLoadsStarted)
            {
                _initialModelLoadsStarted = true;
                if (_aiProviderConfigurationComplete)
                    _ = TestAiConnectionAsync(automatic: true);
            }
            await LoadAgentConfigAsync(_selectedAgent);
            await LoadCodeBadgerTerminalModelsAsync();
        }
    }

    private async Task LoadCodeBadgerTerminalModelsAsync()
    {
        var repositoryPath = Settings.Repositories.FirstOrDefault(repository => repository.IsActive &&
            AgentTools.Normalize(repository.AgentTool) == AgentTools.OpenCode)?.Path;
        repositoryPath ??= Settings.Repositories.FirstOrDefault(repository =>
            AgentTools.Normalize(repository.AgentTool) == AgentTools.OpenCode)?.Path;
        if (string.IsNullOrWhiteSpace(repositoryPath) || !Directory.Exists(repositoryPath))
            return;

        try
        {
            _terminalModels = await OpenCodeActivity.GetAvailableModelsAsync(repositoryPath, CancellationToken.None);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception exception)
        {
            Snackbar.Add(L.T("Could not load OpenCode models: {0}", exception.Message), Severity.Warning);
        }
    }

    private string TerminalModelLabel(OpenCodeActivityService.AvailableModel model) =>
        $"{model.Name} · {model.Reference} · {(model.HasPublishedCost ? $"${model.InputCost:0.####}/${model.OutputCost:0.####}" : L.T("price unavailable"))}";

    private async Task LoadAgentConfigAsync(string agent)
    {
        _selectedAgent = AgentTools.Normalize(agent);
        _isLoadingAgentConfig = true;
        _agentConfigLoadFailed = false;
        _agentConfigJson = "{}";
        _agentMcpServers = [];
        try
        {
            _agentConfigPath = AgentConfigService.GetConfigPath(_selectedAgent);
            _agentConfigJson = await AgentConfigService.LoadAsync(_selectedAgent);
            _agentMcpServers = await AgentConfigService.GetMcpServersAsync(_selectedAgent, _agentConfigJson, Settings.Repositories);
        }
        catch (Exception exception)
        {
            _agentConfigLoadFailed = true;
            _agentMcpServers = [];
            Snackbar.Add(L.T("Could not load agent config: {0}", exception.Message), Severity.Error);
        }
        finally
        {
            _isLoadingAgentConfig = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleMcpServerAsync(string serverName, bool enabled)
    {
        if (_agentConfigLoadFailed || !StartupDetection.IsAgentAvailable(_selectedAgent))
            return;

        _isSavingAgentConfig = true;
        try
        {
            _agentConfigJson = await AgentConfigService.SetMcpServerEnabledAsync(
                _selectedAgent, _agentConfigJson, serverName, enabled, Settings.Repositories);
            _agentMcpServers = await AgentConfigService.GetMcpServersAsync(_selectedAgent, _agentConfigJson, Settings.Repositories);
            Snackbar.Add(L.T("MCP server updated. Backup created when an existing config was changed."), Severity.Success);
        }
        catch (Exception exception)
        {
            Snackbar.Add(L.T("Could not update MCP server: {0}", exception.Message), Severity.Error);
            await LoadAgentConfigAsync(_selectedAgent);
        }
        finally
        {
            _isSavingAgentConfig = false;
        }
    }

    private async Task SaveAgentConfigAsync()
    {
        if (_agentConfigLoadFailed || !StartupDetection.IsAgentAvailable(_selectedAgent))
            return;

        _isSavingAgentConfig = true;
        try
        {
            await AgentConfigService.SaveAsync(_selectedAgent, _agentConfigJson);
            _agentMcpServers = await AgentConfigService.GetMcpServersAsync(_selectedAgent, _agentConfigJson, Settings.Repositories);
            Snackbar.Add(L.T("Agent config saved. Backup created when an existing config was changed."), Severity.Success);
        }
        catch (Exception exception)
        {
            Snackbar.Add(L.T("Could not save agent config: {0}", exception.Message), Severity.Error);
        }
        finally
        {
            _isSavingAgentConfig = false;
        }
    }

    private async Task AddRepositoryAsync()
    {
        var setupDialog = await DialogService.ShowAsync<RepositorySetupDialog>(
            L.T("Add repository"),
            options: new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, CloseButton = true, CloseOnEscapeKey = true });
        var setupResult = await setupDialog.Result;
        if (setupResult is not { Canceled: false, Data: RepositorySetupDialog.RepositorySetupResult setup })
            return;

        var repository = new RepositoryEntry();
        repository.Path = setup.Path;
        repository.Name = Path.GetFileName(Path.TrimEndingDirectorySeparator(setup.Path));
        Settings.Repositories.Add(repository);
        if (!await EditRepositoryAsync(repository))
            Settings.Repositories.Remove(repository);
    }

    private async Task<bool> EditRepositoryAsync(RepositoryEntry repository)
    {
        var editedRepository = System.Text.Json.JsonSerializer.Deserialize<RepositoryEntry>(
            System.Text.Json.JsonSerializer.Serialize(repository))!;
        var dialog = await DialogService.ShowAsync<RepositorySettingsDialog>(
            L.T("Repository settings"),
            new DialogParameters<RepositorySettingsDialog>
            {
                { component => component.Repository, editedRepository },
                { component => component.Settings, Settings }
            },
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Large, CloseButton = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: RepositoryEntry savedRepository })
            return false;

        var index = Settings.Repositories.FindIndex(candidate => candidate.Id == repository.Id);
        if (index >= 0)
            CopyRepositorySettings(savedRepository, repository);
        return true;
    }

    private async Task RemoveRepositoryAsync(RepositoryEntry repository)
    {
        var repositoryName = string.IsNullOrWhiteSpace(repository.Name) ? repository.Path : repository.Name;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L.T("Remove repository"), L.T("Remove repository '{0}'? This cannot be undone.", repositoryName),
            yesText: L.T("Delete"), cancelText: L.T("Cancel"));
        if (confirmed == true)
            Settings.Repositories.Remove(repository);
    }

    private void MoveRepository(RepositoryEntry repository, int offset)
    {
        var currentIndex = Settings.Repositories.IndexOf(repository);
        var targetIndex = currentIndex + offset;
        if (currentIndex < 0 || targetIndex < 0 || targetIndex >= Settings.Repositories.Count)
            return;

        Settings.Repositories.RemoveAt(currentIndex);
        Settings.Repositories.Insert(targetIndex, repository);
    }

    private static void CopyRepositorySettings(RepositoryEntry source, RepositoryEntry target)
    {
        target.Name = source.Name;
        target.Path = source.Path;
        target.IsActive = source.IsActive;
        target.AgentTool = source.AgentTool;
        target.OpenCodeSandboxEnabled = source.OpenCodeSandboxEnabled;
        target.CodeBadgerTerminalEnabled = source.CodeBadgerTerminalEnabled;
        target.CodeBadgerOrchestrationMode = source.CodeBadgerOrchestrationMode;
        target.OpenCodeSandboxModel = source.OpenCodeSandboxModel;
        target.OpenCodeSandboxFiles = source.OpenCodeSandboxFiles;
        target.TicketRequired = source.TicketRequired;
        target.TicketSystem = source.TicketSystem;
        target.TicketMcpServerName = source.TicketMcpServerName;
        target.TicketProjectKey = source.TicketProjectKey;
        target.TaskStoryTemplate = source.TaskStoryTemplate;
        target.AiCustomInstruction = source.AiCustomInstruction;
        target.SlackNotificationsMuted = source.SlackNotificationsMuted;
        target.HiddenStashCommitHashes = source.HiddenStashCommitHashes.ToList();
        target.AutoSyncSubmodules = source.AutoSyncSubmodules;
    }

    private AgentStartupState? GetAgentStartupState(string agent) => StartupDetection.GetAgentState(agent);

    private AgentUpdateStatus? GetAgentUpdateStatus(string agent) => AgentUpdates.Statuses
        .FirstOrDefault(status => status.Agent == AgentTools.Normalize(agent));

    private Task RefreshAgentUpdatesAsync() => AgentUpdates.CheckForUpdatesAsync(refresh: true);

    private async Task UpdateAgentAsync(string agent)
    {
        var update = GetAgentUpdateStatus(agent);
        if (update is not { IsUpdateAvailable: true })
            return;

        if (update.Agent == AgentTools.OpenCode)
        {
            var processCheck = await AgentUpdates.CheckOpenCodeProcessesAsync();
            if (!processCheck.CouldVerify)
            {
                Snackbar.Add(L.T("Could not verify OpenCode processes. Close any OpenCode session and retry; the update was not started."), Severity.Warning);
                return;
            }
        }

        var confirmation = !update.IsConfigImpactVerified || update.ConfigChangeMentioned || update.IsMajorUpgrade
            ? L.T("The release notes indicate possible configuration changes, or could not be checked across every version. Back up configs and review the official notes first. Continue?")
            : L.T("No configuration-breaking changes were identified in the available official release notes, but this is not guaranteed. Back up configs and review the notes before continuing.");
        var configurationScope = update.Agent == AgentTools.Hermes
            ? L.T("Detected Hermes config.yaml, including HERMES_HOME, will be archived.")
            : L.T("Detected global and configured repository config files will be archived.");
        var processScope = update.Agent == AgentTools.OpenCode
            ? "\n\n" + L.T("Confirm that no OpenCode session has unsaved work. CodeBadger will stop all OpenCode sessions and background processes, run the update, then restart the OpenCode background service. Unsaved session work may be lost.")
            : string.Empty;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L.T("Update {0} to {1}?", update.Agent, update.LatestVersion ?? "?"),
            confirmation + "\n\n" + configurationScope + " " + L.T("The terminal performs the tool's official update command; CodeBadger will not update configuration files automatically.") + processScope,
            yesText: update.Agent == AgentTools.OpenCode ? L.T("Stop OpenCode, back up and update") : L.T("Back up and continue"),
            cancelText: L.T("Cancel"),
            options: new DialogOptions { CloseOnEscapeKey = true });
        if (confirmed != true)
            return;

        _isUpdatingAgent = true;
        try
        {
            var backupPath = await AgentUpdates.CreateConfigBackupAsync(update.Agent, Settings);
            AgentUpdates.StartUpdateInTerminal(update.Agent, update.ExecutablePath);
            Snackbar.Add(L.T("Config backup created: {0}", backupPath), Severity.Success);
        }
        catch (Exception exception)
        {
            Snackbar.Add(L.T("Could not prepare the agent update: {0}", exception.Message), Severity.Error);
        }
        finally
        {
            _isUpdatingAgent = false;
        }
    }

    private async Task TestAiConnectionAsync(bool automatic = false)
    {
        if (!_aiProviderConfigurationComplete)
        {
            _aiConnectionError = L.T("Complete the required provider settings to load models automatically.");
            return;
        }

        _isTestingAi = true;
        _hasTestedConnection = false;
        _availableModels = [];
        _aiConnectionError = string.Empty;
        try
        {
            var result = await AiCommitMessageService.GetAvailableModelsAsync(Settings);
            if (result.Success)
            {
                _availableModels = result.Models;
                _hasTestedConnection = true;
                _aiConnectionChanged = false;
                if (!_availableModels.Contains(Settings.AiModel, StringComparer.OrdinalIgnoreCase))
                    Settings.AiModel = _availableModels[0];
                if (!_availableModels.Contains(Settings.AiConflictModel, StringComparer.OrdinalIgnoreCase))
                    Settings.AiConflictModel = _availableModels[0];
            }
            if (!result.Success)
            {
                _aiConnectionError = result.Error;
                if (!automatic)
                    Snackbar.Add(result.Error, Severity.Error);
            }
            else if (!automatic)
                Snackbar.Add(L.T("Connection successful. {0} models found.", _availableModels.Count), Severity.Success);
        }
        catch (Exception exception)
        {
            _aiConnectionError = L.T("Connection to the AI provider failed: {0}", exception.Message);
            if (!automatic)
                Snackbar.Add(_aiConnectionError, Severity.Error);
        }
        finally
        {
            _isTestingAi = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ResetModelList()
    {
        _hasTestedConnection = false;
        _availableModels = [];
        _aiConnectionError = string.Empty;
        _aiConnectionChanged = true;
    }

    private static bool IsValidProviderUrl(string? value) =>
        Uri.TryCreate(value, UriKind.Absolute, out var uri) && uri.Scheme is "http" or "https";

    private async Task LoadSlackChannelsAsync()
    {
        _isLoadingSlackChannels = true;
        try
        {
            _slackChannels = await SlackNotificationService.GetChannelsAsync(Settings.SlackBotToken);
            if (!string.IsNullOrWhiteSpace(Settings.SlackChannelId) &&
                !_slackChannels.Any(channel => channel.Id == Settings.SlackChannelId))
                Settings.SlackChannelId = string.Empty;
            Snackbar.Add(L.T("Loaded {0} Slack channels.", _slackChannels.Count), Severity.Success);
        }
        catch (Exception exception)
        {
            Snackbar.Add(L.T("Could not load Slack channels: {0}", exception.Message), Severity.Error);
        }
        finally { _isLoadingSlackChannels = false; }
    }

    private async Task TestSlackConnectionAsync()
    {
        _isTestingSlack = true;
        try
        {
            await SlackNotificationService.TestConnectionAsync(Settings.SlackBotToken, Settings.SlackAppToken);
            Snackbar.Add(L.T("Slack connection successful."), Severity.Success);
        }
        catch (Exception exception)
        {
            Snackbar.Add(L.T("Slack connection failed: {0}", exception.Message), Severity.Error);
        }
        finally { _isTestingSlack = false; }
    }

    private async Task LoadDiscordChannelsAsync()
    {
        _isLoadingDiscordChannels = true;
        try
        {
            _discordChannels = await SlackNotificationService.GetDiscordChannelsAsync(Settings.DiscordBotToken, Settings.DiscordGuildId);
            if (!string.IsNullOrWhiteSpace(Settings.DiscordChannelId) &&
                !_discordChannels.Any(channel => channel.Id == Settings.DiscordChannelId))
                Settings.DiscordChannelId = string.Empty;
            Snackbar.Add(L.T("Loaded {0} Discord channels.", _discordChannels.Count), Severity.Success);
        }
        catch (Exception exception)
        {
            Snackbar.Add(L.T("Could not load Discord channels: {0}", exception.Message), Severity.Error);
        }
        finally { _isLoadingDiscordChannels = false; }
    }

    private async Task TestDiscordConnectionAsync()
    {
        _isTestingDiscord = true;
        try
        {
            await SlackNotificationService.TestDiscordConnectionAsync(Settings.DiscordBotToken, Settings.DiscordChannelId);
            Snackbar.Add(L.T("Discord connection successful."), Severity.Success);
        }
        catch (Exception exception)
        {
            Snackbar.Add(L.T("Discord connection failed: {0}", exception.Message), Severity.Error);
        }
        finally { _isTestingDiscord = false; }
    }

    private static bool IsDiscordSnowflake(string? value) => !string.IsNullOrWhiteSpace(value) &&
        value.Length is >= 17 and <= 20 && value.All(char.IsAsciiDigit);

    private void HandleSlackConnectionChanged(bool connected, string status) => _ = InvokeAsync(() =>
    {
        _slackConnected = connected;
        _slackConnectionStatus = status;
        StateHasChanged();
    });

    private async Task SaveAsync()
    {
        _isSaving = true;
        try
        {
            Settings.GeneralLogLevel = _logLevelValues.GetValueOrDefault(ApplicationLogCategories.General, "Warning");
            Settings.GitLogLevel = _logLevelValues.GetValueOrDefault(ApplicationLogCategories.Git, "Warning");
            Settings.NotificationsLogLevel = _logLevelValues.GetValueOrDefault(ApplicationLogCategories.Notifications, "Warning");
            Settings.AiLogLevel = _logLevelValues.GetValueOrDefault(ApplicationLogCategories.Ai, "Warning");
            await SettingsService.SaveAsync(Settings);
            ApplicationLogs.PruneExpired(Settings.LogRetentionDays);
            Snackbar.Configuration.VisibleStateDuration = Settings.ToastDurationSeconds * 1000;
            Snackbar.Add(L.T("Settings saved."), Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    public void Dispose()
    {
        L.LanguageChanged -= HandleLanguageChanged;
        AgentUpdates.UpdatesChanged -= HandleAgentUpdatesChanged;
        SlackNotificationService.ConnectionChanged -= HandleSlackConnectionChanged;
    }
}
