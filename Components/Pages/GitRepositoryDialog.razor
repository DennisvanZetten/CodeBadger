@using System.Globalization
@using CodeBadger.Models
@using CodeBadger.Components.Shared
@inject LocalizationService L
@inject GitBranchService GitBranchService
@inject LauncherSettingsService LauncherSettingsService
@inject AiCommitMessageService AiCommitMessageService
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@implements IAsyncDisposable

<MudDialog Class="git-overview-dialog">
    <DialogContent>
        <div class="git-overview-content">
            @if (_isLoading && _snapshot is null)
            {
                <MudStack Spacing="3" Class="git-overview-main git-overview-initial-loading">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap">
                        <MudText Typo="Typo.subtitle1">@RepositoryName</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" aria-label="@L.T("Close")" OnClick="Close" />
                    </MudStack>
                    <div class="git-overview-progress git-overview-progress-active" aria-live="polite">
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                        <span>@L.T(_loadingStage)</span>
                        @if (_loadedBranchCount is not null)
                        {
                            <span class="git-overview-progress-count">@L.T("Branches loaded: {0}", _loadedBranchCount.Value)</span>
                        }
                    </div>
                    <div class="git-overview-loading-space"></div>
                </MudStack>
            }
            else if (_snapshot is null || !_snapshot.IsValid)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@(_snapshot?.Error ?? L.T("Git status unavailable."))</MudAlert>
                <MudIconButton Class="git-overview-close" Icon="@Icons.Material.Filled.Close" aria-label="@L.T("Close")" OnClick="Close" />
            }
            else
            {
              <MudStack Spacing="3" Class="git-overview-main">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.CallSplit">@_snapshot.Branch</MudChip>
                    </MudStack>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                                   Disabled="@_isOperating" OnClick="@(() => OpenCreateBranchDialog("HEAD"))">@L.T("New branch")</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download"
                                   Disabled="@_isOperating" OnClick="PullAsync">@L.T("Pull ({0})", _snapshot.Behind)</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Upload"
                                   Disabled="@_isOperating" OnClick="PushAsync">@L.T("Push ({0})", _snapshot.Ahead)</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SaveAlt"
                                   Disabled="@(_isOperating || _files.Count == 0)" OnClick="StashChangesAsync">@L.T("Stash")</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Unarchive"
                                   Disabled="@(_isOperating || _stashes.Count == 0)" OnClick="PopLatestStashAsync">@L.T("Pop")</MudButton>
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" aria-label="@L.T("Refresh Git status")"
                                       Disabled="@_isOperating" OnClick="@(() => RefreshAsync(fetch: true))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" aria-label="@L.T("Close")" OnClick="Close" />
                    </MudStack>
                </MudStack>
                <div class="git-overview-progress @(_isLoading || _isOperating ? "git-overview-progress-active" : "")" aria-live="polite">
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    <span>@L.T(_loadingStage)</span>
                    @if (_loadedBranchCount is not null)
                    {
                        <span class="git-overview-progress-count">@L.T("Branches loaded: {0}", _loadedBranchCount.Value)</span>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(_snapshot.Warning))
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@_snapshot.Warning</MudAlert>
                }

                <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" Class="git-view-switch">
                    <MudButton Class="@(_view == GitView.History ? "git-view-active" : "git-view-inactive")"
                               StartIcon="@Icons.Material.Filled.AccountTree" Color="@(_view == GitView.History ? Color.Primary : Color.Default)" Variant="@(_view == GitView.History ? Variant.Filled : Variant.Outlined)"
                                OnClick="@(() => _view = GitView.History)">@L.T("Branches & commits")</MudButton>
                    <MudButton Class="@(_view == GitView.Commit ? "git-view-active" : "git-view-inactive")"
                               StartIcon="@Icons.Material.Filled.EditNote" Color="@(_view == GitView.Commit ? Color.Primary : Color.Default)" Variant="@(_view == GitView.Commit ? Variant.Filled : Variant.Outlined)"
                                OnClick="@(() => SwitchToCommitViewAsync())">@L.T("Create commit")</MudButton>
                </MudButtonGroup>

                @if (_snapshot.Conflicts.Count > 0)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Warning">
                        <MudText Typo="Typo.subtitle2">@L.T("Conflicts found ({0})", _snapshot.Conflicts.Count)</MudText>
                        <MudStack Spacing="1" Class="mt-2">
                            @foreach (var conflict in _snapshot.Conflicts)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" @key="conflict">
                                    <MudText Typo="Typo.body2" Class="text-break">@conflict</MudText>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.CompareArrows"
                                                OnClick="@(() => ResolveConflictAsync(conflict))">@L.T("Resolve conflict")</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.OpenInNew"
                                                OnClick="@(() => OpenConflictAsync(conflict))">@L.T("Open in VS Code")</MudButton>
                                </MudStack>
                            }
                        </MudStack>
                    </MudAlert>
                }

                @if (_view == GitView.History)
                {
                    <div class="git-history-workspace @(_isBranchPanelCollapsed ? "git-history-workspace-collapsed" : "") @(_isCommitFilesPanelCollapsed ? "git-history-commit-files-collapsed" : "")">
                        <MudPaper Class="pa-3 git-dialog-panel git-branch-panel" Outlined="true" Elevation="0">
                            <div class="git-branch-header">
                                <MudIconButton Class="git-branch-collapse-button" Icon="@Icons.Material.Filled.ChevronLeft"
                                               aria-label="@L.T("Collapse branch panel")" OnClick="ToggleBranchPanel" />
                            </div>
                            <div class="git-branch-groups @(_stashes.Count > 0 ? "git-branch-groups-with-stashes" : "git-branch-groups-without-stashes")">
                                <details class="git-branch-group" open>
                                    <summary><span>@L.T("Local branches")</span><span class="git-branch-count">@LocalBranches.Count</span></summary>
                                    <div class="git-dialog-list git-branch-list">
                                        @foreach (var folder in LocalBranchFolders)
                                        {
                                            @BranchFolderContent(folder, false)
                                        }
                                        @if (LocalBranches.Count == 0)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L.T("No local branches.")</MudText>
                                        }
                                    </div>
                                </details>
                                <div class="git-history-splitter git-branch-group-splitter" data-branch-group-splitter="0"
                                     role="separator" aria-orientation="horizontal" aria-label="@L.T("Resize local branches and remote branches")" tabindex="0"></div>
                                <details class="git-branch-group" open>
                                    <summary><span>@L.T("Remote branches")</span><span class="git-branch-count">@RemoteBranches.Count</span></summary>
                                    <div class="git-dialog-list git-branch-list">
                                        @foreach (var folder in RemoteBranchFolders)
                                        {
                                            @BranchFolderContent(folder, true)
                                        }
                                        @if (RemoteBranches.Count == 0)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L.T("No remote branches.")</MudText>
                                        }
                                    </div>
                                </details>
                                @if (_stashes.Count > 0)
                                {
                                    <div class="git-history-splitter git-branch-group-splitter" data-branch-group-splitter="1"
                                         role="separator" aria-orientation="horizontal" aria-label="@L.T("Resize remote branches and stashes")" tabindex="0"></div>
                                    <section class="git-branch-group git-stash-group">
                                         <div class="git-stash-header">
                                             <MudText Typo="Typo.body2">@L.T("Stashes")</MudText>
                                             @if (HiddenStashCount > 0)
                                             {
                                                 <MudIconButton Size="Size.Small" Icon="@(_showHiddenStashes ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                                                aria-label="@(_showHiddenStashes ? L.T("Hide hidden stashes") : L.T("Show hidden stashes ({0})", HiddenStashCount))"
                                                                title="@(_showHiddenStashes ? L.T("Hide hidden stashes") : L.T("Show hidden stashes ({0})", HiddenStashCount))"
                                                                OnClick="ToggleHiddenStashes" />
                                             }
                                         </div>
                                         <div class="git-dialog-list git-branch-list git-stash-list">
                                             @foreach (var stash in VisibleStashes)
                                             {
                                                 <div @key="stash.CommitHash" class="git-stash-item" @oncontextmenu:preventDefault="true"
                                                      @oncontextmenu="@(args => OpenStashContextMenu(stash, args))">
                                                     <div class="git-stash-main" role="button" tabindex="0" title="@L.T("Double-click to pop this stash")"
                                                          @ondblclick="@(() => PopStashAsync(stash))"
                                                          @onkeydown="@(args => HandleStashKeyDownAsync(args, stash))">
                                                         <MudText Typo="Typo.body2" Class="git-stash-message">@stash.Message</MudText>
                                                         <MudText Typo="Typo.caption" Color="Color.Secondary">@FormatDate(stash.Date)</MudText>
                                                     </div>
                                                     <MudIconButton Class="git-stash-menu-button" Size="Size.Small" Icon="@Icons.Material.Filled.MoreVert"
                                                                    aria-label="@L.T("Stash actions")" title="@L.T("Stash actions")"
                                                                    OnClick="@(args => OpenStashContextMenu(stash, args))"
                                                                    @oncontextmenu:preventDefault="true" />
                                                 </div>
                                             }
                                         </div>
                                     </section>
                                 }
                                @if (_contextMenuStash is not null)
                                {
                                <div class="git-context-menu-backdrop git-stash-context-backdrop" @onclick="CloseStashContextMenu" @oncontextmenu:preventDefault="true">
                                        <div class="git-commit-context-menu git-stash-context-menu" @onclick:stopPropagation="true">
                                            <button class="git-commit-context-menu-item" disabled="@_isOperating" @onclick="ApplyContextStashAsync">
                                                <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" /><span>@L.T("Apply stash")</span>
                                            </button>
                                            <button class="git-commit-context-menu-item" disabled="@_isOperating" @onclick="PopContextStashAsync">
                                                <MudIcon Icon="@Icons.Material.Filled.Unarchive" Size="Size.Small" /><span>@L.T("Pop stash")</span>
                                            </button>
                                            <button class="git-commit-context-menu-item" disabled="@_isOperating" @onclick="DeleteContextStashAsync">
                                                <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" /><span>@L.T("Delete stash")</span>
                                            </button>
                                            <div class="git-context-menu-separator" role="separator"></div>
                                            <button class="git-commit-context-menu-item" disabled="@_isOperating" @onclick="EditContextStashMessage">
                                                <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" /><span>@L.T("Edit stash message")</span>
                                            </button>
                                            <div class="git-context-menu-separator" role="separator"></div>
                                            <button class="git-commit-context-menu-item" @onclick="ToggleContextStashHidden">
                                                <MudIcon Icon="@(_hiddenStashCommitHashes.Contains(_contextMenuStash.CommitHash) ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)" Size="Size.Small" />
                                                <span>@(_hiddenStashCommitHashes.Contains(_contextMenuStash.CommitHash) ? L.T("Unhide stash") : L.T("Hide stash"))</span>
                                            </button>
                                        </div>
                                    </div>
                                }
                                @if (_stashBeingEdited is not null)
                                {
                                    <div class="git-create-branch-backdrop" @onclick="CloseEditStashDialog">
                                        <div class="git-create-branch-dialog" role="dialog" aria-modal="true" aria-labelledby="edit-stash-title" @onclick:stopPropagation="true">
                                            <MudText id="edit-stash-title" Typo="Typo.h6">@L.T("Edit stash message")</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L.T("Editing moves the stash to the top of the list.")</MudText>
                                            <MudTextField @bind-Value="_editedStashMessage" Label="@L.T("Stash message")" Variant="Variant.Outlined" AutoFocus="true"
                                                          OnKeyDown="HandleEditStashKeyDown" Disabled="@_isOperating" />
                                            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-2">
                                                <MudButton Variant="Variant.Text" Disabled="@_isOperating" OnClick="CloseEditStashDialog">@L.T("Cancel")</MudButton>
                                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_isOperating || string.IsNullOrWhiteSpace(_editedStashMessage))" OnClick="SaveStashMessageAsync">
                                                    @L.T("Save")
                                                </MudButton>
                                            </MudStack>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="git-branch-collapsed-rail">
                                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" aria-label="@L.T("Expand branch panel")" OnClick="ToggleBranchPanel" />
                                <button class="git-branch-rail-item" aria-label="@L.T("Local branches") — @LocalBranches.Count" title="@L.T("Local branches")" @onclick="ExpandBranchPanel">
                                    <MudIcon Icon="@Icons.Material.Filled.CallSplit" Size="Size.Small" />
                                    <span>@LocalBranches.Count</span>
                                </button>
                                <button class="git-branch-rail-item" aria-label="@L.T("Remote branches") — @RemoteBranches.Count" title="@L.T("Remote branches")" @onclick="ExpandBranchPanel">
                                    <MudIcon Icon="@Icons.Material.Filled.Cloud" Size="Size.Small" />
                                    <span>@RemoteBranches.Count</span>
                                </button>
                            </div>
                        </MudPaper>
                        <div class="git-history-splitter git-history-branch-splitter" role="separator" aria-orientation="vertical" aria-label="Resize branch panel" tabindex="0"></div>
                        <MudPaper Class="pa-3 git-dialog-panel git-commit-history-panel" Outlined="true" Elevation="0">
                                <MudText Typo="Typo.subtitle1" Class="mb-2">@L.T("Recent commits")</MudText>
                                 <MudStack Spacing="0" Class="git-dialog-list git-commit-list">
                                    @foreach (var commit in _snapshot.Commits)
                                    {
                                        <div @key="commit.Hash"
                                             class="git-commit-row @(IsSelectedCommit(commit) ? "git-commit-row-selected" : "") @(IsSoloDimmedCommit(commit) ? "git-commit-row-solo-dimmed" : "")"
                                             role="button" tabindex="0" aria-pressed="@IsSelectedCommit(commit)"
                                             @onclick="@(args => HandleCommitRowClickAsync(args, commit))"
                                             @oncontextmenu:preventDefault="true"
                                             @oncontextmenu="@(args => OpenCommitContextMenuAsync(commit, args))"
                                             @onkeydown="@(args => HandleCommitRowKeyDown(args, commit))">
                                            <div class="git-commit-branch-labels">
                                                @if (commit.BranchLabels is { Count: > 0 })
                                                {
                                                    @foreach (var label in commit.BranchLabels)
                                                    {
                                                        <span @key="label.Name" class="git-commit-branch-label @(IsSoloDimmedBranchLabel(label) ? "git-solo-dimmed" : "")"
                                                               style="--branch-color: @GraphColor(label.Color)" title="@label.Name"
                                                               @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">
                                                            @if (label.IsLocal)
                                                            {
                                                                <MudIcon Icon="@Icons.Material.Filled.CallSplit" Size="Size.Small" aria-label="@L.T("Local")" Class="git-branch-label-icon" />
                                                            }
                                                            @if (label.IsRemote)
                                                            {
                                                                <MudIcon Icon="@Icons.Material.Filled.Cloud" Size="Size.Small" aria-label="@L.T("Remote")" Class="git-branch-label-icon" />
                                                            }
                                                            <span class="git-commit-branch-name">@label.Name</span>
                                                        </span>
                                                    }
                                                }
                                                else if (IsSelectedCommit(commit) && GetPathBranchLabel(commit) is { } pathLabel)
                                                {
                                                    <span class="git-commit-branch-label git-commit-branch-label-context @(IsSoloDimmedBranchLabel(pathLabel) ? "git-solo-dimmed" : "")"
                                                          style="--branch-color: @GraphColor(pathLabel.Color)" title="@pathLabel.Name">
                                                        @if (pathLabel.IsLocal)
                                                        {
                                                            <MudIcon Icon="@Icons.Material.Filled.CallSplit" Size="Size.Small" aria-label="@L.T("Local")" Class="git-branch-label-icon" />
                                                        }
                                                        @if (pathLabel.IsRemote)
                                                        {
                                                            <MudIcon Icon="@Icons.Material.Filled.Cloud" Size="Size.Small" aria-label="@L.T("Remote")" Class="git-branch-label-icon" />
                                                        }
                                                        <span class="git-commit-branch-name">@pathLabel.Name</span>
                                                    </span>
                                                }
                                            </div>
                                             <svg class="git-commit-graph" width="@GraphPixelWidth" height="52"
                                                  viewBox="0 0 @GraphPixelWidth 52" preserveAspectRatio="xMinYMid meet" aria-hidden="true">
                                                @if (commit.GraphEdges is not null)
                                                {
                                                    @foreach (var edge in commit.GraphEdges)
                                                    {
                                                        <path class="@(IsSoloDimmedGraphEdge(edge) ? "git-solo-dimmed" : "")" d="@GraphPath(edge)" fill="none" stroke="@GraphColor(edge.Color)" style="@GraphStrokeStyle(edge.Color)" stroke-width="2.5" stroke-linecap="round" />
                                                    }
                                                }
                                                <circle class="@(IsSoloDimmedCommit(commit) ? "git-solo-dimmed" : "")" cx="@GraphX(commit.GraphColumn)" cy="26" r="5.5" fill="var(--mud-palette-surface)" stroke="@GraphColor(commit.GraphColor)" style="@GraphStrokeStyle(commit.GraphColor)" stroke-width="3" />
                                            </svg>
                                            <div class="git-commit-content">
                                                <MudText Typo="Typo.body2" Class="git-commit-subject" title="@commit.Subject">@commit.Subject</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="git-commit-metadata" title="@($"{commit.ShortHash} · {commit.Author} · {FormatDate(commit.Date)}")">@commit.ShortHash · @commit.Author · @FormatDate(commit.Date)</MudText>
                                            </div>
                                        </div>
                                    }
                                    @if (_snapshot.Commits.Count == 0)
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L.T("No commits found.")</MudText>
                                    }
                                </MudStack>
                                @if (_contextMenuCommit is not null)
                                {
                                    <div class="git-context-menu-backdrop" @onclick="CloseCommitContextMenu">
                                        <div class="git-commit-context-menu" @onclick:stopPropagation="true">
                                            @if (_contextMenuCommit.BranchLabels is { Count: > 0 } soloLabels)
                                            {
                                                @foreach (var label in soloLabels)
                                                {
                                                    <button @key="label.Name" class="git-commit-context-menu-item" @onclick="@(() => ToggleSoloBranch(label))">
                                                        <MudIcon Icon="@(string.Equals(_soloBranchName, label.Name, StringComparison.Ordinal) ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)" Size="Size.Small" />
                                                        <span>@L.T(string.Equals(_soloBranchName, label.Name, StringComparison.Ordinal) ? "Stop soloing {0}" : "Solo branch: {0}", label.Name)</span>
                                                    </button>
                                                }
                                                <div class="git-context-menu-separator" role="separator"></div>
                                            }
                                            <button class="git-commit-context-menu-item" disabled="@_isOperating" @onclick="@(() => OpenCreateBranchDialog(_contextMenuCommit.Hash))">
                                                <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                                                <span>@L.T("Create branch here")</span>
                                            </button>
                                            <button class="git-commit-context-menu-item" disabled="@_isOperating" @onclick="CheckoutSelectedCommitAsync">
                                                <MudIcon Icon="@Icons.Material.Filled.CallSplit" Size="Size.Small" />
                                                <span>@L.T("Checkout commit (detached HEAD)")</span>
                                            </button>
                                            <div class="git-context-menu-separator" role="separator"></div>
                                             <button class="git-commit-context-menu-item" disabled="@(_isCheckingCherryPick || _isCommitOnCurrentBranch != false || _isOperating)"
                                                     aria-readonly="@(_isCheckingCherryPick || _isCommitOnCurrentBranch != false || _isOperating)"
                                                     @onclick="CherryPickSelectedCommitAsync">
                                                <MudIcon Icon="@Icons.Material.Filled.CallSplit" Size="Size.Small" />
                                                <span>@L.T("Cherry-pick commit")</span>
                                             </button>
                                              <button class="git-commit-context-menu-item" disabled="@_isOperating" @onclick="RevertSelectedCommitAsync">
                                                  <MudIcon Icon="@Icons.Material.Filled.Undo" Size="Size.Small" />
                                                  <span>@L.T("Revert commit")</span>
                                              </button>
                                              <div class="git-context-menu-separator" role="separator"></div>
                                              <div class="git-commit-context-menu-section-label">@L.T("Reset current branch to this commit")</div>
                                              <button class="git-commit-context-menu-item" disabled="@_isOperating" @onclick="@(() => ResetSelectedCommitAsync("soft"))">
                                                  <MudIcon Icon="@Icons.Material.Filled.FastForward" Size="Size.Small" />
                                                  <span>@L.T("Soft reset")</span>
                                              </button>
                                              <button class="git-commit-context-menu-item" disabled="@_isOperating" @onclick="@(() => ResetSelectedCommitAsync("mixed"))">
                                                  <MudIcon Icon="@Icons.Material.Filled.DriveFileMove" Size="Size.Small" />
                                                  <span>@L.T("Mixed reset")</span>
                                              </button>
                                              <button class="git-commit-context-menu-item" disabled="@_isOperating" @onclick="@(() => ResetSelectedCommitAsync("hard"))">
                                                  <MudIcon Icon="@Icons.Material.Filled.DeleteForever" Size="Size.Small" />
                                                  <span>@L.T("Hard reset")</span>
                                              </button>
                                              @if (_contextMenuMergeBranch is not null && !string.IsNullOrWhiteSpace(_contextMenuTargetBranch))
                                            {
                                                <button class="git-commit-context-menu-item" disabled="@(_isCheckingMergeBranch || !_mergeBranchReady || _isOperating)"
                                                        title="@(_mergeBranchError ?? string.Empty)" @onclick="MergeSelectedBranchAsync">
                                                    @if (_isCheckingMergeBranch)
                                                    {
                                                        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                                                    }
                                                    else
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.Merge" Size="Size.Small" />
                                                    }
                                                    <span>@L.T("Merge {0} into {1}", _contextMenuMergeBranch, _contextMenuTargetBranch)</span>
                                                </button>
                                            }
                                            <div class="git-context-menu-separator" role="separator"></div>
                                            <div class="git-commit-context-menu-section-label">@L.T("Copy to clipboard")</div>
                                            <button class="git-commit-context-menu-item" @onclick="@(() => CopyCommitBranchNamesAsync(_contextMenuCommit))">
                                                <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" />
                                                <span>@L.T("Copy branch name")</span>
                                            </button>
                                             <button class="git-commit-context-menu-item" @onclick="@(() => CopyCommitInfoAsync(_contextMenuCommit))">
                                                 <MudIcon Icon="@Icons.Material.Filled.Subject" Size="Size.Small" />
                                                 <span>@L.T("Copy commit info")</span>
                                             </button>
                                             <button class="git-commit-context-menu-item" @onclick="@(() => CopyCommitMessageAsync(_contextMenuCommit))">
                                                 <MudIcon Icon="@Icons.Material.Filled.Message" Size="Size.Small" />
                                                 <span>@L.T("Copy commit message")</span>
                                             </button>
                                             <button class="git-commit-context-menu-item" @onclick="@(() => CopyCommitShaAsync(_contextMenuCommit))">
                                                <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" />
                                                <span>@L.T("Copy commit SHA")</span>
                                            </button>
                                         </div>
                                     </div>
                                }
                                @if (_isCreateBranchDialogOpen)
                                {
                                    <div class="git-create-branch-backdrop" @onclick="CloseCreateBranchDialog">
                                        <div class="git-create-branch-dialog" role="dialog" aria-modal="true" aria-labelledby="create-branch-title" @onclick:stopPropagation="true">
                                            <MudText id="create-branch-title" Typo="Typo.h6">@L.T("Create new branch")</MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">@L.T("Create branch from {0}", _createBranchStartPointLabel)</MudText>
                                            <MudTextField @bind-Value="_newBranchName" Label="@L.T("Branch name")" Variant="Variant.Outlined" AutoFocus="true"
                                                          OnKeyDown="HandleCreateBranchKeyDown" Disabled="@_isCreatingBranch" />
                                            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-2">
                                                <MudButton Variant="Variant.Text" Disabled="@_isCreatingBranch" OnClick="CloseCreateBranchDialog">@L.T("Cancel")</MudButton>
                                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                                                           Disabled="@(_isCreatingBranch || string.IsNullOrWhiteSpace(_newBranchName))" OnClick="CreateBranchAsync">
                                                    @L.T("Create and checkout")
                                                </MudButton>
                                            </MudStack>
                                        </div>
                                    </div>
                                }
                        </MudPaper>
                        <div class="git-history-splitter git-history-commit-files-splitter" role="separator" aria-orientation="vertical" aria-label="@L.T("Resize commit files panel")" tabindex="0"></div>
                        <MudPaper Class="pa-3 git-dialog-panel git-commit-files-panel" Outlined="true" Elevation="0">
                            @if (!_isCommitFilesPanelCollapsed)
                            {
                                <div class="git-commit-files-header">
                                    <MudText Typo="Typo.subtitle1">@L.T("Commit files")</MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" aria-label="@L.T("Collapse commit files panel")" OnClick="ToggleCommitFilesPanel" />
                                </div>
                                @if (_selectedCommit is null)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L.T("Select a commit to view its files.")</MudText>
                                }
                                else if (_isLoadingCommitFiles)
                                {
                                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                                }
                                else
                                {
                                    <div class="git-commit-files-list">
                                        @if (_commitFiles.Count == 0)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L.T("No files changed in this commit.")</MudText>
                                        }
                                        @foreach (var file in _commitFiles)
                                        {
                                            <button @key="file.Path" class="git-commit-file-button @( _selectedCommitFile?.Path == file.Path ? "selected" : "")"
                                                    title="@file.Path" @onclick="@(() => SelectCommitFileAsync(file))">
                                                <span class="git-commit-file-status">@file.Status</span>
                                                <span class="git-commit-file-path">@file.Path</span>
                                            </button>
                                        }
                                    </div>
                                    @if (_selectedCommitFile is not null)
                                    {
                                        <MudText Typo="Typo.caption" Class="git-commit-file-diff-title" title="@_selectedCommitFile.Path">@_selectedCommitFile.Path</MudText>
                                        <GitDiffViewer Diff="@_selectedCommitFileDiff" IsLoading="@_isLoadingCommitFileDiff" CssClass="git-commit-file-diff" />
                                    }
                                }
                            }
                            else
                            {
                                <div class="git-commit-files-collapsed-rail">
                                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" aria-label="@L.T("Expand commit files panel")" OnClick="ToggleCommitFilesPanel" />
                                    @if (_selectedCommit is not null)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" title="@L.T("Commit files")" />
                                        <span class="git-commit-files-count">@_commitFiles.Count</span>
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" title="@L.T("Commit files")" />
                                    }
                                </div>
                            }
                        </MudPaper>
                    </div>
                }
                else
                {
                    <div class="git-commit-workspace">
                            <MudPaper Class="pa-3 git-dialog-panel git-diff-panel" Outlined="true" Elevation="0">
                                <MudStack Spacing="2" Class="git-diff-section">
                                    <MudText Typo="Typo.subtitle1">@L.T("Diff {0}", _selectedFile is null ? "" : $"— {_selectedFile.Path}")</MudText>
                                    @if (_selectedFile is null)
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L.T("Select a file to view its diff.")</MudText>
                                    }
                                    else
                                    {
                                        <GitDiffViewer Diff="@_selectedDiff" IsLoading="@_isLoadingDiff" />
                                    }
                                </MudStack>
                            </MudPaper>
                            <div class="git-commit-splitter" role="separator" aria-orientation="vertical" aria-label="@L.T("Resize diff and staging panels")" tabindex="0"></div>
                            <div class="git-commit-side-panel">
                                <MudPaper Class="pa-3 git-dialog-panel git-file-panel" Outlined="true" Elevation="0">
                                    <MudStack Spacing="1" Class="git-file-list-section">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="git-file-list-heading">
                                            <MudText Typo="Typo.subtitle1">@L.T("Unstaged ({0})", UnstagedFiles.Count)</MudText>
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="git-file-actions">
                                                <MudTooltip Text="@L.T("Stage all")">
                                                    <MudIconButton Class="git-file-action-button" Size="Size.Small" Variant="Variant.Outlined"
                                                                   Icon="@Icons.Material.Filled.PlaylistAddCheck" aria-label="@L.T("Stage all")"
                                                                    Disabled="@(_isOperating || StageableUnstagedFiles.Count == 0)" OnClick="StageAllAsync" />
                                                </MudTooltip>
                                                 <MudTooltip Text="@L.T("Stage selected ({0})", SelectedStageableUnstagedFiles.Count)">
                                                     <MudIconButton Class="git-file-action-button" Size="Size.Small" Variant="Variant.Outlined"
                                                                    Icon="@Icons.Material.Filled.PlaylistAdd" aria-label="@L.T("Stage selected ({0})", SelectedStageableUnstagedFiles.Count)"
                                                                    Disabled="@(_isOperating || SelectedStageableUnstagedFiles.Count == 0)"
                                                                   OnClick="StageSelectedAsync" />
                                                </MudTooltip>
                                                <MudTooltip Text="@L.T("Undo selected ({0})", SelectedUnstagedFiles.Count)">
                                                    <MudIconButton Class="git-file-action-button" Size="Size.Small" Variant="Variant.Outlined"
                                                                   Color="Color.Error" Icon="@Icons.Material.Filled.DeleteOutline"
                                                                   aria-label="@L.T("Undo selected ({0})", SelectedUnstagedFiles.Count)"
                                                                   Disabled="@(_isOperating || SelectedUnstagedFiles.Count == 0)"
                                                                   OnClick="DiscardSelectedUnstagedFilesAsync" />
                                                </MudTooltip>
                                            </MudStack>
                                        </MudStack>
                                        @if (UnstagedFiles.Count > 0)
                                        {
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="git-unstaged-actions">
                                                <MudCheckBox Class="git-file-checkbox git-select-all-checkbox" T="bool" Value="@AreAllUnstagedFilesSelected" ValueChanged="SetAllUnstagedFilesSelected"
                                                             Label="@L.T("Select all")" Disabled="@_isOperating" Size="Size.Small" />
                                            </MudStack>
                                        }
                                        @if (UnstagedFiles.Count == 0)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L.T("No unstaged changes.")</MudText>
                                        }
                                        <div class="git-file-list-scroll">
                                            @foreach (var file in UnstagedFiles)
                                            {
                                                @FileRow(file, false)
                                            }
                                        </div>
                                    </MudStack>
                                </MudPaper>
                                <MudPaper Class="pa-3 git-dialog-panel git-file-panel" Outlined="true" Elevation="0">
                                    <MudStack Spacing="1" Class="git-file-list-section">
                                        <MudText Typo="Typo.subtitle1">@L.T("Staged ({0})", StagedFiles.Count)</MudText>
                                        @if (StagedFiles.Count == 0)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L.T("No staged changes.")</MudText>
                                        }
                                        <div class="git-file-list-scroll">
                                            @foreach (var file in StagedFiles)
                                            {
                                                @FileRow(file, true)
                                            }
                                        </div>
                                    </MudStack>
                                </MudPaper>
                                <MudPaper Class="pa-3 git-dialog-panel git-message-panel" Outlined="true" Elevation="0">
                                    <MudStack Spacing="2">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                            <MudText Typo="Typo.subtitle1">@L.T("Commit message")</MudText>
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AutoAwesome"
                                                       Disabled="@(_isGeneratingMessage || _isCheckingAiConnection || !_hasAiConnection || StagedFiles.Count == 0)" OnClick="GenerateCommitMessageAsync">
                                                @(_isGeneratingMessage ? L.T("Generating...") : L.T("Generate with AI"))
                                            </MudButton>
                                        </MudStack>
                                        @if (_isCheckingAiConnection)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L.T("Checking AI connection...")</MudText>
                                        }
                                        <MudTextField @bind-Value="_commitTitle" Label="@L.T("Title (required)")" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                      Placeholder="@L.T("Short summary of the change")" MaxLength="72" Counter="72" Immediate="true" />
                                        <MudTextField @bind-Value="_commitDescription" Label="@L.T("Description (optional)")" Lines="2" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                      Placeholder="@L.T("More context about the change...")" />
                                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check"
                                                   Disabled="@(_isOperating || StagedFiles.Count == 0 || string.IsNullOrWhiteSpace(_commitTitle))"
                                                    OnClick="CommitChangesAsync">@L.T("Commit ({0} files)", StagedFiles.Count)</MudButton>
                                    </MudStack>
                                </MudPaper>
                            </div>
                    </div>
                }

                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="git-overview-status">
                    @_snapshot.ChangedFiles @L.T("changed") · @_snapshot.StagedFiles @L.T("Staged changes") · @_snapshot.UnstagedFiles @L.T("Unstaged changes") · @_snapshot.Ahead @L.T("Ahead") / @_snapshot.Behind @L.T("Behind")
                </MudText>
              </MudStack>
            }
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string RepositoryName { get; set; } = string.Empty;
    [Parameter] public string RepositoryPath { get; set; } = string.Empty;
    [Parameter] public LauncherSettings AiSettings { get; set; } = new();
    [Parameter] public RepositoryEntry? RepositorySettings { get; set; }

    private GitRepositorySnapshot? _snapshot;
    private IReadOnlyList<GitFileChange> _files = [];
    private IReadOnlyList<GitStashEntry> _stashes = [];
    private GitFileChange? _selectedFile;
    private bool _selectedFileIsStaged;
    private string _selectedDiff = string.Empty;
    private string _commitTitle = string.Empty;
    private string _commitDescription = string.Empty;
    private bool _isLoading = true;
    private string _loadingStage = "Checking repository...";
    private int? _loadedBranchCount;
    private bool _isLoadingDiff;
    private bool _isOperating;
    private bool _isGeneratingMessage;
    private bool _isCheckingAiConnection = true;
    private bool _hasAiConnection;
    private GitView _view = GitView.History;
    private bool _isBranchPanelCollapsed;
    private bool _isCommitFilesPanelCollapsed;
    private bool _isLoadingCommitFiles;
    private bool _isLoadingCommitFileDiff;
    private GitCommitEntry? _selectedCommit;
    private IReadOnlyList<GitCommitFile> _commitFiles = [];
    private GitCommitFile? _selectedCommitFile;
    private string _selectedCommitFileDiff = string.Empty;
    private GitCommitEntry? _contextMenuCommit;
    private double _contextMenuX;
    private double _contextMenuY;
    private bool _contextMenuNeedsPosition;
    private bool _isCheckingCherryPick;
    private bool? _isCommitOnCurrentBranch;
    private string? _contextMenuMergeBranch;
    private string? _contextMenuTargetBranch;
    private bool _isCheckingMergeBranch;
    private bool _mergeBranchReady;
    private string? _mergeBranchError;
    private bool _isCreateBranchDialogOpen;
    private bool _isCreatingBranch;
    private string _newBranchName = string.Empty;
    private string _createBranchStartPoint = "HEAD";
    private string _createBranchStartPointLabel = "HEAD";
    private bool _shouldScrollToCurrentBranch;
    private IJSObjectReference? _gitHistoryModule;
    private string? _selectedCommitHash;
    private string? _soloBranchName;
    private HashSet<string> _soloBranchCommitHashes = new(StringComparer.Ordinal);
    private GitStashEntry? _contextMenuStash;
    private GitStashEntry? _stashBeingEdited;
    private string _editedStashMessage = string.Empty;
    private bool _showHiddenStashes;
    private double _stashContextMenuX;
    private double _stashContextMenuY;
    private bool _stashContextMenuNeedsPosition;
    private readonly HashSet<string> _hiddenStashCommitHashes = new(StringComparer.Ordinal);
    private readonly HashSet<string> _selectedUnstagedFilePaths = new(StringComparer.Ordinal);
    private IReadOnlyList<GitBranchEntry> LocalBranches => _snapshot?.Branches.Where(branch => !branch.IsRemote).ToList() ?? [];
    private IReadOnlyList<GitBranchEntry> RemoteBranches => _snapshot?.Branches.Where(branch => branch.IsRemote).ToList() ?? [];
    private IReadOnlyList<BranchFolder> LocalBranchFolders => GroupBranchesIntoFolders(LocalBranches);
    private IReadOnlyList<BranchFolder> RemoteBranchFolders => GroupBranchesIntoFolders(RemoteBranches);
    private IReadOnlyList<GitFileChange> StagedFiles => _files.Where(file => file.IsStaged && !file.IsConflicted).ToList();
    private IReadOnlyList<GitFileChange> UnstagedFiles => _files.Where(file => file.IsUnstaged || file.IsUntracked).ToList();
    private IReadOnlyList<GitFileChange> StageableUnstagedFiles => UnstagedFiles.Where(file => !file.IsConflicted).ToList();
    private IReadOnlyList<GitFileChange> SelectedUnstagedFiles => UnstagedFiles.Where(file => _selectedUnstagedFilePaths.Contains(file.Path)).ToList();
    private IReadOnlyList<GitFileChange> SelectedStageableUnstagedFiles => SelectedUnstagedFiles.Where(file => !file.IsConflicted).ToList();
    private bool AreAllUnstagedFilesSelected => UnstagedFiles.Count > 0 && UnstagedFiles.All(file => _selectedUnstagedFilePaths.Contains(file.Path));
    private int HiddenStashCount => _stashes.Count(stash => _hiddenStashCommitHashes.Contains(stash.CommitHash));
    private IReadOnlyList<GitStashEntry> VisibleStashes => _stashes.Where(stash => _showHiddenStashes || !_hiddenStashCommitHashes.Contains(stash.CommitHash)).ToList();

    protected override void OnParametersSet()
    {
        _hiddenStashCommitHashes.Clear();
        if (RepositorySettings?.HiddenStashCommitHashes is { } hiddenHashes)
            _hiddenStashCommitHashes.UnionWith(hiddenHashes);
    }

    protected override Task OnInitializedAsync() => Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ = CheckAiConnectionAsync();
            _gitHistoryModule = await JS.InvokeAsync<IJSObjectReference>("import", "./git-history.js");
        }

        if (_snapshot?.IsValid == true && _gitHistoryModule is not null)
        {
            await _gitHistoryModule.InvokeVoidAsync("attachHistorySplitter");
            if (_view == GitView.History && _shouldScrollToCurrentBranch)
            {
                _shouldScrollToCurrentBranch = false;
                await _gitHistoryModule.InvokeVoidAsync("scrollToCurrentBranch");
            }
        }

        if (_contextMenuNeedsPosition && _contextMenuCommit is not null && _gitHistoryModule is not null)
        {
            await _gitHistoryModule.InvokeVoidAsync("positionCommitContextMenu", _contextMenuX, _contextMenuY);
            _contextMenuNeedsPosition = false;
        }

        if (_stashContextMenuNeedsPosition && _contextMenuStash is not null && _gitHistoryModule is not null)
        {
            await _gitHistoryModule.InvokeVoidAsync("positionStashContextMenu", _stashContextMenuX, _stashContextMenuY);
            _stashContextMenuNeedsPosition = false;
        }

        if (!firstRender)
            return;
        await RefreshAsync(fetch: true);
        _view = _files.Count > 0 ? GitView.Commit : GitView.History;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshAsync(bool fetch = false)
    {
        _isLoading = true;
        _loadingStage = fetch ? "Fetching remotes..." : "Checking repository...";
        _loadedBranchCount = null;
        try
        {
            _snapshot = await GitBranchService.GetRepositorySnapshotAsync(RepositoryPath, fetch, ReportSnapshotProgressAsync);
            RefreshSoloBranchCommits();
            _shouldScrollToCurrentBranch = _snapshot?.IsValid == true && _snapshot.Branch is not null;
            _files = await GitBranchService.GetFileChangesAsync(RepositoryPath);
            _stashes = await GitBranchService.GetStashesAsync(RepositoryPath);
            _selectedUnstagedFilePaths.IntersectWith(UnstagedFiles.Select(file => file.Path));
            if (_snapshot?.IsValid == true && _files.Count > 0)
                _view = GitView.Commit;
            else if (_snapshot?.IsValid == true && _view == GitView.Commit)
                _view = GitView.History;
            if (_selectedFile is not null)
            {
                _selectedFile = _files.FirstOrDefault(file => file.Path == _selectedFile.Path);
                if (_selectedFile is not null)
                    await LoadDiffAsync(_selectedFile);
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ReportSnapshotProgressAsync(GitSnapshotProgress progress)
    {
        _loadingStage = progress.Stage;
        if (progress.BranchCount is not null)
            _loadedBranchCount = progress.BranchCount;

        await InvokeAsync(StateHasChanged);
        await Task.Yield();
    }

    private async Task SwitchToCommitViewAsync()
    {
        _view = GitView.Commit;
        await RefreshAsync();
    }

    private async Task SelectFileAsync(GitFileChange file, bool staged)
    {
        _selectedFile = file;
        _selectedFileIsStaged = staged;
        await LoadDiffAsync(file);
    }

    private async Task LoadDiffAsync(GitFileChange file)
    {
        _isLoadingDiff = true;
        try
        {
            var result = await GitBranchService.GetFileDiffAsync(RepositoryPath, file, _selectedFileIsStaged);
            _selectedDiff = result.Success ? result.Output : result.Message;
        }
        finally
        {
            _isLoadingDiff = false;
        }
    }

    private async Task StageAsync(GitFileChange file)
    {
        if (file.IsConflicted)
            return;

        await RunFileOperationAsync(() => GitBranchService.StageFileAsync(RepositoryPath, file.Path));
    }

    private async Task UnstageAsync(GitFileChange file)
    {
        await RunFileOperationAsync(() => GitBranchService.UnstageFileAsync(RepositoryPath, file.Path));
    }

    private async Task StageAllAsync()
    {
        _isOperating = true;
        try
        {
            var conflictedCount = UnstagedFiles.Count(file => file.IsConflicted);
            var failed = 0;
            foreach (var file in StageableUnstagedFiles)
            {
                var result = await GitBranchService.StageFileAsync(RepositoryPath, file.Path);
                if (!result.Success)
                    failed++;
            }
            if (failed > 0)
                Snackbar.Add(L.T("Stage failed for {0} file(s).", failed), Severity.Error);
            if (conflictedCount > 0)
                Snackbar.Add(L.T("Skipped {0} conflicted file(s).", conflictedCount), Severity.Warning);
            await RefreshAsync();
        }
        finally
        {
            _isOperating = false;
        }
    }

    private async Task StageSelectedAsync()
    {
        var files = SelectedStageableUnstagedFiles.ToList();
        var conflictedCount = SelectedUnstagedFiles.Count(file => file.IsConflicted);
        if (files.Count == 0)
        {
            if (conflictedCount > 0)
                Snackbar.Add(L.T("Skipped {0} conflicted file(s).", conflictedCount), Severity.Warning);
            return;
        }

        _isOperating = true;
        try
        {
            var failed = 0;
            foreach (var file in files)
            {
                var result = await GitBranchService.StageFileAsync(RepositoryPath, file.Path);
                if (!result.Success)
                    failed++;
                else
                    _selectedUnstagedFilePaths.Remove(file.Path);
            }

            await RefreshAsync();
            if (failed > 0)
                Snackbar.Add(L.T("Stage failed for {0} file(s).", failed), Severity.Error);
            if (conflictedCount > 0)
                Snackbar.Add(L.T("Skipped {0} conflicted file(s).", conflictedCount), Severity.Warning);
        }
        finally
        {
            _isOperating = false;
        }
    }

    private void SetAllUnstagedFilesSelected(bool selected)
    {
        if (selected)
            _selectedUnstagedFilePaths.UnionWith(UnstagedFiles.Select(file => file.Path));
        else
            _selectedUnstagedFilePaths.Clear();
    }

    private void ToggleUnstagedFileSelection(GitFileChange file, bool selected)
    {
        if (selected)
            _selectedUnstagedFilePaths.Add(file.Path);
        else
            _selectedUnstagedFilePaths.Remove(file.Path);
    }

    private async Task DiscardSelectedUnstagedFilesAsync()
    {
        var files = SelectedUnstagedFiles.ToList();
        if (files.Count == 0)
            return;

        var ordinaryFiles = files.Where(file => !file.IsConflicted).ToList();
        if (ordinaryFiles.Count > 0)
        {
            var confirmed = await DialogService.ShowMessageBoxAsync(
                L.T("Undo unstaged changes?"),
                (MarkupString)string.Format(L.T("Undo confirmation"), ordinaryFiles.Count),
                yesText: L.T("Undo changes"),
                cancelText: L.T("Cancel"),
                options: new DialogOptions { CloseOnEscapeKey = true });
            if (confirmed != true)
                return;
        }

        _isOperating = true;
        try
        {
            var failed = 0;
            var discarded = 0;
            bool? applyToRemainingConflicts = null;
            foreach (var file in files)
            {
                if (file.IsConflicted)
                {
                    bool confirmed;
                    if (applyToRemainingConflicts.HasValue)
                    {
                        confirmed = applyToRemainingConflicts.Value;
                    }
                    else
                    {
                        var parameters = new DialogParameters<ConfirmConflictDiscardDialog>
                        {
                            { dialog => dialog.FilePath, file.Path },
                            { dialog => dialog.HasFollowingConflicts, files.SkipWhile(candidate => !string.Equals(candidate.Path, file.Path, StringComparison.Ordinal)).Skip(1).Any(candidate => candidate.IsConflicted) }
                        };
                        var dialog = await DialogService.ShowAsync<ConfirmConflictDiscardDialog>(
                            L.T("Undo conflicted file?"), parameters,
                            new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small });
                        var dialogResult = await dialog.Result;
                        if (dialogResult is null || dialogResult.Canceled || dialogResult.Data is not ValueTuple<bool, bool> choice)
                            break;

                        confirmed = choice.Item1;
                        if (choice.Item2)
                            applyToRemainingConflicts = confirmed;
                    }

                    if (!confirmed)
                        continue;
                }

                var result = await GitBranchService.DiscardUnstagedFileAsync(RepositoryPath, file);
                if (!result.Success)
                    failed++;
                else
                {
                    discarded++;
                    _selectedUnstagedFilePaths.Remove(file.Path);
                }
            }

            await RefreshAsync();
            if (failed > 0)
                Snackbar.Add(L.T("Undo failed for {0} file(s).", failed), Severity.Error);
            else if (discarded > 0)
                Snackbar.Add(L.T("Unstaged changes undone."), Severity.Success);
        }
        finally
        {
            _isOperating = false;
        }
    }

    private async Task RunFileOperationAsync(Func<Task<GitOperationResult>> operation)
    {
        _isOperating = true;
        try
        {
            var result = await operation();
            if (!result.Success)
                Snackbar.Add(result.Message, Severity.Error);
            await RefreshAsync();
        }
        finally
        {
            _isOperating = false;
        }
    }

    private async Task GenerateCommitMessageAsync()
    {
        _isGeneratingMessage = true;
        try
        {
            var diff = await GitBranchService.GetStagedDiffAsync(RepositoryPath);
            if (!diff.Success)
            {
                Snackbar.Add(L.T("Failed to load staged diff: {0}", diff.Message), Severity.Error);
                return;
            }

            var branch = await GitBranchService.GetCurrentBranchAsync(RepositoryPath);
            var result = await AiCommitMessageService.GenerateAsync(AiSettings, diff.Output, branch.Branch);
            if (result.Success)
            {
                _commitTitle = result.Title;
                _commitDescription = result.Description;
            }
            else
                Snackbar.Add(result.Error, Severity.Error);
        }
        finally
        {
            _isGeneratingMessage = false;
        }
    }

    private async Task CommitChangesAsync()
    {
        _isOperating = true;
        _loadingStage = "Creating commit...";
        try
        {
            var commitMessage = string.IsNullOrWhiteSpace(_commitDescription)
                ? _commitTitle.Trim()
                : $"{_commitTitle.Trim()}\n\n{_commitDescription.Trim()}";
            var result = await GitBranchService.CommitAsync(RepositoryPath, commitMessage);
            Snackbar.Add(result.Success ? L.T("Commit created.") : L.T("Commit failed: {0}", result.Message),
                result.Success ? Severity.Success : Severity.Error);
            if (result.Success)
            {
                _commitTitle = string.Empty;
                _commitDescription = string.Empty;
                _selectedFile = null;
                _selectedDiff = string.Empty;
                await RefreshAsync();
            }
        }
        finally
        {
            _isOperating = false;
        }
    }

