@page "/"
@inject LauncherSettingsService SettingsService
@inject PowerShellLauncher PowerShellLauncher
@inject GitBranchService GitBranchService
@inject RepositoryFolderPicker FolderPicker
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Repo Launcher</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    <MudStack Spacing="5">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <div>
                <MudText Typo="Typo.h4" Class="fw-bold">Repo Launcher</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary">Start OpenCode in je repositories.</MudText>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                       StartIcon="@Icons.Material.Filled.RocketLaunch" Disabled="@(!_settings.Repositories.Any(r => r.IsActive))"
                       OnClick="LaunchAll">
                Start alle actief
            </MudButton>
        </MudStack>

        <MudPaper Class="pa-5" Outlined="true" Elevation="0">
            <MudStack Spacing="3">
                <MudText Typo="Typo.h6">Startinstellingen</MudText>
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_settings.PowerShellExecutable" Label="PowerShell executable"
                                      HelperText="Bijvoorbeeld pwsh.exe of powershell.exe" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_settings.ToolCommand" Label="Tool / commando"
                                      HelperText="Bijvoorbeeld opencode" Variant="Variant.Outlined" />
                    </MudItem>
                </MudGrid>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-5" Outlined="true" Elevation="0">
            <MudStack Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <div>
                        <MudText Typo="Typo.h6">Repositories</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@ActiveCount actief van @_settings.Repositories.Count</MudText>
                    </div>
                    <MudStack Row="true" Spacing="2" Class="flex-wrap">
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddRepository">
                            Repository toevoegen
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
                                   OnClick="RefreshAllAsync" Disabled="@_isRefreshingBranches">
                            Git-status vernieuwen
                        </MudButton>
                    </MudStack>
                </MudStack>

                @if (_settings.Repositories.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        Voeg een repositorymap toe om te beginnen.
                    </MudAlert>
                }
                else
                {
                    <MudStack Spacing="2">
                        @foreach (var repository in _settings.Repositories)
                        {
                            <MudPaper @key="repository" Class="pa-3" Outlined="true" Elevation="0">
                                <MudGrid Spacing="2">
                                    <MudItem xs="12" sm="1">
                                        <MudSwitch @bind-Value="repository.IsActive" Color="Color.Primary" />
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudTextField @bind-Value="repository.Name" Label="Naam" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </MudItem>
                                     <MudItem xs="12" sm="6">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudTextField @bind-Value="repository.Path" Label="Pad" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                                            <MudIconButton Icon="@Icons.Material.Filled.FolderOpen" Color="Color.Primary"
                                                           aria-label="Repositorymap zoeken"
                                                           Disabled="@(!FolderPicker.IsSupported)"
                                                           OnClick="@(() => BrowseRepositoryAsync(repository))" />
                                        </MudStack>
                                    </MudItem>
                                    <MudItem xs="12" sm="1" Class="d-flex justify-end">
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error"
                                                       aria-label="Repository verwijderen" OnClick="@(() => RemoveRepository(repository))" />
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="flex-wrap">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@BranchLabel(repository)</MudText>
                                            @if (_gitSnapshots.TryGetValue(repository, out var snapshot) && snapshot.IsValid)
                                            {
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@snapshot.ChangedFiles gewijzigd</MudChip>
                                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">↑ @snapshot.Ahead</MudChip>
                                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">↓ @snapshot.Behind</MudChip>
                                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                                           StartIcon="@Icons.Material.Filled.AccountTree"
                                                           OnClick="@(() => OpenGitDialogAsync(repository))">Git-overzicht</MudButton>
                                            }
                                        </MudStack>
                                    </MudItem>
                                </MudGrid>
                            </MudPaper>
                        }
                    </MudStack>
                }
            </MudStack>
        </MudPaper>

        <MudStack Row="true" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Instellingen worden lokaal opgeslagen.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveSettings">Instellingen opslaan</MudButton>
        </MudStack>
    </MudStack>
</MudContainer>

@code {
    private LauncherSettings _settings = new();
    private int ActiveCount => _settings.Repositories.Count(r => r.IsActive);
    private readonly Dictionary<RepositoryEntry, GitBranchInfo> _branches = [];
    private readonly Dictionary<RepositoryEntry, GitRepositorySnapshot> _gitSnapshots = [];
    private bool _isRefreshingBranches;

    protected override async Task OnInitializedAsync()
    {
        _settings = await SettingsService.LoadAsync();
        await RefreshBranches();
    }

    private void AddRepository()
    {
        _settings.Repositories.Add(new RepositoryEntry { Name = "Nieuwe repository" });
    }

    private void RemoveRepository(RepositoryEntry repository)
    {
        _settings.Repositories.Remove(repository);
        _branches.Remove(repository);
        _gitSnapshots.Remove(repository);
    }

    private async Task RefreshBranches(bool force = false)
    {
        if (_isRefreshingBranches && !force)
            return;

        _isRefreshingBranches = true;
        try
        {
            var results = await Task.WhenAll(_settings.Repositories.Select(async repository =>
                (Repository: repository,
                 Snapshot: await GitBranchService.GetRepositorySnapshotAsync(repository.Path),
                 Branch: await GitBranchService.GetCurrentBranchAsync(repository.Path))));

            _branches.Clear();
            _gitSnapshots.Clear();
            foreach (var result in results)
            {
                _branches[result.Repository] = result.Branch;
                _gitSnapshots[result.Repository] = result.Snapshot;
            }
        }
        finally
        {
            _isRefreshingBranches = false;
        }
    }

    private async Task BrowseRepositoryAsync(RepositoryEntry repository)
    {
        var path = await FolderPicker.PickFolderAsync();
        if (string.IsNullOrWhiteSpace(path))
            return;

        repository.Path = path;
        if (string.IsNullOrWhiteSpace(repository.Name) || repository.Name == "Nieuwe repository")
            repository.Name = Path.GetFileName(Path.TrimEndingDirectorySeparator(path));
        await RefreshBranches();
    }

    private async Task OpenGitDialogAsync(RepositoryEntry repository)
    {
        var parameters = new DialogParameters<GitRepositoryDialog>
        {
            { dialog => dialog.RepositoryName, repository.Name },
            { dialog => dialog.RepositoryPath, repository.Path }
        };
        var options = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.ExtraLarge, CloseButton = true };
        var dialog = await DialogService.ShowAsync<GitRepositoryDialog>("Git-overzicht", parameters, options);
        await dialog.Result;
        await RefreshBranches();
    }

    private async Task RefreshAllAsync()
    {
        if (_isRefreshingBranches)
            return;

        _isRefreshingBranches = true;
        try
        {
            var fetchResults = await Task.WhenAll(_settings.Repositories
                .Where(repository => !string.IsNullOrWhiteSpace(repository.Path) && Directory.Exists(repository.Path))
                .Select(repository => GitBranchService.FetchAsync(repository.Path)));
            var failures = fetchResults.Count(result => !result.Success);
            if (failures > 0)
                Snackbar.Add($"Fetch mislukt voor {failures} repository(s).", Severity.Warning);

            await RefreshBranches(force: true);
        }
        finally
        {
            _isRefreshingBranches = false;
        }
    }

    private string BranchLabel(RepositoryEntry repository)
    {
        if (_isRefreshingBranches)
            return "Branch: ophalen...";

        if (!_branches.TryGetValue(repository, out var branchInfo))
            return "Branch: nog niet opgehaald";

        return branchInfo.Branch is not null
            ? $"Branch: {branchInfo.Branch}"
            : $"Branch: {branchInfo.Status}";
    }

    private async Task SaveSettings()
    {
        await SettingsService.SaveAsync(_settings);
        await RefreshBranches();
        Snackbar.Add("Instellingen opgeslagen.", Severity.Success);
    }

    private void LaunchAll()
    {
        var activeRepositories = _settings.Repositories.Where(r => r.IsActive).ToList();
        var invalidRepositories = activeRepositories
            .Where(repository => !Directory.Exists(repository.Path))
            .Select(repository => string.IsNullOrWhiteSpace(repository.Name) ? repository.Path : repository.Name)
            .ToList();

        try
        {
            var startedCount = PowerShellLauncher.LaunchAll(_settings, activeRepositories);
            if (startedCount == 0)
            {
                Snackbar.Add("Geen geldige repositorypaden om te starten.", Severity.Warning);
                return;
            }

            if (invalidRepositories.Count == 0)
                Snackbar.Add($"Windows Terminal gestart met {startedCount} tabblad(en).", Severity.Success);
            else
                Snackbar.Add($"{startedCount} tabblad(en) gestart. Overgeslagen (pad bestaat niet): {string.Join(", ", invalidRepositories)}", Severity.Warning, config => config.VisibleStateDuration = 10000);
        }
        catch (Exception exception)
        {
            Snackbar.Add($"Windows Terminal starten is mislukt: {exception.Message}", Severity.Error, config => config.VisibleStateDuration = 10000);
        }
    }
}
